@page "/notice/{Id:int}"
@inject HomeReader Reader
@inject NavigationManager Nav

<PageTitle>@(_view == null ? "가정통신문" : $"{_view.Notice.Month}월 가정통신문")</PageTitle>

<a class="hp-back" href="/"><i class="bi bi-arrow-left"></i> 목록</a>

@if (_notFound)
{
    <div class="hp-empty">
        <i class="bi bi-envelope-x"></i>
        <p>볼 수 없는 가정통신문입니다.</p>
        <p class="hp-hint">최근 가정통신문 @(HomeReader.VisibleNotices)개까지 볼 수 있습니다.</p>
    </div>
}
else if (_view != null)
{
    <NoticePaper Notice="_view.Notice" Profile="_view.Profile" DeptName="@_view.DeptName" />
}

@code {
    [Parameter] public int Id { get; set; }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private NoticeView? _view;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        var session = ParentClaims.FromPrincipal(HttpContext.User);
        if (session == null)
        {
            Nav.NavigateTo("/login");
            return;
        }

        bool ended = false;
        try
        {
            _view = await Reader.GetNoticeAsync(session, Id);
        }
        catch (ParentSessionEndedException)
        {
            ended = true;
            await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        }

        if (ended)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (_view == null)
        {
            // 다른 부서 것이든, 오래된 것이든, 없는 번호든 같은 답 — 무엇이 있는지 알려 주지 않는다
            _notFound = true;
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
