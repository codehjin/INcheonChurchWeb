<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="INcheonChurchWeb.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // 메시지 내의 줄바꿈(\n) 처리 및 글자 크기(+2px)를 위한 포맷팅 함수
        function formatMessage(msg) {
            if (typeof msg !== 'string') msg = String(msg);

            // XSS 보안 처리 및 줄바꿈 적용
            let safeMsg = msg.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            safeMsg = safeMsg.replace(/\n/g, '<br/>');

            // 기본 글꼴 크기(보통 16px)보다 2px 키운 18px로 강제 지정
            return `<div style="font-size: 18px; font-weight: 500; line-height: 1.6; color: #333; padding: 10px 0;">${safeMsg}</div>`;
        }

        // 기존 alert 덮어쓰기
        window.alert = function (message) {
            return Swal.fire({
                html: formatMessage(message),
                confirmButtonText: '확인',
                confirmButtonColor: '#0d6efd', // 파란색 테마
                allowOutsideClick: false, // 바깥 클릭 방지
                width: '420px',
                animation: false // 빠른 렌더링을 원하면 true로 변경 가능
            });
        };

        // 기존 confirm 덮어쓰기
        window.confirm = function (message) {
            return Swal.fire({
                html: formatMessage(message),
                showCancelButton: true,
                confirmButtonText: '확인',
                cancelButtonText: '취소',
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d', // 회색 테마
                allowOutsideClick: false,
                width: '420px'
            }).then((result) => {
                // C# 코드가 기다리고 있는 true/false 값을 정상적으로 돌려줌
                return result.isConfirmed;
            });
        };
    </script>
</body>

</html>