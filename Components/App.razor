@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="ko">

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="@V("app.css")" />
    <link rel="stylesheet" href="@V("mobile-app.css")" />
    <script src="@V("mobile-app.js")"></script>
    <link rel="stylesheet" href="INcheonChurchWeb.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* [해결 1] RenderMode 사용을 위한 @using 추가 및 HeadOutlet 설정 *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* [해결 2] Routes 설정의 InteractiveServer 오류 해결 *@
    <Routes @rendermode="InteractiveServer" />

    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* 파일이 바뀌면 주소도 바뀌도록 수정 시각을 붙인다 (브라우저 캐시가 옛 파일을 물고 있는 문제 방지) *@
    <script src="@V("js/app.js")"></script>

    <script>
        /* [중요] App.razor 안에 직접 작성되어 있던 window.printPopup 관련
           인라인 스크립트 중복 선언을 삭제했습니다.
           이제 모든 JS 로직은 버전 태그가 달린 /js/app.js에서 안전하게 불러옵니다.
        */

        // 숨겨진 파일 input 트리거 (서비스 로직상 필요한 부분만 유지)
        window.triggerFileInput = function (elementId) {
            const el = document.getElementById(elementId);
            if (el) el.click();
        };

        function formatMessage(msg) {
            if (typeof msg !== 'string') msg = String(msg);
            let safeMsg = msg.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            safeMsg = safeMsg.replace(/\n/g, '<br/>');
            return `<div style="font-size: 18px; font-weight: 500; line-height: 1.6; color: #333; padding: 10px 0;">${safeMsg}</div>`;
        }

        window.alert = function (message) {
            return Swal.fire({
                html: formatMessage(message),
                confirmButtonText: '확인',
                confirmButtonColor: '#0d6efd',
                allowOutsideClick: false,
                width: '420px',
                animation: false
            });
        };

        window.confirm = function (message) {
            return Swal.fire({
                html: formatMessage(message),
                showCancelButton: true,
                confirmButtonText: '확인',
                cancelButtonText: '취소',
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                allowOutsideClick: false,
                width: '420px'
            }).then((result) => {
                return result.isConfirmed;
            });
        };
    </script>
</body>

</html>

@code {
    // 정적 파일 주소에 마지막 수정 시각을 붙여 캐시를 무효화한다.
    private string V(string relativePath)
    {
        try
        {
            var full = Path.Combine(Env.WebRootPath, relativePath.Replace('/', Path.DirectorySeparatorChar));
            var ticks = File.GetLastWriteTimeUtc(full).Ticks;
            return $"/{relativePath}?v={ticks}";
        }
        catch
        {
            return "/" + relativePath;
        }
    }
}
