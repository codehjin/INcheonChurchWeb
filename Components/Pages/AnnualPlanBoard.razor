@page "/annual-plan"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using ClosedXML.Excel
@using System.IO
@inject AccountingService Accounting
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>연간 계획 · 인천중앙교회 재정 시스템</PageTitle>

<style>
    .ap-wrap { padding: 1.5rem 0.5rem 3rem; }

    .ap-head { display: flex; align-items: flex-end; gap: 0.75rem; margin-bottom: 1.5rem; }
    .ap-head-title { font-weight: 700; color: #1b1c15; font-family: 'Manrope', sans-serif; font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -0.02em; margin-bottom: 0.25rem; }
    .ap-head-sub { color: #4e4637; font-size: 1.2rem; margin-bottom: 0; }

    .ap-search { position: relative; width: 100%; margin-bottom: 0.7rem; }
    .ap-search-input {
        width: 100%; height: 42px; padding: 0 2.5rem 0 2.4rem;
        border: 1px solid var(--outline-variant); border-radius: 0.6rem;
        background: var(--surface-lowest); font-size: 0.95rem; color: var(--on-surface);
    }
    .ap-search-input:focus { outline: none; border-color: transparent; box-shadow: 0 0 0 2px rgba(120, 86, 0, 0.2); }
    .ap-search-icon {
        position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%);
        color: var(--on-surface-muted); font-size: 0.85rem; pointer-events: none;
    }
    .ap-search-clear {
        position: absolute; right: 0.55rem; top: 50%; transform: translateY(-50%);
        border: none; background: none; color: var(--on-surface-muted); cursor: pointer;
        padding: 0.35rem; line-height: 1; font-size: 0.8rem;
    }
    .ap-search-banner {
        display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
        background: var(--surface-low); border-radius: 0.6rem; padding: 0.55rem 0.9rem;
        margin-bottom: 0.9rem; font-size: 0.85rem; color: var(--on-surface-sub);
    }
    .ap-year-badge {
        font-size: 0.7rem; font-weight: 700; color: var(--primary-gold);
        background: var(--surface-mid); border-radius: 9999px; padding: 0.1rem 0.45rem; margin-right: 0.35rem;
    }

    .ap-filters { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-bottom: 1.1rem; }
    .ap-select {
        height: 38px; border: 1px solid var(--outline-variant); border-radius: 0.5rem;
        padding: 0 0.75rem; background: var(--surface-lowest); font-size: 0.9rem; color: var(--on-surface);
    }
    .ap-chip {
        border: 1px solid var(--outline-variant); border-radius: 9999px;
        padding: 0.45rem 1rem; font-size: 0.85rem; font-weight: 700; cursor: pointer;
        background: var(--surface-lowest); color: var(--on-surface-muted); transition: all 0.15s;
    }
    .ap-chip.active { background: var(--gold-gradient); color: #fff; border-color: transparent; }

    .ap-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin-bottom: 1.25rem; }
    .ap-sum-card {
        background: var(--surface-lowest); border-radius: 0.65rem; padding: 0.9rem 1.1rem;
        box-shadow: var(--shadow-ambient);
    }
    .ap-sum-label {
        font-size: 0.72rem; font-weight: 700; color: var(--primary-gold);
        text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.35rem;
    }
    .ap-sum-value { font-size: 1.4rem; font-weight: 900; color: var(--on-surface); font-variant-numeric: tabular-nums; }

    .ap-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.85rem; }

    .ap-card {
        background: var(--surface-lowest); border-radius: 0.75rem; padding: 1rem 1.1rem;
        box-shadow: var(--shadow-ambient); border-left: 4px solid var(--outline-variant);
        cursor: pointer; transition: transform 0.12s, box-shadow 0.12s; position: relative;
    }
    .ap-card:hover { transform: translateY(-2px); box-shadow: var(--elevation-shadow); }
    .ap-card.status-inprogress { border-left-color: var(--primary-gold); }
    .ap-card.status-done { border-left-color: var(--tertiary); }
    .ap-card.status-closed { border-left-color: var(--on-surface-muted); }

    .ap-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.6rem; }
    .ap-badge { border-radius: 9999px; padding: 0.15rem 0.6rem; font-size: 0.72rem; font-weight: 700; }
    .ap-badge.planned { background: var(--surface-high); color: var(--on-surface-muted); }
    .ap-badge.inprogress { background: var(--primary-dim); color: var(--primary); }
    .ap-badge.done { background: #dceafe; color: var(--tertiary); }
    .ap-badge.closed { background: var(--surface-highest); color: var(--on-surface-sub); }
    .ap-card-when { font-size: 0.75rem; color: var(--on-surface-muted); }
    .ap-card-title { font-size: 0.98rem; font-weight: 700; color: var(--on-surface); margin-bottom: 0.65rem; }
    .ap-card-figs { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--on-surface-muted); }
    .ap-card-figs b { color: var(--on-surface); font-weight: 700; }

    .ap-add-card {
        background: var(--surface); border-radius: 0.75rem; border: 1.5px dashed var(--outline-variant);
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        min-height: 118px; color: var(--primary-gold); cursor: pointer; transition: background 0.15s;
    }
    .ap-add-card:hover { background: var(--surface-low); }
    .ap-add-card i { font-size: 1.5rem; }
    .ap-add-card span { font-size: 0.85rem; font-weight: 700; margin-top: 0.25rem; }

    .ap-empty { text-align: center; color: var(--on-surface-muted); padding: 2.5rem 1rem; font-size: 0.95rem; }

    /* 모달 */
    .ap-modal-body { padding: 1.25rem 1.5rem; }
    .ap-field { margin-bottom: 1rem; }
    .ap-field label { display: block; font-size: 0.8rem; font-weight: 700; color: var(--on-surface-sub); margin-bottom: 0.35rem; }
    .ap-input {
        width: 100%; height: 40px; border: 1px solid var(--outline-variant); border-radius: 0.5rem;
        padding: 0 0.75rem; background: var(--surface-lowest); font-size: 0.9rem; color: var(--on-surface);
    }
    textarea.ap-input { height: auto; padding: 0.6rem 0.75rem; resize: vertical; }
    .ap-calc-hint {
        background: var(--surface-low); border-radius: 0.5rem; padding: 0.6rem 0.85rem;
        font-size: 0.82rem; color: var(--on-surface-sub); margin-bottom: 1rem;
    }
    .ap-calc-hint b { color: var(--primary-gold); }

    /* 🚀 지난 실적 표 */
    .ap-hist-box {
        background: var(--surface-low); border-radius: 0.5rem;
        padding: 0.6rem 0.85rem; margin-bottom: 1rem; font-size: 0.82rem;
    }
    .ap-hist-title { font-weight: 700; color: var(--on-surface-sub); margin-bottom: 0.45rem; }
    .ap-hist-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
    .ap-hist-table th {
        text-align: right; padding: 0.2rem 0.35rem; color: var(--on-surface-muted);
        font-weight: 700; border-bottom: 1px solid var(--outline-variant);
    }
    .ap-hist-table th:first-child, .ap-hist-table td:first-child { text-align: left; }
    .ap-hist-table td {
        text-align: right; padding: 0.25rem 0.35rem; color: var(--on-surface);
        font-variant-numeric: tabular-nums;
    }
    .ap-hist-table td.over { color: var(--error); font-weight: 700; }
    .ap-hist-table td.under { color: #4a7a4a; }
    .ap-hist-tip {
        margin-top: 0.4rem; padding-top: 0.4rem; border-top: 1px solid var(--outline-variant);
        font-size: 0.74rem; color: var(--primary-gold);
    }
    .ap-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .ap-gold-btn {
        background: var(--gold-gradient); color: #fff; border: none; border-radius: 0.5rem;
        padding: 0.6rem 1.25rem; font-size: 0.9rem; font-weight: 700; cursor: pointer;
    }
    .ap-ghost-btn {
        background: var(--surface-lowest); color: var(--on-surface-sub); border: 1px solid var(--outline-variant);
        border-radius: 0.5rem; padding: 0.6rem 1.25rem; font-size: 0.9rem; font-weight: 700; cursor: pointer;
    }
    .ap-del-btn {
        background: transparent; color: var(--error); border: 1px solid var(--error);
        border-radius: 0.5rem; padding: 0.6rem 1rem; font-size: 0.85rem; font-weight: 700; cursor: pointer;
    }
</style>

<CascadingValue Value="CurrentUser">
<div class="ap-wrap">

    <div class="ap-head">
        <div>
            <h2 class="ap-head-title">연간 계획</h2>
            <p class="ap-head-sub">@_targetYear 회계연도 · @_currentDeptName · 한 해 행사를 미리 계획합니다.</p>
        </div>
        @if (_canEdit)
        {
            <button class="ap-ghost-btn" style="margin-left:auto;" @onclick="OpenImport">
                <i class="bi bi-upload me-1"></i>일괄 등록
            </button>
        }
    </div>

    @* ── 검색 ── *@
    <div class="ap-search">
        <i class="bi bi-search ap-search-icon"></i>
        <input type="text" class="ap-search-input"
               placeholder="행사명 · 추진 내용 · 날짜(2026-07-28) · 분기(3분기)로 검색"
               @bind="_search" @bind:event="oninput" @bind:after="OnSearchChangedAsync" />
        @if (IsSearching)
        {
            <button class="ap-search-clear" title="검색 지우기" @onclick="ClearSearch">
                <i class="bi bi-x-lg"></i>
            </button>
        }
    </div>

    @if (IsSearching)
    {
        <div class="ap-search-banner">
            <i class="bi bi-funnel"></i>
            <span><b>‘@_search.Trim()’</b> 검색 결과 @(_visiblePlans.Count)건 · 전체 연도</span>
            <button class="ap-chip" style="margin-left:auto;" @onclick="ClearSearch">검색 해제</button>
        </div>
    }

    @* ── 필터 ── *@
    <div class="ap-filters">
        <select class="ap-select" @onchange="OnYearChanged" disabled="@IsSearching"
                title="@(IsSearching ? "검색 중에는 전체 연도를 조회합니다" : "")">
            @for (int y = DateTime.Now.Year + 1; y >= DateTime.Now.Year - 3; y--)
            {
                <option value="@y" selected="@(y == _targetYear)">@(y)년</option>
            }
        </select>

        @if (_canPickDept)
        {
            <select class="ap-select" @onchange="OnDeptChanged">
                @foreach (var d in _departments)
                {
                    <option value="@d.Id" selected="@(d.Id == _viewDeptId)">@d.Name</option>
                }
            </select>
        }

        <div style="width:1px; height:24px; background:var(--outline-variant); margin:0 0.25rem;"></div>

        <button class="ap-chip @(_filterQuarter == 0 ? "active" : "")" @onclick="() => SetQuarter(0)">전체</button>
        <button class="ap-chip @(_filterQuarter == 1 ? "active" : "")" @onclick="() => SetQuarter(1)">1분기</button>
        <button class="ap-chip @(_filterQuarter == 2 ? "active" : "")" @onclick="() => SetQuarter(2)">2분기</button>
        <button class="ap-chip @(_filterQuarter == 3 ? "active" : "")" @onclick="() => SetQuarter(3)">3분기</button>
        <button class="ap-chip @(_filterQuarter == 4 ? "active" : "")" @onclick="() => SetQuarter(4)">4분기</button>
    </div>

    @* ── 상태 필터 ── *@
    <div class="ap-filters" style="margin-top:-0.4rem;">
        <span style="font-size:0.78rem; font-weight:700; color:var(--on-surface-muted); margin-right:0.15rem;">상태</span>
        <button class="ap-chip @(_filterStatus == null ? "active" : "")" @onclick="() => SetStatus(null)">전체</button>
        <button class="ap-chip @(_filterStatus == PlanStatus.Planned ? "active" : "")" @onclick="() => SetStatus(PlanStatus.Planned)">계획</button>
        <button class="ap-chip @(_filterStatus == PlanStatus.InProgress ? "active" : "")" @onclick="() => SetStatus(PlanStatus.InProgress)">진행</button>
        <button class="ap-chip @(_filterStatus == PlanStatus.Done ? "active" : "")" @onclick="() => SetStatus(PlanStatus.Done)">완료</button>
        <button class="ap-chip @(_filterStatus == PlanStatus.Closed ? "active" : "")" @onclick="() => SetStatus(PlanStatus.Closed)">마감</button>
    </div>

    @* ── 요약 ── *@
    <div class="ap-summary">
        <div class="ap-sum-card">
            <div class="ap-sum-label">계획</div>
            <div class="ap-sum-value">@_visiblePlans.Count 건</div>
        </div>
        <div class="ap-sum-card">
            <div class="ap-sum-label">목표수입</div>
            <div class="ap-sum-value">@_visiblePlans.Sum(p => p.PlannedIncome).ToString("N0")</div>
        </div>
        <div class="ap-sum-card">
            <div class="ap-sum-label">편성지출</div>
            <div class="ap-sum-value">@_visiblePlans.Sum(p => p.PlannedExpense).ToString("N0")</div>
        </div>
    </div>

    @* ── 카드 그리드 ── *@
    @if (_isLoading)
    {
        <div class="ap-empty">불러오는 중…</div>
    }
    else
    {
        <div class="ap-grid">
            @foreach (var p in _visiblePlans)
            {
                <div class="ap-card @StatusClass(p.Status)" @onclick="() => OpenEdit(p)">
                    <div class="ap-card-top">
                        <span class="ap-badge @StatusBadge(p.Status)">@StatusLabel(p.Status)</span>
                        <span class="ap-card-when">
                            @if (IsSearching)
                            {
                                <span class="ap-year-badge">@p.FiscalYear</span>
                            }
                            @WhenLabel(p)
                        </span>
                    </div>
                    <div class="ap-card-title">@p.Title</div>
                    <div class="ap-card-figs">
                        <span>지출 <b>@p.PlannedExpense.ToString("N0")</b></span>
                        <i class="bi bi-pencil-square" style="color:var(--primary-gold);"></i>
                    </div>
                </div>
            }

            @if (_canEdit && !IsSearching)
            {
                <div class="ap-add-card" @onclick="OpenAdd">
                    <i class="bi bi-plus-lg"></i>
                    <span>계획 추가</span>
                </div>
            }
        </div>

        @if (!_visiblePlans.Any())
        {
            <div class="ap-empty">@(IsSearching ? "검색 결과가 없습니다." : "등록된 연간 계획이 없습니다.")</div>
        }
    }

</div>

@* ══════════════ 추가/수정 모달 ══════════════ *@
@if (_showModal)
{
    @* 배경 클릭으로 닫지 않는다. (입력란 클릭 시 이벤트 전파로 모달이 닫히는 문제 방지)
       닫기는 우측 상단 X 또는 취소 버튼으로만 한다. *@
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.55);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0" style="border-radius: 0.9rem; overflow: hidden;">
                <div class="modal-header border-0" style="background: var(--surface-low);">
                    <h5 class="modal-title fw-bold" style="color: var(--on-surface);">
                        <i class="bi @(_editing.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-1" style="color: var(--primary-gold);"></i>
                        @(_editing.Id == 0 ? "계획 추가" : "계획 수정")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="ap-modal-body">
                    <div class="ap-field">
                        <label>행사명</label>
                        <input class="ap-input" @bind="_editing.Title" @bind:after="LoadHistory" list="event-categories"
                               placeholder="예산 항목에서 선택하거나 직접 입력" autocomplete="off" />
                        <datalist id="event-categories">
                            @foreach (var cat in _eventCategories)
                            {
                                <option value="@cat" />
                            }
                        </datalist>
                        <div style="font-size:0.75rem; color:var(--on-surface-muted); margin-top:0.3rem;">
                            <i class="bi bi-lightbulb me-1"></i>
                            예산에 등록된 항목을 고르면 나중에 지출·보고서가 자동 연결됩니다.
                        </div>
                    </div>

                    <div class="ap-row2">
                        <div class="ap-field">
                            <label>시작일</label>
                            <input type="date" class="ap-input" @bind="_editDate" @bind:after="OnStartDateChanged" />
                        </div>
                        <div class="ap-field">
                            <label>종료일 <span style="font-weight:400; color:var(--on-surface-muted);">(하루면 비움)</span></label>
                            <input type="date" class="ap-input" @bind="_editEndDate" />
                        </div>
                    </div>

                    @if (_dateInfo != null)
                    {
                        <div class="ap-calc-hint">
                            <i class="bi bi-magic me-1"></i>
                            시작일 기준: <b>@(_dateInfo.FiscalYear) 회계연도</b> ·
                            <b>@(_dateInfo.Month)월 @(_dateInfo.MonthWeek)주차</b> ·
                            <b>@(_dateInfo.Quarter)분기</b> (연중 @(_dateInfo.WeekNo)주)
                        </div>
                    }

                    <div class="ap-field">
                        <label>추진 내용 <span style="font-weight:400; color:var(--on-surface-muted);">(선택)</span></label>
                        <textarea class="ap-input" rows="2" @bind="_editing.Description" placeholder="행사 개요·준비 사항 등"></textarea>
                    </div>

                    @* 🚀 과거 실적 — 얼마 편성할지 판단하는 자리에 바로 보여준다 *@
                    @if (_historyLoading)
                    {
                        <div class="ap-hist-box" style="color:var(--on-surface-muted);">지난 실적 확인 중…</div>
                    }
                    else if (_history.Any())
                    {
                        <div class="ap-hist-box">
                            <div class="ap-hist-title">
                                <i class="bi bi-clock-history me-1"></i>@_historyFor · 지난 실적
                            </div>
                            <table class="ap-hist-table">
                                <thead>
                                    <tr>
                                        <th>연도</th>
                                        <th>편성</th>
                                        <th>집행</th>
                                        <th>수입</th>
                                        <th>편차</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in _history)
                                    {
                                        <tr>
                                            <td>@(h.Year)년</td>
                                            <td>@h.Budget.ToString("N0")</td>
                                            <td class="@(h.Spent > h.Budget ? "over" : "")">@h.Spent.ToString("N0")</td>
                                            <td>@(h.Income > 0 ? h.Income.ToString("N0") : "—")</td>
                                            <td class="@(h.Spent > h.Budget ? "over" : "under")">
                                                @(h.Spent > h.Budget ? "+" : "")@((h.Spent - h.Budget).ToString("N0"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (_history.Any(h => h.Spent > h.Budget))
                            {
                                <div class="ap-hist-tip">
                                    <i class="bi bi-lightbulb me-1"></i>
                                    예산을 초과한 해가 있습니다. 편성액 결정 시 참고하세요.
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_historyFor))
                    {
                        <div class="ap-hist-box" style="color:var(--on-surface-muted);">
                            <i class="bi bi-info-circle me-1"></i>@_historyFor · 지난 실적이 없습니다 (신규 행사)
                        </div>
                    }

                    <div class="ap-row2">
                        <div class="ap-field">
                            <label>목표 수입</label>
                            <input type="number" class="ap-input" @bind="_editing.PlannedIncome" />
                        </div>
                        <div class="ap-field">
                            <label>편성 지출</label>
                            <input type="number" class="ap-input" @bind="_editing.PlannedExpense" />
                        </div>
                    </div>

                    <div class="ap-field">
                        <label>상태</label>
                        <select class="ap-input" @bind="_editing.Status">
                            <option value="@PlanStatus.Planned">계획</option>
                            <option value="@PlanStatus.InProgress">진행</option>
                            <option value="@PlanStatus.Done">완료</option>
                            <option value="@PlanStatus.Closed">마감</option>
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div style="color: var(--error); font-size: 0.83rem; margin-bottom: 0.75rem;">
                            <i class="bi bi-exclamation-circle me-1"></i>@_modalError
                        </div>
                    }
                </div>

                <div class="modal-footer border-0" style="justify-content: space-between;">
                    <div>
                        @if (_editing.Id != 0)
                        {
                            <button class="ap-del-btn" @onclick="DeletePlan"><i class="bi bi-trash me-1"></i>삭제</button>
                        }
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                        <button class="ap-ghost-btn" @onclick="CloseModal">취소</button>
                        <button class="ap-gold-btn" @onclick="SavePlan">저장</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@* ══════════════ 일괄 등록(엑셀/CSV) 모달 ══════════════ *@
@if (_showImport)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.55);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0" style="border-radius: 0.9rem; overflow: hidden;">
                <div class="modal-header border-0" style="background: var(--surface-low);">
                    <h5 class="modal-title fw-bold" style="color: var(--on-surface);">
                        <i class="bi bi-upload me-1" style="color: var(--primary-gold);"></i>연간 계획 일괄 등록
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseImport"></button>
                </div>

                <div class="ap-modal-body">
                    <div class="ap-calc-hint" style="margin-bottom:1rem;">
                        <i class="bi bi-info-circle me-1"></i>
                        엑셀(.xlsx) 또는 CSV 파일로 여러 계획을 한 번에 등록합니다.
                        <b>@_currentDeptName</b> 부서로 등록되며, 회계연도·분기·주차는 시작일에서 자동 계산됩니다.
                    </div>

                    <div class="ap-field">
                        <label>1단계 · 양식 내려받기</label>
                        <button class="ap-ghost-btn" @onclick="DownloadTemplate">
                            <i class="bi bi-download me-1"></i>@(_targetYear - 1)년 계획 불러오기
                        </button>
                        <div style="font-size:0.78rem; color:var(--on-surface-muted); margin-top:0.4rem; line-height:1.6;">
                            <b>@(_targetYear - 1)년 계획이 그대로 채워진</b> 엑셀을 받습니다. 날짜는 1년 뒤로 자동 조정되니
                            실제 일정에 맞게 고쳐 쓰세요.<br />
                            오른쪽에 <b>작년 편성·집행·편차</b>가 참고용으로 함께 나오며(회색),
                            예산을 초과한 행사는 <span style="color:var(--error);">붉게</span> 표시됩니다.<br />
                            등록되는 열: 행사명 · 시작일 · 종료일 · 추진내용 · 목표수입 · 편성지출 · 상태
                        </div>
                    </div>

                    <div class="ap-field">
                        <label>2단계 · 파일 선택</label>
                        <InputFile OnChange="HandleImportFile" class="ap-input" style="height:auto; padding:0.5rem;"
                                   accept=".xlsx,.csv" />
                    </div>

                    @if (_importRows.Any())
                    {
                        <div class="ap-field">
                            <label>3단계 · 미리보기 (@_importRows.Count 건)</label>
                            <div style="max-height:220px; overflow-y:auto; border:1px solid var(--outline-variant); border-radius:0.5rem;">
                                <table style="width:100%; font-size:0.8rem; border-collapse:collapse;">
                                    <thead style="background:var(--surface-low); position:sticky; top:0;">
                                        <tr>
                                            <th style="text-align:left; padding:6px 8px;">행사명</th>
                                            <th style="text-align:left; padding:6px 8px;">기간</th>
                                            <th style="text-align:right; padding:6px 8px;">지출</th>
                                            <th style="text-align:center; padding:6px 8px;">분기</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _importRows)
                                        {
                                            <tr style="border-top:1px solid var(--outline-variant);">
                                                <td style="padding:6px 8px;">@r.Title</td>
                                                <td style="padding:6px 8px; color:var(--on-surface-muted);">
                                                    @r.EventDate.ToString("MM/dd")@(r.EndDate.HasValue ? "~" + r.EndDate.Value.ToString("MM/dd") : "")
                                                </td>
                                                <td style="padding:6px 8px; text-align:right;">@r.PlannedExpense.ToString("N0")</td>
                                                <td style="padding:6px 8px; text-align:center;">@(r.Quarter)분기</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_importMessage))
                    {
                        <div style="color:@(_importIsError ? "var(--error)" : "var(--primary-gold)"); font-size:0.83rem; margin-bottom:0.75rem;">
                            <i class="bi @(_importIsError ? "bi-exclamation-circle" : "bi-check-circle") me-1"></i>@_importMessage
                        </div>
                    }
                </div>

                <div class="modal-footer border-0" style="justify-content: flex-end; gap:0.5rem;">
                    <button class="ap-ghost-btn" @onclick="CloseImport">취소</button>
                    <button class="ap-gold-btn" disabled="@(!_importRows.Any() || _isImporting)" @onclick="ConfirmImport">
                        @(_isImporting ? "등록 중…" : $"{_importRows.Count}건 등록")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
</CascadingValue>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private int _targetYear = DateTime.Now.Year;
    private int _filterQuarter = 0;          // 0=전체
    private PlanStatus? _filterStatus = null; // null=전체
    private int _viewDeptId;                  // 현재 조회 중인 부서
    private string _currentDeptName = "";
    private bool _canEdit;                    // Manager/Admin
    private bool _canPickDept;               // Admin/Auditor → 부서 선택 가능
    private bool _isLoading = true;

    private List<Department> _departments = new();
    private List<AnnualPlan> _allPlans = new();
    private List<AnnualPlan> _visiblePlans = new();
    private List<string> _eventCategories = new();   // 예산·장부의 지출 카테고리(=행사명) 제안 목록

    // ── 검색 ── 검색어가 있으면 연도 선택을 무시하고 전체 연도를 대상으로 한다.
    private string _search = "";
    private List<AnnualPlan> _searchPool = new();    // 전체 연도 캐시 (첫 검색 때 한 번만 로드)
    private bool _searchPoolLoaded = false;
    private bool IsSearching => !string.IsNullOrWhiteSpace(_search);

    // 🚀 과거 연도 실적 (행사명 선택 시 자동 조회). 최근 연도부터.
    //   "작년엔 얼마 잡고 얼마 썼나"를 계획 세우는 순간에 보여준다.
    private List<(int Year, decimal Budget, decimal Spent, decimal Income)> _history = new();
    private bool _historyLoading = false;
    private string _historyFor = "";                 // 어떤 행사명으로 조회했는지(중복 조회 방지)

    // 선택된 행사명의 과거 3년 실적을 불러온다.
    private async Task LoadHistory()
    {
        var name = (_editing.Title ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name)) { _history.Clear(); _historyFor = ""; return; }
        if (_historyFor == name) return;             // 같은 행사면 재조회 생략

        _historyLoading = true;
        _historyFor = name;
        _history.Clear();

        // 현재 편성 중인 회계연도의 직전 3개년
        int baseYear = _dateInfo?.FiscalYear ?? _targetYear;
        for (int y = baseYear - 1; y >= baseYear - 3; y--)
        {
            var fins = await Accounting.GetEventFinancesAsync(_viewDeptId, y);
            var f = fins.FirstOrDefault(x => x.EventName.Trim() == name);
            if (f != null && (f.Budget > 0 || f.Spent > 0))
                _history.Add((y, f.Budget, f.Spent, f.Income));
        }

        _historyLoading = false;
    }

    private bool _showModal = false;
    private AnnualPlan _editing = new();
    private DateTime _editDate = DateTime.Today;
    private DateTime? _editEndDate = null;
    private AccountingService.PlanDateInfo? _dateInfo;
    private string _modalError = "";

    protected override async Task OnInitializedAsync()
    {
        _canEdit = CurrentUser?.CanEdit == true;
        _canPickDept = CurrentUser?.CanViewAll == true;

        _departments = await Accounting.GetDepartmentsAsync();
        _viewDeptId = CurrentUser?.DepartmentId ?? (_departments.FirstOrDefault()?.Id ?? 0);

        await LoadPlans();
    }

    private async Task LoadPlans()
    {
        _isLoading = true;
        _currentDeptName = _departments.FirstOrDefault(d => d.Id == _viewDeptId)?.Name ?? "";

        // 행사명 제안 목록(예산+장부의 지출 카테고리) — 드롭다운 자동완성용
        _eventCategories = await Accounting.GetCategorySuggestionsAsync(_viewDeptId, "Expense");

        if (_canPickDept && CurrentUser?.IsSystemAdmin == true && _viewDeptId == 0)
            _allPlans = await Accounting.GetAllAnnualPlansAsync(_targetYear);
        else
            _allPlans = await Accounting.GetAnnualPlansAsync(_viewDeptId, _targetYear);

        _searchPoolLoaded = false;   // 부서·연도가 바뀌면 검색 캐시를 버린다
        if (IsSearching) await EnsureSearchPoolAsync();

        ApplyFilter();
        _isLoading = false;
    }

    // 전체 연도 데이터를 한 번만 불러와 캐시한다.
    private async Task EnsureSearchPoolAsync()
    {
        if (_searchPoolLoaded) return;

        if (_canPickDept && CurrentUser?.IsSystemAdmin == true && _viewDeptId == 0)
            _searchPool = await Accounting.GetAllAnnualPlansAllYearsAsync();
        else
            _searchPool = await Accounting.GetAnnualPlansAllYearsAsync(_viewDeptId);

        _searchPoolLoaded = true;
    }

    private async Task OnSearchChangedAsync()
    {
        if (IsSearching) await EnsureSearchPoolAsync();
        ApplyFilter();
    }

    private void ClearSearch()
    {
        _search = "";
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<AnnualPlan> q = IsSearching ? _searchPool : _allPlans;

        // 검색어 토큰은 AND로 겹쳐 적용한다.
        foreach (var token in BoardSearch.Parse(_search))
        {
            var t = token;   // 람다가 루프 변수를 캡처하지 않도록 복사
            q = t.Kind switch
            {
                SearchTokenKind.Quarter => q.Where(p => p.Quarter == t.Quarter),
                SearchTokenKind.Year => q.Where(p => p.FiscalYear == t.Year),
                SearchTokenKind.Text => q.Where(p => BoardSearch.MatchesText(t, p.Title, p.Description)),
                _ => q.Where(p => BoardSearch.MatchesDate(t, p.EventDate, p.EndDate)),
            };
        }

        if (_filterQuarter != 0)
            q = q.Where(p => p.Quarter == _filterQuarter);

        if (_filterStatus.HasValue)
            q = q.Where(p => p.Status == _filterStatus.Value);

        _visiblePlans = IsSearching
            ? q.OrderByDescending(p => p.FiscalYear).ThenBy(p => p.Quarter).ThenBy(p => p.WeekNo).ToList()
            : q.ToList();
    }

    private void SetStatus(PlanStatus? s) { _filterStatus = s; ApplyFilter(); }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y)) { _targetYear = y; await LoadPlans(); }
    }

    private async Task OnDeptChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id)) { _viewDeptId = id; await LoadPlans(); }
    }

    private void SetQuarter(int q) { _filterQuarter = q; ApplyFilter(); }

    // ── 모달 ──
    private async Task OpenAdd()
    {
        _editing = new AnnualPlan
        {
            DepartmentId = _viewDeptId,
            Status = PlanStatus.Planned
        };
        _editDate = DateTime.Today;
        _editEndDate = DateTime.Today.AddDays(1);   // 기본: 시작일 다음날
        _modalError = "";
        _showModal = true;
        _history.Clear(); _historyFor = "";
        await RecalcDateInfo();
    }

    private async Task OpenEdit(AnnualPlan p)
    {
        // 조회 목록은 AsNoTracking이므로 편집용 복사본을 만든다.
        _editing = new AnnualPlan
        {
            Id = p.Id,
            DepartmentId = p.DepartmentId,
            EventDate = p.EventDate,
            EndDate = p.EndDate,
            FiscalYear = p.FiscalYear,
            WeekNo = p.WeekNo,
            Quarter = p.Quarter,
            Title = p.Title,
            Description = p.Description,
            PlannedIncome = p.PlannedIncome,
            PlannedExpense = p.PlannedExpense,
            Status = p.Status
        };
        _editDate = p.EventDate == default ? DateTime.Today : p.EventDate;
        _editEndDate = p.EndDate;
        _modalError = "";
        _showModal = true;
        _historyFor = "";                 // 강제 재조회
        await RecalcDateInfo();
        await LoadHistory();
    }

    // 시작일이 바뀌면: 회계연도·분기·주차를 다시 계산하고,
    // 종료일도 시작일 다음날로 자동 조정한다(사용자가 직접 바꾸면 그 값이 유지됨).
    // (@bind:after 가 자동으로 리렌더하므로 StateHasChanged 를 부르지 않는다)
    private async Task OnStartDateChanged()
    {
        // 종료일이 비어있거나, 시작일보다 앞서면 → 시작일 다음날로 자동 설정
        if (!_editEndDate.HasValue || _editEndDate.Value.Date < _editDate.Date)
        {
            _editEndDate = _editDate.AddDays(1);
        }
        await RecalcDateInfo();
    }

    private async Task RecalcDateInfo()
    {
        _dateInfo = await Accounting.CalcPlanDateInfoAsync(_editing.DepartmentId, _editDate);
    }

    private void CloseModal() { _showModal = false; }

    private async Task SavePlan()
    {
        if (string.IsNullOrWhiteSpace(_editing.Title)) { _modalError = "행사명을 입력하세요."; return; }
        if (_editEndDate.HasValue && _editEndDate.Value < _editDate)
        {
            _modalError = "종료일이 시작일보다 빠릅니다.";
            return;
        }

        // 시작일 → 회계연도·분기·주차 최종 반영
        var info = await Accounting.CalcPlanDateInfoAsync(_editing.DepartmentId, _editDate);
        _editing.EventDate = _editDate;
        _editing.EndDate = _editEndDate;
        _editing.FiscalYear = info.FiscalYear;
        _editing.Quarter = info.Quarter;
        _editing.WeekNo = info.WeekNo;

        await Accounting.SaveAnnualPlanAsync(_editing, CurrentUser?.Username);
        _showModal = false;

        // 저장한 계획의 회계연도로 화면을 맞춰 바로 보이게 함
        _targetYear = info.FiscalYear;
        await LoadPlans();
    }

    private async Task DeletePlan()
    {
        if (_editing.Id == 0) return;
        bool ok = await JSRuntime.ConfirmAsync("이 계획을 삭제할까요?");
        if (!ok) return;
        await Accounting.DeleteAnnualPlanAsync(_editing.Id, CurrentUser?.Username);
        _showModal = false;
        await LoadPlans();
    }

    // ══════════════ 일괄 등록(엑셀/CSV) ══════════════
    private bool _showImport = false;
    private bool _isImporting = false;
    private List<AnnualPlan> _importRows = new();
    private string _importMessage = "";
    private bool _importIsError = false;

    private void OpenImport()
    {
        _importRows.Clear();
        _importMessage = "";
        _importIsError = false;
        _showImport = true;
    }

    private void CloseImport() { _showImport = false; }

    // 엑셀 양식(.xlsx) 생성 후 다운로드
    // 🚀 양식 다운로드 — 직전 회계연도의 계획을 그대로 채워서 내려준다.
    //   매년 비슷한 행사가 반복되므로, 빈 양식보다 "작년 것을 고쳐 쓰는" 편이 실무에 맞다.
    //   오른쪽 참고 열(작년 집행·편차)은 읽기용이며 업로드 시 무시된다(앞 7열만 파싱).
    private async Task DownloadTemplate()
    {
        int prevYear = _targetYear - 1;

        // 작년 계획 + 작년 실적(집행)을 함께 가져온다
        var prevPlans = await Accounting.GetAnnualPlansAsync(_viewDeptId, prevYear);
        var prevFins = await Accounting.GetEventFinancesAsync(_viewDeptId, prevYear);

        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add($"{_targetYear}년 연간계획");

        string[] headers = { "행사명", "시작일", "종료일", "추진내용", "목표수입", "편성지출", "상태",
                             "│", "작년 편성", "작년 집행", "작년 편차" };
        for (int i = 0; i < headers.Length; i++)
        {
            var c = ws.Cell(1, i + 1);
            c.Value = headers[i];
            c.Style.Font.Bold = true;
            // 입력 열(1~7)은 금색, 참고 열(9~11)은 회색으로 구분
            c.Style.Fill.BackgroundColor = i < 7 ? XLColor.FromHtml("#F5F4E8") : XLColor.FromHtml("#EDEDED");
            c.Style.Font.FontColor = i < 7 ? XLColor.FromHtml("#4E4637") : XLColor.FromHtml("#777777");
        }

        int row = 2;
        if (prevPlans.Any())
        {
            // 작년 계획을 날짜순으로 채운다. 날짜는 1년 뒤로 밀어 초안을 만든다.
            foreach (var p in prevPlans.OrderBy(p => p.EventDate))
            {
                var fin = prevFins.FirstOrDefault(f => f.EventName.Trim() == (p.Title ?? "").Trim());

                ws.Cell(row, 1).Value = p.Title;
                // ClosedXML의 Value는 XLCellValue라 object를 못 받는다.
                // 값이 있을 때만 넣고, 없으면 셀을 비워 둔다.
                if (p.EventDate != default)
                    ws.Cell(row, 2).Value = p.EventDate.AddYears(1);
                if (p.EndDate.HasValue)
                    ws.Cell(row, 3).Value = p.EndDate.Value.AddYears(1);
                ws.Cell(row, 4).Value = p.Description ?? "";
                ws.Cell(row, 5).Value = p.PlannedIncome;
                ws.Cell(row, 6).Value = p.PlannedExpense;
                ws.Cell(row, 7).Value = "계획";   // 새 해의 계획이므로 항상 '계획'으로 시작

                // ── 참고 열 (읽기용) ──
                foreach (var col in new[] { 9, 10, 11 })
                    ws.Cell(row, col).Style.Font.FontColor = XLColor.FromHtml("#777777");

                if (fin != null)
                {
                    ws.Cell(row, 9).Value = fin.Budget;
                    ws.Cell(row, 10).Value = fin.Spent;
                    ws.Cell(row, 11).Value = fin.Spent - fin.Budget;

                    // 작년에 예산을 초과했다면 붉게 표시해 눈에 띄게 한다
                    if (fin.Spent > fin.Budget)
                    {
                        ws.Cell(row, 10).Style.Font.FontColor = XLColor.FromHtml("#BA1A1A");
                        ws.Cell(row, 11).Style.Font.FontColor = XLColor.FromHtml("#BA1A1A");
                        ws.Cell(row, 11).Style.Font.Bold = true;
                    }
                }

                row++;
            }
        }
        else
        {
            // 작년 계획이 없으면 예시 한 줄만 제공
            ws.Cell(2, 1).Value = "여름성경학교";
            ws.Cell(2, 2).Value = new DateTime(_targetYear, 7, 26);
            ws.Cell(2, 3).Value = new DateTime(_targetYear, 7, 28);
            ws.Cell(2, 4).Value = "주제: 살아가요 하나님 나라";
            ws.Cell(2, 5).Value = 0;
            ws.Cell(2, 6).Value = 0;
            ws.Cell(2, 7).Value = "계획";
            row = 3;
        }

        // 숫자 서식
        for (int r = 2; r < row; r++)
            foreach (var col in new[] { 5, 6, 9, 10, 11 })
                ws.Cell(r, col).Style.NumberFormat.Format = "#,##0";

        // ── 안내문 ──
        int note = row + 1;
        ws.Cell(note, 1).Value = prevPlans.Any()
            ? $"※ {prevYear}년 계획을 그대로 불러왔습니다. 날짜는 1년 뒤로 자동 조정했으니 실제 일정에 맞게 고쳐 주세요."
            : $"※ {prevYear}년 계획이 없어 예시 한 줄만 넣었습니다.";
        ws.Cell(note + 1, 1).Value = "※ A~G열만 등록됩니다. I~K열(작년 편성·집행·편차)은 참고용이며 업로드 시 무시됩니다.";
        ws.Cell(note + 2, 1).Value = "※ 붉은 숫자는 작년에 예산을 초과한 행사입니다. 올해 편성액을 정할 때 참고하세요.";
        ws.Cell(note + 3, 1).Value = "※ 상태는 계획 / 진행 / 완료 / 마감 중 하나. 비우면 '계획'으로 등록됩니다.";
        ws.Cell(note + 4, 1).Value = "※ 종료일을 비우면 하루짜리 행사로 등록됩니다.";
        ws.Cell(note + 5, 1).Value = "※ 필요 없는 행사는 줄째로 지우고, 새 행사는 아래에 추가하면 됩니다.";
        for (int i = 0; i < 6; i++)
        {
            ws.Cell(note + i, 1).Style.Font.FontColor = XLColor.FromHtml("#777777");
            // 안내문이 A열 폭에 잘리지 않도록 A~G열을 병합
            ws.Range(note + i, 1, note + i, 7).Merge();
            ws.Cell(note + i, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left;
        }

        // ── 열 너비 (AdjustToContents는 한글·날짜 폭을 제대로 못 잡아 직접 지정) ──
        ws.Column(1).Width = 20;   // 행사명
        ws.Column(2).Width = 14;   // 시작일  (날짜가 ###으로 잘리지 않게)
        ws.Column(3).Width = 14;   // 종료일
        ws.Column(4).Width = 34;   // 추진내용
        ws.Column(5).Width = 13;   // 목표수입
        ws.Column(6).Width = 13;   // 편성지출
        ws.Column(7).Width = 10;   // 상태
        ws.Column(8).Width = 3;    // 구분선
        ws.Column(9).Width = 13;   // 작년 편성
        ws.Column(10).Width = 13;  // 작년 집행
        ws.Column(11).Width = 13;  // 작년 편차

        // 날짜 서식 명시 (지역 설정에 따라 ### 되는 것 방지)
        for (int r = 2; r < row; r++)
        {
            ws.Cell(r, 2).Style.NumberFormat.Format = "yyyy-mm-dd";
            ws.Cell(r, 3).Style.NumberFormat.Format = "yyyy-mm-dd";
        }

        // 헤더 가운데 정렬 + 자동 줄바꿈으로 글자가 잘리지 않게
        ws.Row(1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        ws.Row(1).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
        ws.Row(1).Height = 22;

        ws.SheetView.FreezeRows(1);

        await JSRuntime.DownloadExcelAsync(wb, $"연간계획_{_targetYear}_{_currentDeptName}.xlsx");
    }

    // 파일 선택 → 파싱 → 미리보기 목록 생성
    private async Task HandleImportFile(InputFileChangeEventArgs e)
    {
        _importRows.Clear();
        _importMessage = "";
        _importIsError = false;

        var file = e.File;
        if (file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var raw = file.Name.ToLower().EndsWith(".csv")
                ? ParseCsv(ms)
                : ParseXlsx(ms);

            if (!raw.Any())
            {
                _importMessage = "읽을 수 있는 행이 없습니다. 양식을 확인해 주세요.";
                _importIsError = true;
                return;
            }

            // 각 행의 회계연도·분기·주차를 시작일 기준으로 계산
            foreach (var r in raw)
            {
                var info = await Accounting.CalcPlanDateInfoAsync(_viewDeptId, r.EventDate);
                r.DepartmentId = _viewDeptId;
                r.FiscalYear = info.FiscalYear;
                r.Quarter = info.Quarter;
                r.WeekNo = info.WeekNo;
                _importRows.Add(r);
            }

            _importMessage = $"{_importRows.Count}건을 읽었습니다. 내용을 확인하고 등록하세요.";
        }
        catch (Exception ex)
        {
            _importMessage = $"파일을 읽지 못했습니다: {ex.Message}";
            _importIsError = true;
        }
    }

    // .xlsx 파싱 (1행=헤더, 2행부터 데이터)
    private List<AnnualPlan> ParseXlsx(Stream stream)
    {
        var list = new List<AnnualPlan>();
        using var wb = new XLWorkbook(stream);
        var ws = wb.Worksheets.First();

        foreach (var row in ws.RowsUsed().Skip(1))
        {
            string title = row.Cell(1).GetString().Trim();
            if (string.IsNullOrWhiteSpace(title) || title.StartsWith("※")) continue;
            if (!row.Cell(2).TryGetValue<DateTime>(out var start)) continue;

            DateTime? end = row.Cell(3).TryGetValue<DateTime>(out var e2) ? e2 : (DateTime?)null;

            list.Add(new AnnualPlan
            {
                Title = title,
                EventDate = start.Date,
                EndDate = end?.Date,
                Description = row.Cell(4).GetString().Trim(),
                PlannedIncome = row.Cell(5).TryGetValue<decimal>(out var inc) ? inc : 0m,
                PlannedExpense = row.Cell(6).TryGetValue<decimal>(out var exp) ? exp : 0m,
                Status = ParseStatus(row.Cell(7).GetString())
            });
        }
        return list;
    }

    // .csv 파싱 (1행=헤더)
    private List<AnnualPlan> ParseCsv(Stream stream)
    {
        var list = new List<AnnualPlan>();
        using var reader = new StreamReader(stream, System.Text.Encoding.UTF8);

        bool first = true;
        while (!reader.EndOfStream)
        {
            var line = reader.ReadLine();
            if (string.IsNullOrWhiteSpace(line)) continue;
            if (first) { first = false; continue; }   // 헤더 건너뜀

            var c = line.Split(',');
            if (c.Length < 2) continue;

            string title = c[0].Trim().Trim('"');
            if (string.IsNullOrWhiteSpace(title) || title.StartsWith("※")) continue;
            if (!DateTime.TryParse(c[1].Trim().Trim('"'), out var start)) continue;

            DateTime? end = null;
            if (c.Length > 2 && DateTime.TryParse(c[2].Trim().Trim('"'), out var e2)) end = e2.Date;

            list.Add(new AnnualPlan
            {
                Title = title,
                EventDate = start.Date,
                EndDate = end,
                Description = c.Length > 3 ? c[3].Trim().Trim('"') : "",
                PlannedIncome = c.Length > 4 && decimal.TryParse(c[4].Trim().Trim('"'), out var inc) ? inc : 0m,
                PlannedExpense = c.Length > 5 && decimal.TryParse(c[5].Trim().Trim('"'), out var exp) ? exp : 0m,
                Status = ParseStatus(c.Length > 6 ? c[6] : "")
            });
        }
        return list;
    }

    private PlanStatus ParseStatus(string? s) => (s ?? "").Trim() switch
    {
        "진행" => PlanStatus.InProgress,
        "완료" => PlanStatus.Done,
        "마감" => PlanStatus.Closed,
        _ => PlanStatus.Planned
    };

    // 미리보기 목록을 실제로 저장
    private async Task ConfirmImport()
    {
        if (!_importRows.Any()) return;

        _isImporting = true;
        try
        {
            int n = await Accounting.AddAnnualPlansBulkAsync(_importRows, CurrentUser?.Username);
            _showImport = false;
            _importRows.Clear();
            await LoadPlans();
            await JSRuntime.AlertAsync($"{n}건이 등록되었습니다.");
        }
        catch (Exception ex)
        {
            _importMessage = $"등록 실패: {ex.Message}";
            _importIsError = true;
        }
        finally
        {
            _isImporting = false;
        }
    }

    // ── 표시 헬퍼 ──
    // 하루짜리: "7월 3주차 · 3분기"  /  기간: "7/26~7/28 · 3분기"
    private string WhenLabel(AnnualPlan p)
    {
        if (p.EventDate == default) return $"{p.Quarter}분기";

        if (p.EndDate.HasValue && p.EndDate.Value.Date > p.EventDate.Date)
        {
            string end = p.EndDate.Value.Month == p.EventDate.Month
                ? $"{p.EndDate.Value.Day}일"
                : $"{p.EndDate.Value.Month}/{p.EndDate.Value.Day}";
            return $"{p.EventDate.Month}/{p.EventDate.Day}~{end} · {p.Quarter}분기";
        }

        int monthWeek = AccountingService.GetWeekOfMonth(p.EventDate);
        return $"{p.EventDate.Month}월 {monthWeek}주차 · {p.Quarter}분기";
    }

    private string StatusClass(PlanStatus s) => s switch
    {
        PlanStatus.InProgress => "status-inprogress",
        PlanStatus.Done => "status-done",
        PlanStatus.Closed => "status-closed",
        _ => ""
    };

    private string StatusBadge(PlanStatus s) => s switch
    {
        PlanStatus.InProgress => "inprogress",
        PlanStatus.Done => "done",
        PlanStatus.Closed => "closed",
        _ => "planned"
    };

    private string StatusLabel(PlanStatus s) => s switch
    {
        PlanStatus.InProgress => "진행",
        PlanStatus.Done => "완료",
        PlanStatus.Closed => "마감",
        _ => "계획"
    };
