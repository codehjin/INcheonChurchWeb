    // 엑셀 양식(.xlsx) 생성 후 다운로드
    private async Task DownloadTemplate()
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("연간계획");

        string[] headers = { "행사명", "시작일", "종료일", "추진내용", "목표수입", "편성지출", "상태" };
        for (int i = 0; i < headers.Length; i++)
        {
            ws.Cell(1, i + 1).Value = headers[i];
            ws.Cell(1, i + 1).Style.Font.Bold = true;
            ws.Cell(1, i + 1).Style.Fill.BackgroundColor = XLColor.FromHtml("#F5F4E8");
        }

        // 예시 행 (사용자가 지우고 쓰면 됨)
        ws.Cell(2, 1).Value = "여름성경학교";
        ws.Cell(2, 2).Value = new DateTime(DateTime.Today.Year, 7, 26);
        ws.Cell(2, 3).Value = new DateTime(DateTime.Today.Year, 7, 28);
        ws.Cell(2, 4).Value = "주제: 살아가요 하나님 나라";
        ws.Cell(2, 5).Value = 1500000;
        ws.Cell(2, 6).Value = 3148000;
        ws.Cell(2, 7).Value = "계획";

        ws.Cell(4, 1).Value = "※ 상태는 계획 / 진행 / 완료 / 마감 중 하나. 비우면 '계획'";
        ws.Cell(5, 1).Value = "※ 종료일을 비우면 하루짜리 행사로 등록됩니다.";
        ws.Columns().AdjustToContents();

        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        var bytes = ms.ToArray();

        await JSRuntime.InvokeVoidAsync("downloadExcelFile",
            "연간계획_양식.xlsx", Convert.ToBase64String(bytes));
    }

    // 파일 선택 → 파싱 → 미리보기 목록 생성
    private async Task HandleImportFile(InputFileChangeEventArgs e)
    {
        _importRows.Clear();
        _importMessage = "";
        _importIsError = false;

        var file = e.File;
        if (file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var raw = file.Name.ToLower().EndsWith(".csv")
                ? ParseCsv(ms)
                : ParseXlsx(ms);

            if (!raw.Any())
            {
                _importMessage = "읽을 수 있는 행이 없습니다. 양식을 확인해 주세요.";
                _importIsError = true;
                return;
            }

            // 각 행의 회계연도·분기·주차를 시작일 기준으로 계산
            foreach (var r in raw)
            {
                var info = await Accounting.CalcPlanDateInfoAsync(_viewDeptId, r.EventDate);
                r.DepartmentId = _viewDeptId;
                r.FiscalYear = info.FiscalYear;
                r.Quarter = info.Quarter;
                r.WeekNo = info.WeekNo;
                _importRows.Add(r);
            }

            _importMessage = $"{_importRows.Count}건을 읽었습니다. 내용을 확인하고 등록하세요.";
        }
        catch (Exception ex)
        {
            _importMessage = $"파일을 읽지 못했습니다: {ex.Message}";
            _importIsError = true;
        }
    }

    // .xlsx 파싱 (1행=헤더, 2행부터 데이터)
    private List<AnnualPlan> ParseXlsx(Stream stream)
    {
        var list = new List<AnnualPlan>();
        using var wb = new XLWorkbook(stream);
        var ws = wb.Worksheets.First();

        foreach (var row in ws.RowsUsed().Skip(1))
        {
            string title = row.Cell(1).GetString().Trim();
            if (string.IsNullOrWhiteSpace(title) || title.StartsWith("※")) continue;
            if (!row.Cell(2).TryGetValue<DateTime>(out var start)) continue;

            DateTime? end = row.Cell(3).TryGetValue<DateTime>(out var e2) ? e2 : (DateTime?)null;

            list.Add(new AnnualPlan
            {
                Title = title,
                EventDate = start.Date,
                EndDate = end?.Date,
                Description = row.Cell(4).GetString().Trim(),
                PlannedIncome = row.Cell(5).TryGetValue<decimal>(out var inc) ? inc : 0m,
                PlannedExpense = row.Cell(6).TryGetValue<decimal>(out var exp) ? exp : 0m,
                Status = ParseStatus(row.Cell(7).GetString())
            });
        }
        return list;
    }

    // .csv 파싱 (1행=헤더)
    private List<AnnualPlan> ParseCsv(Stream stream)
    {
        var list = new List<AnnualPlan>();
        using var reader = new StreamReader(stream, System.Text.Encoding.UTF8);

        bool first = true;
        while (!reader.EndOfStream)
        {
            var line = reader.ReadLine();
            if (string.IsNullOrWhiteSpace(line)) continue;
            if (first) { first = false; continue; }   // 헤더 건너뜀

            var c = line.Split(',');
            if (c.Length < 2) continue;

            string title = c[0].Trim().Trim('"');
            if (string.IsNullOrWhiteSpace(title) || title.StartsWith("※")) continue;
            if (!DateTime.TryParse(c[1].Trim().Trim('"'), out var start)) continue;

            DateTime? end = null;
            if (c.Length > 2 && DateTime.TryParse(c[2].Trim().Trim('"'), out var e2)) end = e2.Date;

            list.Add(new AnnualPlan
            {
                Title = title,
                EventDate = start.Date,
                EndDate = end,
                Description = c.Length > 3 ? c[3].Trim().Trim('"') : "",
                PlannedIncome = c.Length > 4 && decimal.TryParse(c[4].Trim().Trim('"'), out var inc) ? inc : 0m,
                PlannedExpense = c.Length > 5 && decimal.TryParse(c[5].Trim().Trim('"'), out var exp) ? exp : 0m,
                Status = ParseStatus(c.Length > 6 ? c[6] : "")
            });
        }
        return list;
    }

    private PlanStatus ParseStatus(string? s) => (s ?? "").Trim() switch
    {
        "진행" => PlanStatus.InProgress,
        "완료" => PlanStatus.Done,
        "마감" => PlanStatus.Closed,
        _ => PlanStatus.Planned
    };

    // 미리보기 목록을 실제로 저장
    private async Task ConfirmImport()
    {
        if (!_importRows.Any()) return;

        _isImporting = true;
        try
        {
            int n = await Accounting.AddAnnualPlansBulkAsync(_importRows, CurrentUser?.Username);
            _showImport = false;
            _importRows.Clear();
            await LoadPlans();
            await JSRuntime.InvokeVoidAsync("alert", $"{n}건이 등록되었습니다.");
        }
        catch (Exception ex)
        {
            _importMessage = $"등록 실패: {ex.Message}";
            _importIsError = true;
        }
        finally
        {
            _isImporting = false;
        }
    }

    // ── 표시 헬퍼 ──
    // 하루짜리: "7월 3주차 · 3분기"  /  기간: "7/26~7/28 · 3분기"
    private string WhenLabel(AnnualPlan p)
    {
        if (p.EventDate == default) return $"{p.Quarter}분기";

        if (p.EndDate.HasValue && p.EndDate.Value.Date > p.EventDate.Date)
        {
            string end = p.EndDate.Value.Month == p.EventDate.Month
                ? $"{p.EndDate.Value.Day}일"
                : $"{p.EndDate.Value.Month}/{p.EndDate.Value.Day}";
            return $"{p.EventDate.Month}/{p.EventDate.Day}~{end} · {p.Quarter}분기";
        }

        int monthWeek = AccountingService.GetWeekOfMonth(p.EventDate);
        return $"{p.EventDate.Month}월 {monthWeek}주차 · {p.Quarter}분기";
    }

