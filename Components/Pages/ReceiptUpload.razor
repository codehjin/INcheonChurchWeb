@page "/receipt-upload"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Data
@using Microsoft.AspNetCore.Hosting
@using System.IO
@inject AppDbContext DbContext
@inject IWebHostEnvironment Env
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-3 mb-5">
    <h4 class="fw-bold text-primary mb-3"><i class="bi bi-camera-fill me-2"></i>영수증 촬영 및 업로드</h4>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <p class="text-muted small mb-4">
                종이 영수증을 촬영하거나 캡처한 이미지를 올려주세요.<br />
                회계 담당자가 PC에서 장부와 대조하여 처리합니다.
            </p>

            <div class="mb-3">
                <label class="form-label fw-bold">1. 결제 날짜</label>
                <input type="date" class="form-control form-control-lg" @bind="newReceipt.ReceiptDate" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">2. 적요 (사용처 / 내용)</label>
                <input type="text" class="form-control form-control-lg" @bind="newReceipt.Description" placeholder="예: 다이소 (여름성경학교 준비물)" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">3. 영수증 사진 첨부</label>
                <InputFile OnChange="HandleFileSelected" class="form-control form-control-lg" accept="image/*" />
                <div class="form-text text-muted small ps-1 mt-1">
                    버튼을 눌러 사진을 찍거나 갤러리에서 선택하세요.
                </div>
            </div>

            @if (!string.IsNullOrEmpty(previewImageUrl))
            {
                <div class="mb-3 text-center bg-light p-2 rounded border">
                    <img src="@previewImageUrl" class="img-fluid rounded shadow-sm" style="max-height: 300px;" />
                </div>
            }

            <button class="btn btn-primary btn-lg w-100 fw-bold" @onclick="UploadReceipt" disabled="@isUploading">
                @if (isUploading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                
                    <span>업로드 중...</span>
                }
                else
                {
                    <i class="bi bi-cloud-arrow-up-fill me-2"></i>
                
                    <span>서버로 전송하기</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }
    private UploadedReceipt newReceipt = new();
    private IBrowserFile? selectedFile;
    private string previewImageUrl = "";
    private bool isUploading = false;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            // 스마트폰 사진은 용량이 크므로, 가로세로 1200px 이하로 압축 (용량 및 메모리 절약)
            selectedFile = await file.RequestImageFileAsync("image/jpeg", 1200, 1200);

            // 미리보기를 위해 브라우저 메모리에 이미지 올리기
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            previewImageUrl = $"data:image/jpeg;base64,{base64}";
        }
    }

    private async Task UploadReceipt()
    {
        if (CurrentUser == null) return;
        if (selectedFile == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "영수증 사진을 선택하거나 촬영해주세요.");
            return;
        }
        if (string.IsNullOrWhiteSpace(newReceipt.Description))
        {
            await JSRuntime.InvokeVoidAsync("alert", "적요(사용처)를 입력해주세요.");
            return;
        }

        isUploading = true;
        StateHasChanged();

        try
        {
            // 폴더 준비 (wwwroot/uploads/receipts)
            var uploadsFolder = Path.Combine(Env.WebRootPath, "uploads", "receipts");
            if (!Directory.Exists(uploadsFolder)) Directory.CreateDirectory(uploadsFolder);

            // 고유 파일명 생성
            string fileName = $"receipt_{CurrentUser.DepartmentId}_{DateTime.Now:yyyyMMddHHmmss}.jpg";
            string filePath = Path.Combine(uploadsFolder, fileName);

            // 서버에 파일 저장
            using var fileStream = new FileStream(filePath, FileMode.Create);
            await selectedFile.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(fileStream);

            // DB에 기록 저장
            newReceipt.DepartmentId = CurrentUser.DepartmentId;
            newReceipt.ImagePath = $"/uploads/receipts/{fileName}"; // 웹에서 접근할 경로

            DbContext.UploadedReceipts.Add(newReceipt);
            await DbContext.SaveChangesAsync();

            await JSRuntime.InvokeVoidAsync("alert", "영수증이 성공적으로 업로드되었습니다!");

            // 초기화
            newReceipt = new();
            selectedFile = null;
            previewImageUrl = "";
            Nav.NavigateTo("/"); // 부드럽게 대시보드로 이동
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"업로드 오류: {ex.Message}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }
}