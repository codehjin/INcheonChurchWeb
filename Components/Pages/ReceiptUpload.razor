@page "/receipt-upload"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Data
@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using System.IO
@inject AppDbContext DbContext
@inject IWebHostEnvironment Env
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject INcheonChurchWeb.Services.OcrService OcrService
@rendermode InteractiveServer

<div class="container mt-3 mb-5">
    <h4 class="fw-bold text-primary mb-3"><i class="bi bi-camera-fill me-2"></i>영수증 촬영 및 업로드</h4>

    @* 🚀 추가된 부분: 이번 달 AI 사용량 현황판 UI *@
    <div class="card shadow-sm border-0 mb-4 bg-primary bg-opacity-10 border-start border-primary border-4">
        <div class="card-body py-3 px-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-primary" style="font-size: 0.95rem;">
                <i class="bi bi-robot me-1"></i> 이번 달 AI 자동 판독
            </span>
            <div class="text-end">
                <span class="badge @(currentOcrUsage >= 1000 ? "bg-danger" : "bg-primary") rounded-pill fs-6 shadow-sm px-3 py-2">
                    @currentOcrUsage <span class="fw-normal opacity-75">/ 1,000건</span>
                </span>
                <div class="small text-muted mt-1 fw-bold" style="font-size: 0.75rem;">(월 사용량)</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <p class="text-muted small mb-4">
                영수증 사진을 선택하면 <strong>인공지능이 자동으로 내용을 분석</strong>합니다.<br />
                분석된 내용이 맞는지 확인 후 수정하거나 바로 전송하세요.
            </p>

            <div class="mb-4">
                @* 1. 진짜 InputFile은 화면에서 숨깁니다 *@
                <InputFile id="mobileFileInput" OnChange="HandleFileSelected" style="display:none;" accept="image/*" />

                @* 2. 누르기 편한 거대한 라벨 버튼 *@
                <label for="mobileFileInput" class="btn @(currentOcrUsage >= 1000 ? "btn-outline-secondary" : "btn-outline-primary") btn-lg w-100 fw-bold py-4 border-2 d-flex align-items-center justify-content-center shadow-sm" style="cursor: pointer; border-style: dashed;">
                    @if (isOcrProcessing)
                    {
                        <div class="spinner-border text-primary me-3" role="status"></div>
                        <span class="fs-5 text-dark">AI가 영수증 읽는 중...</span>
                    }
                    else
                    {
                        <i class="bi bi-camera-fill fs-1 me-3"></i>
                        <span class="fs-5">@(string.IsNullOrEmpty(selectedFileName) ? "여기를 눌러 사진 찾기" : "사진 다시 선택하기")</span>
                    }
                </label>
                @if (currentOcrUsage >= 1000)
                {
                    <div class="text-danger small fw-bold mt-2 text-center">이번 달 무료 제공량을 모두 사용했습니다. 수동으로 입력해주세요.</div>
                }
            </div>

            @if (!string.IsNullOrEmpty(previewImageUrl))
            {
                <div class="mb-3 text-center bg-light p-2 rounded border">
                    <img src="@previewImageUrl" class="img-fluid rounded shadow-sm" style="max-height: 300px;" />
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-bold">1. 결제 날짜</label>
                <input type="date" class="form-control form-control-lg border-primary" @bind="newReceipt.ReceiptDate" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-danger">2. 결제 금액 (숫자만)</label>
                <div class="input-group input-group-lg">
                    <input type="number" class="form-control fw-bold text-end border-danger" @bind="inputAmount" placeholder="예: 15000" />
                    <span class="input-group-text bg-light fw-bold border-danger">원</span>
                    @if (inputAmount.HasValue)
                    {
                        <button class="btn btn-outline-secondary px-3 border-danger" type="button" @onclick="() => { inputAmount = null; }" title="지우기">❌</button>
                    }
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">3. 적요 (사용처 / 내용)</label>
                <div class="input-group input-group-lg">
                    <input type="text" class="form-control border-primary" @bind="newReceipt.Description" placeholder="예: 다이소" />
                    @if (!string.IsNullOrEmpty(newReceipt.Description))
                    {
                        <button class="btn btn-outline-secondary px-3 border-primary" type="button" @onclick="() => { newReceipt.Description = string.Empty; }" title="지우기">❌</button>
                    }
                </div>
            </div>

            <button class="btn btn-primary btn-lg w-100 fw-bold mt-2 shadow-sm" @onclick="UploadReceipt" disabled="@(isUploading || isOcrProcessing)">
                @if (isUploading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                
                    <span>업로드 중...</span>
                }
                else
                {
                    <i class="bi bi-cloud-arrow-up-fill me-2"></i>
                
                    <span>확인 완료 / 서버로 전송</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }
    private UploadedReceipt newReceipt = new() { ReceiptDate = DateTime.Now };
    private decimal? inputAmount = null;
    private IBrowserFile? selectedFile;
    private string selectedFileName = "";
    private string previewImageUrl = "";

    private bool isUploading = false;
    private bool isOcrProcessing = false;
    private const long MaxFileSize = 25 * 1024 * 1024;

    // 🚀 현재 OCR 사용량을 담을 변수
    private int currentOcrUsage = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadOcrUsage();
    }

    // 🚀 DB에서 이번 달 사용량을 실시간으로 불러오는 함수
    private async Task LoadOcrUsage()
    {
        string currentMonth = DateTime.Now.ToString("yyyy-MM");
        var usage = await DbContext.OcrUsages.AsNoTracking().FirstOrDefaultAsync(u => u.YearMonth == currentMonth);
        currentOcrUsage = usage?.UsageCount ?? 0;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            selectedFile = e.File;
            selectedFileName = selectedFile.Name;
            previewImageUrl = "";

            if (selectedFile.Size < 5 * 1024 * 1024 && !selectedFileName.ToLower().EndsWith(".heic"))
            {
                isOcrProcessing = true;
                StateHasChanged();

                try
                {
                    // 1. 이미지 읽기 및 미리보기 생성
                    var previewImage = await selectedFile.RequestImageFileAsync("image/jpeg", 800, 800);
                    using var stream = previewImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                    using var memoryStream = new MemoryStream();
                    await stream.CopyToAsync(memoryStream);
                    var imageBytes = memoryStream.ToArray();

                    var base64 = Convert.ToBase64String(imageBytes);
                    previewImageUrl = $"data:image/jpeg;base64,{base64}";

                    // 2. 구글 클라우드 비전 OCR 자동인식 호출! (이 안에서 이미 DB에 횟수를 차감/저장합니다)
                    var ocrResult = await OcrService.ProcessReceiptAsync(imageBytes);

                    if (ocrResult.IsSuccess)
                    {
                        if (ocrResult.Date.HasValue) newReceipt.ReceiptDate = ocrResult.Date.Value;
                        if (ocrResult.Amount.HasValue && ocrResult.Amount.Value > 0) inputAmount = ocrResult.Amount.Value;
                        if (!string.IsNullOrEmpty(ocrResult.Description)) newReceipt.Description = ocrResult.Description;

                        await JSRuntime.InvokeVoidAsync("alert", "✨ AI가 영수증 정보를 인식했습니다.\n입력된 금액과 날짜가 정확한지 확인해 주세요!");
                    }
                    else
                    {
                        await JSRuntime.InvokeVoidAsync("alert", $"⚠️ OCR 알림: {ocrResult.ErrorMessage}\n\n(사진은 정상적으로 선택되었습니다. 수동으로 입력해 주세요.)");
                    }
                }
                catch (Exception ex)
                {
                    await JSRuntime.InvokeVoidAsync("console.log", "OCR 변환 실패: " + ex.Message);
                }
                finally
                {
                    isOcrProcessing = false;
                    // 🚀 처리가 끝난 직후(성공이든 실패든) DB에서 사용량을 다시 불러와 화면 숫자를 즉시 갱신합니다.
                    await LoadOcrUsage();
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"파일 선택 오류: {ex.Message}");
        }
    }

    private async Task UploadReceipt()
    {
        if (CurrentUser == null) return;
        if (selectedFile == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "영수증 사진을 첨부해 주세요."); return;
        }
        if (!inputAmount.HasValue || inputAmount.Value <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "정확한 결제 금액을 입력해 주세요."); return;
        }
        if (string.IsNullOrWhiteSpace(newReceipt.Description))
        {
            await JSRuntime.InvokeVoidAsync("alert", "적요(사용처)를 입력해 주세요."); return;
        }

        isUploading = true;
        StateHasChanged();

        try
        {
            var uploadsFolder = Path.Combine(Env.WebRootPath, "uploads", "receipts");
            if (!Directory.Exists(uploadsFolder)) Directory.CreateDirectory(uploadsFolder);

            string fileName = $"receipt_{CurrentUser.DepartmentId}_{DateTime.Now:yyyyMMddHHmmss}.jpg";
            string filePath = Path.Combine(uploadsFolder, fileName);

            using var fileStream = new FileStream(filePath, FileMode.Create);
            await selectedFile.OpenReadStream(maxAllowedSize: MaxFileSize).CopyToAsync(fileStream);

            newReceipt.Amount = inputAmount.Value;
            newReceipt.DepartmentId = CurrentUser.DepartmentId;
            newReceipt.ImagePath = $"/uploads/receipts/{fileName}";

            DbContext.UploadedReceipts.Add(newReceipt);
            await DbContext.SaveChangesAsync();

            await JSRuntime.InvokeVoidAsync("alert", "✅ 영수증 업로드가 완료되었습니다!");

            newReceipt = new() { ReceiptDate = DateTime.Now };
            inputAmount = null;
            selectedFile = null;
            selectedFileName = "";
            previewImageUrl = "";

            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"업로드 오류: {ex.Message}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }
}