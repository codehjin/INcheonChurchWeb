@page "/"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Data
@using INcheonChurchWeb.Services
@using Microsoft.EntityFrameworkCore
@inject AccountingService Accounting
@inject AppDbContext DbContext
@rendermode InteractiveServer

<PageTitle>인천중앙교회 재정 시스템</PageTitle>

<style>
    /* ── Tactile Ledger Design Tokens ── */
    .dash-hero-card {
        font-size: 1rem ;
        font-weight: 700 ;
        background-color: var(--surface-lowest);
        border-radius: 0.75rem;
        box-shadow: 0 4px 20px rgba(48, 49, 41, 0.04);
        border: none;
        padding: 2rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 200px;
    }

    .dash-detail-card {
        font-size: 1rem ;
        background-color: var(--surface-lowest);
        border-radius: 0.75rem;
        box-shadow: 0 4px 20px rgba(48, 49, 41, 0.04);
        border: none;
        padding: 2rem 2.5rem;
    }

    .dash-label {
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--primary-gold);
        opacity: 0.85;
        margin-bottom: 0.5rem;
    }

    .dash-hero-amount {
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.02em;
        color: var(--on-surface);
        line-height: 1.1;
    }

    .dash-badge-pct {
        background-color: var(--surface-low);
        border-radius: 9999px;
        padding: 0.25rem 1rem;
        font-size: 1rem;
        font-weight: 700;
        color: var(--primary-gold);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    .dash-progress-bg {
        background-color: var(--surface-low);
        height: 0.5rem;
        border-radius: 9999px;
        overflow: hidden;
    }

    .dash-progress-fill {
        background: var(--gold-gradient);
        height: 100%;
        border-radius: 9999px;
        transition: width 0.5s ease-out;
    }

    .dash-meta-label {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--on-surface-muted);
    }

    .dash-filter-chip {
        background-color: var(--surface-lowest);
        border-radius: 0.5rem;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(48, 49, 41, 0.06);
        border: none;
    }

    .dash-filter-chip-label {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--on-surface-muted);
    }

    .dash-filter-chip-value {
        font-size: 1rem;
        font-weight: 700;
        color: var(--on-surface);
    }

    .dash-stat-row {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .dash-stat-meta {
        display: flex;
        justify-content: space-between;
        font-size: 1rem;
        font-weight: 700;
        color: var(--on-surface);
    }

    .dash-list-wrap {
        overflow: hidden;
        border-radius: 1rem;
        background-color: rgba(255,255,255,0.5);
    }

    .dash-list-head th {
        padding: 1rem 2rem;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--primary-gold);
        opacity: 0.85;
        background-color: var(--surface-lowest);
        box-shadow: 0 2px 8px rgba(48,49,41,0.04);
        border: none !important;
    }

    .dash-list-body tr {
        transition: background-color 0.15s ease-out;
    }

        .dash-list-body tr:hover {
            background-color: rgba(255,255,255,0.8);
        }

        .dash-list-body tr:nth-child(even) {
            background-color: rgba(255,255,255,0.35);
        }

    .dash-list-body td {
        padding: 1.25rem 2rem;
        font-size: 1rem;
        vertical-align: middle;
        border: none !important;
    }

    .dash-status-waiting {
        font-size: 1rem;
        font-weight: 600;
        color: var(--primary-gold);
        background-color: var(--surface-low);
        padding: 0.2rem 0.6rem;
        border-radius: 0.25rem;
    }

    .dash-status-done {
        font-size: 1rem;
        font-weight: 600;
        color: var(--on-surface-muted);
        font-variant-numeric: tabular-nums;
    }
</style>

@if (CurrentUser != null)
{
    <div style="padding: 2rem 1.5rem; max-width: 100%; margin-left: 0; padding-bottom: 5rem;">

        @* ── 필터 & 타이틀 ── *@
        <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2.5rem;">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.5rem;">
                <div>
                    <h3 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; letter-spacing: -0.02em; color: var(--on-surface); margin-bottom: 0.25rem; line-height: 1.2;">
                        @CurrentYear 재정 현황 요약
                    </h3>
                    <p style="color: var(--on-surface-sub); font-size: 1.1rem; font-weight: 400; line-height: 1.5; opacity: 0.85; margin: 0;">
                        현재 회계 기간의 재정 성과 상세 내역입니다.
                    </p>
                </div>
                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
                    @* 연도 이동 칩 *@
                    <div class="dash-filter-chip">
                        <button style="background: none; border: none; color: var(--on-surface-sub); font-weight: 700; padding: 0; cursor: pointer;" @onclick="() => ChangeYear(-1)">◀</button>
                        <span class="dash-filter-chip-label">연도</span>
                        <span class="dash-filter-chip-value" style="font-variant-numeric: tabular-nums;">@CurrentYear</span>
                        <button style="background: none; border: none; color: var(--on-surface-sub); font-weight: 700; padding: 0; cursor: pointer;" @onclick="() => ChangeYear(1)">▶</button>
                    </div>
                    @* 부서 선택 칩 (관리자만) *@
                    @if (CurrentUser?.CanViewAll == true)
                    {
                        <div class="dash-filter-chip">
                            <span class="dash-filter-chip-label">부서</span>
                            <select style="background: none; border: none; font-size: 1.2rem; font-weight: 700; color: var(--on-surface); cursor: pointer; outline: none; padding: 0;" @onchange="OnDeptChanged" value="@DashboardDeptId">
                                <option value="0">전체 부서</option>
                                @foreach (var dept in Departments)
                                {
                                    @if (dept.Name != "관리자" && dept.Name != "교회학교 운영팀" && dept.Name != "감사위원회")
                                    {
                                        <option value="@dept.Id">@dept.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Hero Metrics (지출 / 수입) ── *@
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
            @* 지출 실적 카드 *@
            <article class="dash-hero-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <p class="dash-label">지출 실적</p>
                        <h4 class="dash-hero-amount">₩@TotalExpense.ToString("N0")</h4>
                    </div>
                    <span class="dash-badge-pct">예산 대비 @ProgressPercentage.ToString("0")%</span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span class="dash-meta-label">진행률</span>
                        <span class="dash-meta-label" style="font-variant-numeric: tabular-nums;">
                            한도: ₩@TotalBudget.ToString("N0") &nbsp;|&nbsp; 잔여: ₩@RemainingBudget.ToString("N0")
                        </span>
                    </div>
                    <div class="dash-progress-bg">
                        <div class="dash-progress-fill" style="width: @(Math.Min(ProgressPercentage, 100).ToString("0.0"))%;"></div>
                    </div>
                </div>
            </article>

            @* 수입 내역 카드 *@
            <article class="dash-hero-card" style="background-color: var(--surface-low);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <p class="dash-label">수입 내역</p>
                        <h4 class="dash-hero-amount">₩@TotalIncome.ToString("N0")</h4>
                    </div>
                    <span class="dash-badge-pct">보조금 수령 @IncomeRate%</span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span class="dash-meta-label">진행률</span>
                        <span class="dash-meta-label" style="font-variant-numeric: tabular-nums;">보조금: ₩@SubsidyReceived.ToString("N0")</span>
                    </div>
                    <div class="dash-progress-bg">
                        <div class="dash-progress-fill" style="width: @(Math.Min(IncomeRate, 100))%;"></div>
                    </div>
                </div>
            </article>
        </div>

        @* ── 항목별 상세 (지출 / 수입) ── *@
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">

            @* 지출 항목별 상세 *@
            <div class="dash-detail-card">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
                    <h5 style="font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; color: var(--on-surface); margin: 0;">지출 예산 집행률</h5>
                </div>
                <div style="display: flex; flex-direction: column; gap: 1.5rem; max-height: 400px; overflow-y: auto; padding-right: 0.5rem;">
                    @if (ExpenseStats.Any())
                    {
                        @foreach (var stat in ExpenseStats)
                        {
                            bool isOver = stat.Percentage > 100 || (stat.BudgetAmount == 0 && stat.Amount > 0);
                            string displayPct = stat.BudgetAmount > 0 ? $"{stat.Percentage}%" : "예산초과";

                            <div class="dash-stat-row">
                                <div class="dash-stat-meta">
                                    <span>@stat.Category <span style="color: var(--on-surface-muted); font-weight: 500; font-size: 1rem; margin-left: 4px;">(예산: ₩@stat.BudgetAmount.ToString("N0"))</span></span>
                                    <span style="font-variant-numeric: tabular-nums; color: @(isOver ? "#ba1a1a" : "inherit");">
                                        ₩@stat.Amount.ToString("N0") (@displayPct)
                                    </span>
                                </div>
                                <div class="dash-progress-bg">
                                    <div class="dash-progress-fill" style="width: @(Math.Min(stat.Percentage, 100))%; opacity: 0.85; @(isOver ? "background: #ba1a1a;" : "")"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: var(--on-surface-muted); font-size: 1rem; text-align: center; padding: 1rem 0;">예산 및 집행 내역이 없습니다.</p>
                    }
                </div>
            </div>

            @* 수입 항목별 상세 *@
            <div class="dash-detail-card">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
                    <h5 style="font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; color: var(--on-surface); margin: 0;">수입 예산 달성률</h5>
                </div>
                <div style="display: flex; flex-direction: column; gap: 1.5rem; max-height: 400px; overflow-y: auto; padding-right: 0.5rem;">
                    @if (IncomeStats.Any())
                    {
                        @foreach (var stat in IncomeStats)
                        {
                            bool isOver = stat.Percentage > 100 || (stat.BudgetAmount == 0 && stat.Amount > 0);
                            string displayPct = stat.BudgetAmount > 0 ? $"{stat.Percentage}%" : "예산초과";

                            <div class="dash-stat-row">
                                <div class="dash-stat-meta">
                                    <span>@stat.Category <span style="color: var(--on-surface-muted); font-weight: 500; font-size: 1rem; margin-left: 4px;">(예산: ₩@stat.BudgetAmount.ToString("N0"))</span></span>
                                    <span style="font-variant-numeric: tabular-nums; color: @(isOver ? "#ba1a1a" : "inherit");">
                                        ₩@stat.Amount.ToString("N0") (@displayPct)
                                    </span>
                                </div>
                                <div class="dash-progress-bg">
                                    <div class="dash-progress-fill" style="width: @(Math.Min(stat.Percentage, 100))%; opacity: 0.85; @(isOver ? "background: #ba1a1a;" : "")"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: var(--on-surface-muted); font-size: 1rem; text-align: center; padding: 1rem 0;">예산 및 수입 내역이 없습니다.</p>
                    }
                </div>
            </div>
        </div>

        @* ── 지출결의서 신청현황 ── *@
        <div style="display: flex; flex-direction: column; gap: 1.5rem; padding-bottom: 2rem;">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem;">
                <div>
                    <h4 style="font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; color: var(--on-surface); margin-bottom: 0.25rem;">지출결의서 신청현황</h4>
                    <p style="font-size: 1rem; color: var(--on-surface-muted); font-weight: 400; line-height: 1.5; margin: 0;">모든 승인 대기 및 완료된 신청 건의 상태입니다.</p>
                </div>
                <div style="text-align: right;">
                    <p class="dash-label" style="margin-bottom: 0.25rem;">총 신청액 누계</p>
                    <p style="font-size: 1.5rem; font-weight: 900; font-variant-numeric: tabular-nums; color: var(--on-surface); margin: 0;">
                        ₩@SubsidyRequests.Sum(r => r.Amount).ToString("N0")
                    </p>
                </div>
            </div>

            @* No-Line 테이블 *@
            <div class="dash-list-wrap">
                <table style="width: 100%; text-align: left; border-collapse: collapse;">
                    <thead>
                        <tr class="dash-list-head">
                            <th>작성일</th>
                            <th>제목</th>
                            <th style="text-align: right;">신청금액</th>
                            <th style="text-align: center;">입금일</th>
                        </tr>
                    </thead>
                    <tbody class="dash-list-body">
                        @if (SubsidyRequests.Any())
                        {
                            @foreach (var req in SubsidyRequests)
                            {
                                <tr>
                                    <td style="font-variant-numeric: tabular-nums; font-weight: 500; opacity: 0.75;">
                                        @req.RequestDate.ToShortDateString()
                                    </td>
                                    <td style="font-weight: 700; color: var(--on-surface);">
                                        @req.Title
                                    </td>
                                    <td style="text-align: right; font-weight: 900; font-variant-numeric: tabular-nums; color: var(--on-surface);">
                                        ₩@req.Amount.ToString("N0")
                                    </td>
                                    <td style="text-align: center;">
                                        @if (req.DepositDate.HasValue)
                                        {
                                            <span class="dash-status-done">@req.DepositDate.Value.ToString("yyyy.MM.dd")</span>
                                        }
                                        else
                                        {
                                            <span class="dash-status-waiting">입금대기</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 3rem; color: var(--on-surface-muted); font-size: 1rem;">
                                    신청 내역이 없습니다.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
}

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private int CurrentYear = DateTime.Now.Year;
    private bool IsAdmin = false;
    private int DashboardDeptId = 0;
    private List<Department> Departments = new();

    private decimal TotalBudget = 0;
    private decimal TotalExpense = 0;
    private decimal RemainingBudget => TotalBudget - TotalExpense;
    private double ProgressPercentage = 0;

    private decimal TotalIncomeBudget = 0;
    private int IncomeRate = 0;
    private decimal SubsidyBudget = 0;
    private decimal SubsidyReceived = 0;

    public class CategoryStat
    {
        public string Category { get; set; } = "";
        public decimal Amount { get; set; }
        // 🚀 추가: 예산액을 담을 변수
        public decimal BudgetAmount { get; set; }
        public int Percentage { get; set; }
    }

    private decimal TotalIncome = 0;
    private List<CategoryStat> IncomeStats = new();
    private List<CategoryStat> ExpenseStats = new();

    public class SubsidyRequestItem
    {
        public DateTime RequestDate { get; set; }
        public string Title { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime? DepositDate { get; set; }
    }
    private List<SubsidyRequestItem> SubsidyRequests = new();

    protected override async Task OnInitializedAsync()
    {
        Departments = await Accounting.GetDepartmentsAsync();

        if (CurrentUser != null && CurrentUser.Department != null)
        {
            if (CurrentUser.Role == "Admin" || CurrentUser.Role == "Auditor")
            {
                IsAdmin = true;
                DashboardDeptId = 0;
            }
            else
            {
                IsAdmin = false;
                DashboardDeptId = CurrentUser.DepartmentId;
            }

            try
            {
                var latestBudgetYear = await DbContext.BudgetPlans
                    .Where(b => DashboardDeptId == 0 || b.DepartmentId == DashboardDeptId)
                    .OrderByDescending(b => b.Year)
                    .Select(b => b.Year)
                    .FirstOrDefaultAsync();

                if (latestBudgetYear > 0)
                {
                    CurrentYear = latestBudgetYear;
                }
            }
            catch { /* ignore */ }

            await LoadDashboardData();
        }
    }

    private async Task ChangeYear(int offset)
    {
        CurrentYear += offset;
        await LoadDashboardData();
    }

    private async Task OnDeptChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int deptId))
        {
            DashboardDeptId = deptId;
            await LoadDashboardData();
        }
    }

    private bool IsExpenseType(string t) => string.Equals(t, "Expense", StringComparison.OrdinalIgnoreCase) || string.Equals(t, "지출", StringComparison.OrdinalIgnoreCase);
    private bool IsIncomeType(string t) => string.Equals(t, "Income", StringComparison.OrdinalIgnoreCase) || string.Equals(t, "수입", StringComparison.OrdinalIgnoreCase);

    private async Task LoadDashboardData()
    {
        StateHasChanged();
        try
        {
            var budgetQuery = DbContext.BudgetPlans.AsNoTracking().Where(b => b.Year == CurrentYear);
            if (DashboardDeptId != 0) budgetQuery = budgetQuery.Where(b => b.DepartmentId == DashboardDeptId);
            var budgetList = await budgetQuery.ToListAsync();

            TotalBudget = budgetList.Where(b => IsExpenseType(b.Type)).Sum(b => b.Amount);
            TotalIncomeBudget = budgetList.Where(b => IsIncomeType(b.Type) && b.Category != "은행이자" && b.Category != "환급금").Sum(b => b.Amount);
            SubsidyBudget = budgetList.Where(b => IsIncomeType(b.Type) && b.Category == "교회보조금").Sum(b => b.Amount);

            int queryDeptId = DashboardDeptId == 0 ? (CurrentUser?.DepartmentId ?? 0) : DashboardDeptId;

            var q1 = await Accounting.GetQuarterDateRangeAsync(queryDeptId, CurrentYear, 1);
            var q4 = await Accounting.GetQuarterDateRangeAsync(queryDeptId, CurrentYear, 4);

            DateTime dashboardStartDate = q1.Start.Date;
            DateTime dashboardEndDate = q4.End.Date.AddDays(1);

            var transQuery = DbContext.Transactions.AsNoTracking()
                .Where(t => t.FiscalYear == CurrentYear && t.Date >= dashboardStartDate && t.Date < dashboardEndDate);
            if (DashboardDeptId != 0) transQuery = transQuery.Where(t => t.DepartmentId == DashboardDeptId);

            var transactions = await transQuery.ToListAsync();

            TotalExpense = transactions.Where(t => IsExpenseType(t.Type)).Sum(t => t.Expense);
            TotalIncome = transactions.Where(t => IsIncomeType(t.Type) && t.Category != "은행이자" && t.Category != "환급금").Sum(t => t.Income);
            SubsidyReceived = transactions.Where(t => IsIncomeType(t.Type) && t.Category == "교회보조금").Sum(t => t.Income);

            if (TotalBudget > 0)
            {
                ProgressPercentage = (double)(TotalExpense / TotalBudget) * 100;
                if (ProgressPercentage > 100) ProgressPercentage = 100;
            }
            else { ProgressPercentage = 0; }

            IncomeRate = TotalIncomeBudget > 0 ? (int)Math.Round((TotalIncome / TotalIncomeBudget) * 100) : 0;
            if (IncomeRate > 100) IncomeRate = 100;

            // 🚀 수입: 예산에 등록된 항목 + 실제 발생한 항목을 모두 합쳐서 계산
            var allIncomeCats = budgetList.Where(b => IsIncomeType(b.Type)).Select(b => b.Category)
            .Union(transactions.Where(t => IsIncomeType(t.Type) && t.Income > 0).Select(t => t.Category))
            .Where(c => !string.IsNullOrWhiteSpace(c) && c != "은행이자" && c != "환급금").Distinct();

            IncomeStats = allIncomeCats.Select(cat =>
            {
                decimal bAmt = budgetList.Where(b => IsIncomeType(b.Type) && b.Category == cat).Sum(b => b.Amount);
                decimal tAmt = transactions.Where(t => IsIncomeType(t.Type) && t.Category == cat).Sum(t => t.Income);
                return new CategoryStat
                {
                    Category = cat,
                    Amount = tAmt,
                    BudgetAmount = bAmt,
                    Percentage = bAmt > 0 ? (int)Math.Round((tAmt / bAmt) * 100) : (tAmt > 0 ? 100 : 0)
                };
            }).OrderByDescending(x => x.Percentage).ThenByDescending(x => x.Amount).ToList();

            // 🚀 지출: 예산에 등록된 항목 + 실제 발생한 항목을 모두 합쳐서 계산
            var allExpenseCats = budgetList.Where(b => IsExpenseType(b.Type)).Select(b => b.Category)
                .Union(transactions.Where(t => IsExpenseType(t.Type) && t.Expense > 0).Select(t => t.Category))
                .Where(c => !string.IsNullOrWhiteSpace(c)).Distinct();

            ExpenseStats = allExpenseCats.Select(cat =>
            {
                decimal bAmt = budgetList.Where(b => IsExpenseType(b.Type) && b.Category == cat).Sum(b => b.Amount);
                decimal tAmt = transactions.Where(t => IsExpenseType(t.Type) && t.Category == cat).Sum(t => t.Expense);
                return new CategoryStat
                {
                    Category = cat,
                    Amount = tAmt,
                    BudgetAmount = bAmt,
                    Percentage = bAmt > 0 ? (int)Math.Round((tAmt / bAmt) * 100) : (tAmt > 0 ? 100 : 0)
                };
            }).OrderByDescending(x => x.Percentage).ThenByDescending(x => x.Amount).ToList();

            var reportsQuery = DbContext.ExpenseReports.AsNoTracking().Where(r => r.FiscalYear == CurrentYear);
            if (DashboardDeptId != 0) reportsQuery = reportsQuery.Where(r => r.DepartmentId == DashboardDeptId);
            var reports = await reportsQuery.OrderByDescending(r => r.Date).ToListAsync();

            var allIncomeQuery = DbContext.Transactions.AsNoTracking().Where(t => t.Type == "수입" || t.Type == "Income");
            if (DashboardDeptId != 0) allIncomeQuery = allIncomeQuery.Where(t => t.DepartmentId == DashboardDeptId);
            var incomeListForMatching = await allIncomeQuery.OrderBy(t => t.Date).ToListAsync();

            SubsidyRequests.Clear();
            foreach (var rep in reports)
            {
                var matchedIncome = incomeListForMatching.FirstOrDefault(t =>
                    t.Date.Date >= rep.Date.Date &&
                    t.Income == rep.TotalAmount &&
                    (DashboardDeptId == 0 || t.DepartmentId == rep.DepartmentId));

                string deptPrefix = "";
                if (DashboardDeptId == 0)
                {
                    var repDept = Departments.FirstOrDefault(d => d.Id == rep.DepartmentId);
                    if (repDept != null) deptPrefix = $"[{repDept.Name}] ";
                }

                SubsidyRequests.Add(new SubsidyRequestItem
                {
                    RequestDate = rep.Date,
                    Title = deptPrefix + rep.Title,
                    Amount = rep.TotalAmount,
                    DepositDate = matchedIncome?.Date
                });

                if (matchedIncome != null) incomeListForMatching.Remove(matchedIncome);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"대시보드 로드 오류: {ex.Message}");
        }
    }
}