@page "/"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Data
@using INcheonChurchWeb.Services
@using Microsoft.EntityFrameworkCore
@inject AccountingService Accounting
@inject AppDbContext DbContext
@rendermode InteractiveServer

<PageTitle>인천중앙교회 재정 시스템</PageTitle>

<div class="container mt-4 mb-5">
    @if (string.IsNullOrEmpty(CurrentUser?.Username))
    {
        @* 로그인 전 화면 *@
        <div class="text-center py-5">
            <i class="bi bi-shield-lock text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 fw-bold text-secondary">로그인이 필요합니다</h4>
            <p class="text-muted">좌측 메뉴에서 로그인 후 부서별 장부와 대시보드를 확인하세요.</p>
        </div>
    }
    else
    {
        @* 1. 환영 인사 및 부서/연도 선택 헤더 *@
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-pie-chart-fill text-primary fs-1 me-3"></i>
                <div>
                    <h2 class="fw-bold mb-0">대시보드</h2>
                    <p class="text-muted mb-0">@CurrentYear 년도 예산 및 지출 현황을 한눈에 확인하세요.</p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                @* 연도 이동 컨트롤 *@
                <div class="d-flex align-items-center gap-1 bg-light p-2 rounded shadow-sm border">
                    <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="() => ChangeYear(-1)" disabled="@(CurrentYear <= 2024)">◀</button>
                    <span class="fw-bold fs-5 px-2 text-primary" style="min-width: 80px; text-align: center;">@CurrentYear 년</span>
                    <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="() => ChangeYear(1)" disabled="@(CurrentYear >= DateTime.Now.Year + 1)">▶</button>
                </div>

                @* 관리자용 부서 필터 *@
                @if (IsAdmin)
                {
                    <div class="d-flex align-items-center bg-light p-2 rounded shadow-sm border">
                        <i class="bi bi-funnel-fill text-secondary me-2 ms-1"></i>
                        <label class="fw-bold me-2 text-dark text-nowrap">부서 필터:</label>
                        @* 🚀 value를 숫자로 받도록 수정 *@
                        <select class="form-select border-primary fw-bold text-primary w-auto" @onchange="OnDeptChanged" value="@DashboardDeptId">
                            <option value="0">전체 부서 통합보기</option>
                            @foreach (var dept in Departments)
                            {
                                @* 관리자용 특수 부서는 제외하고 보여줌 *@
                                @if (dept.Name != "관리자" && dept.Name != "교회학교 운영팀")
                                {
                                    <option value="@dept.Id">@dept.Name</option>
                                }
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="badge bg-primary fs-5 p-2 shadow-sm">
                        <i class="bi bi-person-badge me-2"></i>
                        @* 🚀 수정: .Name이 null일 경우를 대비해 Username이라도 출력 *@
                        @(CurrentUser?.Department?.Name ?? CurrentUser?.Username ?? "사용자")
                    </div>
                }
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">데이터를 불러오는 중...</p></div>
        }
        else
        {
            @* 1. 예산 및 보조금 진척도 *@
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 p-4">
                        <h5 class="fw-bold text-danger mb-3"><i class="bi bi-pie-chart-fill me-2"></i>총 지출 예산 진척도</h5>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">사용액: <strong>@TotalExpense.ToString("N0")</strong>원</span>
                            <span class="text-muted">예산: <strong>@TotalBudget.ToString("N0")</strong>원</span>
                        </div>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar @ProgressBarColor progress-bar-striped progress-bar-animated fw-bold fs-6" role="progressbar" style="width: @ProgressPercentage.ToString("0.0")%">
                                @ProgressPercentage.ToString("0.0")%
                            </div>
                        </div>
                        <div class="text-end mt-2 small fw-bold text-secondary">잔여 지출 예산: @RemainingBudget.ToString("N0") 원</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 p-4 bg-primary bg-opacity-10">
                        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-piggy-bank-fill me-2"></i>총 수입(교회보조금 포함) 진척도</h5>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">수입/입금액: <strong class="text-primary">@TotalIncome.ToString("N0")</strong>원</span>
                            <span class="text-muted">수입 예산: <strong>@TotalIncomeBudget.ToString("N0")</strong>원</span>
                        </div>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-primary fw-bold fs-6" role="progressbar" style="width: @IncomeRate%;">@IncomeRate%</div>
                        </div>
                        <div class="text-end mt-2 small fw-bold text-secondary">
                            (참고: 보조금 수령액 @SubsidyReceived.ToString("N0")원 / 예산 @SubsidyBudget.ToString("N0")원)
                        </div>
                    </div>
                </div>
            </div>

            @* 2. 수입/지출 항목별 통계 차트 (가로 바) *@
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold text-primary mb-0"><i class="bi bi-graph-up-arrow me-2"></i>수입 항목 비율 (장부 기준 총 @TotalIncome.ToString("N0")원)</h6>
                        </div>
                        <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                            @if (!IncomeStats.Any())
                            {
                                <div class="text-muted text-center py-4">수입 내역이 없습니다.</div>
                            }
                            @foreach (var stat in IncomeStats)
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="fw-bold">@stat.Category</span>
                                        <span class="text-primary">@stat.Amount.ToString("N0")원 (@stat.Percentage%)</span>
                                    </div>
                                    <div class="progress" style="height: 12px;">
                                        <div class="progress-bar bg-primary opacity-75" role="progressbar" style="width: @stat.Percentage%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold text-danger mb-0"><i class="bi bi-graph-down-arrow me-2"></i>지출 항목 비율 (장부 기준 총 @TotalExpense.ToString("N0")원)</h6>
                        </div>
                        <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                            @if (!ExpenseStats.Any())
                            {
                                <div class="text-muted text-center py-4">지출 내역이 없습니다.</div>
                            }
                            @foreach (var stat in ExpenseStats)
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="fw-bold">@stat.Category</span>
                                        <span class="text-danger">@stat.Amount.ToString("N0")원 (@stat.Percentage%)</span>
                                    </div>
                                    <div class="progress" style="height: 12px;">
                                        <div class="progress-bar bg-danger opacity-75" role="progressbar" style="width: @stat.Percentage%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* 3. 교회보조금 신청현황 (지출결의서 & 장부 자동 매칭) *@
            <div class="card border-0 shadow-sm mb-5">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-file-earmark-check-fill text-success me-2"></i>지출결의서 신청 및 입금 현황</h5>
                    <span class="badge bg-light text-dark border fs-6">총 신청액 누계: <span class="text-primary fw-bold">@SubsidyRequests.Sum(r => r.Amount).ToString("N0")원</span></span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>결의서 작성일</th>
                                <th class="text-start">결의서 제목 (적요)</th>
                                <th class="text-end">신청 금액</th>
                                <th>상태</th>
                                <th>실제 입금일 (장부 매칭)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in SubsidyRequests)
                            {
                                <tr>
                                    <td>@req.RequestDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-start fw-bold">@req.Title</td>
                                    <td class="text-end text-primary fw-bold pe-4">@req.Amount.ToString("N0") 원</td>
                                    <td>
                                        @if (req.DepositDate.HasValue)
                                        {
                                            <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i>입금완료</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-hourglass-split me-1"></i>미입금(대기)</span>
                                        }
                                    </td>
                                    <td>
                                        @if (req.DepositDate.HasValue)
                                        {
                                            <strong class="text-success">@req.DepositDate.Value.ToString("yyyy-MM-dd")</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!SubsidyRequests.Any())
                            {
                                <tr><td colspan="5" class="py-5 text-muted">해당 연도에 작성된 지출결의서가 없습니다.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private int CurrentYear = DateTime.Now.Year;
    private bool IsAdmin = false;

    // 🚀 DashboardDept (string) -> DashboardDeptId (int) 로 교체
    // 0 이면 "전체"를 의미합니다.
    private int DashboardDeptId = 0;

    private bool isLoading = true;

    // 🚀 문자열 배열 대신 실제 DB의 Department 목록을 가져옵니다.
    private List<Department> Departments = new();

    private decimal TotalBudget = 0;
    private decimal TotalExpense = 0;
    private decimal RemainingBudget => TotalBudget - TotalExpense;
    private double ProgressPercentage = 0;
    private string ProgressBarColor = "bg-success";

    private decimal TotalIncomeBudget = 0;
    private int IncomeRate = 0;
    private decimal SubsidyBudget = 0;
    private decimal SubsidyReceived = 0;

    public class CategoryStat { public string Category { get; set; } = ""; public decimal Amount { get; set; } public int Percentage { get; set; } }
    private decimal TotalIncome = 0;
    private List<CategoryStat> IncomeStats = new();
    private List<CategoryStat> ExpenseStats = new();

    public class SubsidyRequestItem { public DateTime RequestDate { get; set; } public string Title { get; set; } = ""; public decimal Amount { get; set; } public DateTime? DepositDate { get; set; } }
    private List<SubsidyRequestItem> SubsidyRequests = new();

    protected override async Task OnInitializedAsync()
    {
        // 🚀 부서 목록을 DB에서 가져옵니다.
        Departments = await Accounting.GetDepartmentsAsync();

        if (CurrentUser != null && CurrentUser.Department != null)
        {
            if (CurrentUser.Department.Name == "교육국" || CurrentUser.Role == "Admin" || CurrentUser.Department.Name == "관리자")
            {
                IsAdmin = true;
                DashboardDeptId = 0; // 0 = 전체보기
            }
            else
            {
                IsAdmin = false;
                DashboardDeptId = CurrentUser.DepartmentId; // 자기 부서 고정
            }

            try
            {
                // 🚀 문자열이 아닌 Id 기반으로 필터링
                var latestBudgetYear = await DbContext.BudgetPlans
                    .Where(b => DashboardDeptId == 0 || b.DepartmentId == DashboardDeptId)
                    .OrderByDescending(b => b.Year)
                    .Select(b => b.Year)
                    .FirstOrDefaultAsync();

                if (latestBudgetYear > 0)
                {
                    CurrentYear = latestBudgetYear;
                }
            }
            catch { /* ignore */ }

            await LoadDashboardData();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task ChangeYear(int offset)
    {
        CurrentYear += offset;
        await LoadDashboardData();
    }

    private async Task OnDeptChanged(ChangeEventArgs e)
    {
        // 🚀 선택된 옵션의 value를 int로 변환
        if (int.TryParse(e.Value?.ToString(), out int deptId))
        {
            DashboardDeptId = deptId;
            await LoadDashboardData();
        }
    }

    private bool IsExpenseType(string t) => string.Equals(t, "Expense", StringComparison.OrdinalIgnoreCase) || string.Equals(t, "지출", StringComparison.OrdinalIgnoreCase);
    private bool IsIncomeType(string t) => string.Equals(t, "Income", StringComparison.OrdinalIgnoreCase) || string.Equals(t, "수입", StringComparison.OrdinalIgnoreCase);

    private async Task LoadDashboardData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var budgetQuery = DbContext.BudgetPlans.AsNoTracking().Where(b => b.Year == CurrentYear);
            // 🚀 문자열 필터 대신 Id 필터 적용 (0이면 조건 무시)
            if (DashboardDeptId != 0) budgetQuery = budgetQuery.Where(b => b.DepartmentId == DashboardDeptId);
            var budgetList = await budgetQuery.ToListAsync();

            TotalBudget = budgetList.Where(b => IsExpenseType(b.Type)).Sum(b => b.Amount);
            TotalIncomeBudget = budgetList.Where(b => IsIncomeType(b.Type)).Sum(b => b.Amount);

            SubsidyBudget = budgetList.Where(b => IsIncomeType(b.Type) && b.Category == "교회보조금").Sum(b => b.Amount);

            // 해당 연도 장부 데이터 로드
            var transQuery = DbContext.Transactions.AsNoTracking().Where(t => t.FiscalYear == CurrentYear);
            if (DashboardDeptId != 0) transQuery = transQuery.Where(t => t.DepartmentId == DashboardDeptId);
            var transactions = await transQuery.ToListAsync();

            TotalExpense = transactions.Where(t => IsExpenseType(t.Type)).Sum(t => t.Expense);
            TotalIncome = transactions.Where(t => IsIncomeType(t.Type)).Sum(t => t.Income);
            SubsidyReceived = transactions.Where(t => IsIncomeType(t.Type) && t.Category == "교회보조금").Sum(t => t.Income);

            if (TotalBudget > 0)
            {
                ProgressPercentage = (double)(TotalExpense / TotalBudget) * 100;
                if (ProgressPercentage > 100) ProgressPercentage = 100;
                if (ProgressPercentage >= 90) ProgressBarColor = "bg-danger";
                else if (ProgressPercentage >= 70) ProgressBarColor = "bg-warning";
                else ProgressBarColor = "bg-success";
            }
            else { ProgressPercentage = 0; ProgressBarColor = "bg-success"; }

            IncomeRate = TotalIncomeBudget > 0 ? (int)Math.Round((TotalIncome / TotalIncomeBudget) * 100) : 0;
            if (IncomeRate > 100) IncomeRate = 100;

            IncomeStats = transactions.Where(t => IsIncomeType(t.Type) && t.Income > 0)
                .GroupBy(t => t.Category)
                .Select(g => new CategoryStat { Category = g.Key, Amount = g.Sum(x => x.Income), Percentage = TotalIncome > 0 ? (int)Math.Round((g.Sum(x => x.Income) / TotalIncome) * 100) : 0 })
                .OrderByDescending(x => x.Amount).ToList();

            ExpenseStats = transactions.Where(t => IsExpenseType(t.Type) && t.Expense > 0)
                .GroupBy(t => t.Category)
                .Select(g => new CategoryStat { Category = g.Key, Amount = g.Sum(x => x.Expense), Percentage = TotalExpense > 0 ? (int)Math.Round((g.Sum(x => x.Expense) / TotalExpense) * 100) : 0 })
                .OrderByDescending(x => x.Amount).ToList();

            // ========================================================
            // 🚀 지출결의서-장부 매칭 로직 수정 부분
            // ========================================================
            var reportsQuery = DbContext.ExpenseReports.AsNoTracking().Where(r => r.FiscalYear == CurrentYear);

            // 373줄: .Department를 .DepartmentId로 수정
            if (DashboardDeptId != 0) reportsQuery = reportsQuery.Where(r => r.DepartmentId == DashboardDeptId);
            var reports = await reportsQuery.OrderByDescending(r => r.Date).ToListAsync();

            var allIncomeQuery = DbContext.Transactions.AsNoTracking().Where(t => t.Type == "수입" || t.Type == "Income");
            if (DashboardDeptId != 0) allIncomeQuery = allIncomeQuery.Where(t => t.DepartmentId == DashboardDeptId);
            var incomeListForMatching = await allIncomeQuery.OrderBy(t => t.Date).ToListAsync();

            SubsidyRequests.Clear();

            foreach (var rep in reports)
            {
                // 384줄: t.Department == rep.Department 를 t.DepartmentId == rep.DepartmentId 로 수정
                var matchedIncome = incomeListForMatching.FirstOrDefault(t =>
                    t.Date.Date >= rep.Date.Date &&
                    t.Income == rep.TotalAmount &&
                    (DashboardDeptId == 0 || t.DepartmentId == rep.DepartmentId));

                // 390줄: rep.Department 를 rep.DepartmentId 로 수정 (부서 이름을 가져오기 위해 List에서 찾음)
                string deptPrefix = "";
                if (DashboardDeptId == 0)
                {
                    var repDept = Departments.FirstOrDefault(d => d.Id == rep.DepartmentId);
                    if (repDept != null) deptPrefix = $"[{repDept.Name}] ";
                }

                SubsidyRequests.Add(new SubsidyRequestItem
                {
                    RequestDate = rep.Date,
                    Title = deptPrefix + rep.Title,
                    Amount = rep.TotalAmount,
                    DepositDate = matchedIncome?.Date
                });

                if (matchedIncome != null) incomeListForMatching.Remove(matchedIncome);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"대시보드 로드 오류: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}