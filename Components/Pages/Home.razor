@page "/"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Data
@using INcheonChurchWeb.Services
@using Microsoft.EntityFrameworkCore
@inject AccountingService Accounting
@inject IDbContextFactory<AppDbContext> DbContextFactory
@rendermode InteractiveServer

<PageTitle>인천중앙교회 재정 시스템</PageTitle>

<style>
    /* ── Tactile Ledger Design Tokens ── */
    .dash-hero-card {
        font-size: 1rem ;
        font-weight: 700 ;
        background-color: var(--surface-lowest);
        border-radius: 0.75rem;
        box-shadow: 0 4px 20px rgba(48, 49, 41, 0.04);
        border: none;
        padding: 2rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 200px;
    }

    .dash-detail-card {
        font-size: 1rem ;
        background-color: var(--surface-lowest);
        border-radius: 0.75rem;
        box-shadow: 0 4px 20px rgba(48, 49, 41, 0.04);
        border: none;
        padding: 2rem 2.5rem;
    }

    .dash-label {
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--primary-gold);
        opacity: 0.85;
        margin-bottom: 0.5rem;
    }

    .dash-hero-amount {
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.02em;
        color: var(--on-surface);
        line-height: 1.1;
    }

    .dash-badge-pct {
        background-color: var(--surface-low);
        border-radius: 9999px;
        padding: 0.25rem 1rem;
        font-size: 1rem;
        font-weight: 700;
        color: var(--primary-gold);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    .dash-progress-bg {
        background-color: var(--surface-low);
        height: 0.5rem;
        border-radius: 9999px;
        overflow: hidden;
    }

    .dash-progress-fill {
        background: var(--gold-gradient);
        height: 100%;
        border-radius: 9999px;
        transition: width 0.5s ease-out;
    }

    /* 📱 라벨과 수치를 양끝 배치. 좁은 화면(폴드 커버 등)에서는 위아래로 쌓아
       글자가 세로로 쪼개지는 것을 막는다. */
    .dash-meta-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    @@media (max-width: 480px) {
        .dash-meta-row { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
        .dash-meta-row .dash-meta-label { text-align: left !important; font-size: 0.9rem; }
    }

    .dash-meta-label {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--on-surface-muted);
    }

    .dash-filter-chip {
        background-color: var(--surface-lowest);
        border-radius: 0.5rem;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(48, 49, 41, 0.06);
        border: none;
    }

    .dash-filter-chip-label {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--on-surface-muted);
    }

    .dash-filter-chip-value {
        font-size: 1rem;
        font-weight: 700;
        color: var(--on-surface);
    }

    .dash-stat-row {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .dash-stat-meta {
        display: flex;
        justify-content: space-between;
        font-size: 1rem;
        font-weight: 700;
        color: var(--on-surface);
    }

    /* 📇 상세 카드 헤더: 제목(=접기 토글) + 정렬 셀렉트 + 방향 표시 */
    .dash-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
        cursor: pointer;
        user-select: none;
    }

    .dash-card-head-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: auto;
    }

    .dash-sort-select {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--on-surface);
        background-color: var(--surface-low);
        border: 1px solid rgba(48, 49, 41, 0.12);
        border-radius: 0.5rem;
        padding: 0.2rem 0.5rem;
        cursor: pointer;
    }

    .dash-chevron {
        font-size: 1rem;
        color: var(--on-surface-muted);
        line-height: 1;
    }

    .dash-head-count {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--on-surface-muted);
        margin-left: 0.35rem;
    }

    /* 🚧 예산 외 구역: 예산 0인데 실적이 있는 항목을 아래로 분리 */
    .dash-offbudget {
        margin-top: 0.5rem;
        padding: 1rem 1rem 0.25rem;
        border: 1px dashed rgba(48, 49, 41, 0.18);
        border-radius: 0.75rem;
        background-color: var(--surface-low);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .dash-offbudget-title {
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--on-surface-muted);
        margin: 0;
    }

    @@media (max-width: 480px) {
        .dash-card-head-right { margin-left: 0; }
        .dash-sort-select { font-size: 0.8rem; }
    }

    .dash-list-wrap {
        overflow-x: auto;
        border-radius: 1rem;
        background-color: rgba(255,255,255,0.5);
    }

    .dash-list-head th {
        padding: 1rem 2rem;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--primary-gold);
        opacity: 0.85;
        background-color: var(--surface-lowest);
        box-shadow: 0 2px 8px rgba(48,49,41,0.04);
        border: none !important;
        white-space: nowrap;
    }

    .dash-list-body tr {
        transition: background-color 0.15s ease-out;
    }

        .dash-list-body tr:hover {
            background-color: rgba(255,255,255,0.8);
        }

        .dash-list-body tr:nth-child(even) {
            background-color: rgba(255,255,255,0.35);
        }

    .dash-list-body td {
        padding: 1.25rem 2rem;
        font-size: 1rem;
        vertical-align: middle;
        border: none !important;
    }

    .dash-status-waiting {
        font-size: 1rem;
        font-weight: 600;
        color: var(--primary-gold);
        background-color: var(--surface-low);
        padding: 0.2rem 0.6rem;
        border-radius: 0.25rem;
    }

    .dash-status-done {
        font-size: 1rem;
        font-weight: 600;
        color: var(--on-surface-muted);
        font-variant-numeric: tabular-nums;
    }
</style>

@if (CurrentUser != null)
{
    <div style="padding: 2rem 1.5rem; max-width: 100%; margin-left: 0; padding-bottom: 5rem;">

        @* ── 필터 & 타이틀 ── *@
        <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2.5rem;">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.5rem;">
                <div>
                    <h3 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; letter-spacing: -0.02em; color: var(--on-surface); margin-bottom: 0.25rem; line-height: 1.2;">
                        @_currentYear 재정 현황 요약
                    </h3>
                    <p style="color: var(--on-surface-sub); font-size: 1.1rem; font-weight: 400; line-height: 1.5; opacity: 0.85; margin: 0;">
                        현재 회계 기간의 재정 성과 상세 내역입니다.
                    </p>
                </div>
                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
                    @* 연도 이동 칩 *@
                    <div class="dash-filter-chip">
                        <button style="background: none; border: none; color: var(--on-surface-sub); font-weight: 700; padding: 0; cursor: pointer;" @onclick="() => ChangeYear(-1)">◀</button>
                        <span class="dash-filter-chip-label">연도</span>
                        <span class="dash-filter-chip-value" style="font-variant-numeric: tabular-nums;">@_currentYear</span>
                        <button style="background: none; border: none; color: var(--on-surface-sub); font-weight: 700; padding: 0; cursor: pointer;" @onclick="() => ChangeYear(1)">▶</button>
                    </div>
                    @* 부서 선택 칩 (관리자만) *@
                    @if (CurrentUser?.CanViewAll == true)
                    {
                        <div class="dash-filter-chip">
                            <span class="dash-filter-chip-label">부서</span>
                            <select style="background: none; border: none; font-size: 1.2rem; font-weight: 700; color: var(--on-surface); cursor: pointer; outline: none; padding: 0;" @onchange="OnDeptChanged" value="@_dashboardDeptId">
                                <option value="0">전체 부서</option>
                                @foreach (var dept in _departments)
                                {
                                    @if (dept.Name != "관리자" && dept.Name != "교회학교 운영팀" && dept.Name != "감사위원회")
                                    {
                                        <option value="@dept.Id">@dept.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Hero Metrics (지출 / 수입) ── *@
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
            @* 지출 실적 카드 *@
            <article class="dash-hero-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <p class="dash-label">지출 실적</p>
                        <h4 class="dash-hero-amount">₩@_totalExpense.ToString("N0")</h4>
                    </div>
                    <span class="dash-badge-pct">예산 대비 @_progressPercentage.ToString("0")%</span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem;">
                    <div class="dash-meta-row">
                        <span class="dash-meta-label" style="flex-shrink: 0; white-space: nowrap;">진행률</span>
                        <span class="dash-meta-label" style="font-variant-numeric: tabular-nums; text-align: right;">
                            한도: ₩@_totalBudget.ToString("N0") &nbsp;|&nbsp; 잔여: ₩@RemainingBudget.ToString("N0")
                        </span>
                    </div>
                    <div class="dash-progress-bg">
                        <div class="dash-progress-fill" style="width: @(Math.Min(_progressPercentage, 100).ToString("0.0"))%;"></div>
                    </div>
                </div>
            </article>

            @* 수입 내역 카드 *@
            <article class="dash-hero-card" style="background-color: var(--surface-low);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <p class="dash-label">수입 내역</p>
                        <h4 class="dash-hero-amount">₩@_totalIncome.ToString("N0")</h4>
                    </div>
                    <span class="dash-badge-pct">보조금 신청 @_incomeRate%</span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem;">
                    <div class="dash-meta-row">
                        <span class="dash-meta-label" style="flex-shrink: 0; white-space: nowrap;">신청액 / 예산 (잔액)</span>
                        <span class="dash-meta-label" style="font-variant-numeric: tabular-nums; text-align: right;">
                            ₩@_subsidyRequested.ToString("N0") / ₩@_subsidyBudget.ToString("N0")
                            <span style="white-space: nowrap; @(SubsidyRemaining < 0 ? "color: var(--error);" : "")">(@(SubsidyRemaining < 0 ? "초과" : "잔여") ₩@Math.Abs(SubsidyRemaining).ToString("N0"))</span>
                        </span>
                    </div>
                    <div class="dash-progress-bg">
                        <div class="dash-progress-fill" style="width: @(Math.Min(_incomeRate, 100))%;"></div>
                    </div>
                </div>
            </article>
        </div>

        @* ── 항목별 상세 (지출 / 수입) ── *@
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">

            @* 지출 항목별 상세 *@
            <div class="dash-detail-card">
                @{
                    var expBudgeted = Budgeted(_expenseStats, _expenseSort).ToList();
                    var expOff = OffBudget(_expenseStats).ToList();
                }
                <div class="dash-card-head" style="margin-bottom: @(_statsCollapsed ? "0" : "2rem");" @onclick="() => _statsCollapsed = !_statsCollapsed">
                    <h5 style="font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; color: var(--on-surface); margin: 0;">
                        <span>지출 예산 집행률</span>
                        @if (_statsCollapsed)
                        {
                            <span class="dash-head-count">(@(expBudgeted.Count + expOff.Count))</span>
                        }
                    </h5>
                    <div class="dash-card-head-right">
                        @if (!_statsCollapsed)
                        {
                            @* 셀렉트 클릭이 헤더의 접기 토글까지 번지지 않게 막는다 *@
                            <div @onclick:stopPropagation="true">
                                <select class="dash-sort-select" @bind="_expenseSort">
                                    <option value="rate">집행률순</option>
                                    <option value="amount">금액순</option>
                                    <option value="name">이름순</option>
                                </select>
                            </div>
                        }
                        <i class="bi @(_statsCollapsed ? "bi-chevron-down" : "bi-chevron-up") dash-chevron"></i>
                    </div>
                </div>
                @if (!_statsCollapsed)
                {
                    <div style="display: flex; flex-direction: column; gap: 1.5rem; max-height: 400px; overflow-y: auto; padding-right: 0.5rem;">
                        @if (expBudgeted.Any() || expOff.Any())
                        {
                            @foreach (var stat in expBudgeted)
                            {
                                bool isOver = stat.Percentage > 100;

                                <div class="dash-stat-row">
                                    <div class="dash-stat-meta">
                                        <span>@stat.Category <span style="color: var(--on-surface-muted); font-weight: 500; font-size: 1rem; margin-left: 4px;">(예산: ₩@stat.BudgetAmount.ToString("N0"))</span></span>
                                        <span style="font-variant-numeric: tabular-nums; color: @(isOver ? "#ba1a1a" : "inherit");">
                                            ₩@stat.Amount.ToString("N0") (@stat.Percentage%)
                                        </span>
                                    </div>
                                    <div class="dash-progress-bg">
                                        <div class="dash-progress-fill" style="width: @(Math.Min(stat.Percentage, 100))%; opacity: 0.85; @(isOver ? "background: #ba1a1a;" : "")"></div>
                                    </div>
                                </div>
                            }
                            @if (expOff.Any())
                            {
                                <div class="dash-offbudget">
                                    <p class="dash-offbudget-title">예산 외 집행</p>
                                    @foreach (var stat in expOff)
                                    {
                                        <div class="dash-stat-row">
                                            <div class="dash-stat-meta">
                                                <span>@stat.Category</span>
                                                <span style="font-variant-numeric: tabular-nums;">₩@stat.Amount.ToString("N0")</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color: var(--on-surface-muted); font-size: 1rem; text-align: center; padding: 1rem 0;">예산 및 집행 내역이 없습니다.</p>
                        }
                    </div>
                }
            </div>

            @* 수입 항목별 상세 *@
            <div class="dash-detail-card">
                @{
                    var incBudgeted = Budgeted(_incomeStats, _incomeSort).ToList();
                    var incOff = OffBudget(_incomeStats).ToList();
                }
                <div class="dash-card-head" style="margin-bottom: @(_statsCollapsed ? "0" : "2rem");" @onclick="() => _statsCollapsed = !_statsCollapsed">
                    <h5 style="font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; color: var(--on-surface); margin: 0;">
                        <span>수입 예산 달성률</span>
                        @if (_statsCollapsed)
                        {
                            <span class="dash-head-count">(@(incBudgeted.Count + incOff.Count))</span>
                        }
                    </h5>
                    <div class="dash-card-head-right">
                        @if (!_statsCollapsed)
                        {
                            @* 셀렉트 클릭이 헤더의 접기 토글까지 번지지 않게 막는다 *@
                            <div @onclick:stopPropagation="true">
                                <select class="dash-sort-select" @bind="_incomeSort">
                                    <option value="rate">달성률순</option>
                                    <option value="amount">금액순</option>
                                    <option value="name">이름순</option>
                                </select>
                            </div>
                        }
                        <i class="bi @(_statsCollapsed ? "bi-chevron-down" : "bi-chevron-up") dash-chevron"></i>
                    </div>
                </div>
                @if (!_statsCollapsed)
                {
                    <div style="display: flex; flex-direction: column; gap: 1.5rem; max-height: 400px; overflow-y: auto; padding-right: 0.5rem;">
                        @if (incBudgeted.Any() || incOff.Any())
                        {
                            @foreach (var stat in incBudgeted)
                            {
                                bool isOver = stat.Percentage > 100;

                                <div class="dash-stat-row">
                                    <div class="dash-stat-meta">
                                        <span>@stat.Category <span style="color: var(--on-surface-muted); font-weight: 500; font-size: 1rem; margin-left: 4px;">(예산: ₩@stat.BudgetAmount.ToString("N0"))</span></span>
                                        <span style="font-variant-numeric: tabular-nums; color: @(isOver ? "#ba1a1a" : "inherit");">
                                            ₩@stat.Amount.ToString("N0") (@stat.Percentage%)
                                        </span>
                                    </div>
                                    <div class="dash-progress-bg">
                                        <div class="dash-progress-fill" style="width: @(Math.Min(stat.Percentage, 100))%; opacity: 0.85; @(isOver ? "background: #ba1a1a;" : "")"></div>
                                    </div>
                                </div>
                            }
                            @if (incOff.Any())
                            {
                                <div class="dash-offbudget">
                                    <p class="dash-offbudget-title">예산 외 수입</p>
                                    @foreach (var stat in incOff)
                                    {
                                        <div class="dash-stat-row">
                                            <div class="dash-stat-meta">
                                                <span>@stat.Category</span>
                                                <span style="font-variant-numeric: tabular-nums;">₩@stat.Amount.ToString("N0")</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color: var(--on-surface-muted); font-size: 1rem; text-align: center; padding: 1rem 0;">예산 및 수입 내역이 없습니다.</p>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── 지출결의서 신청현황 ── *@
        <div style="display: flex; flex-direction: column; gap: 1.5rem; padding-bottom: 2rem;">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem;">
                <div>
                    <h4 style="font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; color: var(--on-surface); margin-bottom: 0.25rem;">지출결의서 신청현황</h4>
                    <p style="font-size: 1rem; color: var(--on-surface-muted); font-weight: 400; line-height: 1.5; margin: 0;">모든 승인 대기 및 완료된 신청 건의 상태입니다.</p>
                </div>
                <div style="text-align: right;">
                    <p class="dash-label" style="margin-bottom: 0.25rem;">총 신청액 누계</p>
                    <p style="font-size: 1.5rem; font-weight: 900; font-variant-numeric: tabular-nums; color: var(--on-surface); margin: 0;">
                        ₩@_subsidyRequests.Sum(r => r.Amount).ToString("N0")
                    </p>
                </div>
            </div>

            @* No-Line 테이블 *@
            <div class="dash-list-wrap">
                <table style="width: 100%; min-width: 560px; text-align: left; border-collapse: collapse;">
                    <thead>
                        <tr class="dash-list-head">
                            <th>작성일</th>
                            <th>제목</th>
                            <th style="text-align: right;">신청금액</th>
                            <th style="text-align: center;">입금일</th>
                        </tr>
                    </thead>
                    <tbody class="dash-list-body">
                        @if (_subsidyRequests.Any())
                        {
                            @foreach (var req in _subsidyRequests)
                            {
                                <tr>
                                    <td style="font-variant-numeric: tabular-nums; font-weight: 500; opacity: 0.75; white-space: nowrap;">
                                        @req.RequestDate.ToShortDateString()
                                    </td>
                                    <td style="font-weight: 700; color: var(--on-surface);">
                                        @req.Title
                                    </td>
                                    <td style="text-align: right; font-weight: 900; font-variant-numeric: tabular-nums; color: var(--on-surface); white-space: nowrap;">
                                        ₩@req.Amount.ToString("N0")
                                    </td>
                                    <td style="text-align: center; white-space: nowrap;">
                                        @if (req.DepositDate.HasValue)
                                        {
                                            <span class="dash-status-done">@req.DepositDate.Value.ToString("yyyy.MM.dd")</span>
                                        }
                                        else
                                        {
                                            <span class="dash-status-waiting">입금대기</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 3rem; color: var(--on-surface-muted); font-size: 1rem;">
                                    신청 내역이 없습니다.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
}

@code {
