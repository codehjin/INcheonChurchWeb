@page "/"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Data
@using INcheonChurchWeb.Services
@using Microsoft.EntityFrameworkCore
@inject AccountingService Accounting
@inject IDbContextFactory<AppDbContext> DbContextFactory
@rendermode InteractiveServer

<PageTitle>인천중앙교회 재정 시스템</PageTitle>

<style>
    /* ── Tactile Ledger Design Tokens ── */
    .dash-hero-card {
        font-size: 1rem ;
        font-weight: 700 ;
        background-color: var(--surface-lowest);
        border-radius: 0.75rem;
        box-shadow: 0 4px 20px rgba(48, 49, 41, 0.04);
        border: none;
        padding: 2rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 200px;
    }

    .dash-detail-card {
        font-size: 1rem ;
        background-color: var(--surface-lowest);
        border-radius: 0.75rem;
        box-shadow: 0 4px 20px rgba(48, 49, 41, 0.04);
        border: none;
        padding: 2rem 2.5rem;
    }

    .dash-label {
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--primary-gold);
        opacity: 0.85;
        margin-bottom: 0.5rem;
    }

    .dash-hero-amount {
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.02em;
        color: var(--on-surface);
        line-height: 1.1;
    }

    .dash-badge-pct {
        background-color: var(--surface-low);
        border-radius: 9999px;
        padding: 0.25rem 1rem;
        font-size: 1rem;
        font-weight: 700;
        color: var(--primary-gold);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    .dash-progress-bg {
        background-color: var(--surface-low);
        height: 0.5rem;
        border-radius: 9999px;
        overflow: hidden;
    }

    .dash-progress-fill {
        background: var(--gold-gradient);
        height: 100%;
        border-radius: 9999px;
        transition: width 0.5s ease-out;
    }

    .dash-meta-label {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--on-surface-muted);
    }

    .dash-filter-chip {
        background-color: var(--surface-lowest);
        border-radius: 0.5rem;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(48, 49, 41, 0.06);
        border: none;
    }

    .dash-filter-chip-label {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--on-surface-muted);
    }

    .dash-filter-chip-value {
        font-size: 1rem;
        font-weight: 700;
        color: var(--on-surface);
    }

    .dash-stat-row {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .dash-stat-meta {
        display: flex;
        justify-content: space-between;
        font-size: 1rem;
        font-weight: 700;
        color: var(--on-surface);
    }

    .dash-list-wrap {
        overflow-x: auto;
        border-radius: 1rem;
        background-color: rgba(255,255,255,0.5);
    }

    .dash-list-head th {
        padding: 1rem 2rem;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--primary-gold);
        opacity: 0.85;
        background-color: var(--surface-lowest);
        box-shadow: 0 2px 8px rgba(48,49,41,0.04);
        border: none !important;
        white-space: nowrap;
    }

    .dash-list-body tr {
        transition: background-color 0.15s ease-out;
    }

        .dash-list-body tr:hover {
            background-color: rgba(255,255,255,0.8);
        }

        .dash-list-body tr:nth-child(even) {
            background-color: rgba(255,255,255,0.35);
        }

    .dash-list-body td {
        padding: 1.25rem 2rem;
        font-size: 1rem;
        vertical-align: middle;
        border: none !important;
    }

    .dash-status-waiting {
        font-size: 1rem;
        font-weight: 600;
        color: var(--primary-gold);
        background-color: var(--surface-low);
        padding: 0.2rem 0.6rem;
        border-radius: 0.25rem;
    }

    .dash-status-done {
        font-size: 1rem;
        font-weight: 600;
        color: var(--on-surface-muted);
        font-variant-numeric: tabular-nums;
    }
</style>

@if (CurrentUser != null)
{
    <div style="padding: 2rem 1.5rem; max-width: 100%; margin-left: 0; padding-bottom: 5rem;">

        @* ── 필터 & 타이틀 ── *@
        <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2.5rem;">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.5rem;">
                <div>
                    <h3 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; letter-spacing: -0.02em; color: var(--on-surface); margin-bottom: 0.25rem; line-height: 1.2;">
                        @_currentYear 재정 현황 요약
                    </h3>
                    <p style="color: var(--on-surface-sub); font-size: 1.1rem; font-weight: 400; line-height: 1.5; opacity: 0.85; margin: 0;">
                        현재 회계 기간의 재정 성과 상세 내역입니다.
                    </p>
                </div>
                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
                    @* 연도 이동 칩 *@
                    <div class="dash-filter-chip">
                        <button style="background: none; border: none; color: var(--on-surface-sub); font-weight: 700; padding: 0; cursor: pointer;" @onclick="() => ChangeYear(-1)">◀</button>
                        <span class="dash-filter-chip-label">연도</span>
                        <span class="dash-filter-chip-value" style="font-variant-numeric: tabular-nums;">@_currentYear</span>
                        <button style="background: none; border: none; color: var(--on-surface-sub); font-weight: 700; padding: 0; cursor: pointer;" @onclick="() => ChangeYear(1)">▶</button>
                    </div>
                    @* 부서 선택 칩 (관리자만) *@
                    @if (CurrentUser?.CanViewAll == true)
                    {
                        <div class="dash-filter-chip">
                            <span class="dash-filter-chip-label">부서</span>
                            <select style="background: none; border: none; font-size: 1.2rem; font-weight: 700; color: var(--on-surface); cursor: pointer; outline: none; padding: 0;" @onchange="OnDeptChanged" value="@_dashboardDeptId">
                                <option value="0">전체 부서</option>
                                @foreach (var dept in _departments)
                                {
                                    @if (dept.Name != "관리자" && dept.Name != "교회학교 운영팀" && dept.Name != "감사위원회")
                                    {
                                        <option value="@dept.Id">@dept.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Hero Metrics (지출 / 수입) ── *@
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
            @* 지출 실적 카드 *@
            <article class="dash-hero-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <p class="dash-label">지출 실적</p>
                        <h4 class="dash-hero-amount">₩@_totalExpense.ToString("N0")</h4>
                    </div>
                    <span class="dash-badge-pct">예산 대비 @_progressPercentage.ToString("0")%</span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span class="dash-meta-label">진행률</span>
                        <span class="dash-meta-label" style="font-variant-numeric: tabular-nums;">
                            한도: ₩@_totalBudget.ToString("N0") &nbsp;|&nbsp; 잔여: ₩@RemainingBudget.ToString("N0")
                        </span>
                    </div>
                    <div class="dash-progress-bg">
                        <div class="dash-progress-fill" style="width: @(Math.Min(_progressPercentage, 100).ToString("0.0"))%;"></div>
                    </div>
                </div>
            </article>

            @* 수입 내역 카드 *@
            <article class="dash-hero-card" style="background-color: var(--surface-low);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <p class="dash-label">수입 내역</p>
                        <h4 class="dash-hero-amount">₩@_totalIncome.ToString("N0")</h4>
                    </div>
                    <span class="dash-badge-pct">보조금 신청 @_incomeRate%</span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span class="dash-meta-label">신청액 / 예산</span>
                        <span class="dash-meta-label" style="font-variant-numeric: tabular-nums;">₩@_subsidyRequested.ToString("N0") / ₩@_subsidyBudget.ToString("N0")</span>
                    </div>
                    <div class="dash-progress-bg">
                        <div class="dash-progress-fill" style="width: @(Math.Min(_incomeRate, 100))%;"></div>
                    </div>
                </div>
            </article>
        </div>

        @* ── 항목별 상세 (지출 / 수입) ── *@
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">

            @* 지출 항목별 상세 *@
            <div class="dash-detail-card">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
                    <h5 style="font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; color: var(--on-surface); margin: 0;">지출 예산 집행률</h5>
                </div>
                <div style="display: flex; flex-direction: column; gap: 1.5rem; max-height: 400px; overflow-y: auto; padding-right: 0.5rem;">
                    @if (_expenseStats.Any())
                    {
                        @foreach (var stat in _expenseStats)
                        {
                            bool isOver = stat.Percentage > 100 || (stat.BudgetAmount == 0 && stat.Amount > 0);
                            string displayPct = stat.BudgetAmount > 0 ? $"{stat.Percentage}%" : "예산초과";

                            <div class="dash-stat-row">
                                <div class="dash-stat-meta">
                                    <span>@stat.Category <span style="color: var(--on-surface-muted); font-weight: 500; font-size: 1rem; margin-left: 4px;">(예산: ₩@stat.BudgetAmount.ToString("N0"))</span></span>
                                    <span style="font-variant-numeric: tabular-nums; color: @(isOver ? "#ba1a1a" : "inherit");">
                                        ₩@stat.Amount.ToString("N0") (@displayPct)
                                    </span>
                                </div>
                                <div class="dash-progress-bg">
                                    <div class="dash-progress-fill" style="width: @(Math.Min(stat.Percentage, 100))%; opacity: 0.85; @(isOver ? "background: #ba1a1a;" : "")"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: var(--on-surface-muted); font-size: 1rem; text-align: center; padding: 1rem 0;">예산 및 집행 내역이 없습니다.</p>
                    }
                </div>
            </div>

            @* 수입 항목별 상세 *@
            <div class="dash-detail-card">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
                    <h5 style="font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; color: var(--on-surface); margin: 0;">수입 예산 달성률</h5>
                </div>
                <div style="display: flex; flex-direction: column; gap: 1.5rem; max-height: 400px; overflow-y: auto; padding-right: 0.5rem;">
                    @if (_incomeStats.Any())
                    {
                        @foreach (var stat in _incomeStats)
                        {
                            bool isOver = stat.Percentage > 100 || (stat.BudgetAmount == 0 && stat.Amount > 0);
                            string displayPct = stat.BudgetAmount > 0 ? $"{stat.Percentage}%" : "예산초과";

                            <div class="dash-stat-row">
                                <div class="dash-stat-meta">
                                    <span>@stat.Category <span style="color: var(--on-surface-muted); font-weight: 500; font-size: 1rem; margin-left: 4px;">(예산: ₩@stat.BudgetAmount.ToString("N0"))</span></span>
                                    <span style="font-variant-numeric: tabular-nums; color: @(isOver ? "#ba1a1a" : "inherit");">
                                        ₩@stat.Amount.ToString("N0") (@displayPct)
                                    </span>
                                </div>
                                <div class="dash-progress-bg">
                                    <div class="dash-progress-fill" style="width: @(Math.Min(stat.Percentage, 100))%; opacity: 0.85; @(isOver ? "background: #ba1a1a;" : "")"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: var(--on-surface-muted); font-size: 1rem; text-align: center; padding: 1rem 0;">예산 및 수입 내역이 없습니다.</p>
                    }
                </div>
            </div>
        </div>

        @* ── 지출결의서 신청현황 ── *@
        <div style="display: flex; flex-direction: column; gap: 1.5rem; padding-bottom: 2rem;">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem;">
                <div>
                    <h4 style="font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; color: var(--on-surface); margin-bottom: 0.25rem;">지출결의서 신청현황</h4>
                    <p style="font-size: 1rem; color: var(--on-surface-muted); font-weight: 400; line-height: 1.5; margin: 0;">모든 승인 대기 및 완료된 신청 건의 상태입니다.</p>
                </div>
                <div style="text-align: right;">
                    <p class="dash-label" style="margin-bottom: 0.25rem;">총 신청액 누계</p>
                    <p style="font-size: 1.5rem; font-weight: 900; font-variant-numeric: tabular-nums; color: var(--on-surface); margin: 0;">
                        ₩@_subsidyRequests.Sum(r => r.Amount).ToString("N0")
                    </p>
                </div>
            </div>

            @* No-Line 테이블 *@
            <div class="dash-list-wrap">
                <table style="width: 100%; min-width: 560px; text-align: left; border-collapse: collapse;">
                    <thead>
                        <tr class="dash-list-head">
                            <th>작성일</th>
                            <th>제목</th>
                            <th style="text-align: right;">신청금액</th>
                            <th style="text-align: center;">입금일</th>
                        </tr>
                    </thead>
                    <tbody class="dash-list-body">
                        @if (_subsidyRequests.Any())
                        {
                            @foreach (var req in _subsidyRequests)
                            {
                                <tr>
                                    <td style="font-variant-numeric: tabular-nums; font-weight: 500; opacity: 0.75; white-space: nowrap;">
                                        @req.RequestDate.ToShortDateString()
                                    </td>
                                    <td style="font-weight: 700; color: var(--on-surface);">
                                        @req.Title
                                    </td>
                                    <td style="text-align: right; font-weight: 900; font-variant-numeric: tabular-nums; color: var(--on-surface); white-space: nowrap;">
                                        ₩@req.Amount.ToString("N0")
                                    </td>
                                    <td style="text-align: center; white-space: nowrap;">
                                        @if (req.DepositDate.HasValue)
                                        {
                                            <span class="dash-status-done">@req.DepositDate.Value.ToString("yyyy.MM.dd")</span>
                                        }
                                        else
                                        {
                                            <span class="dash-status-waiting">입금대기</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 3rem; color: var(--on-surface-muted); font-size: 1rem;">
                                    신청 내역이 없습니다.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
}

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private int _currentYear = DateTime.Now.Year;
    private int _dashboardDeptId = 0;
    private List<Department> _departments = new();

    private decimal _totalBudget = 0;
    private decimal _totalExpense = 0;
    private decimal RemainingBudget => _totalBudget - _totalExpense;
    private double _progressPercentage = 0;

    private int _incomeRate = 0;
    private decimal _subsidyBudget = 0;
    private decimal _subsidyRequested = 0;

    public class CategoryStat
    {
        public string Category { get; set; } = "";
        public decimal Amount { get; set; }
        // 🚀 추가: 예산액을 담을 변수
        public decimal BudgetAmount { get; set; }
        public int Percentage { get; set; }
    }

    private decimal _totalIncome = 0;
    private List<CategoryStat> _incomeStats = new();
    private List<CategoryStat> _expenseStats = new();

    public class SubsidyRequestItem
    {
        public DateTime RequestDate { get; set; }
        public string Title { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime? DepositDate { get; set; }
    }
    private List<SubsidyRequestItem> _subsidyRequests = new();

    protected override async Task OnInitializedAsync()
    {
        _departments = await Accounting.GetDepartmentsAsync();

        if (CurrentUser != null && CurrentUser.Department != null)
        {
            if (CurrentUser.Role == "Admin" || CurrentUser.Role == "Auditor")
            {
                _dashboardDeptId = 0;
            }
            else
            {
                _dashboardDeptId = CurrentUser.DepartmentId;
            }

            try
            {
                using var context = DbContextFactory.CreateDbContext();
                var latestBudgetYear = await context.BudgetPlans
                    .Where(b => _dashboardDeptId == 0 || b.DepartmentId == _dashboardDeptId)
                    .OrderByDescending(b => b.Year)
                    .Select(b => b.Year)
                    .FirstOrDefaultAsync();

                if (latestBudgetYear > 0)
                {
                    _currentYear = latestBudgetYear;
                }
            }
            catch { /* ignore */ }

            await LoadDashboardData();
        }
    }

    private async Task ChangeYear(int offset)
    {
        _currentYear += offset;
        await LoadDashboardData();
    }

    private async Task OnDeptChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int deptId))
        {
            _dashboardDeptId = deptId;
            await LoadDashboardData();
        }
    }

    private bool IsExpenseType(string t) => string.Equals(t, "Expense", StringComparison.OrdinalIgnoreCase) || string.Equals(t, "지출", StringComparison.OrdinalIgnoreCase);
    private bool IsIncomeType(string t) => string.Equals(t, "Income", StringComparison.OrdinalIgnoreCase) || string.Equals(t, "수입", StringComparison.OrdinalIgnoreCase);

    private async Task LoadDashboardData()
    {
        StateHasChanged();
        try
        {
            using var context = DbContextFactory.CreateDbContext();
            var budgetQuery = context.BudgetPlans.AsNoTracking().Where(b => b.Year == _currentYear);
            if (_dashboardDeptId != 0) budgetQuery = budgetQuery.Where(b => b.DepartmentId == _dashboardDeptId);
            var budgetList = await budgetQuery.ToListAsync();

            _totalBudget = budgetList.Where(b => IsExpenseType(b.Type)).Sum(b => b.Amount);
            _subsidyBudget = budgetList.Where(b => IsIncomeType(b.Type) && b.Category == "교회보조금").Sum(b => b.Amount);

            int queryDeptId = _dashboardDeptId == 0 ? (CurrentUser?.DepartmentId ?? 0) : _dashboardDeptId;

            var q1 = await Accounting.GetQuarterDateRangeAsync(queryDeptId, _currentYear, 1);
            var q4 = await Accounting.GetQuarterDateRangeAsync(queryDeptId, _currentYear, 4);

            DateTime dashboardStartDate = q1.Start.Date;
            DateTime dashboardEndDate = q4.End.Date.AddDays(1);

            var transQuery = context.Transactions.AsNoTracking()
                .Where(t => t.FiscalYear == _currentYear && t.Date >= dashboardStartDate && t.Date < dashboardEndDate);
            if (_dashboardDeptId != 0) transQuery = transQuery.Where(t => t.DepartmentId == _dashboardDeptId);

            var transactions = await transQuery.ToListAsync();

            _totalExpense = transactions.Where(t => IsExpenseType(t.Type)).Sum(t => t.Expense);
            _totalIncome = transactions.Where(t => IsIncomeType(t.Type) && t.Category != "은행이자" && t.Category != "환급금").Sum(t => t.Income);

            if (_totalBudget > 0)
            {
                _progressPercentage = (double)(_totalExpense / _totalBudget) * 100;
                if (_progressPercentage > 100) _progressPercentage = 100;
            }
            else { _progressPercentage = 0; }

            // _incomeRate(보조금 수령 비율)는 reports 로드 후 신청액 기준으로 계산 (아래 참조)

            // 🚀 수입/지출: 예산 등록 항목 + 실제 발생 항목을 합쳐 항목별 통계 계산 (은행이자·환급금은 수입에서 제외)
            _incomeStats = BuildCategoryStats(budgetList, transactions, IsIncomeType, t => t.Income, "은행이자", "환급금");
            _expenseStats = BuildCategoryStats(budgetList, transactions, IsExpenseType, t => t.Expense);

            var reportsQuery = context.ExpenseReports.AsNoTracking().Where(r => r.FiscalYear == _currentYear);
            if (_dashboardDeptId != 0) reportsQuery = reportsQuery.Where(r => r.DepartmentId == _dashboardDeptId);
            var reports = await reportsQuery.OrderByDescending(r => r.Date).ToListAsync();

            // 보조금 수령 비율 = 지출결의서 신청액 누계 / 교회보조금 수입예산
            _subsidyRequested = reports.Sum(r => r.TotalAmount);
            _incomeRate = _subsidyBudget > 0 ? (int)Math.Round((_subsidyRequested / _subsidyBudget) * 100) : 0;

            var allIncomeQuery = context.Transactions.AsNoTracking().Where(t => t.Type == "수입" || t.Type == "Income");
            if (_dashboardDeptId != 0) allIncomeQuery = allIncomeQuery.Where(t => t.DepartmentId == _dashboardDeptId);
            var incomeListForMatching = await allIncomeQuery.OrderBy(t => t.Date).ToListAsync();

            _subsidyRequests.Clear();
            foreach (var rep in reports)
            {
                var matchedIncome = incomeListForMatching.FirstOrDefault(t =>
                    t.Date.Date >= rep.Date.Date &&
                    t.Income == rep.TotalAmount &&
                    (_dashboardDeptId == 0 || t.DepartmentId == rep.DepartmentId));

                string deptPrefix = "";
                if (_dashboardDeptId == 0)
                {
                    var repDept = _departments.FirstOrDefault(d => d.Id == rep.DepartmentId);
                    if (repDept != null) deptPrefix = $"[{repDept.Name}] ";
                }

                _subsidyRequests.Add(new SubsidyRequestItem
                {
                    RequestDate = rep.Date,
                    Title = deptPrefix + rep.Title,
                    Amount = rep.TotalAmount,
                    DepositDate = matchedIncome?.Date
                });

                if (matchedIncome != null) incomeListForMatching.Remove(matchedIncome);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"대시보드 로드 오류: {ex.Message}");
        }
    }

    // 예산(budgetList)과 실거래(transactions)를 합쳐 항목별 집행/달성 통계를 생성하는 공용 헬퍼
    // isType: 수입/지출 구분 함수, amount: 거래에서 집계할 금액(수입 또는 지출), excludeCategories: 통계에서 제외할 항목
    private List<CategoryStat> BuildCategoryStats(
        List<BudgetPlan> budgetList,
        List<LedgerEntry> transactions,
        Func<string, bool> isType,
        Func<LedgerEntry, decimal> amount,
        params string[] excludeCategories)
    {
        var categories = budgetList.Where(b => isType(b.Type)).Select(b => b.Category)
            .Union(transactions.Where(t => isType(t.Type) && amount(t) > 0).Select(t => t.Category))
            .Where(c => !string.IsNullOrWhiteSpace(c) && !excludeCategories.Contains(c))
            .Distinct();

        return categories.Select(cat =>
        {
            decimal budgetAmount = budgetList.Where(b => isType(b.Type) && b.Category == cat).Sum(b => b.Amount);
            decimal actualAmount = transactions.Where(t => isType(t.Type) && t.Category == cat).Sum(amount);
            return new CategoryStat
            {
                Category = cat,
                Amount = actualAmount,
                BudgetAmount = budgetAmount,
                Percentage = budgetAmount > 0 ? (int)Math.Round((actualAmount / budgetAmount) * 100) : (actualAmount > 0 ? 100 : 0)
            };
        }).OrderByDescending(x => x.Percentage).ThenByDescending(x => x.Amount).ToList();
    }
}