    private decimal _totalIncome = 0;
    private List<AccountingService.CategoryStat> _incomeStats = new();
    private List<AccountingService.CategoryStat> _expenseStats = new();

    // ── 상세 카드 표시 상태(화면 내에서만 유지 — localStorage 미사용) ──
    // 지출·수입 상세 카드는 하나의 토글로 함께 접는다(한쪽만 접히면 빈 배경이 남는다).
    private bool _statsCollapsed = false;
    private string _expenseSort = "rate";
    private string _incomeSort = "rate";

    // 보조금 잔액(예산 − 신청액). 표시 전용이라 원본 수치는 그대로 둔다.
    private decimal SubsidyRemaining => _subsidyBudget - _subsidyRequested;

    // 예산이 잡힌 항목만 골라 선택한 기준으로 정렬. 원본 리스트는 변형하지 않는다.
    private IEnumerable<AccountingService.CategoryStat> Budgeted(List<AccountingService.CategoryStat> stats, string sort)
    {
        var q = stats.Where(s => s.BudgetAmount > 0);
        return sort switch
        {
            "amount" => q.OrderByDescending(s => s.Amount),
            "name" => q.OrderBy(s => s.Category, StringComparer.CurrentCulture),
            _ => q.OrderByDescending(s => s.Percentage).ThenByDescending(s => s.Amount),
        };
    }

    // 예산 0인데 실적만 있는 항목 — 금액순 고정. 예산·실적 모두 0이면 여기서도 빠진다.
    private IEnumerable<AccountingService.CategoryStat> OffBudget(List<AccountingService.CategoryStat> stats) =>
        stats.Where(s => s.BudgetAmount == 0 && s.Amount > 0).OrderByDescending(s => s.Amount);

    private List<AccountingService.SubsidyRequestItem> _subsidyRequests = new();

    protected override async Task OnInitializedAsync()
    {
        _departments = await Accounting.GetDepartmentsAsync();

        if (CurrentUser != null && CurrentUser.Department != null)
        {
            if (CurrentUser.Role == "Admin" || CurrentUser.Role == "Auditor")
            {
                _dashboardDeptId = 0;
            }
            else
            {
                _dashboardDeptId = CurrentUser.DepartmentId;
            }

            try
            {
                using var context = DbContextFactory.CreateDbContext();
                var latestBudgetYear = await context.BudgetPlans
                    .Where(b => _dashboardDeptId == 0 || b.DepartmentId == _dashboardDeptId)
                    .OrderByDescending(b => b.Year)
                    .Select(b => b.Year)
                    .FirstOrDefaultAsync();

                if (latestBudgetYear > 0)
                {
                    _currentYear = latestBudgetYear;
                }
            }
            catch { /* ignore */ }

            await LoadDashboardData();
        }
    }

    private async Task ChangeYear(int offset)
    {
        _currentYear += offset;
        await LoadDashboardData();
    }

    private async Task OnDeptChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int deptId))
        {
            _dashboardDeptId = deptId;
            await LoadDashboardData();
        }
    }

    private async Task LoadDashboardData()
    {
        StateHasChanged();
        try
        {
            // 🚀 예산 합계·항목별 집행률·보조금 신청현황 집계는 AccountingService 한 곳에서 한다.
            //    (예전에는 같은 계산이 이 파일에도 복제되어 있었고, 예산 0인 항목의 집행률이
            //     서비스와 한 줄 달랐다 — 웹_상세_구조문서.md §6.3)
            var names = _departments.ToDictionary(d => d.Id, d => d.Name);
            var view = await Accounting.GetDashboardAsync(
                _dashboardDeptId, CurrentUser?.DepartmentId ?? 0, _currentYear, names);

            _totalBudget = view.TotalBudget;
            _totalExpense = view.TotalExpense;
            _totalIncome = view.TotalIncome;
            _subsidyBudget = view.SubsidyBudget;
            _subsidyRequested = view.SubsidyRequested;

            // 초과 집행을 100%로 깎지 않는다. 막대만 화면에서 100%로 자른다.
            _progressPercentage = view.ExpenseRate;
            _incomeRate = view.IncomeRate;

            _expenseStats = view.ExpenseStats;
            _incomeStats = view.IncomeStats;
            _subsidyRequests = view.SubsidyRequests;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"대시보드 로드 오류: {ex.Message}");
        }
    }
