@page "/receipt-multi-upload"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Data
@using Microsoft.AspNetCore.Hosting
@using System.IO
@inject AppDbContext DbContext
@inject IWebHostEnvironment Env
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject INcheonChurchWeb.Services.OcrService OcrService
@rendermode InteractiveServer

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary"><i class="bi bi-images me-2"></i>PC 전용 다중 영수증 업로드</h3>
        <button class="btn btn-outline-secondary btn-sm fw-bold" @onclick='() => Nav.NavigateTo("/")'>대시보드로 돌아가기</button>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="alert alert-info border-0 bg-info bg-opacity-10">
                <i class="bi bi-info-circle-fill me-2"></i><strong>작업 효율 팁:</strong> 최대 20장의 영수증 사진을 한 번에 선택하세요. AI가 자동으로 날짜와 금액을 판독하여 장부에 임시 저장합니다. (비어있거나 잘못 인식된 항목은 월별장부에서 영수증을 매칭할 때 수정할 수 있습니다.)
            </div>

            <div class="mb-4">
                <InputFile multiple OnChange="HandleFilesSelected" class="form-control form-control-lg border-primary shadow-sm" accept="image/*" />
                <div class="form-text mt-2 fw-bold text-danger">※ 한 번에 최대 20장까지만 업로드 가능합니다.</div>
            </div>

            @if (fileStatuses.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-hover align-middle border">
                        <thead class="table-light">
                            <tr>
                                <th>파일명</th>
                                <th>AI 판독 상태</th>
                                <th>인식된 날짜</th>
                                <th>인식된 금액</th>
                                <th>인식된 사용처</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var file in fileStatuses)
                            {
                                <tr>
                                    <td class="text-truncate" style="max-width: 150px;" title="@file.FileName">@file.FileName</td>
                                    <td>
                                        @if (file.Status == FileStatus.Pending)
                                        {
                                            <span class="badge bg-secondary">대기중</span>
                                        }
                                        else if (file.Status == FileStatus.Processing)
                                        {

                                            <span class="badge bg-warning text-dark"><span class="spinner-border spinner-border-sm me-1"></span>분석중</span>
                                        }
                                        else if (file.Status == FileStatus.Success)
                                        {

                                            <span class="badge bg-success">성공</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-danger">실패/수동필요</span>
                                        }
                                    </td>
                                    <td>@(file.ParsedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>@(file.ParsedAmount > 0 ? file.ParsedAmount.ToString("#,0") + "원" : "-")</td>
                                    <td>@(string.IsNullOrEmpty(file.ParsedDescription) ? "-" : file.ParsedDescription)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button class="btn btn-primary btn-lg w-100 fw-bold shadow-sm" @onclick="ProcessAllFiles" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                
                        <span>@($"{processedCount} / {fileStatuses.Count} 처리중...")</span>
                    }
                    else
                    {
                        <i class="bi bi-magic me-2"></i>
                
                        <span>전체 AI 분석 및 서버 저장 시작</span>
                    }
                </button>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private enum FileStatus { Pending, Processing, Success, Failed }

    private class FileUploadModel
    {
        public IBrowserFile File { get; set; } = default!;
        public string FileName { get; set; } = "";
        public FileStatus Status { get; set; } = FileStatus.Pending;
        public DateTime? ParsedDate { get; set; }
        public decimal ParsedAmount { get; set; }
        public string ParsedDescription { get; set; } = "";
    }

    private List<FileUploadModel> fileStatuses = new();
    private bool isProcessing = false;
    private int processedCount = 0;
    private const int MaxAllowedFiles = 20;
    private const long MaxFileSize = 10 * 1024 * 1024; // 10MB

    private void HandleFilesSelected(InputFileChangeEventArgs e)
    {
        fileStatuses.Clear();
        var files = e.GetMultipleFiles(MaxAllowedFiles);

        foreach (var file in files)
        {
            fileStatuses.Add(new FileUploadModel
            {
                File = file,
                FileName = file.Name
            });
        }
    }

    private async Task ProcessAllFiles()
    {
        if (CurrentUser == null) return;
        isProcessing = true;
        processedCount = 0;

        var uploadsFolder = Path.Combine(Env.WebRootPath, "uploads", "receipts");
        if (!Directory.Exists(uploadsFolder)) Directory.CreateDirectory(uploadsFolder);

        foreach (var fileModel in fileStatuses)
        {
            fileModel.Status = FileStatus.Processing;
            StateHasChanged();

            try
            {
                // 1. 이미지 읽기
                using var memoryStream = new MemoryStream();
                await fileModel.File.OpenReadStream(maxAllowedSize: MaxFileSize).CopyToAsync(memoryStream);
                var imageBytes = memoryStream.ToArray();

                // 2. AI 판독 실행
                var ocrResult = await OcrService.ProcessReceiptAsync(imageBytes);

                if (ocrResult.IsSuccess)
                {
                    fileModel.ParsedDate = ocrResult.Date;
                    fileModel.ParsedAmount = ocrResult.Amount ?? 0;
                    fileModel.ParsedDescription = ocrResult.Description;
                    fileModel.Status = FileStatus.Success;
                }
                else
                {
                    fileModel.Status = FileStatus.Failed;
                }

                // 3. 파일 물리적 저장
                string ext = Path.GetExtension(fileModel.FileName);
                if (string.IsNullOrEmpty(ext)) ext = ".jpg";
                string newFileName = $"receipt_{CurrentUser.DepartmentId}_{DateTime.Now:yyyyMMddHHmmssfff}{ext}";
                string filePath = Path.Combine(uploadsFolder, newFileName);

                await File.WriteAllBytesAsync(filePath, imageBytes);

                // 4. DB에 임시 저장 (자동 매칭 대기 상태)
                var newReceipt = new UploadedReceipt
                {
                    DepartmentId = CurrentUser.DepartmentId,
                    ImagePath = $"/uploads/receipts/{newFileName}",
                    // AI가 못 읽었으면 오늘 날짜와 0원으로 일단 올립니다. (나중에 장부 화면에서 수동 매치 가능)
                    ReceiptDate = fileModel.ParsedDate ?? DateTime.Now,
                    Amount = fileModel.ParsedAmount,
                    Description = fileModel.ParsedDescription ?? ""
                };

                DbContext.UploadedReceipts.Add(newReceipt);
                await DbContext.SaveChangesAsync();
            }
            catch (Exception)
            {
                fileModel.Status = FileStatus.Failed;
            }

            processedCount++;
            StateHasChanged();
        }

        isProcessing = false;
        await JSRuntime.InvokeVoidAsync("alert", $"{processedCount}장의 영수증 처리가 완료되었습니다.\n월별 장부 화면에서 '자동 매치' 또는 '수동 매치'를 진행해 주세요!");
    }
}