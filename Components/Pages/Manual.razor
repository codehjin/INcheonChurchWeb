@page "/manual"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AccountingService AccService
@inject IDbContextFactory<AppDbContext> DbFactory
@rendermode InteractiveServer

<style>
    .manual-step-card {
        background-color: var(--surface-lowest);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-ambient);
        border: none;
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .manual-step-header {
        padding: 1.25rem 1.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .manual-step-body {
        padding: 0 1.75rem 1.75rem 1.75rem;
    }

    .manual-flow {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.625rem;
        background-color: var(--surface-low);
        border-radius: var(--radius-base);
        padding: 1rem 1.25rem;
    }

    .manual-flow-chip {
        padding: 0.4rem 0.875rem;
        background-color: var(--surface-lowest);
        border-radius: var(--radius-base);
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--on-surface);
        box-shadow: 0 1px 4px rgba(48, 49, 41, 0.06);
    }

    .manual-flow-chip.gold {
        background: var(--gold-gradient);
        color: #ffffff;
    }

    .manual-flow-arrow {
        color: var(--on-surface-muted);
        font-size: 0.875rem;
    }

    .manual-tab-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.3rem 0.75rem;
        background-color: var(--surface-low);
        border-radius: var(--radius-sm);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--primary-gold);
        cursor: pointer;
        transition: background-color 0.15s;
    }

    .manual-tab-chip:hover { background-color: var(--surface-high); }

    .manual-note {
        font-size: 0.8125rem;
        color: var(--on-surface-sub);
        line-height: 1.65;
    }

    .manual-note li { margin-bottom: 0.375rem; }

    .step-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        font-size: 0.875rem;
        font-weight: 800;
        flex-shrink: 0;
    }
</style>

<div style="background-color: var(--surface); min-height: 100vh; padding-bottom: 3rem;">
    <div class="container-fluid" style="max-width: 1200px; margin-left: 0; padding-top: 2rem;">

        @* 헤더 *@
        <div class="mb-5">
            <h2 class="font-heading fw-bold mb-2" style="color: var(--on-surface); letter-spacing: -0.02em;">
                <i class="bi bi-journal-bookmark-fill me-2" style="color: var(--primary-gold);"></i>사용 가이드
            </h2>
            <p style="color: var(--on-surface-sub); font-size: 0.9375rem;">
                아래 순서대로 진행하면 1년 재정 관리를 빠짐없이 처리할 수 있습니다.
                각 단계의 <strong style="color: var(--primary-gold);">[바로 가기]</strong> 버튼을 눌러 해당 화면으로 이동하세요.
            </p>
        </div>

        @* ───────────────────────────────────────────────
           1단계: 연초 세팅
        ─────────────────────────────────────────────── *@
        <div class="manual-step-card">
            <div class="manual-step-header" style="background-color: var(--surface-low);">
                <div class="d-flex align-items-center gap-3">
                    <span class="step-badge" style="background: var(--gold-gradient); color: #fff;">1</span>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--on-surface);">연초 세팅 — 예산·임원·계좌 등록</h5>
                        <span style="color: var(--on-surface-sub); font-size: 0.8125rem;">1년 농사의 시작. 가장 먼저 해야 할 필수 작업입니다.</span>
                    </div>
                </div>
                <button class="btn btn-sm fw-bold" style="background: var(--gold-gradient); color: #fff; border-radius: var(--radius-sm); padding: 0.375rem 1rem; border: none;" @onclick='() => Nav.NavigateTo("/settings")'>
                    환경설정 →
                </button>
            </div>
            <div class="manual-step-body pt-3">
                @* 🚀 초기 세팅 마법사 시작 버튼 *@
                <button class="btn w-100 fw-bold mb-3 py-3" style="background: var(--gold-gradient); color: #fff; border: none; border-radius: var(--radius-md); font-size: 1.05rem; box-shadow: var(--shadow-ambient);" @onclick="OpenWizard">
                    <i class="bi bi-rocket-takeoff-fill me-2"></i>🚀 1분 만에 끝내는 초기 세팅 마법사 시작
                </button>

                <div class="manual-flow mb-3">
                    <span class="manual-flow-chip"><i class="bi bi-download me-1" style="color: var(--primary-gold);"></i>수입 예산</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-upload me-1" style="color: #ba1a1a;"></i>지출 예산</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-person-vcard me-1"></i>부서 임원 정보</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-bank me-1"></i>계좌번호 입력</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-calendar-range me-1"></i>분기 날짜 설정</span>
                </div>
                <ul class="manual-note ps-3 mb-3">
                    <li><b>예산 설정:</b> 올해 수입·지출 항목과 금액을 등록합니다. [직전년도 예산 불러오기]로 빠르게 시작하거나, '데이터 및 엑셀 관리' 탭의 <b>환경설정 엑셀</b>로 일괄 백업·복원할 수 있습니다.</li>
                    <li><b>임원 정보:</b> 교역자·부장·총무·회계의 이름과 임기를 등록하면 지출결의서 결재란에 자동으로 반영됩니다.</li>
                    <li><b>계좌번호:</b> 부서 통장 정보를 입력해 두면 지출결의서 출력 시 자동 기입됩니다.</li>
                    <li><b>분기 날짜:</b> 교회 회계연도에 맞게 각 분기의 시작일·종료일을 설정합니다. [기본값 자동 적용]·[연속성 맞춤] 버튼으로 손쉽게 계산됩니다.</li>
                </ul>

                @* 📱 모바일 서브 탭(2-Depth) 안내 *@
                <div class="p-3 mb-3 rounded" style="background-color: var(--surface-low); border-left: 4px solid var(--primary-gold);">
                    <div class="fw-bold mb-1" style="color: var(--on-surface);"><i class="bi bi-phone me-1" style="color: var(--primary-gold);"></i>한 손에 쏙 — 서브 탭(2-Depth) 네비게이션</div>
                    <p class="mb-0" style="color: var(--on-surface-sub); font-size: 0.875rem;">
                        환경설정의 5개 메인 탭(부서 기본 정보 · 예산 및 회계 기준 · 자동분류 설정 · 데이터 및 엑셀 관리 · 계정 및 보안) 안에는 <b>알약 모양(Pill) 서브 탭</b>이 들어 있어, 긴 스크롤 없이 <b>터치 한 번으로 화면이 즉시 전환</b>됩니다.
                        예를 들어 <b>예산 및 회계 기준</b> 탭은 <b>[수입 예산] / [지출 예산] / [분기(회계) 설정]</b>으로 화면이 분할됩니다. 좁은 폴더블·휴대폰 화면에서는 서브 탭이 줄바꿈 없이 가로로 부드럽게 스크롤됩니다.
                    </p>
                </div>

                @* 🛡️ 최고관리자 전역 통제 안내 *@
                <div class="p-3 rounded" style="background: rgba(120,86,0,0.06); border: 1px solid rgba(120,86,0,0.25);">
                    <div class="fw-bold mb-2" style="color: #5a4000;"><i class="bi bi-shield-lock-fill me-1"></i>최고관리자(SystemAdmin) 전역 통제 기능</div>
                    <ul class="manual-note ps-3 mb-0">
                        <li><b>분기 일괄 적용:</b> 관리자가 회계 분기 일정을 저장하면 안전 경고를 확인한 뒤 <b>단 한 번의 클릭으로 교회 모든 부서 장부에 동일한 분기 일정이 일괄 적용</b>되고, 각 부서의 회계연도·분기가 자동으로 재계산됩니다.</li>
                        <li><b>관리부서 안전 배지:</b> 자동분류 탭에서 타 부서의 규칙을 원격 관리할 때, 화면 우측 상단에 <span class="badge" style="background-color: var(--primary-gold);">현재 관리 대상: ○○부</span> 골드 배지가 항상 표시되어 <b>엉뚱한 부서를 건드리는 실수를 원천 차단</b>합니다.</li>
                        <li><b>통합 엑셀 백업:</b> 관리자가 환경설정 엑셀을 내려받으면 시트 <b>A열에 '부서명'</b>이 자동으로 추가되어, <b>전 부서의 예산과 자동분류 규칙이 단 하나의 파일</b>로 통합 다운로드됩니다. 이 파일을 수정해 일괄 업로드하면 <b>A열 부서명을 기준으로 각 부서 데이터베이스에 정확히 분배되어 복원(Override)</b>됩니다.</li>
                        <li><b>보안 강제:</b> 일반 사용자가 엑셀의 부서명을 임의로 조작해 업로드하더라도, 보안 시스템이 이를 <b>무시하고 무조건 본인 부서 장부로만 강제 적용</b>하여 타 부서 데이터 침범을 막습니다.</li>
                    </ul>
                </div>
            </div>
        </div>

        @* ───────────────────────────────────────────────
           2단계: 보조금 신청 (지출결의서)
        ─────────────────────────────────────────────── *@
        <div class="manual-step-card">
            <div class="manual-step-header" style="background-color: var(--surface-low);">
                <div class="d-flex align-items-center gap-3">
                    <span class="step-badge" style="background-color: #174577; color: #fff;">2</span>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--on-surface);">보조금 신청 — 지출결의서 작성</h5>
                        <span style="color: var(--on-surface-sub); font-size: 0.8125rem;">예산을 사용하기 전, 분기·행사별로 먼저 결의서를 작성해 제출합니다.</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm fw-bold" style="background-color: var(--surface-high); color: var(--on-surface); border: none; border-radius: var(--radius-sm); padding: 0.375rem 0.875rem;" @onclick='() => Nav.NavigateTo("/")'>
                        대시보드 →
                    </button>
                    <button class="btn btn-sm fw-bold" style="background-color: #174577; color: #fff; border: none; border-radius: var(--radius-sm); padding: 0.375rem 0.875rem;" @onclick='() => Nav.NavigateTo("/expense-report-quarterly")'>
                        결의서 작성 →
                    </button>
                </div>
            </div>
            <div class="manual-step-body pt-3">
                <div class="manual-flow mb-3">
                    <span class="manual-flow-chip"><i class="bi bi-search me-1"></i>대시보드에서 잔액 확인</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-pencil-square me-1"></i>신규 결의서 작성·저장</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-printer me-1"></i>인쇄 후 결재·제출</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-check-circle-fill me-1"></i>통장 입금 확인</span>
                </div>
                <ul class="manual-note ps-3 mb-0">
                    <li><b>잔액 확인:</b> 대시보드(홈)의 '보조금 신청현황' 테이블에서 항목별 예산 잔액을 확인합니다.</li>
                    <li><b>결의서 작성:</b> [신규 작성] → [명세표 추가]로 행사별 상세 내역을 입력하고 저장·인쇄합니다.</li>
                    <li><b>입금 확인:</b> 통장에 입금되면 대시보드 또는 결의서 목록에서 입금일을 기록해 두세요.</li>
                </ul>
            </div>
        </div>

        @* ───────────────────────────────────────────────
           3단계: 수집 및 정리 (DataCollectionHub)
        ─────────────────────────────────────────────── *@
        <div class="manual-step-card">
            <div class="manual-step-header" style="background-color: var(--surface-low);">
                <div class="d-flex align-items-center gap-3">
                    <span class="step-badge" style="background: var(--gold-gradient); color: #fff;">3</span>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--on-surface);">수집 및 정리 — 영수증·은행 내역 등록</h5>
                        <span style="color: var(--on-surface-sub); font-size: 0.8125rem;">지출 후 영수증 촬영과 은행 내역 등록을 한 화면에서 처리합니다.</span>
                    </div>
                </div>
                <button class="btn btn-sm fw-bold" style="background: var(--gold-gradient); color: #fff; border-radius: var(--radius-sm); padding: 0.375rem 1rem; border: none;" @onclick='() => Nav.NavigateTo("/data-collection")'>
                    수집 및 정리 →
                </button>
            </div>
            <div class="manual-step-body pt-3">
                @* 탭 안내 *@
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="manual-tab-chip"><i class="bi bi-receipt me-1"></i>영수증(단건)</span>
                    <span class="manual-tab-chip"><i class="bi bi-images me-1"></i>영수증(일괄)</span>
                    <span class="manual-tab-chip"><i class="bi bi-file-earmark-spreadsheet me-1"></i>엑셀 장부</span>
                    <span class="manual-tab-chip"><i class="bi bi-link-45deg me-1"></i>영수증 매칭</span>
                </div>

                <div class="row g-3 mb-3">
                    @* 영수증 단건 *@
                    <div class="col-md-6">
                        <div class="p-3 rounded" style="background-color: var(--surface-low);">
                            <div class="fw-bold mb-2" style="color: var(--on-surface); font-size: 0.875rem;">
                                <i class="bi bi-camera-fill me-1" style="color: var(--primary-gold);"></i>영수증(단건) 탭
                            </div>
                            <div class="manual-flow-chip d-inline-block mb-2"><i class="bi bi-camera-fill me-1"></i>사진 선택</div>
                            <span class="manual-flow-arrow mx-1">→</span>
                            <span class="manual-flow-chip d-inline-block mb-2" style="background: rgba(120,86,0,0.1); color: var(--primary-gold);">AI 자동 판독</span>
                            <span class="manual-flow-arrow mx-1">→</span>
                            <span class="manual-flow-chip d-inline-block mb-2">확인 후 전송</span>
                            <ul class="manual-note ps-3 mb-0 mt-2">
                                <li>AI가 날짜·금액을 1초 안에 인식합니다. 맞는지 확인 후 전송하세요.</li>
                                <li>월 1,000건까지 무료. 초과 시 수동 입력으로 전환됩니다.</li>
                            </ul>
                        </div>
                    </div>
                    @* 영수증 일괄 *@
                    <div class="col-md-6">
                        <div class="p-3 rounded" style="background-color: var(--surface-low);">
                            <div class="fw-bold mb-2" style="color: var(--on-surface); font-size: 0.875rem;">
                                <i class="bi bi-images me-1" style="color: var(--primary-gold);"></i>영수증(일괄) 탭
                            </div>
                            <ul class="manual-note ps-3 mb-0">
                                <li>한 번에 최대 <b>20장</b>까지 선택해 AI로 일괄 분석합니다.</li>
                                <li>분석 결과는 서버에 임시 저장 후 <b>영수증 매칭</b> 탭에서 장부와 연결합니다.</li>
                            </ul>
                        </div>
                    </div>
                    @* 엑셀 장부 *@
                    <div class="col-md-6">
                        <div class="p-3 rounded" style="background-color: var(--surface-low);">
                            <div class="fw-bold mb-2" style="color: var(--on-surface); font-size: 0.875rem;">
                                <i class="bi bi-file-earmark-spreadsheet me-1" style="color: var(--primary-gold);"></i>엑셀 장부 탭
                            </div>
                            <p class="manual-note mb-1"><b>① 은행 거래내역 가져오기</b></p>
                            <div class="manual-flow mb-2">
                                <span class="manual-flow-chip"><i class="bi bi-file-earmark-excel me-1"></i>은행 엑셀 업로드</span>
                                <span class="manual-flow-arrow">→</span>
                                <span class="manual-flow-chip">퀵 분류 (바구니)</span>
                                <span class="manual-flow-arrow">→</span>
                                <span class="manual-flow-chip gold">장부에 저장</span>
                            </div>
                            <p class="manual-note mb-0"><b>② 월별 장부 엑셀 복원:</b> 월별 장부 화면에서 다운로드한 엑셀을 그대로 올리면 자동 분류 없이 즉시 적용됩니다.</p>
                        </div>
                    </div>
                    @* 영수증 매칭 *@
                    <div class="col-md-6">
                        <div class="p-3 rounded" style="background-color: var(--surface-low);">
                            <div class="fw-bold mb-2" style="color: var(--on-surface); font-size: 0.875rem;">
                                <i class="bi bi-link-45deg me-1" style="color: var(--primary-gold);"></i>영수증 매칭 탭
                            </div>
                            <div class="manual-flow mb-2">
                                <span class="manual-flow-chip">미매칭 영수증 선택</span>
                                <span class="manual-flow-arrow">→</span>
                                <span class="manual-flow-chip">장부 내역 선택</span>
                                <span class="manual-flow-arrow">→</span>
                                <span class="manual-flow-chip gold">수동 매치 or 자동 매치</span>
                            </div>
                            <ul class="manual-note ps-3 mb-0">
                                <li>날짜·금액이 일치하면 <b>자동 매치</b>가 한꺼번에 처리합니다.</li>
                                <li>일치하지 않으면 좌측(영수증)·우측(장부)을 각각 선택 후 <b>수동 매치</b>를 누릅니다.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ───────────────────────────────────────────────
           4단계: 월별 장부 조회 및 인쇄
        ─────────────────────────────────────────────── *@
        <div class="manual-step-card">
            <div class="manual-step-header" style="background-color: var(--surface-low);">
                <div class="d-flex align-items-center gap-3">
                    <span class="step-badge" style="background-color: var(--on-surface); color: var(--surface);">4</span>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--on-surface);">월별 장부 — 조회·수정·인쇄</h5>
                        <span style="color: var(--on-surface-sub); font-size: 0.8125rem;">등록된 내역을 검토하고 회계감사용 서류를 출력합니다.</span>
                    </div>
                </div>
                <button class="btn btn-sm fw-bold" style="background-color: var(--on-surface); color: var(--surface); border: none; border-radius: var(--radius-sm); padding: 0.375rem 1rem;" @onclick='() => Nav.NavigateTo("/monthly")'>
                    월별 장부 →
                </button>
            </div>
            <div class="manual-step-body pt-3">
                <div class="manual-flow mb-3">
                    <span class="manual-flow-chip"><i class="bi bi-calendar-check me-1"></i>연도·월 선택</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-pencil-square me-1"></i>내역 수정·추가·삭제</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-journal-text me-1"></i>장부 인쇄</span>
                    <span class="manual-flow-arrow">+</span>
                    <span class="manual-flow-chip"><i class="bi bi-images me-1"></i>영수증 인쇄</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip gold"><i class="bi bi-folder-check me-1"></i>감사 자료 보관</span>
                </div>
                <ul class="manual-note ps-3 mb-0">
                    <li><b>조회 필터:</b> 연도·월·분기·부서(관리자)별로 내역을 필터링합니다. 모바일에서는 좌·우 버튼으로 월을 이동합니다.</li>
                    <li><b>내역 수정:</b> [일괄 수정/삭제] 버튼으로 여러 건을 한꺼번에 항목 변경 또는 삭제할 수 있습니다.</li>
                    <li><b>장부 인쇄:</b> [인쇄] → [장부 인쇄]를 선택하면 A4 형식의 월별 회계 장부가 출력됩니다.</li>
                    <li><b>영수증 인쇄:</b> [인쇄] → [영수증 인쇄]로 진입 후 인쇄할 항목을 선택하면 용지 1장에 1·2·4개 레이아웃으로 출력됩니다.</li>
                    <li><b>엑셀 다운로드:</b> 현재 조회된 내역 전체를 엑셀로 저장합니다. 이 파일을 수정 후 '수집 및 정리 → 엑셀 장부 탭'에서 다시 올릴 수 있습니다.</li>
                </ul>
            </div>
        </div>

        @* 하단 말씀 *@
        <div class="manual-step-card">
            <div class="manual-step-header" style="background-color: var(--surface-low);">
                <div class="d-flex align-items-center gap-3">
                    <span class="step-badge" style="background: var(--gold-gradient); color: #fff;">5</span>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--on-surface);">사역 기록 남기기 — 다음 담당자를 위해</h5>
                        <span style="color: var(--on-surface-sub); font-size: 0.8125rem;">임원이 바뀌어도 "작년에 이 행사를 어떻게 치렀는지"가 남도록 기록합니다.</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm fw-bold" style="background-color: var(--surface-high); color: var(--on-surface); border: none; border-radius: var(--radius-sm); padding: 0.375rem 0.875rem;" @onclick='() => Nav.NavigateTo("/annual-plan")'>
                        연간 계획 →
                    </button>
                    <button class="btn btn-sm fw-bold" style="background: var(--gold-gradient); color: #fff; border: none; border-radius: var(--radius-sm); padding: 0.375rem 0.875rem;" @onclick='() => Nav.NavigateTo("/event-report")'>
                        행사 보고서 →
                    </button>
                </div>
            </div>
            <div class="manual-step-body pt-3">
                <div class="manual-flow mb-3">
                    <span class="manual-flow-chip"><i class="bi bi-calendar-event me-1" style="color: var(--primary-gold);"></i>연간 계획</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-journal-text me-1"></i>주간 회의록</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-book me-1"></i>월별 장부</span>
                    <span class="manual-flow-arrow">→</span>
                    <span class="manual-flow-chip"><i class="bi bi-clipboard-data me-1"></i>행사 보고서</span>
                </div>

                <ul class="manual-note ps-3 mb-3">
                    <li><b>연간 계획</b> — 한 해 행사를 미리 잡아둡니다. 날짜만 고르면 회계연도·분기·주차가 자동 계산됩니다.</li>
                    <li><b>주간 회의록</b> — 행사를 준비하며 나눈 이야기를 행사별로 남깁니다. 나중에 "그때 왜 그렇게 정했지?"를 되짚을 수 있습니다.</li>
                    <li><b>월별 장부</b> — 지출·수입을 적을 때 <b>분류(행사)</b>와 <b>세부(비용 종류)</b>를 함께 고릅니다. 이 두 가지가 있어야 행사별 결산이 자동으로 나옵니다.</li>
                    <li><b>행사 보고서</b> — 행사가 끝나면 작성합니다. 예산·집행·수입은 장부에서 <b>자동 집계</b>되므로, 장소·인원·담당자와 <b>잘된 점·개선할 점</b>만 적으면 됩니다.</li>
                </ul>

                <div class="p-3 rounded" style="background: rgba(120,86,0,0.06); border: 1px solid rgba(120,86,0,0.25);">
                    <div class="fw-bold mb-2" style="color: var(--on-surface);">
                        <i class="bi bi-lightbulb-fill me-1" style="color: var(--primary-gold);"></i>연간 계획을 한 번에 세우는 방법
                    </div>
                    <ul class="manual-note ps-3 mb-0">
                        <li>연간 계획 화면의 <b>[일괄 등록]</b>을 누르면 <b>작년 계획이 그대로 채워진 엑셀</b>을 받을 수 있습니다.</li>
                        <li>날짜는 1년 뒤로 자동 조정되어 있으니, 실제 일정에 맞게 고치고 필요 없는 행사는 줄째로 지우면 됩니다.</li>
                        <li>오른쪽에 <b>작년 편성·집행·편차</b>가 함께 나옵니다. 예산을 넘겼던 행사는 <span style="color: #ba1a1a;">붉게</span> 표시되니, 올해 금액을 정할 때 참고하세요.</li>
                        <li>행사명을 직접 입력할 때도 <b>지난 실적</b>이 자동으로 뜹니다. 작년에 얼마 쓰였는지 보고 편성액을 정할 수 있습니다.</li>
                    </ul>
                </div>

                <div class="p-3 rounded mt-3" style="background: rgba(120,86,0,0.06); border: 1px solid rgba(120,86,0,0.25);">
                    <div class="fw-bold mb-2" style="color: var(--on-surface);">
                        <i class="bi bi-people-fill me-1" style="color: var(--primary-gold);"></i>왜 기록을 남겨야 할까요?
                    </div>
                    <p class="mb-0" style="color: var(--on-surface-sub); font-size: 0.875rem; line-height: 1.65;">
                        교육국 임원은 2년마다 바뀝니다. 새로 맡은 분이 "여름성경학교는 보통 얼마나 들지?", "작년엔 무엇이 아쉬웠지?"를
                        알 수 있어야 헤매지 않고 준비할 수 있습니다. 특히 <b>개선할 점</b>에 남긴 한 줄이 다음 해의 시행착오를 줄여 줍니다.
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 pt-2">
            <p class="font-heading fw-bold" style="color: var(--primary-gold); font-size: 1.0625rem; margin-bottom: 0.5rem;">
                "그리고 맡은 자들에게 구할 것은 충성이니라" (고린도전서 4:2)
            </p>
            <p style="color: var(--on-surface-muted); font-size: 0.875rem;">
                교회의 귀한 재정을 투명하고 지혜롭게 관리해 주시는 헌신에 감사드립니다.
            </p>
        </div>

    </div>
</div>

@* ═══════════════ 초기 세팅 마법사 모달 ═══════════════ *@
@if (_showWizard)
{
    <div class="modal show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" @onclick="CloseWizard">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content" style="border: none; border-radius: var(--radius-lg); overflow: hidden;">
                <div class="modal-header" style="border-bottom: 1px solid var(--surface-low);">
                    <h5 class="modal-title fw-bold" style="color: var(--on-surface);">
                        <i class="bi bi-stars me-2" style="color: var(--primary-gold);"></i>초기 세팅 마법사
                        <span class="text-muted fs-6 ms-1">(@_wizardStep / @WizardTotalSteps 단계)</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseWizard"></button>
                </div>

                @* 진행 상태바 *@
                <div class="progress" style="height: 6px; border-radius: 0;">
                    <div class="progress-bar" role="progressbar" style="width: @(_wizardStep * 100 / WizardTotalSteps)%; background-color: var(--primary-gold); transition: width 0.3s;"></div>
                </div>

                <div class="modal-body" style="min-height: 290px;">
                    @if (_wizardStep == 1)
                    {
                        <h6 class="fw-bold mb-2" style="color: var(--on-surface);">1단계 · 부서 임원 등록</h6>
                        <p class="text-muted small mb-3">교역자·부장·총무·회계를 등록하면 지출결의서 결재란에 자동 반영됩니다. <b>비워두면 건너뜁니다.</b></p>
                        @foreach (var o in _wizardOfficers)
                        {
                            <div class="row g-2 mb-2">
                                <div class="col-5">
                                    <select class="form-select" @bind="o.Role">
                                        <option value="">직분 선택</option>
                                        <option value="교역자">교역자</option>
                                        <option value="부장(팀장)">부장(팀장)</option>
                                        <option value="총무">총무</option>
                                        <option value="회계">회계</option>
                                    </select>
                                </div>
                                <div class="col-7"><input class="form-control" @bind="o.Name" placeholder="이름" /></div>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-secondary mt-1" @onclick="AddOfficerRow"><i class="bi bi-plus-lg me-1"></i>임원 추가</button>
                    }
                    else if (_wizardStep == 2)
                    {
                        <h6 class="fw-bold mb-2" style="color: var(--on-surface);">2단계 · 회계 분기 설정</h6>
                        <p class="text-muted small mb-3">기본값(1·4·7·10월 1일 시작)으로 채워져 있습니다. 필요 시 수정 후 저장하세요.</p>
                        @for (int q = 1; q <= 4; q++)
                        {
                            int lq = q;
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fw-bold" style="width: 64px; color: #5a4000;">@q 분기</span>
                                <input type="date" class="form-control" @bind="_wizardQuarterStarts[lq - 1]" />
                                <span class="text-muted small text-nowrap">시작일</span>
                            </div>
                        }
                    }
                    else if (_wizardStep == 3)
                    {
                        <h6 class="fw-bold mb-2" style="color: var(--on-surface);">3단계 · 기본 예산 항목</h6>
                        <p class="text-muted small mb-3">자주 쓰는 항목을 골라 체크하세요. 금액(선택)은 나중에 환경설정에서 조정할 수 있습니다.</p>
                        @foreach (var b in _wizardBudgetPresets)
                        {
                            <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded" style="background: var(--surface-low);">
                                <input type="checkbox" class="form-check-input mt-0" @bind="b.Selected" />
                                <span class="badge" style="background-color: @(b.Type == "Income" ? "#785600" : "#ba1a1a");">@(b.Type == "Income" ? "수입" : "지출")</span>
                                <span class="fw-bold flex-grow-1" style="color: var(--on-surface);">@b.Category</span>
                                <input type="number" class="form-control form-control-sm" style="width: 130px;" @bind="b.Amount" placeholder="금액(선택)" />
                            </div>
                        }
                    }
                    else if (_wizardStep == 4)
                    {
                        <h6 class="fw-bold mb-2" style="color: var(--on-surface);">4단계 · 자동분류 규칙</h6>
                        <p class="text-muted small mb-3">은행 적요(키워드)를 분류 항목에 연결합니다. <b>비워두면 건너뜁니다.</b></p>
                        @foreach (var m in _wizardMappings)
                        {
                            <div class="row g-2 mb-2">
                                <div class="col-6"><input class="form-control" @bind="m.Keyword" placeholder="키워드 (예: 다이소)" /></div>
                                <div class="col-6"><input class="form-control" @bind="m.Category" placeholder="분류 항목 (예: 행사비)" /></div>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-secondary mt-1" @onclick="AddMappingRow"><i class="bi bi-plus-lg me-1"></i>규칙 추가</button>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-check-circle-fill" style="font-size: 3.5rem; color: #198754;"></i>
                            <h5 class="fw-bold mt-3" style="color: var(--on-surface);">초기 세팅 완료! 🎉</h5>
                            <p class="text-muted mb-0">기본 데이터가 등록되었습니다.<br/>세부 내용은 언제든 <b>환경설정</b>에서 수정할 수 있습니다.</p>
                        </div>
                    }
                </div>

                <div class="modal-footer" style="border-top: 1px solid var(--surface-low);">
                    @if (_wizardStep == 1)
                    {
                        <button class="btn btn-light fw-bold" @onclick="NextStep" disabled="@_wizardSaving">건너뛰기(나중에)</button>
                        <button class="btn fw-bold" style="background: var(--gold-gradient); color: #fff; border: none;" @onclick="SaveOfficersNext" disabled="@_wizardSaving">@(_wizardSaving ? "저장 중..." : "저장 후 다음 →")</button>
                    }
                    else if (_wizardStep == 2)
                    {
                        <button class="btn fw-bold" style="background: var(--gold-gradient); color: #fff; border: none;" @onclick="SaveQuartersNext" disabled="@_wizardSaving">@(_wizardSaving ? "저장 중..." : "기본값으로 저장 후 다음 →")</button>
                    }
                    else if (_wizardStep == 3)
                    {
                        <button class="btn btn-light fw-bold" @onclick="NextStep" disabled="@_wizardSaving">건너뛰기</button>
                        <button class="btn fw-bold" style="background: var(--gold-gradient); color: #fff; border: none;" @onclick="SaveBudgetsNext" disabled="@_wizardSaving">@(_wizardSaving ? "저장 중..." : "선택 항목 저장 후 다음 →")</button>
                    }
                    else if (_wizardStep == 4)
                    {
                        <button class="btn btn-light fw-bold" @onclick="NextStep" disabled="@_wizardSaving">건너뛰기</button>
                        <button class="btn fw-bold" style="background: var(--gold-gradient); color: #fff; border: none;" @onclick="SaveMappingsNext" disabled="@_wizardSaving">@(_wizardSaving ? "저장 중..." : "저장 후 다음 →")</button>
                    }
                    else
                    {
                        <button class="btn fw-bold px-4" style="background: var(--gold-gradient); color: #fff; border: none;" @onclick="CloseWizard"><i class="bi bi-check-lg me-1"></i>마법사 종료</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private void GoToPage(string url) => Nav.NavigateTo(url);

    // ════════════ 초기 세팅 마법사 ════════════
    [CascadingParameter] public User? CurrentUser { get; set; }

    private bool _showWizard = false;
    private int _wizardStep = 1;
    private bool _wizardSaving = false;
    private const int WizardTotalSteps = 5;

    private int Year => DateTime.Now.Year;
    private int DeptId => CurrentUser?.DepartmentId ?? 0;

    // 입력 모델
    public class OfficerInput { public string Role { get; set; } = ""; public string Name { get; set; } = ""; }
    public class MappingInput { public string Keyword { get; set; } = ""; public string Category { get; set; } = ""; }
    public class BudgetPreset { public string Type { get; set; } = ""; public string Category { get; set; } = ""; public decimal Amount { get; set; } public bool Selected { get; set; } = true; }

    // 1단계: 임원(기본 빈값)
    private List<OfficerInput> _wizardOfficers = new() { new OfficerInput() };
    // 2단계: 분기 시작일 기본값(1/1, 4/1, 7/1, 10/1)
    private DateTime[] _wizardQuarterStarts = new DateTime[4];
    // 3단계: 공통 기본 예산 세트(체크박스)
    private List<BudgetPreset> _wizardBudgetPresets = new();
    // 4단계: 자동분류(기본 빈값)
    private List<MappingInput> _wizardMappings = new() { new MappingInput() };

    protected override void OnInitialized()
    {
        int y = Year;
        _wizardQuarterStarts = new[]
        {
            new DateTime(y, 1, 1), new DateTime(y, 4, 1), new DateTime(y, 7, 1), new DateTime(y, 10, 1)
        };
        _wizardBudgetPresets = new()
        {
            new BudgetPreset { Type = "Income", Category = "주일헌금" },
            new BudgetPreset { Type = "Income", Category = "찬조금" },
            new BudgetPreset { Type = "Expense", Category = "행사비" },
            new BudgetPreset { Type = "Expense", Category = "교육비" },
            new BudgetPreset { Type = "Expense", Category = "소모품비" },
        };
    }

    private void OpenWizard() { _wizardStep = 1; _showWizard = true; }
    private void CloseWizard() { _showWizard = false; }
    private void NextStep() { if (_wizardStep < WizardTotalSteps) _wizardStep++; }
    private void AddOfficerRow() => _wizardOfficers.Add(new OfficerInput());
    private void AddMappingRow() => _wizardMappings.Add(new MappingInput());

    // Step 1: 임원 저장(값 있을 때만) 후 다음
    private async Task SaveOfficersNext()
    {
        var valid = _wizardOfficers.Where(o => !string.IsNullOrWhiteSpace(o.Name) && !string.IsNullOrWhiteSpace(o.Role)).ToList();
        if (valid.Any())
        {
            _wizardSaving = true;
            using var db = DbFactory.CreateDbContext();
            foreach (var o in valid)
            {
                db.DepartmentOfficers.Add(new DepartmentOfficer
                {
                    DepartmentId = DeptId, Year = Year, Role = o.Role, Name = o.Name,
                    StartDate = new DateTime(Year, 1, 1), EndDate = new DateTime(Year, 12, 31)
                });
            }
            await db.SaveChangesAsync();
            _wizardSaving = false;
        }
        NextStep();
    }

    // Step 2: 분기 저장(시작일 기준, 종료일=다음 분기 시작 -1일/4분기는 연말) 후 다음
    private async Task SaveQuartersNext()
    {
        _wizardSaving = true;
        for (int q = 1; q <= 4; q++)
        {
            DateTime start = _wizardQuarterStarts[q - 1];
            DateTime end = (q < 4) ? _wizardQuarterStarts[q].AddDays(-1) : new DateTime(Year, 12, 31);
            await AccService.SaveQuarterSettingAsync(DeptId, Year, q, start, end);
        }
        _wizardSaving = false;
        NextStep();
    }

    // Step 3: 선택된 예산만 저장 후 다음(없으면 건너뜀)
    private async Task SaveBudgetsNext()
    {
        var selected = _wizardBudgetPresets.Where(b => b.Selected).ToList();
        if (selected.Any())
        {
            _wizardSaving = true;
            foreach (var b in selected)
                await AccService.SaveBudgetPlanAsync(new BudgetPlan { DepartmentId = DeptId, Year = Year, Type = b.Type, Category = b.Category, Amount = b.Amount });
            _wizardSaving = false;
        }
        NextStep();
    }

    // Step 4: 매핑 저장(값 있을 때만) 후 다음
    private async Task SaveMappingsNext()
    {
        var valid = _wizardMappings.Where(m => !string.IsNullOrWhiteSpace(m.Keyword) && !string.IsNullOrWhiteSpace(m.Category)).ToList();
        if (valid.Any())
        {
            _wizardSaving = true;
            foreach (var m in valid)
                await AccService.SaveMappingAsync(new CategoryMapping { DepartmentId = DeptId, Keyword = m.Keyword, Category = m.Category });
            _wizardSaving = false;
        }
        NextStep();
    }
}
