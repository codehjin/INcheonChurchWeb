        {
            using var workbook = new XLWorkbook();
            var ws = workbook.Worksheets.Add("장부양식");
            
            // 필수 헤더 작성
            var headers = new[] { "날짜", "구분", "항목", "내역", "수입", "지출", "비고" };
            for (int i = 0; i < headers.Length; i++)
            {
                ws.Cell(1, i + 1).Value = headers[i];
                ws.Cell(1, i + 1).Style.Fill.BackgroundColor = XLColor.LightGray;
                ws.Cell(1, i + 1).Style.Font.Bold = true;
                ws.Cell(1, i + 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            }

            // 가이드라인/예시 데이터 작성
            ws.Cell(2, 1).Value = "2026-04-10";
            ws.Cell(2, 2).Value = "지출";
            ws.Cell(2, 3).Value = "행사비";
            ws.Cell(2, 4).Value = "어린이날 행사 물품 (※ 이 예시 줄은 지우고 작성하세요)";
            ws.Cell(2, 5).Value = 0;
            ws.Cell(2, 6).Value = 50000;
            ws.Cell(2, 4).Style.Font.FontColor = XLColor.Red;

            // 칸 너비 비율 맞춤
            ws.Column(1).Width = 15;
            ws.Column(2).Width = 10;
            ws.Column(3).Width = 15;
            ws.Column(4).Width = 40;
            ws.Column(5).Width = 12;
            ws.Column(6).Width = 12;
            ws.Column(7).Width = 20;

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
