    private async Task LoadBankFiles(InputFileChangeEventArgs e)
    {
        isLoading = true;
        _savedPreviewList.Clear();
        selectedUnclassified.Clear();

        try
        {
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
            using var memoryStream = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            using (var reader = ExcelReaderFactory.CreateReader(memoryStream))
            {
                var result = reader.AsDataSet();
                var table = result.Tables[0];
                int colDate = -1, colDesc = -1, colMemo = -1, colPerson = -1, colIn = -1, colOut = -1, dataStart = 0;
                for (int i = 0; i < Math.Min(table.Rows.Count, 15); i++)
                {
                    var row = table.Rows[i];
                    for (int c = 0; c < table.Columns.Count; c++)
                    {
                        string h = row[c]?.ToString()?.Trim() ?? "";
                        if (h == "거래일시" || h == "날짜") colDate = c;
                        else if (h == "적요") colDesc = c;
                        else if (h == "추가메모") colMemo = c;
                        else if (h.Contains("의뢰인") || h.Contains("수취인")) colPerson = c;
                        else if (h == "입금" || h.Contains("입금액")) colIn = c;
                        else if (h == "출금" || h.Contains("출금액")) colOut = c;
                    }
                    if (colDate >= 0 && colDesc >= 0) { dataStart = i + 1; break; }
                }

                if (colDate < 0) { colDate = 0; colDesc = 1; colMemo = 2; colPerson = 3; colIn = 4; colOut = 5; dataStart = 2; }
                string Cell(DataRow row, int idx) => idx >= 0 && idx < table.Columns.Count ? row[idx]?.ToString()?.Trim() ?? "" : "";

                for (int i = dataStart; i < table.Rows.Count; i++)
                {
                    var row = table.Rows[i];
                    if (!DateTime.TryParse(Cell(row, colDate), out DateTime date)) continue;

                    string desc = Cell(row, colDesc);
                    string memo = Cell(row, colMemo);
                    string person = Cell(row, colPerson);
                    decimal income = ParseDecimal(Cell(row, colIn));
                    decimal expense = ParseDecimal(Cell(row, colOut));
                    if (income == 0 && expense == 0) continue;

                    string type = income > 0 ? "수입" : "지출";
                    string cat = ClassifyAuto($"{desc} {person} {memo}", type);

                    // 🚀 회계연도 계산 로직 추가
                    int calendarYear = date.Year;
                    DateTime currentYearEnd = GetFiscalYearEndDate(calendarYear);
                    int calcFiscalYear;
                    if (date > currentYearEnd) {
                        calcFiscalYear = calendarYear + 1;
                    } else {
                        DateTime lastYearEnd = GetFiscalYearEndDate(calendarYear - 1);
                        calcFiscalYear = date > lastYearEnd ? calendarYear : calendarYear - 1;
                    }

                    _savedPreviewList.Add(new LedgerEntry
                    {
                        Date = date, Description = desc, Note = string.Join(" ", new[] { person, memo }.Where(s => !string.IsNullOrWhiteSpace(s))),
                        Income = income, Expense = expense,
                        DepartmentId = UserDepartmentId,
                        Category = cat, Type = type, 
                        FiscalYear = calcFiscalYear, // 🚀 계산된 회계연도 적용
                        Quarter = GetQuarter(date), IsAudited = false
                    });
                }
            }

            if (!_savedPreviewList.Any(x => x.Type == "지출" && x.Category == "미분류") && _savedPreviewList.Any(x => x.Type == "수입" && x.Category == "미분류")) _savedCurrentTab = "수입";
            else _savedCurrentTab = "지출";
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"오류: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private async Task HandleLedgerImport(InputFileChangeEventArgs e)
    {
        isLedgerImporting = true;
        StateHasChanged();
        try
        {
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
            using var memoryStream = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var reader = ExcelReaderFactory.CreateReader(memoryStream);
            var result = reader.AsDataSet();
            var table = result.Tables[0];

            int colDate=-1, colType=-1, colCat=-1, colDesc=-1, colIncome=-1, colExpense=-1, colNote=-1, dataStart=0;

            for (int i = 0; i < Math.Min(table.Rows.Count, 10); i++)
            {
                var row = table.Rows[i];
                for(int c=0; c<table.Columns.Count; c++)
                {
                    string h = row[c]?.ToString()?.Trim() ?? "";
                    if (h == "날짜") colDate = c;
                    else if (h == "구분") colType = c;
                    else if (h == "세부항목" || h == "항목" || h == "카테고리") colCat = c;
                    else if (h == "내용" || h == "적요" || h == "내역") colDesc = c;
                    else if (h == "수입") colIncome = c;
                    else if (h == "지출") colExpense = c;
                    else if (h == "비고") colNote = c;
                }
                if (colDate >= 0 && colCat >= 0) { dataStart = i + 1; break; }
            }

            if (colDate < 0) throw new Exception("엑셀에서 '날짜', '세부항목(항목)', '수입/지출' 등의 표 머리글(헤더)을 찾을 수 없습니다.");

            var importedList = new List<LedgerEntry>();
            for (int i = dataStart; i < table.Rows.Count; i++)
            {
                var row = table.Rows[i];
                string dateStr = row[colDate]?.ToString()?.Trim() ?? "";

                if (string.IsNullOrEmpty(dateStr) || dateStr.Contains("계") || dateStr.Contains("총")) continue;

                if (!DateTime.TryParse(dateStr, out DateTime date)) continue;

                decimal inc = colIncome >= 0 ? ParseDecimal(row[colIncome]?.ToString()) : 0;
                decimal exp = colExpense >= 0 ? ParseDecimal(row[colExpense]?.ToString()) : 0;
                if (inc == 0 && exp == 0) continue;

                string parsedType = colType >= 0 ? (row[colType]?.ToString()?.Trim() ?? "") : "";
                if(string.IsNullOrEmpty(parsedType)) parsedType = (inc > 0 ? "수입" : "지출");

                // 🚀 회계연도 계산 로직 추가
                int calendarYear = date.Year;
                DateTime currentYearEnd = GetFiscalYearEndDate(calendarYear);
                int calcFiscalYear;
                if (date > currentYearEnd) {
                    calcFiscalYear = calendarYear + 1;
                } else {
                    DateTime lastYearEnd = GetFiscalYearEndDate(calendarYear - 1);
                    calcFiscalYear = date > lastYearEnd ? calendarYear : calendarYear - 1;
                }

                importedList.Add(new LedgerEntry {
                    DepartmentId = UserDepartmentId,
                    Date = date,
                    FiscalYear = calcFiscalYear, // 🚀 계산된 회계연도 적용
                    Quarter = GetQuarter(date),
                    Type = parsedType,
                    Category = colCat >= 0 ? row[colCat]?.ToString()?.Trim() ?? "미분류" : "미분류",
                    Description = colDesc >= 0 ? row[colDesc]?.ToString()?.Trim() ?? "" : "",
                    Income = inc,
                    Expense = exp,
                    Note = colNote >= 0 ? row[colNote]?.ToString()?.Trim() ?? "" : "",
                    IsAudited = false
                });
            }

            if (!importedList.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "읽어들일 장부 데이터가 없습니다.");
                return;
            }

            var existingTrans = await DbContext.Transactions.Where(t => t.DepartmentId == UserDepartmentId).ToListAsync();
            var duplicates = importedList.Where(item => existingTrans.Any(t => t.Date.Date == item.Date.Date && t.Income == item.Income && t.Expense == item.Expense)).ToList();

            if (duplicates.Any())
            {
                bool overwrite = await JSRuntime.InvokeAsync<bool>("confirm", $"?? 경고: 날짜와 금액이 일치하는 기존 장부 내역이 {duplicates.Count}건 발견되었습니다.\n\n중복되는 기존 내역을 삭제하고 지금 올리는 파일 내용으로 완전히 덮어쓰시겠습니까?");
                if (!overwrite)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "장부 업로드가 취소되었습니다.");
                    return;
                }

                foreach (var dup in duplicates)
                {
                    var toDelete = existingTrans.Where(t => t.Date.Date == dup.Date.Date && t.Income == dup.Income && t.Expense == dup.Expense).ToList();
                    DbContext.Transactions.RemoveRange(toDelete);
                }
                await DbContext.SaveChangesAsync();
            }

            await DbContext.Transactions.AddRangeAsync(importedList);
            await DbContext.SaveChangesAsync();

            await JSRuntime.InvokeVoidAsync("alert", $"총 {importedList.Count}건의 장부 데이터가 성공적으로 등록(교체)되었습니다!");
            Nav.NavigateTo("/monthly");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"장부 업로드 중 오류 발생: {ex.Message}");
        }
        finally
        {
            isLedgerImporting = false;
            StateHasChanged();
        }
    }

