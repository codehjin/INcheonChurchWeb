@page "/data-collection"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using ExcelDataReader
@using System.Data
@using System.IO
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Components.Forms
@using ClosedXML.Excel
@inject AppDbContext DbContext
@inject IWebHostEnvironment Env
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject INcheonChurchWeb.Services.OcrService OcrService
@inject AccountingService Accounting
@rendermode InteractiveServer

<PageTitle>수집 및 정리</PageTitle>

<style>
    .hub-surface { background-color: #fbfaee; }
    .hub-card { background-color: #ffffff; border-radius: 0.375rem; border: none; box-shadow: 0 2px 8px rgba(48, 49, 41, 0.04); transition: all 0.2s ease-out; }
    .hub-card-warm { background-color: #f5f4e8; border-radius: 0.375rem; border: none; }
    .hub-tab-bar { background-color: #f5f4e8; border-radius: 0.75rem; padding: 0.375rem; /* 🚀 탭 메뉴 가로 스크롤 및 스크롤바 숨김 처리 */display: flex; gap: 0.25rem; overflow-x: auto; max-width: 100%;-webkit-overflow-scrolling: touch; /* 스마트폰 부드러운 스크롤 */scrollbar-width: none; /* 파이어폭스 스크롤바 숨김 */}
    .hub-tab-bar::-webkit-scrollbar { display: none; } /* 크롬/사파리 스크롤바 숨김 */
    .hub-tab { padding: 0.625rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; background: transparent; color: #4e4637; cursor: pointer; transition: all 0.2s ease-out;/* 🚀 글씨 줄바꿈 방지 및 탭 크기 찌그러짐 방지 */white-space: nowrap; flex-shrink: 0; }
    .hub-tab:hover { background-color: #eae9dd; }
    .hub-tab.active { background-color: #ffffff; color: #5a4000; box-shadow: 0 2px 6px rgba(48, 49, 41, 0.06); font-weight: 700; }
    .hub-gold-btn { background: linear-gradient(135deg, #785600 0%, #5a4000 100%); color: #ffffff; font-weight: 700; border: none; border-radius: 0.25rem; padding: 0.75rem 2.5rem; font-size: 0.875rem; transition: all 0.15s ease-out; }
    .hub-gold-btn:hover { transform: scale(1.03); color: #ffffff; }
    .hub-gold-btn:active { transform: scale(0.97); }
    .hub-gold-btn:disabled { opacity: 0.5; transform: none; }
    .hub-secondary-btn { background-color: #eae9dd; color: #5a4000; font-weight: 700; border: none; border-radius: 0.5rem; padding: 0.75rem 2rem; font-size: 0.875rem; transition: all 0.2s ease-out; }
    .hub-secondary-btn:hover { background-color: #e4e3d7; color: #5a4000; }
    .hub-input { background-color: #ffffff; border: none; border-radius: 0.375rem; padding: 0.625rem 1rem; font-size: 1rem; color: #1b1c15; transition: box-shadow 0.2s ease-out; }
    .hub-input:focus { outline: none; box-shadow: 0 0 0 2px rgba(123, 88, 3, 0.2); }
    .hub-label { font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #4e4637; margin-bottom: 0.375rem; }
    .hub-info-box { background-color: #f5f4e8; border-radius: 0.375rem; padding: 1.5rem; display: flex; align-items: flex-start; gap: 1rem; }
    .hub-receipt-item { background-color: #f5f4e8; border-radius: 0.75rem; padding: 1rem; display: flex; align-items: center; gap: 1rem; transition: box-shadow 0.2s ease-out; cursor: pointer; }
    .hub-receipt-item:hover { box-shadow: 0 4px 12px rgba(48, 49, 41, 0.08); }
    .hub-receipt-item.selected { background-color: #eae9dd; }
    .hub-table-row { transition: background-color 0.15s ease-out; }
    .hub-table-row:hover { background-color: #ffffff; }
    .hub-table-header { background-color: rgba(234, 233, 221, 0.5); }
    .hub-badge { font-size: 0.625rem; font-weight: 700; padding: 0.25rem 0.5rem; border-radius: 0.25rem; }
    .hub-badge-cat { background-color: rgba(23, 69, 119, 0.1); color: #174577; }
    .hub-tabular { font-variant-numeric: tabular-nums; }
    .hub-bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: rgba(251, 250, 238, 0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); padding: 1.25rem 2rem; z-index: 1040; box-shadow: 0 -20px 40px rgba(48, 49, 41, 0.06); display: flex; align-items: center; justify-content: space-between; }
    .hub-dashed-upload { border: 2px dashed #d2c5b2; border-radius: 0.75rem; padding: 3rem 2rem; text-align: center; cursor: pointer; transition: all 0.2s ease-out; background-color: #ffffff; }
    .hub-dashed-upload:hover { border-color: #785600; background-color: #f5f4e8; }
    .hub-file-table td, .hub-file-table th { border: none !important; padding: 0.875rem 1rem; vertical-align: middle; }
    .hub-file-table thead th { font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #4e4637; }
    .hub-delete-btn { opacity: 0; transition: opacity 0.15s ease-out; color: #ba1a1a; background: none; border: none; padding: 0.25rem; cursor: pointer; font-size: 1rem; }
    .hub-receipt-item:hover .hub-delete-btn { opacity: 1; }
    .hub-amount { color: #5a4000; font-weight: 800; font-size: 1.1rem !important; }
    .hub-preview-img { max-height: 250px; border-radius: 0.375rem; object-fit: contain; }
</style>

<div class="hub-surface min-vh-100" style="padding-bottom: @(activeTab == "matching" ? "7rem" : "2rem");">
    <div class="container-fluid px-2 pt-4">

        <div class="mb-4">
            <h2 class="fw-bold mb-1" style="color: #1b1c15; font-family: 'Manrope', sans-serif; letter-spacing: -0.02em;">수집 및 정리</h2>
            <p class="mb-0" style="color: #4e4637; font-size: 0.9rem;">영수증과 장부 데이터를 매칭하여 정확한 회계를 관리하세요.</p>
        </div>

        <div class="mb-4">
            <div class="hub-tab-bar">
                <button class="hub-tab @(activeTab == "single" ? "active" : "")" @onclick='() => activeTab = "single"'>
                    <i class="bi bi-receipt me-1"></i>영수증(단일)
                </button>
                <button class="hub-tab @(activeTab == "multi" ? "active" : "")" @onclick='() => activeTab = "multi"'>
                    <i class="bi bi-images me-1"></i>영수증(일괄)
                </button>
                <button class="hub-tab @(activeTab == "excel" ? "active" : "")" @onclick='() => activeTab = "excel"'>
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i>엑셀 내역
                </button>
                <button class="hub-tab @(activeTab == "matching" ? "active" : "")" @onclick="ActivateMatchingTab">
                    <i class="bi bi-link-45deg me-1"></i>장부 매칭
                    @if (pendingReceipts.Any())
                    {
                        <span class="ms-1 px-2 py-0 rounded-pill" style="background-color: #5a4000; color: #fff; font-size: 0.6875rem; font-weight: 800;">@pendingReceipts.Count</span>
                    }
                </button>
            </div>
        </div>

        @* ????????????????????????????????????????????????????????????????
           TAB 1: 영수증(단일) ? ReceiptUpload.razor 로직
        ???????????????????????????????????????????????????????????????? *@
        @if (activeTab == "single")
        {
            <div class="row g-4">
                <div class="col-12">
                    <div class="hub-card p-3 p-md-4">

                        <div class="hub-info-box mb-4">
                            <i class="bi bi-robot fs-4" style="color: #785600;"></i>
                            <div class="d-flex justify-content-between align-items-center flex-grow-1">
                                <div>
                                    <div class="fw-bold" style="color: #1b1c15; font-size: 0.875rem;">이번 달 AI 자동 판독</div>
                                    <div style="color: #4e4637; font-size: 0.75rem;">사진 선택 시 자동으로 날짜·금액·사용처를 인식합니다.</div>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold hub-tabular" style="font-size: 1.25rem; color: @(currentOcrUsage >= 1000 ? "#ba1a1a" : "#5a4000");">@currentOcrUsage</span>
                                    <span style="color: #4e4637; font-size: 0.75rem;"> / 1,000</span>
                                </div>
                            </div>
                        </div>

                        <InputFile id="hubSingleFileInput" OnChange="HandleFileSelected" style="display:none;" accept="image/*" />
                        <label for="hubSingleFileInput" class="hub-dashed-upload w-100 mb-4 d-flex align-items-center justify-content-center" style="@(currentOcrUsage >= 1000 ? "border-color: #ba1a1a; opacity: 0.6;" : "")">
                            @if (isOcrProcessing)
                            {
                                <sapn class="spinner-border me-3" style="color: #785600;" role="status"></sapn>
                                <span class="fw-bold" style="color: #1b1c15; font-size: 1.1rem;">AI가 영수증 읽는 중...</span>
                            }
                            else
                            {
                                <i class="bi bi-camera-fill me-3" style="font-size: 2rem; color: #785600;"></i>
                                <span class="fw-bold" style="color: #1b1c15; font-size: 1.1rem;">@(string.IsNullOrEmpty(selectedFileName) ? "여기를 눌러 사진 찾기" : "사진 다시 선택하기")</span>
                            }
                        </label>
                        @if (currentOcrUsage >= 1000)
                        {
                            <div class="text-center mb-3" style="color: #ba1a1a; font-size: 0.8rem; font-weight: 700;">이번 달 무료 제공량을 모두 사용했습니다. 수동으로 입력해주세요.</div>
                        }

                        @if (!string.IsNullOrEmpty(previewImageUrl))
                        {
                            <div class="text-center mb-2 p-0 rounded" 
                                 style="overflow: hidden; position: relative; height: 350px; display: flex; align-items: center; justify-content: center; background-color: #f5f4e8; cursor: @(isDragging ? "grabbing" : "grab");"
                                 @onwheel="HandleWheel" @onwheel:preventDefault="true"
                                 @onmousedown="HandleMouseDown" @onmousemove="HandleMouseMove" @onmouseup="HandleMouseUp" @onmouseleave="HandleMouseUp">
                                
                                <img src="@previewImageUrl" 
                                     style="transform: translate(@(imgX)px, @(imgY)px) scale(@imgScale); transition: transform 0.05s linear; max-height: 100%; max-width: 100%; object-fit: contain; pointer-events: none;" />
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="badge bg-secondary" style="opacity: 0.7;">휠: 확대 / 드래그: 이동</span>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ZoomOut" title="축소">
                                        <i class="bi bi-dash-lg"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetImageTransform" title="화면 맞춤">
                                        <i class="bi bi-arrows-fullscreen"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ZoomIn" title="확대">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <div class="hub-label" style="color: #ba1a1a;">1. 결제 날짜(필수입력)</div>
                            <input type="date" class="form-control hub-input" @bind="newReceipt.ReceiptDate" />
                        </div>

                        <div class="mb-3">
                            <div class="hub-label" style="color: #ba1a1a;">2. 결제 금액(필수입력)</div>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="number" class="form-control hub-input flex-grow-1 text-end fw-bold" @bind="inputAmount" placeholder="예: 15000" />
                                <span class="fw-bold" style="color: #4e4637;">원</span>
                                @if (inputAmount.HasValue)
                                {
                                    <button class="btn btn-sm" style="color: #ba1a1a;" @onclick="() => { inputAmount = null; }"><i class="bi bi-x-circle"></i></button>
                                }
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="hub-label">3. 사용처/내역(선택입력)</div>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="text" class="form-control hub-input flex-grow-1" @bind="newReceipt.Description" placeholder="예: 다이소" />
                                @if (!string.IsNullOrEmpty(newReceipt.Description))
                                {
                                    <button class="btn btn-sm" style="color: #ba1a1a;" @onclick="() => { newReceipt.Description = string.Empty; }"><i class="bi bi-x-circle"></i></button>
                                }
                            </div>
                        </div>

                        @if (CurrentUser?.Role == "Admin")
                        {
                            <div class="mb-4">
                                <div class="hub-label" style="color: #ba1a1a;">4. 부서 선택 (관리자 필수)</div>
                                <select class="form-select hub-input fw-bold" @bind="adminSelectedDeptId" style="color: #785600;">
                                    <option value="0">부서를 선택하세요</option>
                                    @foreach (var dept in allDepts.Where(d => d.Name != "관리자"))
                                    {
                                        <option value="@dept.Id">@dept.Name</option>
                                    }
                                </select>
                            </div>
                        }

                        <button class="hub-gold-btn w-100 py-3" @onclick="UploadReceipt" disabled="@(isUploading || isOcrProcessing)">
                            @if (isUploading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span><span>업로드 중...</span>
                            }
                            else
                            {
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i><span>확인 완료 / 서버로 전송</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }

        @* ????????????????????????????????????????????????????????????????
           TAB 2: 영수증(일괄) ? ReceiptMultiUpload.razor 로직
        ???????????????????????????????????????????????????????????????? *@
        @if (activeTab == "multi")
        {
            <div class="hub-card p-3 p-md-4">

                <div class="hub-info-box mb-4">
                    <i class="bi bi-info-circle-fill" style="color: #785600; font-size: 1.25rem;"></i>
                    <div>
                        <div class="fw-bold mb-1" style="color: #1b1c15; font-size: 0.875rem;">작업 효율 팁</div>
                        <p class="mb-0" style="color: #4e4637; font-size: 0.8125rem; line-height: 1.5;">최대 20장의 영수증 사진을 한 번에 선택하세요. AI가 자동으로 날짜와 금액을 판독하여 장부에 임시 저장합니다. 비어있거나 잘못 인식된 항목은 월별장부에서 수정할 수 있습니다.</p>
                    </div>
                </div>

                <div class="mb-4">
                    <InputFile multiple OnChange="HandleFilesSelected" class="form-control hub-input" accept="image/*" />
                    <div class="mt-2" style="font-size: 0.75rem; font-weight: 700; color: #ba1a1a;">※ 한 번에 최대 20장까지만 업로드 가능합니다.</div>
                </div>

                @if (fileStatuses.Any())
                {
                    <div class="hub-card-warm rounded p-0 mb-4 overflow-hidden">
                        <table class="table mb-0 hub-file-table">
                            <thead class="hub-table-header">
                                <tr>
                                    <th>파일명</th>
                                    <th>AI 판독 상태</th>
                                    <th>인식된 날짜</th>
                                    <th class="text-end">인식된 금액</th>
                                    <th>인식된 사용처</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in fileStatuses)
                                {
                                    <tr class="hub-table-row">
                                        <td class="text-truncate fw-bold" style="max-width: 150px; color: #1b1c15;" title="@file.FileName">@file.FileName</td>
                                        <td>
                                            @if (file.Status == FileStatus.Pending)
                                            {
                                                <span class="hub-badge" style="background-color: #eae9dd; color: #4e4637;">대기중</span>
                                            }
                                            else if (file.Status == FileStatus.Processing)
                                            {
                                                <span class="hub-badge" style="background-color: rgba(120, 86, 0, 0.1); color: #785600;"><span class="spinner-border spinner-border-sm me-1"></span>분석중</span>
                                            }
                                            else if (file.Status == FileStatus.Success)
                                            {
                                                <span class="hub-badge" style="background-color: rgba(23, 69, 119, 0.1); color: #174577;">성공</span>
                                            }
                                            else
                                            {
                                                <span class="hub-badge" style="background-color: rgba(186, 26, 26, 0.1); color: #ba1a1a;">실패/수동필요</span>
                                            }
                                        </td>
                                        <td class="hub-tabular" style="color: #4e4637;">@(file.ParsedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td class="text-end hub-tabular hub-amount">@(file.ParsedAmount > 0 ? file.ParsedAmount.ToString("#,0") + "원" : "-")</td>
                                        <td style="color: #1b1c15;">@(string.IsNullOrEmpty(file.ParsedDescription) ? "-" : file.ParsedDescription)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button class="hub-gold-btn w-100 py-3" @onclick="ProcessAllFiles" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span><span>@($"{processedCount} / {fileStatuses.Count} 처리중...")</span>
                        }
                        else
                        {
                            <i class="bi bi-magic me-2"></i><span>전체 AI 분석 및 서버 저장 시작</span>
                        }
                    </button>
                }
            </div>
        }

        @* ????????????????????????????????????????????????????????????????
  TAB 3: 엑셀 내역 업로드 ? BankImport.razor 로직
 ???????????????????????????????????????????????????????????????? *@
 @if (activeTab == "excel")
 {
     @if (!string.IsNullOrEmpty(UserDepartmentName))
     {
         <div class="hub-info-box mb-4">
             <i class="bi bi-building" style="color: #785600; font-size: 1.25rem;"></i>
             <div>
                 <span style="color: #1b1c15; font-weight: 700;">현재 '@UserDepartmentName' 부서 장부로 작업 중입니다.</span>
                 
                 @* 🚀 하드코딩 제거: 등록된 자동 분류 규칙(autoRules)이 존재하면 뱃지를 표시 *@
                 @if (autoRules != null && autoRules.Any())
                 {
                     <span class="hub-badge ms-2" style="background-color: rgba(23, 69, 119, 0.1); color: #174577;">자동 분류 ON (@(autoRules.Count)개 규칙 적용중)</span>
                 }
             </div>
         </div>
     }

            <div class="hub-card p-3 p-md-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <i class="bi bi-bank fs-4" style="color: #785600;"></i>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: #1b1c15;">은행 통장 거래내역 가져오기</h5>
                        <p class="mb-0" style="color: #4e4637; font-size: 0.8125rem;">자동 분류 규칙에 따라 항목이 분류되며, 미리보기 후 저장합니다.</p>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="flex-grow-1">
                        <InputFile OnChange="LoadBankFiles" class="form-control hub-input" accept=".xls,.xlsx,.csv" />
                    </div>
                    @if (LastTransactionDate.HasValue)
                    {
                        <div class="p-2 px-3 rounded" style="background-color: #f5f4e8;">
                            <span style="color: #4e4637; font-size: 0.75rem; display: block;">마지막 장부 기록일</span>
                            <strong class="hub-tabular" style="color: #5a4000; font-size: 1.1rem;">@LastTransactionDate.Value.ToString("yyyy-MM-dd")</strong>
                        </div>
                    }
                </div>
                @if (isLoading)
                {
                    <div class="mt-3 p-3 rounded d-flex align-items-center gap-2" style="background-color: #f5f4e8;">
                        <div class="spinner-border spinner-border-sm" style="color: #785600;"></div>
                        <span style="color: #5a4000; font-weight: 600; font-size: 0.875rem;">은행 엑셀 파일 분석 중...</span>
                    </div>
                }
            </div>

            @if (_savedPreviewList != null && _savedPreviewList.Any())
            {
                var unclassifiedIncomeCount = _savedPreviewList.Count(x => x.Category == "미분류" && x.Type == "수입");
                var unclassifiedExpenseCount = _savedPreviewList.Count(x => x.Category == "미분류" && x.Type == "지출");
                var totalUnclassified = unclassifiedIncomeCount + unclassifiedExpenseCount;

                <div class="hub-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0" style="color: #1b1c15;">
                            <i class="bi bi-arrows-move me-2" style="color: #785600;"></i>퀵 분류 (남은 미분류: @totalUnclassified 건)
                        </h5>
                        <button class="hub-secondary-btn px-3 py-2" style="font-size: 0.8rem;" @onclick="ClearWorkData">
                            <i class="bi bi-arrow-clockwise me-1"></i>목록 비우기
                        </button>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-5">
                            <div class="hub-card p-3" style="background-color: #ffffff;">
                                <div class="d-flex rounded p-1 mb-3" style="background-color: #f5f4e8;">
                                    <button class="btn btn-sm flex-fill fw-bold @(_savedCurrentTab == "수입" ? "bg-white shadow-sm" : "")"
                                            style="border-radius: 0.375rem; color: @(_savedCurrentTab == "수입" ? "#5a4000" : "#4e4637"); border: none;"
