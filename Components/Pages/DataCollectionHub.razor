    private async Task LoadBankFiles(InputFileChangeEventArgs e)
    {
        isLoading = true;
        _savedPreviewList.Clear();
        selectedUnclassified.Clear();

        int duplicateCount = 0; // 🟢 중복 제외 카운트

        try
        {
            // 🚀 1. 기존 장부 데이터 로드 (빠른 중복 검사를 위해 필요 항목만 조회)
            using var context = DbContextFactory.CreateDbContext();
            var existingTrans = await context.Transactions
                .AsNoTracking()
                .Where(t => t.DepartmentId == UserDepartmentId)
                .Select(t => new { t.Date, t.Income, t.Expense })
                .ToListAsync();

            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
            using var memoryStream = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: GlobalConstants.MaxBankImportFileSize).CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using (var reader = ExcelReaderFactory.CreateReader(memoryStream))
            {
                var result = reader.AsDataSet();
                var table = result.Tables[0];
                int colDate = -1, colDesc = -1, colMemo = -1, colPerson = -1, colIn = -1, colOut = -1, dataStart = 0;

                for (int i = 0; i < Math.Min(table.Rows.Count, 15); i++)
                {
                    var row = table.Rows[i];
                    for (int c = 0; c < table.Columns.Count; c++)
                    {
                        string h = row[c]?.ToString()?.Trim() ?? "";
                        if (h == "거래일시" || h == "날짜") colDate = c;
                        else if (h == "적요") colDesc = c;
                        else if (h == "추가메모") colMemo = c;
                        else if (h.Contains("의뢰인") || h.Contains("수취인")) colPerson = c;
                        else if (h == "입금" || h.Contains("입금액")) colIn = c;
                        else if (h == "출금" || h.Contains("출금액")) colOut = c;
                    }
                    if (colDate >= 0 && colDesc >= 0) { dataStart = i + 1; break; }
                }

                if (colDate < 0) { colDate = 0; colDesc = 1; colMemo = 2; colPerson = 3; colIn = 4; colOut = 5; dataStart = 2; }
                string Cell(DataRow row, int idx) => idx >= 0 && idx < table.Columns.Count ? row[idx]?.ToString()?.Trim() ?? "" : "";

                for (int i = dataStart; i < table.Rows.Count; i++)
                {
                    var row = table.Rows[i];
                    if (!DateTime.TryParse(Cell(row, colDate), out DateTime date)) continue;

                    string desc = Cell(row, colDesc);
                    string memo = Cell(row, colMemo);
                    string person = Cell(row, colPerson);
                    decimal income = ParseDecimal(Cell(row, colIn));
                    decimal expense = ParseDecimal(Cell(row, colOut));

                    if (income == 0 && expense == 0) continue;

                    // 🚀 2. 중복 검사 (날짜, 수입, 지출 금액이 모두 동일한 내역이 이미 장부에 있는지 확인)
                    bool isDuplicate = existingTrans.Any(t =>
                        t.Date.Date == date.Date &&
                        t.Income == income &&
                        t.Expense == expense);

                    // 중복이면 카운트만 올리고 리스트에 넣지 않고 패스
                    if (isDuplicate)
                    {
                        duplicateCount++;
                        continue;
                    }

                    string type = income > 0 ? GlobalConstants.TransactionTypeIncome : GlobalConstants.TransactionTypeExpense;
                    string cat = ClassifyAuto($"{desc} {person} {memo}", type);
                    int calcFiscalYear = DateHelper.CalculateFiscalYear(date);

                    _savedPreviewList.Add(new LedgerEntry
                    {
                        Date = date,
                        Description = desc,
                        Note = string.Join(" ", new[] { person, memo }.Where(s => !string.IsNullOrWhiteSpace(s))),
                        Income = income,
                        Expense = expense,
                        DepartmentId = UserDepartmentId,
                        Category = cat,
                        Type = type,
                        FiscalYear = calcFiscalYear,
                        Quarter = DateHelper.GetQuarter(date),
                        IsAudited = false
                    });
                }
            }

            // 초기 화면 탭 설정
            if (!_savedPreviewList.Any(x => x.Type == GlobalConstants.TransactionTypeExpense && x.Category == GlobalConstants.CategoryUnclassified) &&
                 _savedPreviewList.Any(x => x.Type == GlobalConstants.TransactionTypeIncome && x.Category == GlobalConstants.CategoryUnclassified))
            {
                _savedCurrentTab = GlobalConstants.TransactionTypeIncome;
            }
            else
            {
                _savedCurrentTab = GlobalConstants.TransactionTypeExpense;
            }

            // 🚀 3. 사용자를 위한 결과 알림
            if (_savedPreviewList.Count == 0 && duplicateCount > 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"업로드된 모든 내역({duplicateCount}건)이 이미 장부에 등록되어 있어 가져오기를 종료합니다.");
            }
            else if (duplicateCount > 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"기존 장부에 이미 등록된 중복 내역 {duplicateCount}건은 자동으로 제외되었습니다.\n남은 신규 내역만 분류를 진행해 주세요.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"오류: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleLedgerImport(InputFileChangeEventArgs e)
{
    isLedgerImporting = true;
    StateHasChanged();
    try
    {
        System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
        using var memoryStream = new MemoryStream();
        await e.File.OpenReadStream(maxAllowedSize: GlobalConstants.MaxLedgerImportFileSize).CopyToAsync(memoryStream);
        memoryStream.Position = 0;

        using var reader = ExcelReaderFactory.CreateReader(memoryStream);
        var result = reader.AsDataSet();
        var importedList = new List<LedgerEntry>();

        foreach (System.Data.DataTable table in result.Tables)
        {
            int colDate = -1, colCat = -1, colDesc = -1, colIncome = -1, colExpense = -1, colNote = -1, dataStart = 0;

            for (int i = 0; i < Math.Min(table.Rows.Count, 10); i++)
            {
                var row = table.Rows[i];
                for (int c = 0; c < table.Columns.Count; c++)
                {
                    string h = row[c]?.ToString()?.Trim() ?? "";
                    if (h == "날짜") colDate = c;
                    else if (h == "분류항목" || h == "항목" || h == "세부항목" || h == "카테고리") colCat = c;
                    else if (h == "적요" || h == "내용" || h == "내역") colDesc = c;
                    else if (h == "수입") colIncome = c;
                    else if (h == "지출") colExpense = c;
                    else if (h == "비고") colNote = c;
                }
                if (colDate >= 0) { dataStart = i + 1; break; }
            }

            if (colDate < 0) continue;

            for (int i = dataStart; i < table.Rows.Count; i++)
            {
                var row = table.Rows[i];
                string dateRaw = row[colDate]?.ToString()?.Trim() ?? "";
                string descStr = colDesc >= 0 ? row[colDesc]?.ToString()?.Trim() ?? "" : "";
                string catStr = colCat >= 0 ? row[colCat]?.ToString()?.Trim() ?? "" : "";

                // 이월금, 합계 행 등 저장할 필요 없는 데이터 스킵
                if (string.IsNullOrEmpty(dateRaw) || descStr.Contains("이월") || descStr.Contains("잔액") || descStr.Contains("합계") || catStr.Contains("이월")) continue;

                // 엑셀 숫자형 날짜 완벽 대응 로직
                DateTime date;
                if (!DateTime.TryParse(dateRaw, out date))
                {
                    if (double.TryParse(dateRaw, out double oaDate)) date = DateTime.FromOADate(oaDate);
                    else continue; 
                }

                decimal inc = colIncome >= 0 ? ParseDecimal(row[colIncome]?.ToString()) : 0;
                decimal exp = colExpense >= 0 ? ParseDecimal(row[colExpense]?.ToString()) : 0;
                if (inc == 0 && exp == 0) continue;
                int calcFiscalYear = DateHelper.CalculateFiscalYear(date);

                importedList.Add(new LedgerEntry
                {
                    DepartmentId = UserDepartmentId,
                    Date = date,
                    FiscalYear = calcFiscalYear,
                    Quarter = DateHelper.GetQuarter(date),
                    Type = inc > 0 ? GlobalConstants.TransactionTypeIncome : GlobalConstants.TransactionTypeExpense,
                    Category = string.IsNullOrEmpty(catStr) ? GlobalConstants.CategoryUnclassified : catStr,
                    Description = descStr,
                    Income = inc,
                    Expense = exp,
                    Note = colNote >= 0 ? row[colNote]?.ToString()?.Trim() ?? "" : "",
                    IsAudited = false
                });
            }
        }

        if (!importedList.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", "읽어들일 장부 데이터가 없습니다. (양식이나 날짜를 확인해주세요)");
            return;
        }

        using var context = DbContextFactory.CreateDbContext();
        var existingTrans = await context.Transactions.Where(t => t.DepartmentId == UserDepartmentId).ToListAsync();
        var duplicates = importedList.Where(item => existingTrans.Any(t => t.Date.Date == item.Date.Date && t.Income == item.Income && t.Expense == item.Expense)).ToList();

        if (duplicates.Any())
        {
            bool overwrite = await JSRuntime.InvokeAsync<bool>("confirm", $"⚠️ 날짜와 금액이 일치하는 기존 장부 내역이 {duplicates.Count}건 발견되었습니다.\n\n중복 내역을 삭제하고 올리신 파일로 덮어쓰시겠습니까?");
            if (!overwrite) return;

            foreach (var dup in duplicates)
            {
                var toDelete = existingTrans.Where(t => t.Date.Date == dup.Date.Date && t.Income == dup.Income && t.Expense == dup.Expense).ToList();
                context.Transactions.RemoveRange(toDelete);
            }
            await context.SaveChangesAsync();
        }

        await context.Transactions.AddRangeAsync(importedList);
        await context.SaveChangesAsync();

        await JSRuntime.InvokeVoidAsync("alert", $"총 {importedList.Count}건의 장부 데이터가 성공적으로 등록(교체)되었습니다!");
        Nav.NavigateTo("/monthly");
    }
    catch (Exception ex)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"장부 업로드 중 오류 발생: {ex.Message}");
    }
    finally
    {
        isLedgerImporting = false;
        StateHasChanged();
    }
}

