@page "/data-collection"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using ExcelDataReader
@using System.Data
@using System.IO
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Components.Forms
@using ClosedXML.Excel
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject FileService FileService
@inject IWebHostEnvironment Env
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject INcheonChurchWeb.Services.OcrService OcrService
@inject AccountingService Accounting

<PageTitle>수집 및 정리</PageTitle>

<div class="hub-surface min-vh-100" style="padding-bottom: @(activeTab == "matching" ? "7rem" : "2rem");">
    <div class="container-fluid px-2 pt-4">

        <div class="mb-4">
            <h2 class="fw-bold mb-1" style="color: #1b1c15; font-family: 'Manrope', sans-serif; letter-spacing: -0.02em;">수집 및 정리</h2>
            <p class="mb-0" style="color: #4e4637; font-size: 1rem;">영수증과 장부 데이터를 매칭하여 정확한 회계를 관리하세요.</p>
        </div>

        <div class="mb-4">
            <div class="hub-tab-bar">
                <button class="hub-tab @(activeTab == "single" ? "active" : "")" @onclick='() => activeTab = "single"'>
                    <i class="bi bi-receipt me-1"></i>영수증(단일)
                </button>
                <button class="hub-tab @(activeTab == "multi" ? "active" : "")" @onclick='() => activeTab = "multi"'>
                    <i class="bi bi-images me-1"></i>영수증(일괄)
                </button>
                <button class="hub-tab @(activeTab == "excel" ? "active" : "")" @onclick='() => activeTab = "excel"'>
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i>엑셀 내역
                </button>
                <button class="hub-tab @(activeTab == "matching" ? "active" : "")" @onclick="ActivateMatchingTab">
                    <i class="bi bi-link-45deg me-1"></i>장부 매칭
                    @if (pendingReceipts.Any())
                    {
                        <span class="ms-1 px-2 py-0 rounded-pill" style="background-color: #5a4000; color: #fff; font-size: 1rem; font-weight: 800;">@pendingReceipts.Count</span>
                    }
                </button>
            </div>
        </div>

        @* ????????????????????????????????????????????????????????????????
           TAB 1: 영수증(단일) ? ReceiptUpload.razor 로직
        ???????????????????????????????????????????????????????????????? *@
        @if (activeTab == "single")
        {
            <ReceiptSingleUpload CurrentUser="@CurrentUser"
                                 CurrentOcrUsage="@currentOcrUsage"
                                 IsOcrProcessing="@isOcrProcessing"
                                 IsUploading="@isUploading"
                                 SelectedFileName="@selectedFileName"
                                 PreviewImageUrl="@previewImageUrl"
                                 IsDragging="@isDragging"
                                 ImgX="@imgX"
                                 ImgY="@imgY"
                                 ImgScale="@imgScale"
                                 NewReceipt="@newReceipt"
                                 @bind-InputAmount="inputAmount"
                                 @bind-AdminSelectedDeptId="adminSelectedDeptId"
                                 AllDepts="@allDepts"
                                 HandleFileSelected="HandleFileSelected"
                                 HandleWheel="HandleWheel"
                                 HandleMouseDown="HandleMouseDown"
                                 HandleMouseMove="HandleMouseMove"
                                 HandleMouseUp="HandleMouseUp"
                                 ZoomOut="ZoomOut"
                                 ResetImageTransform="ResetImageTransform"
                                 ZoomIn="ZoomIn"
                                 UploadReceipt="UploadReceipt" />
        }

        @* ????????????????????????????????????????????????????????????????
           TAB 2: 영수증(일괄) ? ReceiptMultiUpload.razor 로직
        ???????????????????????????????????????????????????????????????? *@
        @if (activeTab == "multi")
        {
            <ReceiptMultiUpload FileStatuses="fileStatuses"
                                IsProcessing="isProcessing"
                                ProcessedCount="processedCount"
                                HandleFilesSelected="HandleFilesSelected"
                                ProcessAllFiles="ProcessAllFiles" />
        }

        @* ????????????????????????????????????????????????????????????????
  TAB 3: 엑셀 내역 업로드 ? BankImport.razor 로직
 ???????????????????????????????????????????????????????????????? *@
@if (activeTab == "excel")
{
            <BankImport UserDepartmentName="@UserDepartmentName"
                AutoRules="@autoRules"
                LastTransactionDate="@LastTransactionDate"
                IsLoading="@isLoading"
                IsSaving="@isSaving"
                IsLedgerImporting="@isLedgerImporting"
                SavedPreviewList="@_savedPreviewList"
                @bind-SavedCurrentTab="@_savedCurrentTab"
                IncomeCats="@IncomeCats"
                ExpenseCats="@ExpenseCats"
                @bind-SearchUnclassified="@searchUnclassified"
                @bind-SearchPreview="@searchPreview"
                @bind-BatchSelectedCategory="@batchSelectedCategory"
                SelectedUnclassified="@selectedUnclassified"
                LoadBankFiles="LoadBankFiles"
                ClearWorkData="ClearWorkData"
                SaveToLedger="SaveToLedger"
                DownloadLedgerTemplate="DownloadLedgerTemplate"
                HandleLedgerImport="HandleLedgerImport" />
}

        @* ????????????????????????????????????????????????????????????????
           TAB 4: 장부 매칭 ? ReceiptQuery + MonthlyLedger 매칭 로직 병합
        ???????????????????????????????????????????????????????????????? *@
        @if (activeTab == "matching")
        {
            <LedgerMatching PendingReceipts="pendingReceipts"
                            UnmatchedEntries="unmatchedEntries"
                            @bind-MatchingFilterMonth="matchingFilterMonth"
                            SelectedMatchingReceipt="selectedMatchingReceipt"
                            SelectedMatchingReceiptChanged="OnSelectedMatchingReceiptChanged"
                            SelectedMatchingReceiptIds="selectedMatchingReceiptIds"
                            @bind-SelectedMatchingEntryId="selectedMatchingEntryId"
                            @bind-SearchKeyword="SearchKeyword"
                            SearchData="SearchData"
                            HandleKeyUp="HandleKeyUp"
                            DeleteReceipt="DeleteReceipt"
                            OpenImageModal="OpenImageModal"
                            ManualMatchSingle="ManualMatchSingle"
                            AutoMatchReceipts="AutoMatchReceipts"
                            ShowImageModal="showImageModal"
                            CurrentLargeImageUrl="currentLargeImageUrl"
                            ImgX="imgX"
                            ImgY="imgY"
                            ImgScale="imgScale"
                            IsDragging="isDragging"
                            CloseImageModal="CloseImageModal"
                            HandleWheel="HandleWheel"
                            HandleMouseDown="HandleMouseDown"
                            HandleMouseMove="HandleMouseMove"
                            HandleMouseUp="HandleMouseUp" />
        }

    </div>
</div>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    // ==========================================
    // 🔎 공통 이미지 모달 (확대/축소/이동) 상태 변수 - 중복 제거된 단일 선언
    // ==========================================
    private bool showImageModal = false;
    private string currentLargeImageUrl = string.Empty;

    private double imgScale = 1.0;
    private double imgX = 0;
    private double imgY = 0;
    private bool isDragging = false;
    private double startDragX = 0;
    private double startDragY = 0;

    // 모달 열기 (썸네일 버튼 등에서 호출)
    private void OpenImageModal(string imageUrl)
    {
        currentLargeImageUrl = imageUrl;
        ResetImageTransform();
        showImageModal = true;
    }

    // 모달 닫기
    private void CloseImageModal()
    {
        showImageModal = false;
        currentLargeImageUrl = string.Empty;
    }

    // 줌 및 위치 초기화
    private void ResetImageTransform()
    {
        imgScale = 1.0;
        imgX = 0;
        imgY = 0;
    }

    // [+] [-] 버튼 확대/축소
    private void ZoomIn() => imgScale = Math.Min(imgScale + 0.2, 5.0);
    private void ZoomOut() => imgScale = Math.Max(imgScale - 0.2, 0.5);

    // 마우스 휠: 확대/축소 (공통)
    private void HandleWheel(WheelEventArgs e)
    {
        if (e.DeltaY < 0) imgScale = Math.Min(imgScale + 0.1, 5.0);
        else imgScale = Math.Max(imgScale - 0.1, 0.5);
    }

    // 마우스 클릭: 드래그 시작
    private void HandleMouseDown(MouseEventArgs e)
    {
        isDragging = true;
        startDragX = e.ClientX - imgX;
        startDragY = e.ClientY - imgY;
    }

    // 마우스 이동: 이미지 팬(Pan)
    private void HandleMouseMove(MouseEventArgs e)
    {
        if (isDragging)
        {
            imgX = e.ClientX - startDragX;
            imgY = e.ClientY - startDragY;
        }
    }

    // 마우스 떼기: 드래그 종료
    private void HandleMouseUp(MouseEventArgs e) => isDragging = false;

    // =====================================================
    // 공통 UI / 탭 변수 (한 번만 선언)
    // =====================================================
    private string activeTab = "single";
    // ???????????????????????????????????????????
    // TAB 1: 단일 영수증 업로드 (ReceiptUpload.razor)
    // ???????????????????????????????????????????
    private UploadedReceipt newReceipt = new() { ReceiptDate = DateTime.Now };
    private decimal? inputAmount = null;
    private IBrowserFile? selectedFile;
    private string selectedFileName = "";
    private string? previewImageUrl = null;
    private bool isUploading = false;
    private bool isOcrProcessing = false;
    private const long MaxFileSize = GlobalConstants.MaxSingleFileSize;
    private int currentOcrUsage = 0;

    // ???????????????????????????????????????????
    // TAB 2: 일괄 영수증 업로드 (ReceiptMultiUpload.razor)
    // ???????????????????????????????????????????
    private List<ReceiptFileUploadModel> fileStatuses = new();
    private bool isProcessing = false;
    private int processedCount = 0;
    private const int MaxAllowedFiles = 20;
    private const long MaxMultiFileSize = GlobalConstants.MaxMultiFileSize;

    // ???????????????????????????????????????????
    // TAB 3: 엑셀 내역 업로드 (BankImport.razor)
    // ???????????????????????????????????????????
    private int UserDepartmentId => CurrentUser?.DepartmentId ?? 0;
    private string UserDepartmentName => CurrentUser?.Department?.Name ?? "";
    private DateTime? LastTransactionDate = null;

    private static List<LedgerEntry> _savedPreviewList = new();
    private static string _savedCurrentTab = GlobalConstants.TransactionTypeExpense;

    private List<CategoryMapping> autoRules = new();
    private bool isLoading = false;
    private bool isSaving = false;
    private bool isLedgerImporting = false;

    private List<string> IncomeCats = new();
    private List<string> ExpenseCats = new();

    private string searchUnclassified = "";
    private string searchPreview = "";
    private string batchSelectedCategory = "";
    private HashSet<LedgerEntry> selectedUnclassified = new();
    private LedgerEntry? draggedItem;

    // ???????????????????????????????????????????
    // TAB 4: 장부 매칭 (ReceiptQuery + MonthlyLedger 병합)
    // ???????????????????????????????????????????
    private bool CanViewAll => CurrentUser?.Role == "Admin" || CurrentUser?.Role == "Auditor" || CurrentUser?.Department?.Name == "교육국" || CurrentUser?.Department?.Name == "관리자";
    private int adminSelectedDeptId = 0;

    private List<UploadedReceipt> pendingReceipts = new();
    private List<LedgerEntry> unmatchedEntries = new();
    private Dictionary<int, int> selectedMatchDict = new();

    private int SearchDeptId = 0;
    private string SearchKeyword = "";
    private List<Department> allDepts = new();
    private List<LedgerEntry> searchResults = new();

    // 장부 매칭 탭 전용 UI 상태
    private int matchingFilterMonth = 0;
    private UploadedReceipt? selectedMatchingReceipt = null;
    private HashSet<int> selectedMatchingReceiptIds = new();
    private int selectedMatchingEntryId = 0;

    // ???????????????????????????????????????????
    // 초기화
    // ???????????????????????????????????????????
    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser == null) return;

        await LoadOcrUsage();

        using var context = DbContextFactory.CreateDbContext();

        if (UserDepartmentId > 0)
        {
            autoRules = await Accounting.GetMappingsAsync(UserDepartmentId);
            LastTransactionDate = await Accounting.GetLastTransactionDateAsync(UserDepartmentId);

            int currentYear = DateTime.Now.Year;
            var budgetPlans = await context.BudgetPlans.AsNoTracking().Where(b => b.DepartmentId == UserDepartmentId && b.Year == currentYear).ToListAsync();

            IncomeCats = budgetPlans.Where(b => b.Type == "Income" || b.Type == "수입").Select(b => b.Category).Distinct().ToList();
            ExpenseCats = budgetPlans.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();

            if (!IncomeCats.Any()) IncomeCats = new List<string> { "주일헌금", "찬조금", "이월금", "교회보조금", "은행이자", "회비수입", "환급금" };
            if (!ExpenseCats.Any()) ExpenseCats = new List<string> { "행사비", "공과비", "교육활동비", "여름성경학교", "운영비", "간식비", "부서관리비", "교사회의비", "훈련비" };
        }

        allDepts = await context.Departments.AsNoTracking().OrderBy(d => d.Id).ToListAsync();
        await LoadPendingReceipts();
    }

    private async Task ActivateMatchingTab()
    {
        activeTab = "matching";
        await LoadPendingReceipts();
    }

// 🚀 빈 장부 복원 양식 다운로드 기능 (월별장부 출력 양식과 동일하게 수정)
private async Task DownloadLedgerTemplate()
{
    try
    {
        using var workbook = new XLWorkbook();
        var ws = workbook.Worksheets.Add("장부양식");
        
        // 1. 1번행: 컬럼명 (헤더)
        // 월별장부 표준 컬럼: 날짜, 항목, 적요(내역), 수입, 지출, 잔액, 비고
        var headers = new[] { "날짜", "항목", "적요", "수입", "지출", "잔액", "비고" };
        for (int i = 0; i < headers.Length; i++)
        {
            var cell = ws.Cell(1, i + 1);
            cell.Value = headers[i];
            cell.Style.Fill.BackgroundColor = XLColor.LightGray;
            cell.Style.Font.Bold = true;
            cell.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            cell.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
        }

        // 2. 2번행: 이월금 (전월이월 데이터)
        // 업로드 시 이 행은 자동으로 스킵되도록 설정되어 있습니다.
        ws.Cell(2, 1).Value = DateTime.Now.ToString("yyyy-MM-01"); // 해당 월 1일
        ws.Cell(2, 2).Value = "이월금";
        ws.Cell(2, 3).Value = "전월이월";
        ws.Cell(2, 4).Value = 0; // 수입
        ws.Cell(2, 5).Value = 0; // 지출
        ws.Cell(2, 6).Value = 0; // 잔액
        ws.Cell(2, 7).Value = "※ 이 행은 이월금 행으로 업로드 시 제외됩니다.";
        ws.Row(2).Style.Font.FontColor = XLColor.Gray;

        // 3. 3번행: 가이드라인/예시 데이터
        // 여기서부터 실제 데이터로 인식되어 DB에 저장됩니다.
        ws.Cell(3, 1).Value = DateTime.Now.ToString("yyyy-MM-dd");
        ws.Cell(3, 2).Value = "소모품비";
        ws.Cell(3, 3).Value = "사무용지 구입 (예시 데이터)";
        ws.Cell(3, 4).Value = 0;
        ws.Cell(3, 5).Value = 15000;
        ws.Cell(3, 6).Value = -15000;
        ws.Cell(3, 7).Value = "비고란입니다.";

        // 테두리 및 서식 설정
        var dataRange = ws.Range(1, 1, 3, headers.Length);
        dataRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
        dataRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;

        // 숫자에 천단위 콤마 서식 적용 (수입, 지출, 잔액)
        ws.Column(4).Style.NumberFormat.Format = "#,##0";
        ws.Column(5).Style.NumberFormat.Format = "#,##0";
        ws.Column(6).Style.NumberFormat.Format = "#,##0";

        // 칸 너비 자동으로 맞추거나 수동 조절
        ws.Column(1).Width = 15; // 날짜
        ws.Column(2).Width = 15; // 항목
        ws.Column(3).Width = 35; // 적요
        ws.Column(4).Width = 12; // 수입
        ws.Column(5).Width = 12; // 지출
        ws.Column(6).Width = 12; // 잔액
        ws.Column(7).Width = 25; // 비고

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        var base64 = Convert.ToBase64String(stream.ToArray());
        
        await JSRuntime.InvokeVoidAsync("downloadExcelFile", "회계장부_복원용_양식.xlsx", base64);
    }
    catch (Exception ex)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"양식 다운로드 오류: {ex.Message}");
    }
}

    // ???????????????????????????????????????????
    // TAB 1 메서드: 단일 영수증 업로드 (ReceiptUpload.razor 그대로)
    // ???????????????????????????????????????????
    private async Task LoadOcrUsage()
    {
        string currentMonth = DateTime.Now.ToString("yyyy-MM");
        using var context = DbContextFactory.CreateDbContext();
        var usage = await context.OcrUsages.AsNoTracking().FirstOrDefaultAsync(u => u.YearMonth == currentMonth);
        currentOcrUsage = usage?.UsageCount ?? 0;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            selectedFile = e.File;
            selectedFileName = selectedFile.Name;
            previewImageUrl = null;
            ResetImageTransform(); // 새 이미지 로드 시 줌 위치 초기화

            // [1단계] 미리보기: 크기 무관하게 비 HEIC 파일인 경우 항상 먼저 실행
            if (!selectedFileName.ToLower().EndsWith(".heic"))
            {
                try
                {
                    var previewImage = await selectedFile.RequestImageFileAsync("image/jpeg", 800, 800);
                    using var ms = new MemoryStream();
                    await previewImage.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024).CopyToAsync(ms);
                    previewImageUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";

                    // OCR 시작 전에 미리보기 썸네일부터 즉시 화면에 렌더링
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"미리보기 로드 실패: {ex.Message}");
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "HEIC 형식은 브라우저 미리보기가 지원되지 않습니다. 변환 후 업로드해 주세요.");
                StateHasChanged();
            }

            // [2단계] OCR: 5MB 미만 및 비 HEIC 파일에만 실행
            if (selectedFile.Size < 5 * 1024 * 1024 && !selectedFileName.ToLower().EndsWith(".heic"))
            {
                isOcrProcessing = true;
                StateHasChanged(); // 스피너(AI 읽는 중) 표시

                try
                {
                    using var stream = selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                    using var memoryStream = new MemoryStream();
                    await stream.CopyToAsync(memoryStream);
                    var imageBytes = memoryStream.ToArray();

                    var ocrResult = await OcrService.ProcessReceiptAsync(imageBytes);

                    if (ocrResult.IsSuccess)
                    {
                        if (ocrResult.Date.HasValue) newReceipt.ReceiptDate = ocrResult.Date.Value;
                        if (ocrResult.Amount.HasValue && ocrResult.Amount.Value > 0) inputAmount = ocrResult.Amount.Value;
                        if (!string.IsNullOrEmpty(ocrResult.Description)) newReceipt.Description = ocrResult.Description;

                        await JSRuntime.InvokeVoidAsync("alert", "AI가 영수증 정보를 인식했습니다.\n입력된 금액과 날짜가 정확한지 확인해 주세요!");
                    }
                    else
                    {
                        await JSRuntime.InvokeVoidAsync("alert", $"OCR 알림: {ocrResult.ErrorMessage}\n\n(사진은 정상적으로 선택되었습니다. 수동으로 입력해 주세요.)");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine("OCR 변환 실패: " + ex.Message);
                }
                finally
                {
                    isOcrProcessing = false;
                    await LoadOcrUsage();
                    StateHasChanged(); // OCR 스피너 제거 및 결과 반영
                }
            }
            else if (selectedFile.Size >= 5 * 1024 * 1024)
            {
                // 5MB 이상의 고용량 사진은 미리보기만 보여주고 OCR 패스 안내
                await JSRuntime.InvokeVoidAsync("alert", "파일 크기가 5MB 이상이라 AI 자동 판독은 생략됩니다. 금액과 내역을 수동으로 입력해 주세요.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"파일 선택 오류: {ex.Message}");
        }
    }

    private async Task UploadReceipt()
    {
        if (CurrentUser == null) return;
        if (selectedFile == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "영수증 사진을 첨부해 주세요."); return;
        }
        if (!inputAmount.HasValue || inputAmount.Value <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "정확한 결제 금액을 입력해 주세요."); return;
        }
        if (string.IsNullOrWhiteSpace(newReceipt.Description))
        {
            newReceipt.Description = "내역 없음";
        }
        if (CurrentUser.Role == "Admin" && adminSelectedDeptId == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "부서를 선택해주세요."); return;
        }

        int targetDeptId = CurrentUser.Role == "Admin" ? adminSelectedDeptId : CurrentUser.DepartmentId;

        isUploading = true;
        StateHasChanged();

        try
        {
            string fileName = FileService.BuildReceiptFileName(CurrentUser.DepartmentId, ".jpg");
            await FileService.SaveBrowserFileAsync(selectedFile, fileName, MaxFileSize);

            newReceipt.Amount = inputAmount.Value;
            newReceipt.DepartmentId = targetDeptId;
            newReceipt.ImagePath = FileService.BuildReceiptRelativePath(fileName);

            using var context = DbContextFactory.CreateDbContext();
            context.UploadedReceipts.Add(newReceipt);
            await context.SaveChangesAsync();

            await JSRuntime.InvokeVoidAsync("alert", "영수증 업로드가 완료되었습니다!");

