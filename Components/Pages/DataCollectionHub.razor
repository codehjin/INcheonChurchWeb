    private async Task ManualMatchSingle()
    {
        if (_selectedMatchingReceipt == null || _selectedMatchingEntryId == 0)
        {
            await JSRuntime.AlertAsync("영수증과 장부 내역을 모두 선택해주세요.");
            return;
        }

        using var context = DbContextFactory.CreateDbContext();

        var receipt = await context.UploadedReceipts.FindAsync(_selectedMatchingReceipt.Id);
        if (receipt == null) return;

        var entry = await context.Transactions.FindAsync(_selectedMatchingEntryId);
        if (entry == null)
        {
            await JSRuntime.AlertAsync("해당 장부 내역을 찾을 수 없습니다. 삭제되었을 수 있습니다.");
            return;
        }

        string oldRelativePath = receipt.ImagePath;

        if (File.Exists(FileService.GetPhysicalPathFromRelative(oldRelativePath)))
        {
            string deptName = _allDepts.FirstOrDefault(d => d.Id == entry.DepartmentId)?.Name ?? "알수없음";
            string safeDescription = string.Concat((entry.Description ?? "내역없음").Split(Path.GetInvalidFileNameChars()));
            safeDescription = safeDescription.Replace(" ", "");

            decimal targetAmount = entry.Expense > 0 ? entry.Expense : entry.Income;
            string newFileName = $"{entry.Date:yyyyMMdd}_{deptName}_{entry.Category}_{targetAmount}원_{safeDescription}_{receipt.Id}{Path.GetExtension(oldRelativePath)}";

            try
            {
                FileService.TryMoveByRelativePath(oldRelativePath, newFileName, out var newRelativePath);
                entry.ReceiptUrl = newRelativePath;
                receipt.ImagePath = newRelativePath;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"파일명 변경 실패: {ex.Message}");
                entry.ReceiptUrl = oldRelativePath;
            }
        }
        else
        {
            entry.ReceiptUrl = oldRelativePath;
        }

        receipt.IsMatched = true;

        context.Transactions.Update(entry);
        context.UploadedReceipts.Update(receipt);
        await context.SaveChangesAsync();

        await JSRuntime.AlertAsync("영수증이 장부 내역과 성공적으로 연결되었습니다!");

        _selectedMatchingEntryId = 0;
        _selectedMatchingReceipt = null;
        _selectedMatchingReceiptIds.Clear();

        await LoadPendingReceipts();
    }

    // 자동 매칭 (MonthlyLedger.razor의 AutoMatchReceipts 로직 적용)
    private async Task AutoMatchReceipts()
    {
        int count = 0;
        var receipts = GetFilteredPendingReceipts().ToList();
        var entries = _unmatchedEntries.ToList();

        foreach (var r in receipts)
        {
            var exact = entries.Where(e => e.Date.Date == r.ReceiptDate.Date && e.Expense == r.Amount).ToList();
            LedgerEntry? target = null;
            if (exact.Count == 1) target = exact.First();
            else if (exact.Count > 1 && !string.IsNullOrWhiteSpace(r.Description))
            {
                string rd = r.Description.Replace(" ", "");
                target = exact.FirstOrDefault(e => e.Description != null && (e.Description.Replace(" ", "").Contains(rd) || rd.Contains(e.Description.Replace(" ", ""))));
            }
            if (target != null)
            {
                using var context = DbContextFactory.CreateDbContext();
                var dbReceipt = await context.UploadedReceipts.FindAsync(r.Id);
                var dbEntry = await context.Transactions.FindAsync(target.Id);
                if (dbReceipt != null && dbEntry != null)
                {
                    dbEntry.ReceiptUrl = r.ImagePath;
                    dbReceipt.IsMatched = true;
                    await context.SaveChangesAsync();
                    count++;
                    entries.Remove(target);
                }
            }
        }

        await JSRuntime.AlertAsync($"자동 매칭 완료: {count}건 연결.");
        await LoadPendingReceipts();
    }

private async Task DeleteReceipt(int id)
    {
        bool confirmed = await JSRuntime.ConfirmAsync("이 영수증을 삭제(반려)하시겠습니까?\n서버에서도 파일이 완전히 삭제됩니다.");
        if (confirmed)
        {
            using var context = DbContextFactory.CreateDbContext();
            var target = await context.UploadedReceipts.FindAsync(id);
            if (target != null)
            {
                FileService.DeleteByRelativePath(target.ImagePath);

                context.UploadedReceipts.Remove(target);
                await context.SaveChangesAsync();
                await LoadPendingReceipts();
            }
        }
    }

private async Task SearchData()
{
    using var context = DbContextFactory.CreateDbContext();
    var query = context.Transactions.AsNoTracking().AsQueryable();
    if (CanViewAll && _searchDeptId > 0)
    {
        query = query.Where(t => t.DepartmentId == _searchDeptId);
    }
    else if (!CanViewAll && CurrentUser != null)
    {
        query = query.Where(t => t.DepartmentId == CurrentUser.DepartmentId);
    }

    if (!string.IsNullOrWhiteSpace(_searchKeyword))
    {
        query = query.Where(t => (t.Description != null && t.Description.Contains(_searchKeyword)) || (!string.IsNullOrEmpty(t.Note) && t.Note.Contains(_searchKeyword)));
    }

    query = query.Where(t => t.ReceiptUrl == null || t.ReceiptUrl == "");
    _unmatchedEntries = await query.OrderByDescending(t => t.Date).Take(100).ToListAsync();
}

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchData();
    }
}