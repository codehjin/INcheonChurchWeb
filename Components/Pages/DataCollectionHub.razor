    private async Task ProcessAllFiles()
    {
        if (CurrentUser == null) return;
        isProcessing = true;
        processedCount = 0;

        foreach (var fileModel in fileStatuses)
        {
            fileModel.Status = ReceiptFileStatus.Processing;
            StateHasChanged();

            try
            {
                using var memoryStream = new MemoryStream();
                await fileModel.File.OpenReadStream(maxAllowedSize: MaxMultiFileSize).CopyToAsync(memoryStream);
                var imageBytes = memoryStream.ToArray();

                var ocrResult = await OcrService.ProcessReceiptAsync(imageBytes);

                if (ocrResult.IsSuccess)
                {
                    fileModel.ParsedDate = ocrResult.Date;
                    fileModel.ParsedAmount = ocrResult.Amount ?? 0;
                    fileModel.ParsedDescription = ocrResult.Description;
                    fileModel.Status = ReceiptFileStatus.Success;
                }
                else
                {
                    fileModel.Status = ReceiptFileStatus.Failed;
                }

                string ext = Path.GetExtension(fileModel.FileName);
                if (string.IsNullOrEmpty(ext)) ext = ".jpg";
                string newFileName = FileService.BuildReceiptFileName(CurrentUser.DepartmentId, ext, includeMilliseconds: true);

                await FileService.SaveBytesAsync(imageBytes, newFileName);

                var newUploadedReceipt = new UploadedReceipt
                {
                    DepartmentId = CurrentUser.DepartmentId,
                    ImagePath = FileService.BuildReceiptRelativePath(newFileName),
                    ReceiptDate = fileModel.ParsedDate ?? DateTime.Now,
                    Amount = fileModel.ParsedAmount,
                    Description = fileModel.ParsedDescription ?? ""
                };

                using var context = DbContextFactory.CreateDbContext();
                context.UploadedReceipts.Add(newUploadedReceipt);
                await context.SaveChangesAsync();

                await JSRuntime.InvokeVoidAsync("alert", $"{fileModel.FileName} : AI 분석 및 서버 전송 완료!");
            }
            catch (Exception)
            {
                fileModel.Status = ReceiptFileStatus.Failed;
            }

            processedCount++;
            StateHasChanged();
        }

        isProcessing = false;
        await JSRuntime.InvokeVoidAsync("alert", $"{processedCount}장의 영수증 처리가 완료되었습니다.\n월별 장부 화면에서 '자동 매치' 또는 '수동 매치'를 진행해 주세요!");
    }

