    private async Task ProcessAllFiles()
    {
        if (CurrentUser == null) return;
        _isProcessing = true;
        _processedCount = 0;

        foreach (var fileModel in _fileStatuses)
        {
            fileModel.Status = ReceiptFileStatus.Processing;
            StateHasChanged();

            try
            {
                using var memoryStream = new MemoryStream();
                await fileModel.File.OpenReadStream(maxAllowedSize: MaxMultiFileSize).CopyToAsync(memoryStream);
                var imageBytes = memoryStream.ToArray();

                var ocrResult = await OcrService.ProcessReceiptAsync(imageBytes);

                if (ocrResult.IsSuccess)
                {
                    fileModel.ParsedDate = ocrResult.Date;
                    fileModel.ParsedAmount = ocrResult.Amount ?? 0;
                    fileModel.ParsedDescription = ocrResult.Description;
                    fileModel.Status = ReceiptFileStatus.Success;
                }
                else
                {
                    fileModel.Status = ReceiptFileStatus.Failed;
                }

                await Accounting.SaveUploadedReceiptAsync(
                    FileService, imageBytes, fileModel.FileName, CurrentUser.DepartmentId,
                    fileModel.ParsedDate ?? DateTime.Now, fileModel.ParsedAmount, fileModel.ParsedDescription);

                await JSRuntime.AlertAsync($"{fileModel.FileName} : AI 분석 및 서버 전송 완료!");
            }
            catch (Exception)
            {
                fileModel.Status = ReceiptFileStatus.Failed;
            }

            _processedCount++;
            StateHasChanged();
        }

        _isProcessing = false;
        await LoadOcrUsage(); // 🚀 일괄 처리로 누적된 Vision API 사용량을 화면에 다시 반영
        await JSRuntime.AlertAsync($"{_processedCount}장의 영수증 처리가 완료되었습니다.\n월별 장부 화면에서 '자동 매치' 또는 '수동 매치'를 진행해 주세요!");
    }

