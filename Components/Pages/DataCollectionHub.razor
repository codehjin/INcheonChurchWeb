    private string ClassifyAuto(string text, string type)
    {
        var matched = _autoRules.FirstOrDefault(r => !string.IsNullOrEmpty(r.Keyword) && text.Contains(r.Keyword) && (r.Category != null && (type == GlobalConstants.TransactionTypeIncome ? _incomeCats.Contains(r.Category) : _expenseCats.Contains(r.Category))));
        if (matched != null) return matched.Category;
        return GlobalConstants.CategoryUnclassified;
    }
    private decimal ParseDecimal(string? value) { if (string.IsNullOrWhiteSpace(value)) return 0; decimal.TryParse(value.Replace("\"", "").Replace(",", ""), out decimal r); return r; }

    private async Task SaveToLedger()
    {
        if (!_savedPreviewList.Any()) return;

        // 1. 미분류 항목 체크
        if (_savedPreviewList.Any(x => x.Category == GlobalConstants.CategoryUnclassified))
        {
            await JSRuntime.AlertAsync("미분류 항목을 모두 처리해주세요!");
            return;
        }

        using var context = DbContextFactory.CreateDbContext();

        // 2. 중복 내역 확인 (날짜, 수입, 지출 금액이 모두 일치하는 경우)
        var existingTrans = await context.Transactions
            .Where(t => t.DepartmentId == UserDepartmentId)
            .ToListAsync();

        var duplicates = _savedPreviewList
            .Where(item => existingTrans.Any(t =>
                t.Date.Date == item.Date.Date &&
                t.Income == item.Income &&
                t.Expense == item.Expense))
            .ToList();

        // 3. 중복 발생 시 사용자 확인
        if (duplicates.Any())
        {
            bool overwrite = await JSRuntime.ConfirmAsync(
                $"⚠️ 장부에 이미 등록된 내역과 일치하는 데이터가 {duplicates.Count}건 발견되었습니다.\n\n" +
                "기존 내역을 삭제하고 현재 리스트로 덮어쓰시겠습니까?\n" +
                "(취소를 누르면 저장이 중단됩니다.)");

            if (!overwrite) return;

            // 기존 중복 데이터 제거 로직
            foreach (var dup in duplicates)
            {
                var toDelete = existingTrans.Where(t =>
                    t.Date.Date == dup.Date.Date &&
                    t.Income == dup.Income &&
                    t.Expense == dup.Expense).ToList();
                context.Transactions.RemoveRange(toDelete);
            }
            await context.SaveChangesAsync();
        }
        else
        {
            // 중복이 없는 경우 일반적인 저장 확인
            if (!await JSRuntime.ConfirmAsync($"{_savedPreviewList.Count}건을 장부에 저장하시겠습니까?"))
                return;
        }

        // 4. 최종 저장 실행
        _isSaving = true;
        try
        {
            // 중복 제거 후 남은/새로운 데이터 추가
            await Accounting.AddTransactionsAsync(_savedPreviewList);
            ClearWorkData();
            await JSRuntime.AlertAsync("성공적으로 저장되었습니다!");
            Nav.NavigateTo("/monthly");
        }
        catch (Exception ex)
        {
            await JSRuntime.AlertAsync($"저장 중 오류가 발생했습니다: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

