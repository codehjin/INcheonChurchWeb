    private async Task LoadPendingReceipts()
    {
        if (CurrentUser == null) return;

        int deptId = CurrentUser.DepartmentId;

        // 1. 모바일 미처리 영수증 불러오기
        pendingReceipts = await DbContext.UploadedReceipts
            .Where(r => r.DepartmentId == deptId && r.IsMatched == false)
            .OrderByDescending(r => r.ReceiptDate)
            .ToListAsync();

        // 2. 현재 부서의 장부 내역 중 영수증(ReceiptUrl)이 비어있는 항목 불러오기
        unmatchedEntries = await DbContext.Transactions.AsNoTracking()
            .Where(t => t.DepartmentId == deptId && (t.ReceiptUrl == null || t.ReceiptUrl == ""))
            .OrderByDescending(t => t.Date).ToListAsync();

        selectedMatchDict.Clear();
        foreach (var r in pendingReceipts)
        {
            selectedMatchDict[r.Id] = 0;
        }

        // 매칭 탭 UI 초기화
        selectedMatchingReceiptIds.Clear();
        selectedMatchingEntryId = 0;
        if (pendingReceipts.Any())
        {
            selectedMatchingReceipt = pendingReceipts.First();
        }
        else
        {
            selectedMatchingReceipt = null;
        }
    }

    private List<UploadedReceipt> GetFilteredPendingReceipts()
    {
        if (matchingFilterMonth == 0) return pendingReceipts;
        return pendingReceipts.Where(r => r.ReceiptDate.Month == matchingFilterMonth).ToList();
    }

