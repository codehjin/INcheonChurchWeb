    private async Task ManualMatchSingle()
    {
        if (selectedMatchingReceipt == null || selectedMatchingEntryId == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "영수증과 장부 내역을 모두 선택해주세요.");
            return;
        }

        var receipt = await DbContext.UploadedReceipts.FindAsync(selectedMatchingReceipt.Id);
        if (receipt == null) return;

        var entry = await DbContext.Transactions.FindAsync(selectedMatchingEntryId);
        if (entry == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "해당 장부 내역을 찾을 수 없습니다. 삭제되었을 수 있습니다.");
            return;
        }

        // 파일명 스마트 변경 로직 (ReceiptQuery.razor의 MatchReceiptToEntry 로직)
        string oldRelativePath = receipt.ImagePath;
        string oldPhysicalPath = Path.Combine(Env.WebRootPath, oldRelativePath.TrimStart('/'));

        if (File.Exists(oldPhysicalPath))
        {
            string deptName = allDepts.FirstOrDefault(d => d.Id == entry.DepartmentId)?.Name ?? "알수없음";
            string safeDescription = string.Concat((entry.Description ?? "내역없음").Split(Path.GetInvalidFileNameChars()));
            safeDescription = safeDescription.Replace(" ", "");

            decimal targetAmount = entry.Expense > 0 ? entry.Expense : entry.Income;
            string newFileName = $"{entry.Date:yyyyMMdd}_{deptName}_{entry.Category}_{targetAmount}원_{safeDescription}_{receipt.Id}{Path.GetExtension(oldPhysicalPath)}";

            string newRelativePath = $"/uploads/receipts/{newFileName}";
            string newPhysicalPath = Path.Combine(Env.WebRootPath, "uploads", "receipts", newFileName);

            try
            {
                File.Move(oldPhysicalPath, newPhysicalPath);
                entry.ReceiptUrl = newRelativePath;
                receipt.ImagePath = newRelativePath;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"파일명 변경 실패: {ex.Message}");
                entry.ReceiptUrl = oldRelativePath;
            }
        }
        else
        {
            entry.ReceiptUrl = oldRelativePath;
        }

        receipt.IsMatched = true;

        DbContext.Transactions.Update(entry);
        DbContext.UploadedReceipts.Update(receipt);
        await DbContext.SaveChangesAsync();

        await JSRuntime.InvokeVoidAsync("alert", "영수증이 장부 내역과 성공적으로 연결되었습니다!");

        selectedMatchingEntryId = 0;
        selectedMatchingReceipt = null;
        selectedMatchingReceiptIds.Clear();

        await LoadPendingReceipts();
    }

    // 자동 매칭 (MonthlyLedger.razor의 AutoMatchReceipts 로직 적용)
    private async Task AutoMatchReceipts()
    {
        int count = 0;
        var receipts = GetFilteredPendingReceipts().ToList();
        var entries = unmatchedEntries.ToList();

        foreach (var r in receipts)
        {
            var exact = entries.Where(e => e.Date.Date == r.ReceiptDate.Date && e.Expense == r.Amount).ToList();
            LedgerEntry? target = null;
            if (exact.Count == 1) target = exact.First();
            else if (exact.Count > 1 && !string.IsNullOrWhiteSpace(r.Description))
            {
                string rd = r.Description.Replace(" ", "");
                target = exact.FirstOrDefault(e => e.Description != null && (e.Description.Replace(" ", "").Contains(rd) || rd.Contains(e.Description.Replace(" ", ""))));
            }
            if (target != null)
            {
                var dbReceipt = await DbContext.UploadedReceipts.FindAsync(r.Id);
                var dbEntry = await DbContext.Transactions.FindAsync(target.Id);
                if (dbReceipt != null && dbEntry != null)
                {
                    dbEntry.ReceiptUrl = r.ImagePath;
                    dbReceipt.IsMatched = true;
                    await DbContext.SaveChangesAsync();
                    count++;
                    entries.Remove(target);
                }
            }
        }

        await JSRuntime.InvokeVoidAsync("alert", $"자동 매칭 완료: {count}건 연결.");
        await LoadPendingReceipts();
    }

    private async Task DeleteReceipt(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "이 영수증을 삭제(반려)하시겠습니까?\n서버에서도 파일이 완전히 삭제됩니다.");
        if (confirmed)
        {
            var target = await DbContext.UploadedReceipts.FindAsync(id);
            if (target != null)
            {
                string filePath = Path.Combine(Env.WebRootPath, target.ImagePath.TrimStart('/'));
                if (File.Exists(filePath)) File.Delete(filePath);

                DbContext.UploadedReceipts.Remove(target);
                await DbContext.SaveChangesAsync();
                await LoadPendingReceipts();
            }
        }
    }

    private async Task SearchData()
    {
        var query = DbContext.Transactions.AsNoTracking().AsQueryable();
        if (CanViewAll && SearchDeptId > 0)
        {
            query = query.Where(t => t.DepartmentId == SearchDeptId);
        }
        else if (!CanViewAll && CurrentUser != null)
        {
            query = query.Where(t => t.DepartmentId == CurrentUser.DepartmentId);
        }

        if (!string.IsNullOrWhiteSpace(SearchKeyword))
        {
            query = query.Where(t => (t.Description != null && t.Description.Contains(SearchKeyword)) || (!string.IsNullOrEmpty(t.Note) && t.Note.Contains(SearchKeyword)));
        }

        // 장부 매칭 탭에서는 미증빙 내역만 필터
        query = query.Where(t => t.ReceiptUrl == null || t.ReceiptUrl == "");

        unmatchedEntries = await query.OrderByDescending(t => t.Date).Take(100).ToListAsync();
    }

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if (e.Key == "Enter") await SearchData(); }

