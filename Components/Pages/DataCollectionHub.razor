            await JSRuntime.InvokeVoidAsync("downloadExcelFile", "월별장부_빈양식.xlsx", base64);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"양식 다운로드 오류: {ex.Message}");
        }
    }

