@page "/expense-report-quarterly"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using System.Text.Json
@inject AccountingService AccService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

@* ══════════════════════════════════════════
   화면 전용 UI (인쇄 시 숨김)
══════════════════════════════════════════ *@
<div class="no-print" style="background-color: #fbfaee; min-height: 100vh; padding-bottom: 7rem;">
    <div class="container-fluid px-2 px-md-0 pt-4">

        @* ── 페이지 헤더 ── *@
        <div class="mb-4">
            <h2 class="fw-bold mb-1" style="color: #1b1c15; font-family: 'Manrope', sans-serif; font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -0.02em;">지출결의서 작성</h2>
            <p class="mb-0" style="color: #4e4637; font-size: 1.2rem;">예산 범위 내에서 지출 내역을 작성하고 결재를 요청하세요.</p>
        </div>

        @* ── 기존 신청 내역 (수평 스크롤 카드) ── *@
        <div class="mb-5">
            <div class="d-flex align-items-end justify-content-between mb-3">
                <div>
                    <span class="d-block mb-1" style="font-size: 1.2rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">기 신청내역</span>
                    <span style="font-size: 1rem; color: #807666; font-style: italic;">* 항목 클릭 시 현재 폼으로 데이터가 복사됩니다.</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center rounded px-2 py-1" style="background-color: #f5f4e8;">
                        <button class="btn btn-sm p-1" style="color: #4e4637; background: none; border: none; font-weight: 700;" @onclick="PrevYear">◀</button>
                        <span class="fw-bold px-2" style="color: #5a4000; font-variant-numeric: tabular-nums; min-width: 60px; text-align: center;">@(_targetYear)</span>
                        <button class="btn btn-sm p-1" style="color: #4e4637; background: none; border: none; font-weight: 700;" @onclick="NextYear">▶</button>
                    </div>
                    <button class="px-3 py-2 fw-bold" style="background: linear-gradient(135deg, #785600 0%, #5a4000 100%); color: #fff; border: none; border-radius: 0.25rem; font-size: 0.8rem; transition: transform 0.15s ease-out;" @onclick="NewReport">
                        <i class="bi bi-plus-circle me-1"></i>신규 작성
                    </button>
                </div>
            </div>

            <div class="d-flex gap-3 pb-3" style="overflow-x: auto;">
                @if (_reportHistory.Count > 0)
                {
                    @foreach (var report in _reportHistory)
                    {
                        <div class="flex-shrink-0 p-3 px-4" style="background-color: @(_currentReport.Id == report.Id ? "#eae9dd" : "#f5f4e8"); border-radius: 0.25rem; cursor: pointer; transition: all 0.2s ease-out; min-width: 180px;" @onclick="() => LoadReport(report)">
                            <div class="fw-bold mb-1" style="color: #5a4000; font-size: 0.8125rem;">@report.Title</div>
                            <div style="font-size: 0.6875rem; color: #4e4637; font-variant-numeric: tabular-nums;">@report.Date.ToString("yyyy-MM-dd") · ₩ @report.TotalAmount.ToString("N0")</div>
                            <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-sm p-0" style="color: #5a4000; font-size: 0.6875rem; font-weight: 700; background: none; border: none;" @onclick:stopPropagation="true" @onclick="() => LoadReport(report)">수정</button>
                                <button class="btn btn-sm p-0" style="color: #ba1a1a; font-size: 0.6875rem; font-weight: 700; background: none; border: none;" @onclick:stopPropagation="true" @onclick="() => DeleteReport(report)">삭제</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-4 text-center w-100" style="color: #807666; background-color: #f5f4e8; border-radius: 0.375rem;">해당 연도의 신청 내역이 없습니다.</div>
                }
            </div>
        </div>

        @* ── 통계 카드 ── *@
        <div class="row g-3 mb-5">
            <div class="col-6 col-md-3">
                <div class="p-4" style="background-color: #f5f4e8; border-radius: 0.375rem;">
                    <span class="d-block mb-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">총 예산 (보조금)</span>
                    <span class="fw-bold" style="font-size: 1.25rem; font-variant-numeric: tabular-nums; color: #1b1c15;">₩ @_totalBudget.ToString("N0")</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-4" style="background-color: #f5f4e8; border-radius: 0.375rem;">
                    <span class="d-block mb-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">기 신청액</span>
                    <span class="fw-bold" style="font-size: 1.25rem; font-variant-numeric: tabular-nums; color: #1b1c15; opacity: 0.7;">₩ @_usedBudget.ToString("N0")</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-4" style="background-color: #f5f4e8; border-radius: 0.375rem;">
                    <span class="d-block mb-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">이번 신청액</span>
                    <span class="fw-bold" style="font-size: 1.25rem; font-variant-numeric: tabular-nums; color: #5a4000;">₩ @CurrentRequestTotal.ToString("N0")</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-4" style="background-color: rgba(90, 64, 0, 0.05); border-radius: 0.375rem;">
                    <span class="d-block mb-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">신청 후 잔액</span>
                    <span class="fw-bold" style="font-size: 1.25rem; font-variant-numeric: tabular-nums; color: @((_totalBudget - _usedBudget - CurrentRequestTotal) < 0 ? "#ba1a1a" : "#1b1c15");">₩ @((_totalBudget - _usedBudget - CurrentRequestTotal).ToString("N0"))</span>
                </div>
            </div>
        </div>

        @* ── 좌우 분할 레이아웃 컨테이너 (PC는 좌/우, 모바일은 상/하) ── *@
        <div class="row g-4 g-xl-5 mb-5 align-items-start">

            @* =========================================
               [좌측 영역] 입력 폼 및 상세 내역
            ========================================= *@
            <div class="col-lg-7">

                @* ── 입력 영역 (No-Line Input) ── *@
                <div class="mb-5">
                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <label class="d-block mb-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">문서 제목 (청구인)</label>
                            <input type="text" class="form-control er-noline-input fs-5 fw-medium" @bind="_currentReport.Title" placeholder="성명을 입력하세요" />
                        </div>
                        <div class="col-md-3">
                            <label class="d-block mb-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">지출 일자</label>
                            <input type="date" class="form-control er-noline-input fs-5" style="font-variant-numeric: tabular-nums;" @bind="_currentReport.Date" />
                        </div>
                        <div class="col-md-5">
                            <label class="d-block mb-2" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">지급 방법</label>
                            <div class="d-flex align-items-center gap-4 pt-1">
                                <label class="d-flex align-items-center gap-2" style="cursor: pointer;">
                                    <input type="radio" name="payMethod" id="payAcc" style="width: 1.125rem; height: 1.125rem; accent-color: #5a4000;"
                                           checked="@(_currentReport.PaymentMethod == "계좌")"
                                           @onchange='() => _currentReport.PaymentMethod = "계좌"' />
                                    <span class="fw-medium" style="color: @(_currentReport.PaymentMethod == "계좌" ? "#5a4000" : "#1b1c15");">계좌이체</span>
                                </label>
                                <label class="d-flex align-items-center gap-2" style="cursor: pointer;">
                                    <input type="radio" name="payMethod" id="payCash" style="width: 1.125rem; height: 1.125rem; accent-color: #5a4000;"
                                           checked="@(_currentReport.PaymentMethod == "현금")"
                                           @onchange='() => _currentReport.PaymentMethod = "현금"' />
                                    <span class="fw-medium" style="color: @(_currentReport.PaymentMethod == "현금" ? "#5a4000" : "#1b1c15");">현금지급</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── 지출 상세 내역 ── *@
                <div class="mb-5">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h4 class="fw-bold mb-0" style="color: #1b1c15; font-size: 1.2rem;">지출 상세 내역</h4>
                        <button class="d-flex align-items-center gap-1 px-3 py-2 fw-bold" style="color: #5a4000; font-size: 1rem; background: none; border: none; border-radius: 0.25rem; transition: background 0.2s;" @onclick="AddOrUpdateItem">
                            <i class="bi bi-plus-circle"></i> @(_isEditing ? "수정완료" : "항목 추가")
                        </button>
                    </div>

                    @* 입력 행 *@
                    <div class="p-4 mb-1 rounded" style="background-color: #eae9dd;">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="d-block mb-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">지출항목</label>
                                <ComboBox @bind-Value="_newItem.Category" Options="_catList" Placeholder="선택/입력" InputClass="form-control er-noline-input ep-input" />
                            </div>
                            <div class="col-md-5">
                                <label class="d-block mb-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">산출근거 (내용)</label>
                                <input class="form-control er-noline-input ep-input" style="ime-mode:active;" @bind="_newItem.CalcDetail" @bind:event="oninput" placeholder="상세 내용" />
                            </div>
                            <div class="col-md-2">
                                <label class="d-block mb-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">청구금액</label>
                                <input type="number" class="form-control er-noline-input ep-input no-spinners text-end fw-bold" @bind="_inputAmount" @bind:event="oninput" placeholder="금액" @onkeyup="EnterKey" />
                            </div>
                            <div class="col-md-2 d-flex gap-2 align-items-end">
                                <button class="flex-grow-1 py-2 fw-bold" style="background: linear-gradient(135deg, #785600 0%, #5a4000 100%); color: #fff; border: none; border-radius: 0.25rem; font-size: 1rem; transition: transform 0.15s ease-out;" @onclick="AddOrUpdateItem">
                                    <i class="@(_isEditing ? "bi bi-check-circle me-1" : "bi bi-arrow-down-circle me-1")"></i>@(_isEditing ? "완료" : "추가")
                                </button>
                                @if (_isEditing)
                                {
                                    <button class="py-2 px-3 fw-bold" style="background-color: rgba(186, 26, 26, 0.1); color: #ba1a1a; border: none; border-radius: 0.25rem; font-size: 1rem;" @onclick="ClearInputFields">취소</button>
                                }
                            </div>
                        </div>
                    </div>

                    @* 항목 목록 (No-Line 테이블) *@
                    <div class="rounded overflow-hidden" style="background-color: #f5f4e8;">
                        @* 헤더 *@
                        <div class="d-none d-md-flex px-4 py-3" style="background-color: rgba(234, 233, 221, 0.6);">
                            <div style="width: 25%; font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">지출항목</div>
                            <div class="flex-grow-1" style="font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">산출근거(내용)</div>
                            <div class="text-end" style="width: 20%; font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">청구금액</div>
                            <div class="text-center" style="width: 100px; font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">수정</div>
                        </div>
                        @* 행 *@
                        @if (_itemList.Count > 0)
                        {
                            @foreach (var item in _itemList)
                            {
                                bool isCurrentEdit = _isEditing && _editingItem == item;
                                <div class="d-flex flex-wrap px-4 py-3 align-items-center" style="background-color: @(isCurrentEdit ? "#eae9dd" : (_itemList.IndexOf(item) % 2 == 0 ? "#f5f4e8" : "rgba(255,255,255,0.4)")); transition: background-color 0.15s ease-out; cursor: pointer;">
                                    <div class="fw-bold" style="width: 25%; color: #1b1c15;">@item.Category</div>
                                    <div class="flex-grow-1" style="color: #4e4637; font-size: 0.875rem;">@item.CalcDetail</div>
                                    <div class="text-end fw-bold" style="width: 20%; color: #5a4000; font-variant-numeric: tabular-nums;">₩ @item.Amount.ToString("N0")</div>
                                    <div class="d-flex justify-content-center gap-3" style="width: 100px;">
                                        <button class="btn btn-sm p-0" style="color: #4e4637; background: none; border: none;" @onclick="() => EditItem(item)"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm p-0" style="color: #ba1a1a; background: none; border: none;" @onclick="() => RemoveItem(item)"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5" style="color: #807666;">추가된 명세가 없습니다.</div>
                        }
                    </div>
                </div>

                @* ── 총액 표시 & 안내 ── *@
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-end gap-4 mb-5">
                    <div class="p-4 w-100" style="background-color: #e4e3d7; border-radius: 0.375rem;">
                        <span class="d-block mb-2" style="font-size: 1.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #4e4637;">총 결의 금액</span>
                        <div style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #5a4000; font-variant-numeric: tabular-nums; letter-spacing: -0.02em;">
                            <span style="font-size: 1.25rem; font-weight: 500; margin-right: 0.5rem;">₩</span>@CurrentRequestTotal.ToString("N0")
                        </div>
                    </div>
                </div>

                <div class="p-4 d-flex align-items-start gap-3" style="background-color: #f5f4e8; border-radius: 0.375rem;">
                    <i class="bi bi-info-circle mt-1" style="color: #785600;"></i>
                    <div>
                        <h6 class="fw-bold mb-1" style="color: #1b1c15; font-size: 0.875rem;">작성 안내</h6>
                        <p class="mb-0" style="color: #4e4637; font-size: 1rem; line-height: 1.6;">교회 양식을 사용하는걸 추천드리며, 본 양식은 지출결의서 작성에 도움을 드리기 위한 참고자료입니다.</p>
                    </div>
                </div>

            </div>
            @* [좌측 영역 끝] *@

            @* =========================================
               [우측 영역] 인쇄 미리보기 (스크롤 고정)
            ========================================= *@
            <div class="col-lg-5 d-none d-lg-block">
                @* 스크롤 시 화면에 고정 *@
                <div style="position: sticky; top: 6rem; z-index: 10;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h4 class="fw-bold d-flex align-items-center gap-2 mb-0" style="color: #1b1c15;">
                            <i class="bi bi-eye" style="color: #785600;"></i> 인쇄 미리보기
                        </h4>
                    </div>
                    <div class="p-4 p-xl-5 d-flex align-items-start justify-content-center" style="background-color: #f5f4e8; border-radius: 0.375rem; overflow-x: auto;">
                        <div class="expense-paper shadow" style="margin: 0 auto; transform: scale(1);">

                            @* 🚀 명세표 코드 (미리보기 화면) *@
                            <div class="ep-title">지 출 결 의 서</div>
                            <div class="d-flex flex-column align-items-end mb-2">
                                <div class="mb-1" style="font-weight: bold; text-align: right; width: 100%; font-size: 11pt; color: #000;">
                                    @_currentReport.Date.ToString("yyyy 년 MM 월 dd 일")
                                </div>
                                <table class="ep-approval">
                                    <tbody>
                                        <tr>
                                            <td class="ep-apr-side" rowspan="2">결재</td>
                                            <td class="ep-apr-title">팀 장</td>
                                            <td class="ep-apr-title">국 장</td>
                                            <td class="ep-apr-title">관리국장</td>
                                            <td class="ep-apr-title">담임목사</td>
                                        </tr>
                                        <tr class="ep-apr-sign">
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="ep-request text-center">아래와 같이 지출하여 주시기 바랍니다.</div>
                            <table class="ep-main">
                                <tr>
                                    <td class="ep-lbl" rowspan="2">금&nbsp;&nbsp;액</td>
                                    <td class="ep-val text-start fw-bold" colspan="4" style="border-bottom: 1px dashed #ccc;">일금 @AmountInKorean</td>
                                </tr>
                                <tr><td class="ep-val text-start fw-bold" colspan="4">₩ @CurrentRequestTotal.ToString("N0")</td></tr>
                                <tr><td class="ep-lbl">지출항목</td><td class="ep-val text-start" colspan="4">@(CurrentUser?.Department?.Name ?? "")</td></tr>
                                <tr>
                                    <td class="ep-lbl" style="vertical-align:middle;">적&nbsp;&nbsp;요</td>
                                    <td class="ep-detail-cell" colspan="4">
                                        <table class="ep-inner-table">
                                            <thead>
                                                <tr>
                                                    <th class="col-cat">지출항목</th>
                                                    <th class="col-desc" style="text-align: center;">산출근거</th>
                                                    <th class="col-amt" style="text-align: center;">금액</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (_itemList.Count > 0)
                                                {
                                                    @foreach (var item in _itemList)
                                                    {
                                                        <tr>
                                                            <td class="col-cat"><span class="text-nowrap-squish" style="@GetDynamicStyle(item.Category, "Category")">@item.Category</span></td>
                                                            <td class="col-desc"><span class="text-nowrap-squish" style="@GetDynamicStyle(item.CalcDetail, "Detail")">@item.CalcDetail</span></td>
                                                            <td class="col-amt text-end"><span class="text-nowrap-squish" style="font-size: 10pt !important; font-weight: bold;">@item.Amount.ToString("N0")</span></td>
                                                        </tr>
                                                    }
                                                }
                                                @for (int i = 0; i < Math.Max(6, _itemList.Count) - _itemList.Count; i++)
                                                {
                                                    <tr>
                                                        <td class="col-cat">&nbsp;</td>
                                                        <td class="col-desc"></td>
                                                        <td class="col-amt"></td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr class="ep-sum-row">
                                                    <td colspan="2" class="ep-sum-lbl">합 계 :</td>
                                                    <td class="ep-sum-val">@CurrentRequestTotal.ToString("N0")</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ep-lbl" rowspan="2" style="vertical-align: middle;">계&nbsp;&nbsp;좌</td>
                                    <td class="ep-acc-hd" style="width: 18%;">지급방법</td>
                                    <td class="ep-acc-hd" style="width: 18%;">은행명</td>
                                    <td class="ep-acc-hd" style="width: 29%;">계좌번호</td>
                                    <td class="ep-acc-hd" style="width: 20%;">예금주</td>
                                </tr>
                                <tr>
                                    <td class="ep-acc-val fw-bold">
                                        <span class="text-nowrap-squish" style="font-size: 9pt !important; letter-spacing: -0.5px;">
                                            현금@(_currentReport.PaymentMethod == "현금" ? "☑" : "□")
                                            계좌@(_currentReport.PaymentMethod == "계좌" ? "☑" : "□")
                                        </span>
                                    </td>
                                    @if (_currentReport.PaymentMethod == "계좌")
                                    {
                                        <td class="ep-acc-val"><span class="text-nowrap-squish" style="font-size: 9.5pt !important;">@(CurrentUser?.Department?.BankName ?? "")</span></td>
                                        <td class="ep-acc-val"><span class="text-nowrap-squish" style="font-size: 9.5pt !important; letter-spacing: -0.5px;">@(CurrentUser?.Department?.AccountNumber ?? "")</span></td>
                                        <td class="ep-acc-val"><span class="text-nowrap-squish" style="font-size: 9.5pt !important; letter-spacing: -0.5px;">@(CurrentUser?.Department?.AccountHolder ?? "")</span></td>
                                    }
                                    else
                                    {
                                        <td class="ep-acc-val" colspan="3"><span class="text-muted small">현금 지급 (계좌이체 안함)</span></td>
