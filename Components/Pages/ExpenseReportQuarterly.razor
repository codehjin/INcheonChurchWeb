@page "/expense-report-quarterly"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using System.Text.Json
@inject AccountingService AccService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

@* ══════════════════════════════════════════
   화면 전용 UI (인쇄 시 숨김)
══════════════════════════════════════════ *@
<div class="container mt-4 no-print">

    @* 1. 상단 타이틀 바 *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-3">
        <div class="d-flex align-items-center">
            <h3 class="fw-bold mb-0 text-primary">
                <i class="bi bi-file-earmark-text me-2"></i>지출결의서 작성
            </h3>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-1 bg-light p-2 rounded shadow-sm border">
                <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="PrevYear">◀</button>
                <span class="fw-bold fs-5 px-2 text-primary" style="min-width: 80px; text-align: center;">@(TargetYear) 년</span>
                <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="NextYear">▶</button>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-warning fw-bold shadow-sm" @onclick="NewReport">
                    <i class="bi bi-plus-circle me-1"></i>신규 작성
                </button>
                <button class="btn btn-secondary fw-bold shadow-sm" @onclick="PrintPage">
                    <i class="bi bi-printer me-1"></i>인쇄
                </button>
            </div>
        </div>
    </div>

    @* 2. 상단 좌/우 2단 배치 *@
    <div class="row g-4 mb-4">

        @* ── ① 기존 신청 내역 (상단 좌측) ── *@
        <div class="col-lg-5">
            <div class="card shadow-sm h-100 border-0 bg-light">
                <div class="card-header bg-white border-bottom fw-bold d-flex justify-content-between align-items-center py-3">
                    <span class="text-secondary"><i class="bi bi-clock-history me-2"></i>① 신청 내역</span>
                    <span class="badge bg-secondary rounded-pill">
                        총 @(reportHistory.Count)건
                    </span>
                </div>
                <div class="card-body p-0 table-responsive" style="height: 480px; overflow-y: auto;">
                    <table class="table table-hover mb-0 text-center small align-middle bg-white">
                        <thead class="table-light sticky-top shadow-sm">
                            <tr>
                                <th width="75">작성일</th>
                                <th class="text-start">청구인/제목</th>
                                <th width="90">금액</th>
                                <th width="120">관리</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (reportHistory.Count > 0)
                            {
                                @foreach (var report in reportHistory)
                                {
                                    <tr class="@(CurrentReport.Id == report.Id ? "table-primary fw-bold" : "")"
                                        style="cursor:pointer" @onclick="() => LoadReport(report)">
                                        <td>@report.Date.ToString("MM-dd")</td>
                                        <td class="text-start text-truncate" style="max-width: 100px;">@report.Title</td>
                                        <td class="text-end text-danger pe-2">@report.TotalAmount.ToString("N0")</td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <button class="btn btn-sm btn-outline-primary py-0 px-2 fw-bold"
                                                        @onclick:stopPropagation="true" @onclick="() => LoadReport(report)">
                                                    수정
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold"
                                                        @onclick:stopPropagation="true" @onclick="() => DeleteReport(report)">
                                                    삭제
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="py-5 text-muted">해당 연도의 신청 내역이 없습니다.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* ── ② 내역 입력 (상단 우측) ── *@
        <div class="col-lg-7">
            <div class="card shadow-sm border-primary h-100 border-opacity-50">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    <i class="bi bi-pencil-square me-2"></i>② 내역 입력 (@(CurrentReport.Id == 0 ? "신규" : "수정중"))
                </div>
                <div class="card-body bg-white d-flex flex-column">
                    <div class="alert alert-primary bg-opacity-10 border-primary border-opacity-25 small mb-4 py-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">총 예산(수령액)</span>
                            <span class="fw-bold">@TotalBudget.ToString("N0") 원</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">기 신청액</span>
                            <span class="fw-bold text-danger">－ @UsedBudget.ToString("N0") 원</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">이번 신청액</span>
                            <span class="fw-bold text-primary">－ @CurrentRequestTotal.ToString("N0") 원</span>
                        </div>
                        <div class="border-top border-primary border-opacity-25 my-2"></div>
                        <div class="d-flex justify-content-between fw-bold fs-6">
                            <span>신청 후 잔액</span>
                            <span class="@((TotalBudget - UsedBudget - CurrentRequestTotal) < 0 ? "text-danger" : "text-success")">
                                @((TotalBudget - UsedBudget - CurrentRequestTotal).ToString("N0")) 원
                            </span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary mb-1">청구일자</label>
                            <input type="date" class="form-control form-control-sm" @bind="CurrentReport.Date" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary mb-1">청구인 이름</label>
                            <div class="input-group input-group-sm">
                                <input class="form-control" @bind="CurrentReport.Title" placeholder="이름 입력" />
                                @if (!string.IsNullOrEmpty(CurrentReport.Title))
                                {
                                    <button class="btn btn-outline-secondary px-2" type="button" style="font-size: 0.75rem;" @onclick="() => { CurrentReport.Title = string.Empty; }" title="지우기">❌</button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">지급 방법</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="payMethod" id="payAcc"
                                       checked="@(CurrentReport.PaymentMethod == "계좌")"
                                       @onchange='() => CurrentReport.PaymentMethod = "계좌"' />
                                <label class="form-check-label fw-bold" for="payAcc">계좌이체</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="payMethod" id="payCash"
                                       checked="@(CurrentReport.PaymentMethod == "현금")"
                                       @onchange='() => CurrentReport.PaymentMethod = "현금"' />
                                <label class="form-check-label fw-bold" for="payCash">현금지급 (바로수령)</label>
                            </div>
                        </div>
                    </div>

                    <div class="card p-3 border border-secondary border-opacity-25 bg-light mb-3">
                        <div class="row g-2 mb-2">
                            @* 1. 지출항목 (X 지우기 버튼 탑재) *@
                            <div class="col-4">
                                <label class="form-label small fw-bold text-secondary mb-1">지출항목</label>
                                <div class="input-group">
                                    <input class="form-control ep-input" list="expCats" @bind="newItem.Category" @bind:event="oninput" placeholder="선택/입력" />
                                    <datalist id="expCats">
                                        @foreach (var c in catList)
                                        {
                                            <option value="@c" />
                                        }
                                    </datalist>
                                    @if (!string.IsNullOrEmpty(newItem.Category))
                                    {
                                        <button class="btn btn-outline-secondary px-2" type="button" style="font-size: 0.75rem;" @onclick="() => { newItem.Category = string.Empty; }" title="지우기">❌</button>
                                    }
                                </div>
                            </div>

                            @* 2. 산출근거 (X 지우기 버튼 탑재) *@
                            <div class="col-5">
                                <label class="form-label small fw-bold text-secondary mb-1">산출근거 (내용)</label>
                                <div class="input-group">
                                    <input class="form-control ep-input" style="ime-mode:active;" @bind="newItem.CalcDetail" @bind:event="oninput" placeholder="상세 내용" />
                                    @if (!string.IsNullOrEmpty(newItem.CalcDetail))
                                    {
                                        <button class="btn btn-outline-secondary px-2" type="button" style="font-size: 0.75rem;" @onclick="() => { newItem.CalcDetail = string.Empty; }" title="지우기">❌</button>
                                    }
                                </div>
                            </div>

                            @* 3. 청구 금액 (X 지우기 버튼 탑재) *@
                            <div class="col-3">
                                <label class="form-label small fw-bold text-secondary mb-1">청구 금액</label>
                                <div class="input-group">
                                    <input type="number" class="form-control ep-input no-spinners" @bind="inputAmount" @bind:event="oninput" placeholder="금액" @onkeyup="EnterKey" />
                                    @if (inputAmount.HasValue)
                                    {
                                        <button class="btn btn-outline-secondary px-2" type="button" style="font-size: 0.75rem;" @onclick="() => { inputAmount = null; }" title="지우기">❌</button>
                                    }
                                </div>
                            </div>
                        </div>

                        @* 🚀 거대한 초기화 버튼 삭제 및 추가/수정완료 버튼 100% 폭 적용 *@
                        <div class="d-flex gap-2 mt-2">
                            <button class="btn btn-outline-primary fw-bold w-100" @onclick="AddOrUpdateItem">
                                <i class="@(isEditing ? "bi bi-check-circle me-1" : "bi bi-arrow-down-circle me-1")"></i>
                                @(isEditing ? "수정완료" : "명세표에 추가")
                            </button>
                            @if (isEditing)
                            {
                                <button class="btn btn-danger fw-bold px-3" style="min-width: 90px;" @onclick="ClearInputFields" title="수정 취소">
                                    ❌ 취소
                                </button>
                            }
                        </div>
                    </div>

                    <div class="table-responsive flex-grow-1 border rounded bg-white" style="max-height: 140px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0 small text-center align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th width="25%">항목</th>
                                    <th class="text-start">내용</th>
                                    <th width="20%">금액</th>
                                    <th width="80">관리</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (itemList.Count > 0)
                                {
                                    @foreach (var item in itemList)
                                    {
                                        <tr class="@(isEditing && editingItem == item ? "table-warning" : "")">
                                            <td class="fw-bold text-truncate" style="max-width: 60px;">@item.Category</td>
                                            <td class="text-start text-truncate" style="max-width: 100px;">@item.CalcDetail</td>
                                            <td class="text-end fw-bold text-primary pe-2">@item.Amount.ToString("N0")</td>
                                            <td>
                                                <button class="btn btn-sm btn-link text-primary p-0 me-2" @onclick="() => EditItem(item)">
                                                    수정
                                                </button>
                                                <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => RemoveItem(item)">
                                                    삭제
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="py-3 text-muted">추가된 명세가 없습니다.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button class="btn btn-primary btn-lg fw-bold w-100 shadow-sm mt-3" @onclick="SaveReport">
                        <i class="bi bi-save me-2"></i>결의서 저장
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ── ③ 미리보기 (하단 중앙, 크게) ── *@
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-dark w-100 mb-5">
                <div class="card-header border-bottom border-secondary text-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-eye me-2"></i>③ 지출결의서 미리보기</span>
                    <span class="badge bg-secondary"><i class="bi bi-printer me-1"></i>인쇄 크기 100%</span>
                </div>
                <div class="card-body d-flex align-items-start justify-content-center p-5"
                     style="background:#6c757d; overflow-x:auto; overflow-y:auto; height: auto;">
                    <div class="expense-paper shadow" style="margin: 0 auto; transform: scale(1);">

                        @* 🚀 에러 방지를 위해 명세표 코드를 직접 삽입 (미리보기 화면) *@
                        <div class="ep-title">지 출 결 의 서</div>
                        <div class="d-flex flex-column align-items-end mb-2">
                            <div class="mb-1" style="font-weight: bold; text-align: right; width: 100%; font-size: 11pt; color: #000;">
                                @CurrentReport.Date.ToString("yyyy 년 MM 월 dd 일")
                            </div>
                            <table class="ep-approval">
                                <tbody>
                                    <tr>
                                        <td class="ep-apr-side" rowspan="2">결재</td>
                                        <td class="ep-apr-title">팀 장</td>
                                        <td class="ep-apr-title">국 장</td>
                                        <td class="ep-apr-title">관리국장</td>
                                        <td class="ep-apr-title">담임목사</td>
                                    </tr>
                                    <tr class="ep-apr-sign">
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="ep-request text-center">아래와 같이 지출하여 주시기 바랍니다.</div>
                        <table class="ep-main">
                            <tr>
                                <td class="ep-lbl" rowspan="2">금&nbsp;&nbsp;액</td>
                                <td class="ep-val text-start fw-bold" colspan="4" style="border-bottom: 1px dashed #ccc;">일금 @AmountInKorean</td>
                            </tr>
                            <tr><td class="ep-val text-start fw-bold" colspan="4">₩ @CurrentRequestTotal.ToString("N0")</td></tr>
                            <tr><td class="ep-lbl">지출항목</td><td class="ep-val text-start" colspan="4">@(CurrentUser?.Department?.Name ?? "")</td></tr>
                            <tr>
                                <td class="ep-lbl" style="vertical-align:middle;">적&nbsp;&nbsp;요</td>
                                <td class="ep-detail-cell" colspan="4">
                                    <div class="ep-detail-header">
                                        <div class="col-cat">항목</div><div class="col-desc" style="text-align: center !important;">세부내역</div><div class="col-amt" style="text-align: center !important;">금액</div>
                                    </div>
                                    <div class="ep-detail-body">
                                        @if (itemList.Count > 0)
                                        {
                                            @foreach (var item in itemList)
                                            {
                                                <div class="ep-detail-row">
                                                    <div class="col-cat"><span class="text-nowrap-squish" style="@GetDynamicStyle(item.Category)">@item.Category</span></div>
                                                    <div class="col-desc"><span class="text-nowrap-squish" style="@GetDynamicStyle(item.CalcDetail ?? "")">@item.CalcDetail</span></div>
                                                    <div class="col-amt"><span class="text-nowrap-squish" style="font-size: 10pt !important;">@item.Amount.ToString("N0")</span></div>
                                                </div>
                                            }
                                        }
                                        @* 🚀 입력된 개수가 6개 이하면 무조건 6칸을 유지하고, 넘어가면 딱 입력된 개수까지만 칸을 나눕니다! *@
                                        @for (int i = 0; i < Math.Max(6, itemList.Count) - itemList.Count; i++)
                                        {
                                            <div class="ep-detail-row"><div class="col-cat">&nbsp;</div><div class="col-desc"></div><div class="col-amt"></div></div>
                                        }
                                    </div>
                                    <div class="ep-sum-row"><div class="ep-sum-lbl">합 계 :</div><div class="ep-sum-val">@CurrentRequestTotal.ToString("N0")</div></div>
                                </td>
                            </tr>
                            <tr>
                                <td class="ep-lbl" rowspan="2" style="vertical-align: middle;">계&nbsp;&nbsp;좌</td>
                                <td class="ep-acc-hd" style="width: 18%;">지급방법</td>
                                <td class="ep-acc-hd" style="width: 18%;">은행명</td>
                                <td class="ep-acc-hd" style="width: 29%;">계좌번호</td>
                                <td class="ep-acc-hd" style="width: 20%;">예금주</td>
                            </tr>
                            <tr>
                                <td class="ep-acc-val fw-bold">
                                    <span class="text-nowrap-squish" style="font-size: 9pt !important; letter-spacing: -0.5px;">
                                        현금@(CurrentReport.PaymentMethod == "현금" ? "☑" : "□")
                                        계좌@(CurrentReport.PaymentMethod == "계좌" ? "☑" : "□")
                                    </span>
                                </td>
                                @if (CurrentReport.PaymentMethod == "계좌")
                                {
                                    <td class="ep-acc-val"><span class="text-nowrap-squish" style="font-size: 9.5pt !important;">@(CurrentUser?.Department?.BankName ?? "")</span></td>
                                    <td class="ep-acc-val"><span class="text-nowrap-squish" style="font-size: 9.5pt !important; letter-spacing: -0.5px;">@(CurrentUser?.Department?.AccountNumber ?? "")</span></td>
                                    <td class="ep-acc-val"><span class="text-nowrap-squish" style="font-size: 9.5pt !important; letter-spacing: -0.5px;">@(CurrentUser?.Department?.AccountHolder ?? "")</span></td>
                                }
                                else
                                {
                                    <td class="ep-acc-val" colspan="3"><span class="text-muted small">현금 지급 (계좌이체 안함)</span></td>
                                }
                            </tr>
                            <tr><td class="ep-lbl">청구날짜</td><td class="ep-cval text-end pe-3" colspan="4">@CurrentReport.Date.ToString("yyyy년 MM월 dd일")</td></tr>
                            <tr><td class="ep-lbl">청&nbsp;구&nbsp;인</td><td class="ep-cval text-end pe-3" colspan="4">@CurrentReport.Title <span class="ep-seal fw-bold ms-2">(인)</span></td></tr>
                            <tr><td class="ep-lbl">지출날짜</td><td class="ep-cval text-end pe-3 fw-bold" colspan="4">&nbsp;&nbsp;&nbsp;&nbsp;년&nbsp;&nbsp;&nbsp;&nbsp;월&nbsp;&nbsp;&nbsp;&nbsp;일</td></tr>
                        </table>
                        <div class="ep-footer">인천중앙성결교회</div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════
   인쇄 전용 영역 (화면에서는 숨김)
══════════════════════════════════════════ *@
<div class="print-only">
    <div class="a4-sheet">
        <div class="cut-line-top"><span class="scissors-h">✂</span></div>
        <div class="cut-line-bottom"><span class="scissors-h">✂</span></div>
        <div class="cut-line-left"><span class="scissors-v">✂</span></div>
        <div class="cut-line-right"><span class="scissors-v">✂</span></div>

        <div class="expense-paper print-center">

            @* 🚀 에러 방지를 위해 명세표 코드를 직접 삽입 (인쇄 화면) *@
            <div class="ep-title">지 출 결 의 서</div>
            <div class="d-flex flex-column align-items-end mb-2">
                <div class="mb-1" style="font-weight: bold; text-align: right; width: 100%; font-size: 11pt; color: #000;">
                    @CurrentReport.Date.ToString("yyyy 년 MM 월 dd 일")
                </div>
                <table class="ep-approval">
                    <tbody>
                        <tr>
                            <td class="ep-apr-side" rowspan="2">결재</td>
                            <td class="ep-apr-title">팀 장</td>
                            <td class="ep-apr-title">국 장</td>
                            <td class="ep-apr-title">관리국장</td>
                            <td class="ep-apr-title">담임목사</td>
                        </tr>
                        <tr class="ep-apr-sign">
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="ep-request text-center">아래와 같이 지출하여 주시기 바랍니다.</div>
            <table class="ep-main">
                <tr>
                    @* 🚀 기준점: 첫 번째 칸을 15%로 확실히 고정 *@
                    <td class="ep-lbl" rowspan="2" style="width: 15%;">금&nbsp;&nbsp;액</td>
                    <td class="ep-val text-start fw-bold" colspan="4" style="border-bottom: 1px dashed #ccc;">일금 @AmountInKorean</td>
                </tr>
                <tr><td class="ep-val text-start fw-bold" colspan="4">₩ @CurrentRequestTotal.ToString("N0")</td></tr>
                <tr><td class="ep-lbl">지출항목</td><td class="ep-val text-start" colspan="4">@(CurrentUser?.Department?.Name ?? "")</td></tr>
                <tr>
                    <td class="ep-lbl" style="vertical-align:middle;">적&nbsp;&nbsp;요</td>
                    <td class="ep-detail-cell" colspan="4">
                        <div class="ep-detail-header">
