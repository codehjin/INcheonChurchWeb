@page "/expense-report-quarterly"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using System.Text.Json
@inject AccountingService AccService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

@* ══════════════════════════════════════════
   화면 전용 UI (인쇄 시 숨김)
══════════════════════════════════════════ *@
<div class="container mt-4 no-print">

    @* 1. 상단 타이틀 바 *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-3">
        <div class="d-flex align-items-center">
            <h3 class="fw-bold mb-0 text-primary">
                <i class="bi bi-file-earmark-text me-2"></i>지출결의서 작성
            </h3>
        </div>

        <div class="d-flex align-items-center gap-3">
            @* 회계연도 좌우 화살표 *@
            <div class="d-flex align-items-center gap-1 bg-light p-2 rounded shadow-sm border">
                <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="PrevYear">◀</button>
                <span class="fw-bold fs-5 px-2 text-primary" style="min-width: 80px; text-align: center;">@(TargetYear) 년</span>
                <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="NextYear">▶</button>
            </div>

            @* 버튼 그룹 *@
            <div class="d-flex gap-2">
                <button class="btn btn-warning fw-bold shadow-sm" @onclick="NewReport">
                    <i class="bi bi-plus-circle me-1"></i>신규 작성
                </button>
                <button class="btn btn-secondary fw-bold shadow-sm" @onclick="PrintPage">
                    <i class="bi bi-printer me-1"></i>인쇄
                </button>
            </div>
        </div>
    </div>

    @* 2. 상단 좌/우 2단 배치 *@
    <div class="row g-4 mb-4">

        @* ── ① 기존 신청 내역 (상단 좌측) ── *@
        <div class="col-lg-5">
            <div class="card shadow-sm h-100 border-0 bg-light">
                <div class="card-header bg-white border-bottom fw-bold d-flex justify-content-between align-items-center py-3">
                    <span class="text-secondary"><i class="bi bi-clock-history me-2"></i>① 신청 내역</span>
                    <span class="badge bg-secondary rounded-pill">
                        총 @(reportHistory.Count)건
                    </span>
                </div>
                <div class="card-body p-0 table-responsive" style="height: 480px; overflow-y: auto;">
                    <table class="table table-hover mb-0 text-center small align-middle bg-white">
                        <thead class="table-light sticky-top shadow-sm">
                            <tr>
                                <th width="75">작성일</th>
                                <th class="text-start">청구인/제목</th>
                                <th width="90">금액</th>
                                <th width="120">관리</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (reportHistory.Count > 0)
                            {
                                @foreach (var report in reportHistory)
                                {
                                    <tr class="@(CurrentReport.Id == report.Id ? "table-primary fw-bold" : "")"
                                        style="cursor:pointer" @onclick="() => LoadReport(report)">
                                        <td>@report.Date.ToString("MM-dd")</td>
                                        <td class="text-start text-truncate" style="max-width: 100px;">@report.Title</td>
                                        <td class="text-end text-danger pe-2">@report.TotalAmount.ToString("N0")</td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <button class="btn btn-sm btn-outline-primary py-0 px-2 fw-bold"
                                                        @onclick:stopPropagation="true" @onclick="() => LoadReport(report)">
                                                    수정
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold"
                                                        @onclick:stopPropagation="true" @onclick="() => DeleteReport(report)">
                                                    삭제
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="py-5 text-muted">해당 연도의 신청 내역이 없습니다.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* ── ② 내역 입력 (상단 우측) ── *@
        <div class="col-lg-7">
            <div class="card shadow-sm border-primary h-100 border-opacity-50">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    <i class="bi bi-pencil-square me-2"></i>② 내역 입력 (@(CurrentReport.Id == 0 ? "신규" : "수정중"))
                </div>
                <div class="card-body bg-white d-flex flex-column">
                    <div class="alert alert-primary bg-opacity-10 border-primary border-opacity-25 small mb-4 py-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">총 예산(수령액)</span>
                            <span class="fw-bold">@TotalBudget.ToString("N0") 원</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">기 신청액</span>
                            <span class="fw-bold text-danger">－ @UsedBudget.ToString("N0") 원</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">이번 신청액</span>
                            <span class="fw-bold text-primary">－ @CurrentRequestTotal.ToString("N0") 원</span>
                        </div>
                        <div class="border-top border-primary border-opacity-25 my-2"></div>
                        <div class="d-flex justify-content-between fw-bold fs-6">
                            <span>신청 후 잔액</span>
                            <span class="@((TotalBudget - UsedBudget - CurrentRequestTotal) < 0 ? "text-danger" : "text-success")">
                                @((TotalBudget - UsedBudget - CurrentRequestTotal).ToString("N0")) 원
                            </span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary mb-1">청구일자</label>
                            <input type="date" class="form-control form-control-sm" @bind="CurrentReport.Date" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary mb-1">청구인 이름</label>
                            <input class="form-control form-control-sm" @bind="CurrentReport.Title" placeholder="이름 입력" />
                        </div>
                    </div>

                    <div class="card p-3 border border-secondary border-opacity-25 bg-light mb-3">
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label small fw-bold text-secondary mb-1">지출항목</label>
                                <input class="form-control form-control-sm" list="expCats" @bind="newItem.Category" placeholder="선택/입력" />
                                <datalist id="expCats">
                                    @foreach (var c in catList)
                                    {
                                        <option value="@c" />
                                    }
                                </datalist>
                            </div>
                            <div class="col-5">
                                <label class="form-label small fw-bold text-secondary mb-1">산출근거 (내용)</label>
                                <input class="form-control form-control-sm" @bind="newItem.CalcDetail" placeholder="상세 내용" />
                            </div>
                            <div class="col-3">
                                <label class="form-label small fw-bold text-secondary mb-1">청구 금액</label>
                                <input type="number" class="form-control form-control-sm" @bind="newItem.Amount" placeholder="금액" @onkeyup="EnterKey" />
                            </div>
                        </div>
                        <button class="btn btn-outline-primary fw-bold mt-2" @onclick="AddItem">
                            <i class="bi bi-arrow-down-circle me-1"></i>명세표에 추가
                        </button>
                    </div>

                    <div class="table-responsive flex-grow-1 border rounded bg-white" style="max-height: 140px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0 small text-center align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th width="30%">항목</th>
                                    <th class="text-start">내용</th>
                                    <th width="25%">금액</th>
                                    <th width="40"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (itemList.Count > 0)
                                {
                                    @foreach (var item in itemList)
                                    {
                                        <tr>
                                            <td class="fw-bold text-truncate" style="max-width: 60px;">@item.Category</td>
                                            <td class="text-start text-truncate" style="max-width: 100px;">@item.CalcDetail</td>
                                            <td class="text-end fw-bold text-primary">@item.Amount.ToString("N0")</td>
                                            <td>
                                                <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => RemoveItem(item)">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="py-3 text-muted">추가된 명세가 없습니다.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button class="btn btn-primary btn-lg fw-bold w-100 shadow-sm mt-3" @onclick="SaveReport">
                        <i class="bi bi-save me-2"></i>결의서 저장
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ── ③ 미리보기 (하단 중앙, 크게) ── *@
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-dark w-100 mb-5">
                <div class="card-header border-bottom border-secondary text-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-eye me-2"></i>③ 지출결의서 미리보기</span>
                    <span class="badge bg-secondary"><i class="bi bi-printer me-1"></i>인쇄 크기 100%</span>
                </div>
                <div class="card-body d-flex align-items-start justify-content-center p-5"
                     style="background:#6c757d; overflow-x:auto; overflow-y:auto; height: auto;">
                    <div class="expense-paper shadow" style="margin: 0 auto; transform: scale(1);">
                        @PaperMarkup
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════
   인쇄 전용 영역 (화면에서는 숨김)
══════════════════════════════════════════ *@
<div class="print-only">
    <div class="a4-sheet">
        <div class="cut-line-top"><span class="scissors-h">✂</span></div>
        <div class="cut-line-bottom"><span class="scissors-h">✂</span></div>
        <div class="cut-line-left"><span class="scissors-v">✂</span></div>
        <div class="cut-line-right"><span class="scissors-v">✂</span></div>

        <div class="expense-paper print-center">
            @PaperMarkup
        </div>
    </div>
</div>

@* ══════════════════════════════════════════
   결의서 본문 마크업 (미리보기 + 인쇄 공용)
══════════════════════════════════════════ *@
@{
    // 결의서 공용 마크업을 변수로 선언 (RenderFragment)
}

<style>
    /* ── 화면 ── */
    @@media screen {
        .print-only {
            display: none !important;
        }

        .expense-paper {
            border: 1px solid #ccc;
            box-shadow: 0 4px 20px rgba(0,0,0,.3);
            background: #fff;
        }
    }

    /* ── 공통 결의서 스타일 (12pt 강제 적용 및 규격 135x195 고정) ── */
    .expense-paper {
        width: 135mm;
        height: 195mm;
        padding: 2mm 5mm 5mm 5mm;
        background: #fff;
        font-family: 'Malgun Gothic','Dotum','돋움',sans-serif;
        font-size: 12pt !important;
        box-sizing: border-box;
        color: #000;
    }

        .expense-paper table, .expense-paper th, .expense-paper td, .expense-paper div, .expense-paper span {
            font-size: inherit;
        }

    /* 🚀 2줄 방지 원천 차단 클래스 */
    .text-nowrap-squish {
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: clip !important;
        display: block;
        width: 100%;
    }

    /* 상단 제목 */
    .ep-title {
        text-align: center;
        font-size: 22pt !important;
        font-weight: 900;
        letter-spacing: 10px;
        margin-bottom: 1.5mm;
        line-height: 1.2;
    }

    /* 결재란 */
    .ep-approval {
        border-collapse: collapse;
        margin-left: auto;
        margin-bottom: 1.5mm;
        font-size: 12pt;
    }

        .ep-approval td {
            border: 1px solid #222;
            text-align: center;
            padding: 0;
        }

    .ep-apr-side {
        background: #ebebeb;
        font-weight: bold;
        width: 20px;
        line-height: 1.4;
        padding: 1px;
        vertical-align: middle;
        writing-mode: vertical-lr;
        letter-spacing: 2px;
    }

    .ep-apr-title {
        width: 18mm;
        height: 5.5mm;
        vertical-align: middle;
        font-weight: bold;
    }

    .ep-apr-sign {
        height: 13mm;
    }

        .ep-apr-sign td {
            width: 18mm;
        }

    .ep-request {
        font-weight: bold;
        font-size: 12pt;
        border-bottom: 1.5px solid #000;
        padding-bottom: 1mm;
        margin-bottom: 0;
    }

    /* 🚀 통합 메인 테이블 (모든 표를 하나로 묶음) */
    .ep-main {
        width: 100%;
        border-collapse: collapse;
        border-top: 1px solid #444;
        font-size: 12pt;
    }

        .ep-main td {
            border: 1px solid #555;
            vertical-align: middle;
        }

    .ep-lbl {
        background: #f0f0f0;
        font-weight: bold;
        text-align: center;
        white-space: nowrap;
        width: 15%;
        padding: 2px;
    }

    .ep-val {
        padding: 2px 6px;
    }

    /* 적요 영역 레이아웃 */
    .ep-detail-cell {
        padding: 0 !important;
        vertical-align: top;
    }

    .ep-detail-header {
        display: flex;
        width: 100%;
        background: #f0f0f0;
        font-weight: bold;
        text-align: center;
        border-bottom: 1px solid #aaa;
        font-size: 11pt;
    }

        .ep-detail-header > div {
            padding: 2px;
            border-right: 1px solid #ccc;
        }

            .ep-detail-header > div:last-child {
                border-right: none;
            }

    .ep-detail-body {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 60mm;
        overflow: hidden;
    }

    .ep-detail-row {
        display: flex;
        width: 100%;
        flex: 1;
        border-bottom: 1px solid #eee;
        align-items: center;
        text-align: center;
        box-sizing: border-box;
    }

        .ep-detail-row:last-child {
            border-bottom: none;
        }

        .ep-detail-row > div {
            border-right: 1px solid #ccc;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            overflow: hidden;
            padding: 0 4px;
        }

            .ep-detail-row > div:last-child {
                border-right: none;
            }

    .col-cat {
        width: 25%;
    }

    .col-desc {
        width: 50%;
        justify-content: flex-start !important;
        text-align: left;
    }

    .col-amt {
        width: 25%;
        justify-content: flex-end !important;
        text-align: right;
        font-weight: bold;
    }

    .ep-sum-row {
        display: flex;
        width: 100%;
        background: #e8e8e8;
        font-weight: bold;
        border-top: 1.5px solid #444;
        align-items: center;
        font-size: 12pt;
    }

    .ep-sum-lbl {
        width: 75%;
        text-align: center;
        padding: 2px 5px;
        border-right: 1px solid #ccc;
    }

    .ep-sum-val {
        width: 25%;
        text-align: right;
        padding: 2px 5px;
    }

    .ep-acc-hd {
        background: #f0f0f0;
        text-align: center;
        padding: 1.5px;
        font-weight: bold;
        border-left: 1px solid #555;
    }

    .ep-acc-val {
        text-align: center;
        padding: 0px 2px;
        height: 6mm;
        vertical-align: middle;
        border-left: 1px solid #555;
    }

    .ep-cval {
        padding: 1.5px 6px;
        height: 6mm;
        vertical-align: middle;
    }

    .ep-seal {
        color: #666;
    }

    .ep-footer {
        text-align: right;
        font-weight: bold;
        margin-top: 1mm;
        letter-spacing: 2px;
        font-size: 12pt;
    }

    /* ── 인쇄 ── */
    @@media print {
        .no-print {
            display: none !important;
        }

        nav, header, aside, footer,
        .sidebar, .top-row, .navbar, .nav-menu,
        .bi-list, [class*="sidebar"], [class*="nav-"],
        .mud-drawer, .mud-appbar,
        .layout-sidebar, .page-header,
        a.nav-link {
            display: none !important;
        }

        .container {
            margin-left: 0 !important;
            padding-left: 0 !important;
            max-width: 100% !important;
        }

        .page, .main, article, .content,
        .page > main, main > article {
            margin: 0 !important;
            padding: 0 !important;
            max-width: none !important;
            width: 100% !important;
        }

        @@page {
            size: A4 portrait;
            margin: 0;
        }

        body, html {
            margin: 0 !important;
            padding: 0 !important;
            background: white !important;
        }

        .print-only {
            display: block !important;
        }

        .a4-sheet {
            position: relative;
            width: 210mm;
            height: 297mm;
            background: white;
            overflow: hidden;
        }

            .a4-sheet .print-center {
                position: absolute;
                top: 9mm;
                left: 0;
                right: 0;
                margin: 0 auto;
                width: 135mm !important;
                height: 197mm !important;
                min-height: unset !important;
                padding: 5mm !important;
                border: none !important;
                box-shadow: none !important;
                overflow: hidden;
            }

        .cut-line-top {
            position: absolute;
            top: 0mm;
            left: 37.4mm;
            height: 0;
            width: 135mm;
            border-top: 1px dashed #999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cut-line-bottom {
            position: absolute;
            top: 208mm;
            left: 37.4mm;
            height: 0;
            width: 135mm;
            border-top: 1px dashed #999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .scissors-h {
            font-size: 10pt !important;
            color: #777;
            background: #fff;
            padding: 0 2px;
        }

        .cut-line-left {
            position: absolute;
            top: 9mm;
            left: 37.4mm;
            width: 0;
            height: 195mm;
            border-left: 1px dashed #999;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .cut-line-right {
            position: absolute;
            top: 9mm;
            left: 172.5mm;
            width: 0;
            height: 195mm;
            border-left: 1px dashed #999;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .scissors-v {
            font-size: 10pt !important;
            transform: rotate(90deg);
            display: inline-block;
            color: #777;
            background: #fff;
            padding: 2px 0;
        }

        .ep-lbl, .ep-apr-side, .ep-apr-title,
        .ep-acc-hd, .ep-detail-header, .ep-sum-row {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }
</style>

@* ══════════════════════════════════════════
   @code 블록
══════════════════════════════════════════ *@
@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private int TargetYear = DateTime.Now.Year;
    private decimal TotalBudget = 0;
    private decimal UsedBudget = 0;

    private ExpenseReport CurrentReport = new() { Date = DateTime.Now };
    private List<BudgetPlan> itemList = new();
    private BudgetPlan newItem = new();
    private List<ExpenseReport> reportHistory = new();
    private List<string> catList = new();

    private decimal CurrentRequestTotal => itemList.Sum(x => x.Amount);

    private string GetDynamicStyle(string? text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        if (text.Length > 28) return "font-size: 7.5pt !important; letter-spacing: -1.5px;";
        if (text.Length > 20) return "font-size: 8.5pt !important; letter-spacing: -1px;";
        if (text.Length > 14) return "font-size: 9.5pt !important; letter-spacing: -0.5px;";
        return "font-size: 10pt !important;";
    }

    private RenderFragment PaperMarkup => __builder =>
    {
        int rowCount = Math.Max(6, itemList.Count);

        <div class="ep-title">지 출 결 의 서</div>

        <div class="d-flex flex-column align-items-end mb-2">
            <div class="mb-1" style="font-weight: bold; text-align: right; width: 100%; font-size: 11pt;">
                @CurrentReport.Date.ToString("yyyy 년 MM 월 dd 일")
            </div>
            <table class="ep-approval">
                <tbody>
                    <tr>
                        <td class="ep-apr-side" rowspan="2">결재</td>
                        <td class="ep-apr-title">팀 장</td>
                        <td class="ep-apr-title">국 장</td>
                        <td class="ep-apr-title">관리국장</td>
                        <td class="ep-apr-title">담임목사</td>
                    </tr>
                    <tr class="ep-apr-sign">
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="ep-request text-center">아래와 같이 지출하여 주시기 바랍니다.</div>

        <table class="ep-main">
            <tr>
                <td class="ep-lbl" rowspan="2">금&nbsp;&nbsp;액</td>
