@* ══════════════════════════════════════════
   @code 블록
══════════════════════════════════════════ *@
@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private int TargetYear = DateTime.Now.Year;
    private decimal TotalBudget = 0;
    private decimal UsedBudget = 0;

    // 🚀 화면의 '금액' 빈칸 입력을 처리하기 위한 전용 변수 (null 허용)
    private decimal? inputAmount = null;

    private ExpenseReport CurrentReport = new() { Date = DateTime.Now };
    private List<BudgetPlan> itemList = new();
    private BudgetPlan newItem = new();
    private List<ExpenseReport> reportHistory = new();
    private List<string> catList = new();

    // 🚀 수정 모드 처리를 위한 변수
    private bool isEditing = false;
    private BudgetPlan? editingItem = null;

    private decimal CurrentRequestTotal => itemList.Sum(x => x.Amount);

    // 🚀 항목(Category)인지 내용(Detail)인지 구분해서 글자 축소 & 두 줄 넘김 적용
    private string GetDynamicStyle(string? text, string colType = "Detail")
    {
        if (string.IsNullOrEmpty(text)) return "";
        int len = text.Length;

        // 항목은 7자, 내용은 14자를 기준으로 축소 시작
        int threshold = (colType == "Category") ? 7 : 14;

        // 항목은 11자, 내용은 22자를 넘어가면 두 줄로 래핑(줄바꿈) 허용
        int wrapLimit = (colType == "Category") ? 11 : 22;

        // 1. 기준치 이하면 꽉 차는 10pt
        if (len <= threshold)
            return "font-size: 10pt !important;";

        // 2. 최대치를 초과하면 7.5pt로 고정하고 두 줄로 래핑 (white-space: normal 적용)
        if (len > wrapLimit)
        {
            return "font-size: 7.5pt !important; letter-spacing: -0.5px; white-space: normal !important; word-break: break-all; line-height: 1.1;";
        }

        // 3. 그 사이 값이면 회원님 공식대로 0.5pt씩 미세 축소 (한 줄 유지)
        double fontSize = 10.0 - ((len - threshold) * 0.5);
        if (fontSize < 7.0) fontSize = 7.0;

        double letterSpacing = (len - threshold) * -0.1;
        if (letterSpacing < -0.7) letterSpacing = -0.7;

        return $"font-size: {fontSize:F1}pt !important; letter-spacing: {letterSpacing:F1}px;";
    }

    private async Task PrevYear() { TargetYear--; await LoadData(); }
    private async Task NextYear() { TargetYear++; await LoadData(); }

    private string AmountInKorean
    {
        get
        {
            long n = (long)CurrentRequestTotal;
            if (n == 0) return "영원정";
            string[] ones = { "", "일", "이", "삼", "사", "오", "육", "칠", "팔", "구" };
            string[] units = { "", "십", "백", "천" };
            string[] bigUnits = { "", "만", "억", "조" };
            string result = "";
            int groupIdx = 0;

            while (n > 0)
            {
                long group = n % 10000;
                if (group != 0)
                {
                    string gs = "";
                    for (int i = 3; i >= 0; i--)
                    {
                        int d = (int)((group / (long)Math.Pow(10, i)) % 10);
                        if (d > 0) gs += ones[d] + units[i];
                    }
                    result = gs + bigUnits[groupIdx] + result;
                }
                n /= 10000;
                groupIdx++;
            }
            return result + "원정";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser == null) return;
        await LoadData();
        catList = await AccService.GetCategorySuggestionsAsync(CurrentUser.DepartmentId, "Expense");
    }

    private async Task LoadData()
    {
        if (CurrentUser == null) return;
        var status = await AccService.GetSubsidyStatusForReportAsync(CurrentUser.DepartmentId, TargetYear);
        TotalBudget = status.TotalReceived;
        UsedBudget = status.TotalUsed;
        reportHistory = await AccService.GetExpenseReportsAsync(CurrentUser.DepartmentId, TargetYear);
    }

    private void NewReport()
    {
        CurrentReport = new ExpenseReport
        {
            Date = DateTime.Now,
            DepartmentId = CurrentUser?.DepartmentId ?? 0,
            FiscalYear = TargetYear
        };
        itemList.Clear();
        newItem = new();
        inputAmount = null; // 신규 작성 시 금액 빈칸 초기화
        isEditing = false;
        editingItem = null;
    }

    // 🚀 항목 추가 및 수정 완료 통합 메서드
    private async Task AddOrUpdateItem()
    {
        // 화면의 값을 실제 데이터에 옮겨 담기 (null이면 0으로 처리)
        newItem.Amount = inputAmount ?? 0;

        if (string.IsNullOrWhiteSpace(newItem.Category) || newItem.Amount <= 0) return;

        // 예산 초과 검증 (수정 모드일 때는 기존 항목 금액을 빼고 계산)
        decimal amountToCheck = isEditing && editingItem != null ? newItem.Amount - editingItem.Amount : newItem.Amount;

        if (TotalBudget > 0 && UsedBudget + CurrentRequestTotal + amountToCheck > TotalBudget)
        {
            bool proceed = await JSRuntime.InvokeAsync<bool>("confirm",
                "⚠️ 신청 금액이 현재 남은 예산을 초과합니다.\n\n" +
                "(추가 보조금 등의 수입 예정 사유가 있다면 계속 진행하실 수 있습니다.)\n\n" +
                "그래도 명세표에 추가하시겠습니까?");

            if (!proceed) return;
        }

        if (isEditing && editingItem != null)
        {
            editingItem.Category = newItem.Category;
            editingItem.CalcDetail = newItem.CalcDetail;
            editingItem.Amount = newItem.Amount;
        }
        else
        {
            itemList.Add(new BudgetPlan
            {
                Category = newItem.Category,
                CalcDetail = newItem.CalcDetail,
                Amount = newItem.Amount
            });
        }

        newItem = new();
        inputAmount = null; // 🚀 입력 완료 후 금액 칸을 다시 완벽한 빈칸으로!
        isEditing = false;
        editingItem = null;
    }

    // 🚀 항목 수정 시작
    private void EditItem(BudgetPlan item)
    {
        editingItem = item;
        newItem = new BudgetPlan
        {
            Category = item.Category,
            CalcDetail = item.CalcDetail,
            Amount = item.Amount
        };
        inputAmount = item.Amount; // 🚀 수정 버튼 누르면 금액도 다시 불러오기
        isEditing = true;
    }

    // 🚀 입력칸 모두 비우기 & 수정 모드 취소 (초기화 버튼 동작)
    private void ClearInputFields()
    {
        newItem = new BudgetPlan(); // 지출항목, 산출근거 빈칸으로
        inputAmount = null; // 금액 빈칸으로
        isEditing = false; // 수정 모드 해제
        editingItem = null;
    }

    // 🚀 항목 삭제
    private void RemoveItem(BudgetPlan item)
    {
        itemList.Remove(item);
        if (isEditing && editingItem == item)
        {
            ClearInputFields();
        }
    }

    private async Task SaveReport()
    {
        if (!itemList.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", "내역을 입력하세요.");
            return;
        }
        if (string.IsNullOrWhiteSpace(CurrentReport.Title))
        {
            await JSRuntime.InvokeVoidAsync("alert", "청구인을 입력하세요.");
            return;
        }

        CurrentReport.DepartmentId = CurrentUser?.DepartmentId ?? 0;
        CurrentReport.FiscalYear = TargetYear;
        CurrentReport.TotalAmount = CurrentRequestTotal;
        CurrentReport.DetailsJson = JsonSerializer.Serialize(itemList);

        await AccService.SaveExpenseReportAsync(CurrentReport);
        await LoadData();
        await JSRuntime.InvokeVoidAsync("alert", "저장되었습니다.");
    }

    private void LoadReport(ExpenseReport report)
    {
        CurrentReport = new ExpenseReport
        {
            Id = report.Id,
            Date = report.Date,
            Title = report.Title,
            FiscalYear = report.FiscalYear,
            DepartmentId = report.DepartmentId,
            TotalAmount = report.TotalAmount,
            PaymentMethod = report.PaymentMethod ?? "계좌" // 지급 방법 불러오기 방어 코드
        };
        try
        {
            itemList = JsonSerializer.Deserialize<List<BudgetPlan>>(report.DetailsJson) ?? new();
        }
        catch
        {
            itemList = new();
        }
        newItem = new();
        inputAmount = null;
        isEditing = false;
        editingItem = null;
    }

    private async Task DeleteReport(ExpenseReport report)
    {
        // 🚀 report.Status가 null일 수도 있으므로, 안전하게 비교하도록 수정
        bool isDeposited = (report.Status != null) && (report.Status == "입금완료" || report.Status == "지급완료");
        if (isDeposited)
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "⚠️ 이미 입금이 확인(완료)된 지출결의서입니다.\n\n" +
                "삭제가 필요하신 경우, 회계 장부(또는 입금 내역)에서\n" +
                "해당 건을 먼저 취소(삭제)하신 후 다시 시도해 주세요.");
            return;
        }

        bool confirmDelete = await JSRuntime.InvokeAsync<bool>("confirm",
            "⚠️ 정말 이 지출결의서를 삭제하시겠습니까?\n\n" +
            "※ 주의: 삭제된 데이터는 다시 되돌릴 수 없습니다!");

        if (confirmDelete)
        {
            await AccService.DeleteExpenseReportAsync(report.Id);
            await LoadData();
            NewReport();
        }
    }

    private void EnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = AddOrUpdateItem();
    }

    private async Task PrintPage()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            (function(){
                var style = document.createElement('style');
                style.id = '__printHide';
                style.innerHTML =
                    '@media print {' +
                    '  nav, header, aside, .sidebar, .top-row, .navbar, ' +
                    '  [class*=""nav-""], .mud-drawer, .mud-appbar,' +
                    '  .page > div:first-child { display:none!important; }' +
                    '  .page, .main, article, .content { margin:0!important; padding:0!important; }' +
                    '}';
                document.head.appendChild(style);
                window.print();
                setTimeout(function(){ var s=document.getElementById('__printHide'); if(s) s.remove(); }, 2000);
            })();
        ");
    }
}