    private decimal? _inputAmount = null;

    private ExpenseReport _currentReport = new() { Date = DateTime.Now };
    private List<BudgetPlan> _itemList = new();
    private BudgetPlan _newItem = new();
    private List<ExpenseReport> _reportHistory = new();
    private List<string> _catList = new();

    // 🚀 수정 모드 처리를 위한 변수
    private bool _isEditing = false;
    private BudgetPlan? _editingItem = null;

    private decimal CurrentRequestTotal => _itemList.Sum(x => x.Amount);

    // 🚀 반복되는 alert 호출 압축용 헬퍼

    // 🚀 항목(Category)인지 내용(Detail)인지 구분해서 글자 축소 & 두 줄 넘김 적용
    private string GetDynamicStyle(string? text, string colType = "Detail")
    {
        if (string.IsNullOrEmpty(text)) return "";
        int len = text.Length;

        // 항목은 7자, 내용은 14자를 기준으로 축소 시작
        int threshold = (colType == "Category") ? 7 : 14;

        // 항목은 11자, 내용은 22자를 넘어가면 두 줄로 래핑(줄바꿈) 허용
        int wrapLimit = (colType == "Category") ? 11 : 22;

        // 1. 기준치 이하면 꽉 차는 10pt
        if (len <= threshold)
            return "font-size: 10pt !important;";

        // 2. 최대치를 초과하면 7.5pt로 고정하고 두 줄로 래핑 (white-space: normal 적용)
        if (len > wrapLimit)
        {
            return "font-size: 7.5pt !important; letter-spacing: -0.5px; white-space: normal !important; word-break: break-all; line-height: 1.1;";
        }

        // 3. 그 사이 값이면 회원님 공식대로 0.5pt씩 미세 축소 (한 줄 유지)
        double fontSize = 10.0 - ((len - threshold) * 0.5);
        if (fontSize < 7.0) fontSize = 7.0;

        double letterSpacing = (len - threshold) * -0.1;
        if (letterSpacing < -0.7) letterSpacing = -0.7;

        return $"font-size: {fontSize:F1}pt !important; letter-spacing: {letterSpacing:F1}px;";
    }

    private async Task PrevYear() { _targetYear--; await LoadData(); }
    private async Task NextYear() { _targetYear++; await LoadData(); }

    private string AmountInKorean
    {
        get
        {
            long n = (long)CurrentRequestTotal;
            if (n == 0) return "영원정";
            string[] ones = { "", "일", "이", "삼", "사", "오", "육", "칠", "팔", "구" };
            string[] units = { "", "십", "백", "천" };
            string[] bigUnits = { "", "만", "억", "조" };
            string result = "";
            int groupIdx = 0;

            while (n > 0)
            {
                long group = n % 10000;
                if (group != 0)
                {
                    string gs = "";
                    for (int i = 3; i >= 0; i--)
                    {
                        int d = (int)((group / (long)Math.Pow(10, i)) % 10);
                        if (d > 0) gs += ones[d] + units[i];
                    }
                    result = gs + bigUnits[groupIdx] + result;
                }
                n /= 10000;
                groupIdx++;
            }
            return result + "원정";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser == null) return;
        await LoadData();
        _catList = await AccService.GetCategorySuggestionsAsync(CurrentUser.DepartmentId, "Expense");
    }

    private async Task LoadData()
    {
        if (CurrentUser == null) return;
        var status = await AccService.GetSubsidyStatusForReportAsync(CurrentUser.DepartmentId, _targetYear);
        _totalBudget = status.TotalReceived;
        _usedBudget = status.TotalUsed;
        _reportHistory = await AccService.GetExpenseReportsAsync(CurrentUser.DepartmentId, _targetYear);
    }

    private void NewReport()
    {
        _currentReport = new ExpenseReport
        {
            Date = DateTime.Now,
            DepartmentId = CurrentUser?.DepartmentId ?? 0,
            FiscalYear = _targetYear
        };
        _itemList.Clear();
        _newItem = new();
        _inputAmount = null; // 신규 작성 시 금액 빈칸 초기화
        _isEditing = false;
        _editingItem = null;
    }

    // 🚀 항목 추가 및 수정 완료 통합 메서드
    private async Task AddOrUpdateItem()
    {
        // 화면의 값을 실제 데이터에 옮겨 담기 (null이면 0으로 처리)
        _newItem.Amount = _inputAmount ?? 0;

        if (string.IsNullOrWhiteSpace(_newItem.Category) || _newItem.Amount <= 0) return;

        // 예산 초과 검증 (수정 모드일 때는 기존 항목 금액을 빼고 계산)
        decimal amountToCheck = _isEditing && _editingItem != null ? _newItem.Amount - _editingItem.Amount : _newItem.Amount;

        if (_totalBudget > 0 && _usedBudget + CurrentRequestTotal + amountToCheck > _totalBudget)
        {
            bool proceed = await JSRuntime.ConfirmAsync(
                "⚠️ 신청 금액이 현재 남은 예산을 초과합니다.\n\n" +
                "(추가 보조금 등의 수입 예정 사유가 있다면 계속 진행하실 수 있습니다.)\n\n" +
                "그래도 명세표에 추가하시겠습니까?");

            if (!proceed) return;
        }

        if (_isEditing && _editingItem != null)
        {
            _editingItem.Category = _newItem.Category;
            _editingItem.CalcDetail = _newItem.CalcDetail;
            _editingItem.Amount = _newItem.Amount;
        }
        else
        {
            _itemList.Add(new BudgetPlan
            {
                Category = _newItem.Category,
                CalcDetail = _newItem.CalcDetail,
                Amount = _newItem.Amount
            });
        }

        _newItem = new();
        _inputAmount = null; // 🚀 입력 완료 후 금액 칸을 다시 완벽한 빈칸으로!
        _isEditing = false;
        _editingItem = null;
    }

    // 🚀 항목 수정 시작
    private void EditItem(BudgetPlan item)
    {
        _editingItem = item;
        _newItem = new BudgetPlan
        {
            Category = item.Category,
            CalcDetail = item.CalcDetail,
            Amount = item.Amount
        };
        _inputAmount = item.Amount; // 🚀 수정 버튼 누르면 금액도 다시 불러오기
        _isEditing = true;
    }

    // 🚀 입력칸 모두 비우기 & 수정 모드 취소 (초기화 버튼 동작)
    private void ClearInputFields()
    {
        _newItem = new BudgetPlan(); // 지출항목, 산출근거 빈칸으로
        _inputAmount = null;         // 금액 빈칸으로
        _isEditing = false;          // 수정 모드 해제
        _editingItem = null;
    }

    // 🚀 항목 삭제
    private void RemoveItem(BudgetPlan item)
    {
        _itemList.Remove(item);
        if (_isEditing && _editingItem == item)
        {
            ClearInputFields();
        }
    }

    private async Task SaveReport()
    {
        if (!_itemList.Any())
        {
            await JSRuntime.AlertAsync("내역을 입력하세요.");
            return;
        }
        if (string.IsNullOrWhiteSpace(_currentReport.Title))
        {
            await JSRuntime.AlertAsync("청구인을 입력하세요.");
            return;
        }

        _currentReport.DepartmentId = CurrentUser?.DepartmentId ?? 0;
        _currentReport.FiscalYear = _targetYear;
        _currentReport.TotalAmount = CurrentRequestTotal;
        _currentReport.DetailsJson = JsonSerializer.Serialize(_itemList);

        await AccService.SaveExpenseReportAsync(_currentReport);
        await LoadData();
        await JSRuntime.AlertAsync("저장되었습니다.");
    }

    private void LoadReport(ExpenseReport report)
    {
        _currentReport = new ExpenseReport
        {
            Id = report.Id,
            Date = report.Date,
            Title = report.Title,
            FiscalYear = report.FiscalYear,
            DepartmentId = report.DepartmentId,
            TotalAmount = report.TotalAmount,
            PaymentMethod = report.PaymentMethod ?? "계좌" // 지급 방법 불러오기 방어 코드
        };

        try
        {
            _itemList = JsonSerializer.Deserialize<List<BudgetPlan>>(report.DetailsJson) ?? new();
        }
        catch
        {
            _itemList = new();
        }

        _newItem = new();
        _inputAmount = null;
        _isEditing = false;
        _editingItem = null;
    }

    private async Task DeleteReport(ExpenseReport report)
    {
        // 🚀 report.Status가 null일 수도 있으므로, 안전하게 비교하도록 수정
        bool isDeposited = (report.Status != null) && (report.Status == "입금완료" || report.Status == "지급완료");

        if (isDeposited)
        {
            await JSRuntime.AlertAsync("⚠️ 이미 입금이 확인(완료)된 지출결의서입니다.\n\n" +
                "삭제가 필요하신 경우, 회계 장부(또는 입금 내역)에서\n" +
                "해당 건을 먼저 취소(삭제)하신 후 다시 시도해 주세요.");
            return;
        }

        bool confirmDelete = await JSRuntime.ConfirmAsync(
            "⚠️ 정말 이 지출결의서를 삭제하시겠습니까?\n\n" +
            "※ 주의: 삭제된 데이터는 다시 되돌릴 수 없습니다!");

        if (confirmDelete)
        {
            await AccService.DeleteExpenseReportAsync(report.Id);
            await LoadData();
            NewReport();
        }
    }

    private void EnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = AddOrUpdateItem();
    }

    private async Task PrintPage()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            (function(){
                var style = document.createElement('style');
                style.id = '__printHide';
                style.innerHTML =
                    '@media print {' +
                    '  body * { visibility: hidden !important; }' +
                    '  .print-only, .print-only * { visibility: visible !important; }' +
                    '  .print-only { position: absolute !important; left: 0; top: 0; width: 100%; display: flex; justify-content: center; }' +
                    '}';
                document.head.appendChild(style);
                window.print();
                setTimeout(function(){ var s=document.getElementById('__printHide'); if(s) s.remove(); }, 2000);
            })();
        ");
    }
}