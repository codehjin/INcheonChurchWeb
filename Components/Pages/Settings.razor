            else if (activeTab == "Account")
            {
                <div class="col-md-9 mx-auto mt-4 mb-5">
                    <h5 class="fw-bold mb-3 text-success">🏦 부서 계좌번호 설정</h5>

                    <div class="@(visibleDepartments.Count > 1 ? "accordion shadow-sm" : "")" id="accountAccordion">
                        @foreach (var dept in visibleDepartments)
                        {
                            bool isExpanded = expandedDepts.ContainsKey(dept.Id) && expandedDepts[dept.Id];
                            bool useAccordion = visibleDepartments.Count > 1;

                            <div class="@(useAccordion ? "accordion-item border mb-2 rounded" : "card shadow-sm border mb-4")">
                                @if (useAccordion)
                                {
                                    <h2 class="accordion-header" id="heading-acc-@dept.Id">
                                        <button class="accordion-button @(isExpanded ? "" : "collapsed") fw-bold text-success bg-light" type="button" @onclick="() => ToggleDept(dept.Id)">
