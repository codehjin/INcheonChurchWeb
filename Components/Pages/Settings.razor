    private async Task HandleSystemRestore(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "⚠️ [경고] 현재 시스템의 모든 데이터가 지워지고 업로드한 백업 파일로 덮어쓰기 됩니다.\n정말 복원을 진행하시겠습니까?");
        if (!confirmed) return;

        isRestoring = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var backupData = JsonSerializer.Deserialize<SystemBackupDto>(json, options);
            if (backupData == null || backupData.Departments == null || backupData.Users == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "유효하지 않은 백업 파일입니다.");
                return;
            }

            DbContext.CategoryMappings.RemoveRange(DbContext.CategoryMappings);
            DbContext.BudgetPlans.RemoveRange(DbContext.BudgetPlans);
            DbContext.Transactions.RemoveRange(DbContext.Transactions);
            DbContext.Users.RemoveRange(DbContext.Users);
            DbContext.Departments.RemoveRange(DbContext.Departments);
            await DbContext.SaveChangesAsync();

            if (backupData.Departments.Any()) DbContext.Departments.AddRange(backupData.Departments);
            if (backupData.Users.Any()) DbContext.Users.AddRange(backupData.Users);
            if (backupData.Transactions.Any()) DbContext.Transactions.AddRange(backupData.Transactions);
            if (backupData.BudgetPlans.Any()) DbContext.BudgetPlans.AddRange(backupData.BudgetPlans);
            if (backupData.CategoryMappings.Any()) DbContext.CategoryMappings.AddRange(backupData.CategoryMappings);

            await DbContext.SaveChangesAsync();

            await LoadData();
            await JSRuntime.InvokeVoidAsync("alert", "✅ 시스템 복원이 성공적으로 완료되었습니다.\n새로고침을 위해 시스템 초기화면으로 이동합니다.");
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"❌ 복원 중 오류 발생: {ex.Message}");
        }
        finally
        {
            isRestoring = false;
            StateHasChanged();
        }
    }

