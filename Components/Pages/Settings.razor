                                                        <tr>
                                                            <td class="fw-bold" style="color: #5a4000;">@o.Role</td>
                                                            <td class="fw-bold fs-6" style="color: #1b1c15;">@o.Name</td>
                                                            <td class="settings-tabular text-muted">@o.StartDate.ToString("yyyy.MM.dd")</td>
                                                            <td class="settings-tabular text-muted">@o.EndDate.ToString("yyyy.MM.dd")</td>
                                                            <td>
                                                                <button class="settings-secondary-btn py-1 px-2" style="font-size: 0.75rem;" @onclick="() => EditOfficer(dept.Id, o)">수정</button>
                                                                <button class="settings-danger-btn py-1 px-2" style="font-size: 0.75rem; background-color: #ffffff; border: 1px solid #ba1a1a;" @onclick="() => StartReplaceOfficer(dept.Id, o)">교체</button>
                                                                <button class="settings-danger-btn py-1 px-2 ms-1" style="font-size: 0.75rem;" @onclick="() => DeleteOfficerData(dept.Id, o.Id)"><i class="bi bi-trash"></i></button>
                                                            </td>
                                                        </tr>
                                                    }
                                                    @if (!oList.Any()) { <tr><td colspan="5" class="py-5 text-muted">등록된 임원 정보가 없습니다.</td></tr> }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                }

                @* ── 계좌 번호 서브 탭 ── *@
                @if (_infoSubTab == "Account")
                {
                <div class="col-md-9 mx-auto mt-2">
                    <h4 class="fw-bold mb-4" style="color: #1b1c15;">부서 계좌번호 설정</h4>

                    <div class="@(_visibleDepartments.Count > 1 ? "accordion shadow-sm" : "")" id="accountAccordion">
                        @foreach (var dept in _visibleDepartments)
                        {
                            bool isExpanded = _expandedDepts.ContainsKey(dept.Id) && _expandedDepts[dept.Id];
                            bool useAccordion = _visibleDepartments.Count > 1;

                            <div class="@(useAccordion ? "accordion-item" : "settings-card border border-light p-4 mb-4")">
                                @if (useAccordion)
                                {
                                    <h2 class="accordion-header" id="heading-acc-@dept.Id">
                                        <button class="accordion-button @(isExpanded ? "" : "collapsed")" type="button" @onclick="() => ToggleDept(dept.Id)">
                                            <i class="bi bi-people-fill me-1" style="color: #785600;"></i>@dept.Name 계좌
                                            @if(!string.IsNullOrEmpty(dept.BankName)) { <span class="badge bg-white text-muted border ms-3">@dept.BankName 등록됨</span> }
                                        </button>
                                    </h2>
                                }
                                else
                                {
                                    <h5 class="fw-bold text-dark mb-4"><i class="bi bi-people-fill me-1" style="color: #785600;"></i>@dept.Name 계좌
                                        @if(!string.IsNullOrEmpty(dept.BankName)) { <span class="badge bg-light text-muted border ms-2 fs-6">@dept.BankName 등록됨</span> }
                                    </h5>
                                }

                                <div id="collapse-acc-@dept.Id" class="@(useAccordion ? $"accordion-collapse collapse {(isExpanded ? "show" : "")}" : "")">
                                    <div class="@(useAccordion ? "accordion-body bg-white p-4" : "")">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold small text-muted">은행명</label>
                                                <input type="text" class="settings-input fw-bold" @bind="dept.BankName" placeholder="예: 하나은행" style="color: #785600;" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold small text-muted">계좌번호</label>
                                                <input type="text" class="settings-input settings-tabular" @bind="dept.AccountNumber" placeholder="'-' 포함 입력" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold small text-muted">예금주</label>
                                                <input type="text" class="settings-input" @bind="dept.AccountHolder" placeholder="예: 인천중앙교회" />
                                            </div>
                                        </div>
                                        <div class="mt-4 text-end">
                                            <button class="settings-gold-btn px-5 py-3" @onclick="() => SaveAccountInfo(dept)">
                                                <i class="bi bi-save me-2"></i> 안전하게 저장
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                }
            }
        </div>
    </div>
</div>

<script>
    window.downloadJsonFile = (fileName, jsonContent) => {
        const blob = new Blob([jsonContent], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = fileName; link.href = url; document.body.appendChild(link); link.click(); document.body.removeChild(link); URL.revokeObjectURL(url);
    };
    window.downloadExcelFile = (fileName, base64String) => {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = `data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,${base64String}`;
        document.body.appendChild(link); link.click(); document.body.removeChild(link);
    };
</script>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private Guid _systemRestoreKey = Guid.NewGuid();
    private Guid _settingsImportKey = Guid.NewGuid();
