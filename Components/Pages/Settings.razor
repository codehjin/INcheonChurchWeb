    // 🚀 메인 탭별 서브 탭(2-Depth) 상태
    private string _infoSubTab = "Officers";      // Officers, Account
    private string _budgetSubTab = "Income";      // Income, Expense, Quarter (구 _budgetType 대체)
    private string _mappingSubTab = "Income";     // Income, Expense, Analyze
