                                <td>
                                    @(u.Role == "Admin" ? "시스템 관리자" :
                                                                u.Role == "Auditor" ? "국장/회계감사" :
                                                                (u.Role == "DeptAdmin" || u.Role == "User") ? "부서 메인회계" : "부서 보조회계")
