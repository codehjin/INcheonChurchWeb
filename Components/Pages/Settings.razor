    private DateTime GetFiscalYearEndDate(int year) => AccountingService.GetFourthSundayOfMonth(year, 11);
    // 권한 체크
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;
   
    private List<string> _incomeCats = new();
    private List<string> _expenseCats = new();
    private List<BudgetPlan> _budgetList = new();
    private IGrouping<int, BudgetPlan>[] _budgetHistory = Array.Empty<IGrouping<int, BudgetPlan>>();

    private IEnumerable<BudgetPlan> CurrentYearBudgets => _budgetList.Where(b => b.Year == _targetYear && b.Type == _budgetSubTab);
    private IEnumerable<IGrouping<string, BudgetPlan>> GroupedBudgets => CurrentYearBudgets.GroupBy(b => b.Category);

    private IEnumerable<DataBackup> ManualBackups => _backupList.Where(b => b.DataType != "Auto").OrderByDescending(b => b.BackupDate);
    private IEnumerable<DataBackup> AutoBackups => _backupList.Where(b => b.DataType == "Auto").OrderByDescending(b => b.BackupDate);

    private BudgetPlan _newPlan = new();
    private List<CategoryMapping> _mappingList = new();
    private CategoryMapping _newMapping = new();

    // 🚀 자동분류 설정 '관리 대상 부서' — 최고관리자는 타 부서로 전환 가능(0이면 본인 부서로 초기화)
    private int _mappingTargetDeptId = 0;

    // 🚀 규칙 테이블 정렬/필터 상태 (수입용 / 지출용 각각)
    private string _incomeSortColumn = "Keyword";
    private bool _incomeSortAscending = true;
    private string _incomeFilterCategory = "";
    private string _expenseSortColumn = "Keyword";
    private bool _expenseSortAscending = true;
    private string _expenseFilterCategory = "";

    // 헤더 클릭 시 정렬 토글 (같은 컬럼이면 방향 반전, 다른 컬럼이면 오름차순부터)
    private void SortIncomeRules(string column)
    {
        if (_incomeSortColumn == column) _incomeSortAscending = !_incomeSortAscending;
        else { _incomeSortColumn = column; _incomeSortAscending = true; }
    }
    private void SortExpenseRules(string column)
    {
        if (_expenseSortColumn == column) _expenseSortAscending = !_expenseSortAscending;
        else { _expenseSortColumn = column; _expenseSortAscending = true; }
    }

    // 필터(카테고리) + 정렬(키워드/항목)을 적용한 최종 표시용 목록
    private IEnumerable<CategoryMapping> IncomeRules =>
        ApplyRuleSortFilter(_mappingList.Where(x => _incomeCats.Contains(x.Category ?? "")), _incomeFilterCategory, _incomeSortColumn, _incomeSortAscending);
    private IEnumerable<CategoryMapping> ExpenseRules =>
        ApplyRuleSortFilter(_mappingList.Where(x => _expenseCats.Contains(x.Category ?? "")), _expenseFilterCategory, _expenseSortColumn, _expenseSortAscending);

    private static IEnumerable<CategoryMapping> ApplyRuleSortFilter(IEnumerable<CategoryMapping> src, string filterCategory, string sortColumn, bool ascending)
    {
        if (!string.IsNullOrEmpty(filterCategory)) src = src.Where(x => x.Category == filterCategory);
        Func<CategoryMapping, string> keySelector = sortColumn == "Category" ? (x => x.Category ?? "") : (x => x.Keyword ?? "");
        return ascending ? src.OrderBy(keySelector) : src.OrderByDescending(keySelector);
    }

    // 정렬 상태 아이콘: 비활성 컬럼은 양방향, 활성 컬럼은 오름/내림 알파벳 아이콘
    private static string RuleSortIcon(string activeColumn, string thisColumn, bool ascending)
        => activeColumn != thisColumn ? "bi-arrow-down-up text-muted" : (ascending ? "bi-sort-alpha-down" : "bi-sort-alpha-up");

    private string IncomeKeywordIcon => RuleSortIcon(_incomeSortColumn, "Keyword", _incomeSortAscending);
    private string IncomeCategoryIcon => RuleSortIcon(_incomeSortColumn, "Category", _incomeSortAscending);
    private string ExpenseKeywordIcon => RuleSortIcon(_expenseSortColumn, "Keyword", _expenseSortAscending);
    private string ExpenseCategoryIcon => RuleSortIcon(_expenseSortColumn, "Category", _expenseSortAscending);

    // 🚀 추천 결과(Suggestions) 정렬/필터 상태 (기본: 빈도 Count 내림차순)
    private string _suggSortColumn = "Count";
    private bool _suggSortAscending = false;
    private string _suggFilterCategory = "";

    private void SortSuggestions(string column)
    {
        if (_suggSortColumn == column) _suggSortAscending = !_suggSortAscending;
        else { _suggSortColumn = column; _suggSortAscending = column != "Count"; } // 텍스트는 오름차순, Count는 내림차순부터
    }

    // 필터(추천분류) + 정렬(키워드/추천분류/빈도) 적용한 표시용 추천 목록
    private IEnumerable<KeywordSuggestion> FilteredSuggestions
    {
        get
        {
            IEnumerable<KeywordSuggestion> src = _suggestions;
            if (!string.IsNullOrEmpty(_suggFilterCategory)) src = src.Where(s => s.RecommendedCategory == _suggFilterCategory);
            src = _suggSortColumn switch
            {
                "Keyword"  => _suggSortAscending ? src.OrderBy(s => s.Keyword) : src.OrderByDescending(s => s.Keyword),
                "Category" => _suggSortAscending ? src.OrderBy(s => s.RecommendedCategory) : src.OrderByDescending(s => s.RecommendedCategory),
                _          => _suggSortAscending ? src.OrderBy(s => s.TotalCount) : src.OrderByDescending(s => s.TotalCount), // "Count"
            };
            return src;
        }
    }

    private string SuggKeywordIcon => RuleSortIcon(_suggSortColumn, "Keyword", _suggSortAscending);
    private string SuggCountIcon => RuleSortIcon(_suggSortColumn, "Count", _suggSortAscending);
    private string SuggCategoryIcon => RuleSortIcon(_suggSortColumn, "Category", _suggSortAscending);

    // 🚀 자동분류 규칙 분석(추천 시스템) 상태
    private int _analysisYear = DateTime.Now.Year;
    private int _analysisQuarter = 0; // 0 = 전체
    private int _analysisMonth = 0;   // 0 = 전체
    private string _analysisType = "지출"; // 분석 대상 장부 구분(수입/지출)
    private bool _isAnalyzing = false;
    private bool _analysisRan = false;
    private List<KeywordSuggestion> _suggestions = new();

    // 🚀 추천 결과 체크박스 일괄 등록용 (선택된 키워드 집합)
    private HashSet<string> _selectedSuggestions = new();

    private bool IsAllSuggestionsSelected => FilteredSuggestions.Any() && _selectedSuggestions.Count == FilteredSuggestions.Count();

    private void ToggleAllSuggestions(ChangeEventArgs e)
    {
        bool isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            _selectedSuggestions = FilteredSuggestions.Select(s => s.Keyword).ToHashSet();
        }
        else
        {
            _selectedSuggestions.Clear();
        }
    }

    private void ToggleSuggestion(string keyword, object? checkedValue)
    {
        bool isChecked = checkedValue is bool b && b;
        if (isChecked) _selectedSuggestions.Add(keyword);
        else _selectedSuggestions.Remove(keyword);
    }
    // 프로그레스 바 색상 팔레트 (분포 세그먼트 순환용)
    private static readonly string[] _barPalette = { "#785600", "#b08500", "#5a8f3c", "#3c7d8f", "#8f5a3c", "#9c4f6e", "#6e6e6e" };
    private string BarColor(int idx) => _barPalette[idx % _barPalette.Length];
    private List<DataBackup> _backupList = new();

    private List<User> _adminUserList = new();
    private List<Department> _adminDeptList = new();
    
    private User _newUser = new() { Role = "Manager", IsActive = true };
    private string _newSelfPassword = "";
    private string _confirmSelfPassword = "";
    private string _currentVisiblePassword = "";
    private string _customBackupMemo = "";

    private List<Department> _visibleDepartments = new();
    private Dictionary<int, List<DepartmentOfficer>> _deptOfficers = new();
    private Dictionary<int, DepartmentOfficer> _newOfficers = new();
    private Dictionary<int, bool> _isEditingMap = new();
    private DepartmentOfficer? _officerToReplace = null;
    private string _replaceNewName = "";
    private DateTime _replaceStartDate = DateTime.Now;
    private int _replacingDeptId = 0;
    private bool _isReplacing = false;
    private Dictionary<int, bool> _expandedDepts = new();
    private Dictionary<string, bool> _expandedCategories = new();

    private DateTime[] _quarterStartDates = new DateTime[4] { DateTime.Now, DateTime.Now, DateTime.Now, DateTime.Now };
    private DateTime[] _quarterEndDates = new DateTime[4] { DateTime.Now, DateTime.Now, DateTime.Now, DateTime.Now };

    private string _tempSecret = "";
    private string _qrCodeImageUrl = "";
    private string _setupOtpCode = "";

    private async Task SyncWithPreviousQuarter(int q)
    {
        if (q == 1)
        {
            var prevQ4 = await AccService.GetQuarterDateRangeAsync(CurrentUser?.DepartmentId ?? 0, _targetYear - 1, 4);
            _quarterStartDates[0] = prevQ4.End.Date.AddDays(1);
        }
        else
        {
            _quarterStartDates[q - 1] = _quarterEndDates[q - 2].Date.AddDays(1);
        }
    }

    private void ApplyDefaultQuarters()
    {
        for (int q = 1; q <= 4; q++)
        {
            var range = AccountingService.GetDefaultQuarterRange(_targetYear, q);
            _quarterStartDates[q - 1] = range.Start;
            _quarterEndDates[q - 1] = range.End;
        }
    }

    private async Task SaveAllQuarters()
    {
        if (await JSRuntime.InvokeAsync<bool?>("confirm", $"{_targetYear}년도 전체 분기 기간을 저장하시겠습니까?") != true) return;
        for (int q = 1; q <= 4; q++)
        {
            await AccService.SaveQuarterSettingAsync(CurrentUser?.DepartmentId ?? 0, _targetYear, q, _quarterStartDates[q - 1], _quarterEndDates[q - 1]);
        }
        int updated = await AccService.BulkRecalcFiscalYearQuarterAsync(CurrentUser?.DepartmentId ?? 0, _targetYear);
        string msg = $"{_targetYear}년도 전체 분기 기간이 저장되었습니다.";
        if (updated > 0) msg += $"\n장부 데이터 {updated}건의 회계연도/분기가 재계산되었습니다.";
        await ShowAlertAsync(msg);
    }

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser == null) return;
        
        if (CurrentUser?.IsManager == true) _activeTab = "Budget";
        else if (CurrentUser?.IsAuditor == true) _activeTab = "Info";
        else _activeTab = "Security";
       
        _targetYear = Math.Max(2024, DateTime.Now.Year);
        using var context = DbContextFactory.CreateDbContext();
        var username = CurrentUser?.Username;
        var user = await context.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Username == username);
        if (user != null) _currentVisiblePassword = user.Password;

        await LoadData();
    }

    private async Task ChangeYear(int offset)
    {
        int newYear = _targetYear + offset;
        if (newYear >= 2024 && newYear <= DateTime.Now.Year + 1)
        {
            _targetYear = newYear;
            await LoadData();
        }
    }

    private async Task ChangeTab(string tab)
    {
        _activeTab = tab;
        _newPlan = new();
        _expandedCategories.Clear();
        await LoadData();
    }

    private async Task LoadData()
    {
        if (CurrentUser == null) return;
        int myDeptId = CurrentUser.DepartmentId;

        for (int i = 1; i <= 4; i++)
        {
            var range = await AccService.GetQuarterDateRangeAsync(myDeptId, _targetYear, i);
            _quarterStartDates[i - 1] = range.Start;
            _quarterEndDates[i - 1] = range.End;
        }

        if (CurrentUser?.IsSystemAdmin == true && _activeTab == "Security")
        {
            _adminUserList = await AccService.GetAllUsersAsync();
            _adminDeptList = await AccService.GetDepartmentsAsync();
            return;
        }

        if (_activeTab == "Budget")
        {
            using var context = DbContextFactory.CreateDbContext();
            if (CurrentUser?.IsSystemAdmin == true)
            {
                // Admin: 모든 부서 예산 로드 (수입/지출 모두 — 탭 내부에서 _budgetSubTab으로 분기)
                var allDepts = await context.Departments.AsNoTracking().Where(d => d.Name != "관리자").OrderBy(d => d.Id).ToListAsync();
                _visibleDepartments = allDepts;
                var allPlans = await context.BudgetPlans.AsNoTracking()
                    .OrderBy(b => b.Year).ThenBy(b => b.DepartmentId).ThenBy(b => b.Category).ToListAsync();
                _budgetList = allPlans;
                _budgetHistory = allPlans.GroupBy(b => b.Year).ToArray();
                var allCurrentYearPlans = allPlans.Where(b => b.Year == _targetYear).ToList();
                _incomeCats = allCurrentYearPlans.Where(b => b.Type == "Income" || b.Type == "수입").Select(b => b.Category).Distinct().ToList();
                _expenseCats = allCurrentYearPlans.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();
            }
            else
            {
                var allPlans = await context.BudgetPlans.AsNoTracking().Where(b => b.DepartmentId == myDeptId).OrderBy(b => b.Year).ThenBy(b => b.Category).ToListAsync();
                _budgetList = allPlans;
                _budgetHistory = allPlans.GroupBy(b => b.Year).ToArray();
                var currentYearAllPlans = allPlans.Where(b => b.Year == _targetYear).ToList();
                _incomeCats = currentYearAllPlans.Where(b => b.Type == "Income" || b.Type == "수입").Select(b => b.Category).Distinct().ToList();
                _expenseCats = currentYearAllPlans.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();
            }
        }
        else if (_activeTab == "Mapping")
        {
            using var context = DbContextFactory.CreateDbContext();

            // 🚀 최고관리자는 대상 부서를 전환할 수 있으므로 부서 목록을 로드.
            if (CurrentUser?.IsSystemAdmin == true)
            {
                _adminDeptList = await AccService.GetDepartmentsAsync();
            }
            // 대상 부서가 미설정(0)이면 본인 부서로 초기화.
            if (_mappingTargetDeptId == 0) _mappingTargetDeptId = CurrentUser?.DepartmentId ?? 0;

            // 관리자 본인 부서가 선택 목록(관리자 부서 제외)에 없으면 첫 실부서로 스냅 → 드롭다운과 상태 정합.
            if (CurrentUser?.IsSystemAdmin == true)
            {
                var selectable = _adminDeptList.Where(d => d.Name != "관리자").ToList();
                if (selectable.Any() && !selectable.Any(d => d.Id == _mappingTargetDeptId))
                {
                    _mappingTargetDeptId = selectable.First().Id;
                }
            }

            // 이후 모든 조회는 본인 부서가 아니라 '관리 대상 부서(_mappingTargetDeptId)' 기준.
            _mappingList = await AccService.GetMappingsAsync(_mappingTargetDeptId);
            var currentYearAllPlans = await context.BudgetPlans.AsNoTracking().Where(b => b.DepartmentId == _mappingTargetDeptId && b.Year == _targetYear).ToListAsync();
            _expenseCats = currentYearAllPlans.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();
            _incomeCats = currentYearAllPlans.Where(b => b.Type == "Income" || b.Type == "수입").Select(b => b.Category).Distinct().ToList();
        }
        else if (_activeTab == "Backup") 
        { 
            _backupList = await AccService.GetBackupsAsync(myDeptId);
        }
        else if (_activeTab == "Info")
        {
            using var context = DbContextFactory.CreateDbContext();
            var allDepts = await context.Departments.Where(d => d.Name != "관리자" && d.Name != "시스템").OrderBy(d => d.Id).ToListAsync();
            if (CurrentUser?.IsSystemAdmin == true || CurrentUser?.IsAuditor == true || CurrentUser?.Department?.Name == "교육국")
            {
                _visibleDepartments = allDepts;
            }
            else
            {
                _visibleDepartments = allDepts.Where(d => d.Id == (CurrentUser?.DepartmentId ?? 0)).ToList();
            }

            foreach (var d in _visibleDepartments)
            {
                _deptOfficers[d.Id] = await context.DepartmentOfficers.AsNoTracking().Where(o => o.DepartmentId == d.Id && o.Year == _targetYear).ToListAsync();
                if (!_newOfficers.ContainsKey(d.Id))
                {
                    _newOfficers[d.Id] = new DepartmentOfficer { DepartmentId = d.Id, Year = _targetYear, StartDate = _quarterStartDates[0], EndDate = _quarterEndDates[3] };
                    _isEditingMap[d.Id] = false;
                }
                if (!_expandedDepts.ContainsKey(d.Id))
                {
                    _expandedDepts[d.Id] = false;
                }
            }
        }
    }

