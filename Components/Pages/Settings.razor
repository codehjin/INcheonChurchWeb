    private async Task HandleBulkImport(InputFileChangeEventArgs e)
    {
        if (CurrentUser == null) return;
        var file = e.File; if (file == null) return;
        _isImporting = true; StateHasChanged();
        try
        {
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream); memoryStream.Position = 0;
            using var reader = ExcelReaderFactory.CreateReader(memoryStream); var result = reader.AsDataSet();
            int budgetCount = 0; int mappingCount = 0;
            int deptId = CurrentUser.DepartmentId;
            using var context = DbContextFactory.CreateDbContext();

            foreach (DataTable table in result.Tables)
            {
                if (table.TableName == "�����ϰ��Է�")
                {
                    for (int i = 1; i < table.Rows.Count; i++)
                    {
                        var row = table.Rows[i];
                        string type = row[0]?.ToString()?.Trim() ?? ""; 
                        if (type.Contains("�����ϼ���")) continue; 

                        string cat = row[1]?.ToString()?.Trim() ?? ""; string sub = row[2]?.ToString()?.Trim() ?? ""; string calc = row[3]?.ToString()?.Trim() ?? ""; string amtStr = row[4]?.ToString()?.Trim() ?? "0";
                        if (string.IsNullOrEmpty(cat)) continue;
                        if (type == "����") type = "Income"; if (type == "����") type = "Expense";
                        if (type != "Income" && type != "Expense") continue;
                        decimal.TryParse(amtStr, out decimal amt);
                        context.BudgetPlans.Add(new BudgetPlan { DepartmentId = deptId, Year = _targetYear, Type = type, Category = cat, SubCategory = sub, CalcDetail = calc, Amount = amt });
                        budgetCount++;
                    }
                }
                else if (table.TableName == "�ڵ��з��ϰ��Է�")
                {
                    for (int i = 1; i < table.Rows.Count; i++)
                    {
                        var row = table.Rows[i];
                        string type = row[0]?.ToString()?.Trim() ?? "";
                        if (type.Contains("�����ϼ���")) continue; 

                        string keyword = row[1]?.ToString()?.Trim() ?? ""; string cat = row[2]?.ToString()?.Trim() ?? "";
                        if (string.IsNullOrEmpty(keyword) || string.IsNullOrEmpty(cat)) continue;
                        context.CategoryMappings.Add(new CategoryMapping { DepartmentId = deptId, Keyword = keyword, Category = cat }); mappingCount++;
                    }
                }
            }
            await context.SaveChangesAsync();
            await LoadData(); 
            await ShowAlertAsync($"? �ϰ� �Է� �Ϸ�!\n- ����: {budgetCount}��\n- �ڵ��з�: {mappingCount}��");
        }
        catch (Exception ex) { await ShowAlertAsync($"? ���� ó�� �� ����: {ex.Message}"); }
        finally { _isImporting = false; _bulkImportKey = Guid.NewGuid(); StateHasChanged(); }
    }

