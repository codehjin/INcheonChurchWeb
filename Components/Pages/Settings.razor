                    else
                    {
                        <div class="card p-3 shadow-sm border-primary border-opacity-25 bg-light mb-4">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">직분</label>
                                    <select class="form-select" @bind="newOfficer.Role">
                                        <option value="">-선택-</option>
