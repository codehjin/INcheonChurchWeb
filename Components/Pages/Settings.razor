                                <div id="collapse-acc-@dept.Id" class="@(useAccordion ? $"accordion-collapse collapse {(isExpanded ? "show" : "")}" : "")">
                                    <div class="@(useAccordion ? "accordion-body bg-white p-4" : "card-body bg-white p-4")">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold small text-secondary">은행명</label>
                                                <input type="text" class="form-control border-success" @bind="dept.BankName" placeholder="예: 농협은행" />
