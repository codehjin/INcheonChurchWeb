        };
    }

    // 수정 취소: 편집 모드 해제(원본은 그대로)
    private void CancelEditMapping()
    {
        _editingMappingId = 0;
    }

    // 수정 저장: 권한 확인 후 SaveMappingAsync(Update) → 편집 모드 해제 → 재로딩
    private async Task SaveEditMappingAsync()
    {
        bool canEdit = CurrentUser?.IsSystemAdmin == true || _mappingTargetDeptId == (CurrentUser?.DepartmentId ?? 0);
        if (!canEdit) { await ShowAlertAsync("해당 부서의 규칙을 수정할 권한이 없습니다."); return; }
        if (string.IsNullOrWhiteSpace(_editMappingTemp.Keyword) || string.IsNullOrWhiteSpace(_editMappingTemp.Category))
        {
            await ShowAlertAsync("키워드와 항목을 입력하세요.");
            return;
        }

        await AccService.SaveMappingAsync(_editMappingTemp);
        _editingMappingId = 0;
        await LoadData();
    }

    // 🚀 최고관리자 전용: 자동분류 관리 대상 부서 전환
    private async Task ChangeMappingTargetDept(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id)) _mappingTargetDeptId = id;
        _suggestions.Clear();   // 이전 부서의 분석 결과 제거
        _analysisRan = false;   // 새 부서는 분석 전 상태로
        await LoadData();       // 새 부서 기준 규칙/항목 재로딩
    }

    // 🚀 선택 기간의 지출 장부를 분석하여 키워드별 추천 분류 목록을 생성
    private async Task RunMappingAnalysis()
    {
        if (CurrentUser == null) return;
        _isAnalyzing = true;
        StateHasChanged();      // 🚀 로딩 스피너를 먼저 화면에 그리도록 즉시 렌더 요청
        await Task.Delay(10);   // 🚀 UI 스레드에 양보하여 스피너가 실제로 표시되게 함
        try
        {
            _suggestions = await AccService.AnalyzeMappingSuggestionsAsync(_mappingTargetDeptId, _analysisYear, _analysisQuarter, _analysisMonth, _analysisType);
            _selectedSuggestions.Clear(); // 새 분석 결과에 맞춰 선택 초기화
            _analysisRan = true;
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged(); // 🚀 분석 종료 후 결과/스피너 해제 상태를 확실히 반영
        }
    }

    // 🚀 추천된 키워드/분류를 지출 자동분류 규칙 DB에 즉시 등록하고 상단 목록 갱신
    private async Task AddSuggestedRule(KeywordSuggestion s)
    {
        if (CurrentUser == null) return;
        if (_mappingList.Any(m => (m.Keyword ?? "").Trim() == s.Keyword)) { await ShowAlertAsync("이미 등록된 키워드입니다."); return; }

        await AccService.SaveMappingAsync(new CategoryMapping
        {
            DepartmentId = _mappingTargetDeptId,
            Keyword = s.Keyword,
            Category = s.RecommendedCategory
        });
        await LoadData(); // 상단 '지출 항목 자동분류 규칙' 목록(_mappingList) 갱신
        await ShowAlertAsync($"'{s.Keyword}' → '{s.RecommendedCategory}' 규칙이 등록되었습니다.");
    }

    // 🚀 체크된 추천 키워드들을 한 번에 규칙으로 등록
    private async Task BulkAddSuggestedRulesAsync()
    {
        if (_selectedSuggestions.Count == 0) { await ShowAlertAsync("등록할 추천 항목을 선택하세요."); return; }

        bool canEdit = CurrentUser?.IsSystemAdmin == true || _mappingTargetDeptId == (CurrentUser?.DepartmentId ?? 0);
        if (!canEdit) { await ShowAlertAsync("해당 부서의 규칙을 등록할 권한이 없습니다."); return; }

        // 선택된 항목 중 아직 등록되지 않은 것만 저장(중복 방지)
        var targets = FilteredSuggestions
            .Where(s => _selectedSuggestions.Contains(s.Keyword)
                     && !_mappingList.Any(m => (m.Keyword ?? "").Trim() == s.Keyword))
            .ToList();

        int added = 0;
        foreach (var s in targets)
        {
            await AccService.SaveMappingAsync(new CategoryMapping
            {
                DepartmentId = _mappingTargetDeptId,
                Keyword = s.Keyword,
                Category = s.RecommendedCategory
                // MappingType 구분은 분석 대상(_analysisType)과 동일 → Category가 해당 구분 항목이므로 자동 귀속
            });
            added++;
        }

        _selectedSuggestions.Clear();
        await LoadData();           // 상단 규칙 목록 갱신
        await RunMappingAnalysis(); // 추천 리스트 재분석(이미 등록된 항목 배지 반영)
        await ShowAlertAsync($"{added}건의 {_analysisType} 규칙이 일괄 등록되었습니다.");
    }

    private async Task HandlePasswordKey(KeyboardEventArgs e) { if (e.Key == "Enter") { await ChangeMyPassword(); } }
    
    private async Task ChangeMyPassword()
    {
        if (string.IsNullOrWhiteSpace(_newSelfPassword)) { await ShowAlertAsync("새 비밀번호를 입력하세요."); return; }
        if (_newSelfPassword != _confirmSelfPassword) { await ShowAlertAsync("입력하신 두 비밀번호가 서로 일치하지 않습니다. 다시 확인해주세요."); return; }
        if (await JSRuntime.InvokeAsync<bool?>("confirm", "새로운 비밀번호로 변경하시겠습니까?") == true && CurrentUser != null) 
        { 
            await AccService.ChangePasswordAsync(CurrentUser.Username, _newSelfPassword);
            _currentVisiblePassword = _newSelfPassword; _newSelfPassword = ""; _confirmSelfPassword = ""; 
            await ShowAlertAsync("비밀번호가 성공적으로 변경되었습니다!");
        }
    }
    
    private void Prepare2FA() { if (CurrentUser != null) { _tempSecret = TotpService.GenerateSecret(); _qrCodeImageUrl = TotpService.GetQrCodeImage(CurrentUser.Username, _tempSecret); } }
    private async Task HandleOtpKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Enable2FA(); }

    private async Task Enable2FA() 
    {
        if (TotpService.VerifyCode(_tempSecret, _setupOtpCode)) 
        {
            if (CurrentUser != null)
            {
                using var context = DbContextFactory.CreateDbContext();
                var user = await context.Users.FirstOrDefaultAsync(u => u.Username == CurrentUser.Username);
                if (user != null)
                {
                    user.TwoFactorSecret = _tempSecret; user.IsTwoFactorEnabled = true; await context.SaveChangesAsync();
                    CurrentUser.IsTwoFactorEnabled = true; _tempSecret = ""; _setupOtpCode = "";
                    await ShowAlertAsync("성공! 이제 로그인 시 OTP 인증이 필요합니다.");
                }
            }
        } 
        else { await ShowAlertAsync("번호가 일치하지 않습니다. 다시 확인하세요."); }
    }
    
    // 반복되던 단순 알림(alert) 호출을 한 곳으로 모은 내부 헬퍼
    private async Task ShowAlertAsync(string message) => await JSRuntime.InvokeVoidAsync("alert", message);

    private async Task Disable2FA()
    {
        if (await JSRuntime.InvokeAsync<bool?>("confirm", "보안 인증을 해제하시겠습니까?") == true) 
        {
            if (CurrentUser != null)
            {
                using var context = DbContextFactory.CreateDbContext();
                var user = await context.Users.FirstOrDefaultAsync(u => u.Username == CurrentUser.Username);
                if (user != null)
                {
                    user.IsTwoFactorEnabled = false; user.TwoFactorSecret = null; await context.SaveChangesAsync();
                    CurrentUser.IsTwoFactorEnabled = false; await ShowAlertAsync("보안 인증이 해제되었습니다.");
                }
            }
        }
    }
}