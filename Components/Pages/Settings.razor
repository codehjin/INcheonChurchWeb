                                        <option value="부장(팀장)">부장(팀장)</option>
                                        <option value="총무">총무</option>
                                        <option value="회계">회계</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1">이름</label>
                                    <div class="input-group">
                                        <input class="form-control" @bind="newOfficer.Name" placeholder="이름 입력" />
                                        @if (!string.IsNullOrEmpty(newOfficer.Name))
                                        {
                                            <button class="btn btn-outline-secondary px-2" type="button" style="font-size: 0.75rem;" @onclick="() => { newOfficer.Name = string.Empty; }" title="지우기">❌</button>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label small fw-bold mb-1 text-center d-block">임기 (시작 ~ 종료)</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="date" class="form-control" @bind="newOfficer.StartDate" />
                                        <span>~</span>
                                        <input type="date" class="form-control" @bind="newOfficer.EndDate" />
