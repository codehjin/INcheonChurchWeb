</div>

<script>
    window.downloadJsonFile = (fileName, jsonContent) => {
        const blob = new Blob([jsonContent], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = fileName; link.href = url; document.body.appendChild(link); link.click(); document.body.removeChild(link); URL.revokeObjectURL(url);
    };
    window.downloadExcelFile = (fileName, base64String) => {
        const link = document.createElement('a');
        link.download = fileName; link.href = `data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,${base64String}`;
        document.body.appendChild(link); link.click(); document.body.removeChild(link);
    };
</script>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private Guid bulkImportKey = Guid.NewGuid();
    private Guid systemRestoreKey = Guid.NewGuid();
    private string mappingType = "지출";
    private string activeTab = "Income";
    private int TargetYear = DateTime.Now.Year;
    private bool isImporting = false;
    private bool isRestoring = false;
    private bool IsSystemAdmin = false;
    private bool IsDeptAdmin = false;
    
    private List<string> IncomeCats = new();
    private List<string> ExpenseCats = new();
    private List<BudgetPlan> budgetList = new();
    private IGrouping<int, BudgetPlan>[] budgetHistory = Array.Empty<IGrouping<int, BudgetPlan>>();
    
    private IEnumerable<BudgetPlan> CurrentYearBudgets => budgetList.Where(b => b.Year == TargetYear && b.Type == activeTab);
    private IEnumerable<IGrouping<string, BudgetPlan>> GroupedBudgets => CurrentYearBudgets.GroupBy(b => b.Category);

    private IEnumerable<DataBackup> ManualBackups => backupList.Where(b => b.DataType != "Auto").OrderByDescending(b => b.BackupDate);
    private IEnumerable<DataBackup> AutoBackups => backupList.Where(b => b.DataType == "Auto").OrderByDescending(b => b.BackupDate);

    private BudgetPlan newPlan = new();
    private List<CategoryMapping> mappingList = new();
    private CategoryMapping newMapping = new();
    private List<DataBackup> backupList = new();

    private List<User> adminUserList = new();
    private List<Department> adminDeptList = new();
    private User newUser = new() { Role = "DeptAdmin", IsActive = true };
    private string newSelfPassword = "";
    private string currentVisiblePassword = "";
    private string customBackupMemo = "";

    private List<Department> visibleDepartments = new();
    private Dictionary<int, List<DepartmentOfficer>> deptOfficers = new();
    private Dictionary<int, DepartmentOfficer> newOfficers = new();
    private Dictionary<int, bool> isEditingMap = new();
    private DepartmentOfficer? officerToReplace = null;
    private string replaceNewName = "";
    private DateTime replaceStartDate = DateTime.Now;
    private int replacingDeptId = 0;
    private bool isReplacing = false;

    private Dictionary<int, bool> expandedDepts = new();
    private Dictionary<string, bool> expandedCategories = new();
    
    private DateTime[] QuarterStartDates = new DateTime[4] { DateTime.Now, DateTime.Now, DateTime.Now, DateTime.Now };
    private DateTime[] QuarterEndDates = new DateTime[4] { DateTime.Now, DateTime.Now, DateTime.Now, DateTime.Now };
    
    private string tempSecret = "";
    private string qrCodeImageUrl = "";
    private string setupOtpCode = "";

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser == null) return;
        IsSystemAdmin = CurrentUser.Role == "Admin";
        IsDeptAdmin = CurrentUser.Role == "DeptAdmin" || CurrentUser.Role == "User";

        if (IsSystemAdmin) activeTab = "Users";
        else if (IsDeptAdmin) activeTab = "Income";
        else activeTab = "MyInfo";

        TargetYear = Math.Max(2024, DateTime.Now.Year);
        var user = await DbContext.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Username == CurrentUser.Username);
        if (user != null) currentVisiblePassword = user.Password;

        await LoadData();
    }

    private async Task ChangeYear(int offset)
    {
        int newYear = TargetYear + offset;
        if (newYear >= 2024 && newYear <= DateTime.Now.Year + 1)
        {
            TargetYear = newYear;
            await LoadData();
        }
    }

    private async Task ChangeTab(string tab)
    {
        activeTab = tab;
        newPlan = new();
        expandedCategories.Clear();
        await LoadData();
    }

    private async Task LoadData()
    {
        if (CurrentUser == null) return;
        int myDeptId = CurrentUser.DepartmentId;

        for (int i = 1; i <= 4; i++)
        {
            var range = await AccService.GetQuarterDateRangeAsync(myDeptId, TargetYear, i);
            QuarterStartDates[i - 1] = range.Start;
            QuarterEndDates[i - 1] = range.End;
        }

        if (IsSystemAdmin && activeTab == "Users")
        {
            adminUserList = await AccService.GetAllUsersAsync();
            adminDeptList = await AccService.GetDepartmentsAsync();
            return;
        }

        if (activeTab == "Income" || activeTab == "Expense")
        {
            var allPlansForTab = await DbContext.BudgetPlans.AsNoTracking().Where(b => b.DepartmentId == myDeptId && b.Type == activeTab).OrderBy(b => b.Year).ThenBy(b => b.Category).ToListAsync();
            budgetList = allPlansForTab;
            budgetHistory = allPlansForTab.GroupBy(b => b.Year).ToArray();

            var currentYearAllPlans = await DbContext.BudgetPlans.AsNoTracking().Where(b => b.DepartmentId == myDeptId && b.Year == TargetYear).ToListAsync();
            IncomeCats = currentYearAllPlans.Where(b => b.Type == "Income" || b.Type == "수입").Select(b => b.Category).Distinct().ToList();
            ExpenseCats = currentYearAllPlans.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();
        }
        else if (activeTab == "Mapping")
        {
            mappingList = await AccService.GetMappingsAsync(myDeptId);
            var currentYearAllPlans = await DbContext.BudgetPlans.AsNoTracking().Where(b => b.DepartmentId == myDeptId && b.Year == TargetYear).ToListAsync();
            ExpenseCats = currentYearAllPlans.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();
            IncomeCats = currentYearAllPlans.Where(b => b.Type == "Income" || b.Type == "수입").Select(b => b.Category).Distinct().ToList();
        }
        else if (activeTab == "Backup") 
        { 
            backupList = await AccService.GetBackupsAsync(myDeptId);
        }
        else if (activeTab == "Officers" || activeTab == "Account")
        {
            var allDepts = await DbContext.Departments.Where(d => d.Name != "관리자" && d.Name != "시스템").OrderBy(d => d.Id).ToListAsync();
            if (IsSystemAdmin || CurrentUser.Role == "Auditor" || CurrentUser.Role == "Director" || CurrentUser.Department?.Name == "교육국")
            {
                visibleDepartments = allDepts; 
            }
            else
            {
                visibleDepartments = allDepts.Where(d => d.Id == CurrentUser.DepartmentId).ToList(); 
            }

            foreach (var d in visibleDepartments)
            {
                deptOfficers[d.Id] = await DbContext.DepartmentOfficers.AsNoTracking().Where(o => o.DepartmentId == d.Id && o.Year == TargetYear).ToListAsync();
                if (!newOfficers.ContainsKey(d.Id))
                {
                    newOfficers[d.Id] = new DepartmentOfficer { DepartmentId = d.Id, Year = TargetYear, StartDate = QuarterStartDates[0], EndDate = QuarterEndDates[3] };
                    isEditingMap[d.Id] = false;
                }
                if (!expandedDepts.ContainsKey(d.Id))
                {
                    expandedDepts[d.Id] = false;
                }
            }
        }
    }

