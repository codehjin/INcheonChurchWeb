                                                            <option value="총무">총무</option>
                                                            <option value="회계">회계</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label small fw-bold mb-1 text-muted">이름</label>
                                                        <input class="settings-input" @bind="nOff.Name" placeholder="이름" />
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="form-label small fw-bold mb-1 text-muted">임기 (시작 ~ 종료)</label>
