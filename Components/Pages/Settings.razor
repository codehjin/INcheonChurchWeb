    private async Task HandleBulkImport(InputFileChangeEventArgs e)
    {
        if (CurrentUser == null) return; var file = e.File; if (file == null) return;
        isImporting = true; StateHasChanged();
        try
        {
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance); using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream); memoryStream.Position = 0;
            using var reader = ExcelReaderFactory.CreateReader(memoryStream); var result = reader.AsDataSet();
            int budgetCount = 0; int deptId = CurrentUser.DepartmentId;
            foreach (DataTable table in result.Tables)
            {
                if (table.TableName == "예산일괄입력")
                {
                    for (int i = 1; i < table.Rows.Count; i++)
                    {
                        var row = table.Rows[i]; string type = row[0]?.ToString()?.Trim() ?? ""; string cat = row[1]?.ToString()?.Trim() ?? ""; string sub = row[2]?.ToString()?.Trim() ?? ""; string calc = row[3]?.ToString()?.Trim() ?? ""; string amtStr = row[4]?.ToString()?.Trim() ?? "0";
                        if (string.IsNullOrEmpty(cat)) continue;
                        if (type == "수입") type = "Income"; if (type == "지출") type = "Expense";
                        if (type != "Income" && type != "Expense") continue;
                        decimal.TryParse(amtStr, out decimal amt);
                        DbContext.BudgetPlans.Add(new BudgetPlan { DepartmentId = deptId, Year = TargetYear, Type = type, Category = cat, SubCategory = sub, CalcDetail = calc, Amount = amt }); budgetCount++;
                    }
                }
            }
            await DbContext.SaveChangesAsync(); await LoadData(); await JSRuntime.InvokeVoidAsync("alert", $"✅ 일괄 입력 완료! {budgetCount}건 추가");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"❌ 엑셀 처리 중 오류: {ex.Message}"); }
        finally { isImporting = false; bulkImportKey = Guid.NewGuid(); StateHasChanged(); }
    }

