    private List<BudgetPlan> GetDefaultBudgetPlans(int deptId, int targetYear)
    {
        var youthDept = DbContext.Departments.FirstOrDefault(d => d.Name == "유년부");
        if (youthDept == null || youthDept.Id != deptId) return new List<BudgetPlan>();
        return new List<BudgetPlan> {
            new BudgetPlan { Type="Income", Category="교회보조금", CalcDetail="기본 보조", Amount=7800000, Year=targetYear, DepartmentId=deptId},
            new BudgetPlan { Type="Expense", Category="여름성경학교", SubCategory="식사", CalcDetail="8,000원*38명*2회", Amount=608000, Year=targetYear, DepartmentId=deptId }
            // ... (전체 목록은 기존과 동일)
        };
    }

    private async Task SafeImportBaseBudget()
    {
        if (isImporting || CurrentUser == null) return;
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"[{TargetYear}년도] 기초예산을 불러옵니다.\n\n계속하시겠습니까?");
        if (!confirmed) return;

        isImporting = true;
        StateHasChanged();

        try
        {
            int deptId = CurrentUser.DepartmentId;
            var existingPlans = await DbContext.BudgetPlans.Where(b => b.DepartmentId == deptId && b.Year == TargetYear).ToListAsync();

            if (existingPlans.Any(x => x.Amount > 0)) { await JSRuntime.InvokeVoidAsync("alert", "이미 입력된 예산이 있습니다."); return; }
            if (existingPlans.Any()) { DbContext.BudgetPlans.RemoveRange(existingPlans); await DbContext.SaveChangesAsync(); }

            var basePlans = GetDefaultBudgetPlans(deptId, TargetYear);
            if (!basePlans.Any()) { await JSRuntime.InvokeVoidAsync("alert", "기초 예산 템플릿이 없습니다."); return; }

            DbContext.BudgetPlans.AddRange(basePlans);
            await DbContext.SaveChangesAsync();
            await LoadData();
            await JSRuntime.InvokeVoidAsync("alert", "기초예산 불러오기 완료!");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"오류: {ex.Message}"); }
        finally { isImporting = false; }
    }

