                                                            <input type="date" class="settings-input settings-tabular" @bind="nOff.StartDate" />
                                                            <span style="color: #d2c5b2;">~</span>
                                                            <input type="date" class="settings-input settings-tabular" @bind="nOff.EndDate" />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3 d-flex gap-1">
                                                        <button class="settings-gold-btn flex-grow-1" @onclick="() => SaveOfficer(dept.Id)">
                                                            @(isEditing ? "수정 저장" : "임원 등록")
                                                        </button>
                                                        @if (isEditing) { <button class="settings-secondary-btn px-3" @onclick="() => CancelOfficerEdit(dept.Id)" title="취소"><i class="bi bi-x-lg"></i></button> }
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <div class="settings-table-container">
                                            <table class="settings-table">
                                                <thead><tr><th>직분</th><th>이름</th><th>임기 시작일</th><th>임기 종료일</th><th width="150">관리</th></tr></thead>
                                                <tbody>
                                                    @foreach (var o in oList.OrderBy(x => x.Role).ThenBy(x => x.StartDate))
