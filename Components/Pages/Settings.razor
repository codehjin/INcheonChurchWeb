    private async Task DeleteBackup(int backupId) { if (await JSRuntime.InvokeAsync<bool>("confirm", "이 백업 파일을 완전히 삭제하시겠습니까?")) { var target = await DbContext.DataBackups.FindAsync(backupId); if (target != null) { DbContext.DataBackups.Remove(target); await DbContext.SaveChangesAsync(); await LoadData(); } } }
    private async Task DownloadBackupFile(DataBackup b) { var targetDept = DbContext.Departments.FirstOrDefault(d => d.Id == b.DepartmentId); string deptName = targetDept?.Name ?? "알수없는부서"; string fileName = $"Backup_{deptName}_{b.BackupDate:yyyyMMdd_HHmm}.json"; await JSRuntime.InvokeVoidAsync("downloadJsonFile", fileName, b.JsonData); }
    private void EditPlan(BudgetPlan p) { newPlan = new BudgetPlan { Id = p.Id, Category = p.Category, SubCategory = p.SubCategory, CalcDetail = p.CalcDetail, Amount = p.Amount, Year = p.Year, Type = p.Type, DepartmentId = p.DepartmentId }; }
    private async Task AddMapping() { if (CurrentUser != null && !string.IsNullOrWhiteSpace(newMapping.Keyword) && !string.IsNullOrWhiteSpace(newMapping.Category)) { newMapping.DepartmentId = CurrentUser.DepartmentId; await AccService.SaveMappingAsync(newMapping); newMapping = new CategoryMapping(); await LoadData(); } else { await JSRuntime.InvokeVoidAsync("alert", "키워드와 항목을 모두 입력해주세요."); } }
    private async Task DeleteMapping(int id) { await AccService.DeleteMappingAsync(id); await LoadData(); }
    private async Task ChangeMyPassword() { if (string.IsNullOrWhiteSpace(newSelfPassword)) { await JSRuntime.InvokeVoidAsync("alert", "새 비밀번호를 입력해주세요."); return; } bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"[{newSelfPassword}] (으)로 변경하시겠습니까?"); if (confirmed && CurrentUser != null) { await AccService.ChangePasswordAsync(CurrentUser.Username, newSelfPassword); currentVisiblePassword = newSelfPassword; newSelfPassword = ""; await JSRuntime.InvokeVoidAsync("alert", "변경 완료되었습니다."); } }

