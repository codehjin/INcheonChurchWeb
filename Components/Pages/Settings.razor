    private async Task HandleSystemRestore(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        if (await JSRuntime.InvokeAsync<bool?>("confirm", "?? ���� �ý����� ��� �����Ͱ� �����˴ϴ�. �����Ͻðڽ��ϱ�?") != true) return;
        _isRestoring = true; StateHasChanged();
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var backupData = JsonSerializer.Deserialize<SystemBackupDto>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (backupData == null || backupData.Departments == null || backupData.Users == null) { await ShowAlertAsync("��ȿ���� ���� ��� �����Դϴ�."); return; }

            using var context = DbContextFactory.CreateDbContext();
            context.CategoryMappings.RemoveRange(context.CategoryMappings); context.BudgetPlans.RemoveRange(context.BudgetPlans); context.Transactions.RemoveRange(context.Transactions); context.Users.RemoveRange(context.Users); context.Departments.RemoveRange(context.Departments);
            await context.SaveChangesAsync();
            if (backupData.Departments.Any()) context.Departments.AddRange(backupData.Departments);
            if (backupData.Users.Any()) context.Users.AddRange(backupData.Users);
            if (backupData.Transactions.Any()) context.Transactions.AddRange(backupData.Transactions);
            if (backupData.BudgetPlans.Any()) context.BudgetPlans.AddRange(backupData.BudgetPlans);
            if (backupData.CategoryMappings.Any()) context.CategoryMappings.AddRange(backupData.CategoryMappings);
            await context.SaveChangesAsync(); await LoadData();
            await ShowAlertAsync("? �ý��� ������ �Ϸ�Ǿ����ϴ�."); Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex) { await ShowAlertAsync($"? ���� �� ���� �߻�: {ex.Message}"); }
        finally { _isRestoring = false; _systemRestoreKey = Guid.NewGuid(); StateHasChanged(); }
    }

