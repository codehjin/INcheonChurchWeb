@page "/settings"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using System.Text
@using ClosedXML.Excel
@using ExcelDataReader
@using System.Data
@using System.IO
@inject AccountingService AccService
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject TwoFactorAuthService TotpService
@rendermode InteractiveServer

<PageTitle>환경 설정</PageTitle>

<style>
    /* =======================================================
       ?? DESIGN SYSTEM: The Tactile Ledger
    ======================================================= */
    .settings-surface { background-color: #fbfaee; min-height: 100vh; padding-bottom: 5rem; }
    .settings-card { background-color: #ffffff; border-radius: 0.5rem; border: none; box-shadow: 0 2px 8px rgba(48, 49, 41, 0.04); transition: all 0.2s ease-out; }
    .settings-card-warm { background-color: #f5f4e8; border-radius: 0.5rem; border: none; padding: 1.25rem; }
    
    /* 탭 메뉴 디자인 */
    .settings-tab-bar { background-color: #f5f4e8; border-radius: 0.75rem; padding: 0.375rem; display: flex; flex-wrap: wrap; gap: 0.25rem; }
    .settings-tab { padding: 0.625rem 1rem; font-size: 1rem; font-weight: 600; border-radius: 0.5rem; border: none; background: transparent; color: #4e4637; cursor: pointer; transition: all 0.2s ease-out; }
    .settings-tab:hover { background-color: #eae9dd; }
    .settings-tab.active { background-color: #ffffff; color: #5a4000; box-shadow: 0 2px 6px rgba(48, 49, 41, 0.06); font-weight: 800; }
    
    /* 버튼 디자인 */
    .settings-gold-btn { background: linear-gradient(135deg, #785600 0%, #5a4000 100%); color: #ffffff; font-weight: 700; border: none; border-radius: 0.375rem; padding: 0.5rem 1.25rem; font-size: 1rem; transition: all 0.15s ease-out; }
    .settings-gold-btn:hover { transform: translateY(-1px); color: #ffffff; box-shadow: 0 4px 10px rgba(120, 86, 0, 0.2); }
    .settings-gold-btn:disabled { opacity: 0.6; transform: none; box-shadow: none; cursor: not-allowed; }
    
    .settings-secondary-btn { background-color: #eae9dd; color: #5a4000; font-weight: 700; border: none; border-radius: 0.375rem; padding: 0.5rem 1.25rem; font-size: 1rem; transition: all 0.2s ease-out; }
    .settings-secondary-btn:hover { background-color: #e4e3d7; color: #5a4000; }
    .settings-secondary-btn:disabled { opacity: 0.6; cursor: not-allowed; }

    .settings-danger-btn { background-color: rgba(186, 26, 26, 0.1); color: #ba1a1a; font-weight: 700, border: none; border-radius: 0.375rem; padding: 0.4rem 1rem; font-size: 1rem; transition: all 0.2s ease-out; }
    .settings-danger-btn:hover { background-color: rgba(186, 26, 26, 0.2); color: #ba1a1a; }

    /* 입력창 (Input & Select) */
    .settings-input { background-color: #ffffff; border: 1px solid #e4e3d7; border-radius: 0.375rem; padding: 0.5rem 0.75rem; font-size: 1rem; color: #1b1c15; transition: border-color 0.2s, box-shadow 0.2s; width: 100%; }
    .settings-input:focus { outline: none; border-color: #785600; box-shadow: 0 0 0 2px rgba(120, 86, 0, 0.1); }
    select.settings-input { padding-right: 2.25rem !important; }

    /* 안내 박스 */
    .settings-info-box { background-color: #f5f4e8; border-radius: 0.375rem; padding: 1rem 1.25rem; display: flex; align-items: flex-start; gap: 1rem; border-left: 4px solid #785600; }
    .settings-info-box.danger { border-left-color: #ba1a1a; background-color: rgba(186, 26, 26, 0.05); }

    /* 테이블 디자인 */
    .settings-table-container { overflow-x: auto; border-radius: 0.5rem; background-color: #ffffff; border: 1px solid #eae9dd; }
    .settings-table { width: 100%; min-width: 720px; border-collapse: collapse; margin-bottom: 0; }
    .settings-table th { background-color: rgba(234, 233, 221, 0.6); color: #4e4637; font-weight: 700; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.875rem 1rem; border-bottom: 2px solid #d2c5b2; white-space: nowrap; text-align: center; }
    .settings-table td { padding: 0.875rem 1rem; vertical-align: middle; font-size: 1rem; color: #1b1c15; border-bottom: 1px solid #eae9dd; text-align: center; }
    .settings-table tbody tr { transition: background-color 0.15s; }
    .settings-table tbody tr:hover { background-color: #fbfcfa; }
    .settings-tabular { font-variant-numeric: tabular-nums; }

    /* 아코디언 오버라이드 (부서 임원/계좌용) */
    .accordion-button:not(.collapsed) { background-color: #f5f4e8; color: #5a4000; box-shadow: inset 0 -1px 0 rgba(0,0,0,.125); font-weight: 800; }
    .accordion-button:focus { box-shadow: 0 0 0 0.25rem rgba(120, 86, 0, 0.25); }
    .accordion-item { border-color: #eae9dd; border-radius: 0.5rem; overflow: hidden; margin-bottom: 0.5rem; }

    /* 서브 탭(2-Depth) nav-pills — 모바일에서 가로 스크롤, 줄바꿈 방지 */
    .sub-nav { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; gap: 0.25rem; }
    .sub-nav::-webkit-scrollbar { height: 4px; }
    .sub-nav .nav-link { white-space: nowrap; color: #4e4637; font-weight: 700; border-radius: 0.5rem; padding: 0.5rem 0.9rem; }
    .sub-nav .nav-link:hover { background-color: #eae9dd; }
    .sub-nav .nav-link.active { background-color: #785600; color: #ffffff; box-shadow: 0 2px 6px rgba(120, 86, 0, 0.2); }

    /* 연도 선택기 */
    .year-selector { display: inline-flex; align-items: center; background-color: #ffffff; border-radius: 0.5rem; padding: 0.25rem; border: 1px solid #eae9dd; }
    .year-btn { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 0.25rem; color: #785600; border: none; background: transparent; cursor: pointer; transition: background 0.2s; font-size: 1rem; font-weight: bold; }
    .year-btn:hover { background-color: #f5f4e8; }
    .year-btn:disabled { opacity: 0.3; cursor: not-allowed; }
    .year-value { font-size: 1rem; font-weight: 800; color: #1b1c15; min-width: 4rem; text-align: center; padding: 0 0.5rem; }
</style>

<div class="settings-surface">
    <div class="container-fluid px-3 px-md-4 pt-4">

        @* 상단 헤더 & 컨트롤 바 *@
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1" style="color: #1b1c15; font-family: 'Manrope', sans-serif; letter-spacing: -0.02em;">환경 설정</h2>
                <p class="mb-0" style="color: #4e4637; font-size: 0.9rem;">@(CurrentUser?.Department?.Name ?? (CurrentUser?.IsSystemAdmin == true ? "시스템 관리자" : "부서미정")) 권한으로 접속 중입니다.</p>
            </div>

            @if (CurrentUser?.IsManager == true)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 p-2 rounded" style="background-color: #f5f4e8;">
                    <span class="fw-bold" style="font-size: 0.75rem; color: #4e4637; text-transform: uppercase; letter-spacing: 0.05em; padding-left: 0.5rem;">작업 연도</span>
                    <div class="year-selector">
                        <button class="year-btn" @onclick="() => ChangeYear(-1)" disabled="@(_targetYear <= 2024)">◀</button>
                        <span class="year-value">@(_targetYear)년</span>
                        <button class="year-btn" @onclick="() => ChangeYear(1)" disabled="@(_targetYear >= DateTime.Now.Year + 1)">▶</button>
                    </div>
                </div>
            }
        </div>

        @* 숨겨진 파일 업로드 Input *@
        <InputFile @key="_systemRestoreKey" id="systemRestoreInput" OnChange="HandleSystemRestore" style="display:none;" accept=".json" />
        <InputFile @key="_settingsImportKey" id="settingsImportInput" OnChange="HandleSettingsImport" style="display:none;" accept=".xlsx,.xls" />

        @* 탭 메뉴 분리 *@
        <div class="settings-tab-bar mb-4">
            @if (CurrentUser?.IsManager == true || CurrentUser?.IsAuditor == true)
            {
                <button class="settings-tab @(_activeTab == "Info" ? "active" : "")" @onclick='() => ChangeTab("Info")'><i class="bi bi-person-badge me-1"></i>부서 기본 정보</button>
            }
            @if (CurrentUser?.IsManager == true)
            {
                <button class="settings-tab @(_activeTab == "Budget" ? "active" : "")" @onclick='() => ChangeTab("Budget")'><i class="bi bi-graph-up-arrow me-1"></i>예산 및 회계 기준</button>
                <button class="settings-tab @(_activeTab == "Mapping" ? "active" : "")" @onclick='() => ChangeTab("Mapping")'><i class="bi bi-magic me-1"></i>자동분류 설정</button>
                <button class="settings-tab @(_activeTab == "Backup" ? "active" : "")" @onclick='() => ChangeTab("Backup")'><i class="bi bi-hdd-fill me-1"></i>데이터 및 엑셀 관리</button>
            }
            <button class="settings-tab @(_activeTab == "Security" ? "active" : "")" @onclick='() => ChangeTab("Security")'><i class="bi bi-shield-lock-fill me-1"></i>계정 및 보안</button>
        </div>

        <div class="settings-card p-4 p-md-5">

            @* ──────────────────────────────
               [1] 탭: 예산 관리 (수입/지출)
            ────────────────────────────── *@
            @if (_activeTab == "Budget" && CurrentUser?.IsManager == true)
            {
                <ul class="nav nav-pills sub-nav mb-4">
                    <li class="nav-item"><button class="nav-link @(_budgetSubTab == "Income" ? "active" : "")" @onclick='() => _budgetSubTab = "Income"'><i class="bi bi-graph-up-arrow me-1"></i>수입 예산</button></li>
                    <li class="nav-item"><button class="nav-link @(_budgetSubTab == "Expense" ? "active" : "")" @onclick='() => _budgetSubTab = "Expense"'><i class="bi bi-graph-down-arrow me-1"></i>지출 예산</button></li>
                    <li class="nav-item"><button class="nav-link @(_budgetSubTab == "Quarter" ? "active" : "")" @onclick='() => _budgetSubTab = "Quarter"'><i class="bi bi-calendar3 me-1"></i>분기(회계) 설정</button></li>
                </ul>

                @if (_budgetSubTab == "Income" || _budgetSubTab == "Expense")
                {
                    var currentCats = _budgetSubTab == "Income" ? _incomeCats : _expenseCats;

                    <div class="d-flex justify-content-end mb-3">
                        <button class="settings-secondary-btn py-1 px-3" style="font-size: 0.85rem;" @onclick="SafeImportPreviousYearBudget" disabled="@_isImporting">
                            @if (_isImporting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-arrow-clockwise me-1"></i><span>직전년도 예산 불러오기</span> }
                        </button>
                    </div>

                <h4 class="fw-bold mb-4" style="color: #1b1c15;">@(_targetYear)년도 @(_budgetSubTab == "Income" ? "수입" : "지출") 예산 편집</h4>

                <div class="settings-info-box mb-4">
                    <i class="bi bi-info-circle-fill fs-5 mt-1" style="color: #785600;"></i>
                    <div>
                        <div class="fw-bold mb-1" style="color: #1b1c15;">사용법 안내</div>
                        <p class="mb-0" style="color: #4e4637; font-size: 0.875rem;">1년 동안 사용할 수입/지출 예산을 항목별로 등록합니다. 엑셀 일괄 백업·복원은 <b>[데이터 및 엑셀 관리]</b> 탭의 <b>[환경설정 엑셀 관리]</b>에서 할 수 있습니다.</p>
                    </div>
                </div>

                @if (!(CurrentUser?.IsSystemAdmin == true))
                {
                    <div class="settings-card-warm mb-4">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold mb-1 text-muted">항목 (직접입력/선택)</label>
                                <ComboBox @bind-Value="_newPlan.Category" Options="currentCats" Placeholder="예: 행사비, 주일헌금" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1 text-muted">상세내역</label>
                                <input class="settings-input" @bind="_newPlan.SubCategory" placeholder="상세내역" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold mb-1 text-muted">산출근거</label>
                                <input class="settings-input" @bind="_newPlan.CalcDetail" placeholder="산출근거" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1 text-muted">금액</label>
                                <input type="number" class="settings-input text-end fw-bold settings-tabular" style="color: #785600;" @bind="_newPlan.Amount" placeholder="0" />
                            </div>
                            <div class="col-md-2">
                                <button class="settings-gold-btn w-100 py-2" @onclick="SavePlan"><i class="bi @((_newPlan.Id == 0) ? "bi-plus-circle" : "bi-pencil-square") me-1"></i>@((_newPlan.Id == 0) ? "추가" : "수정")</button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold" style="color: #4e4637;">총 @(_budgetList.Count(b => b.Year == _targetYear && b.Type == _budgetSubTab))건의 예산 내역</span>
                        <div class="d-flex gap-2">
                            <button class="settings-secondary-btn py-1 px-3" style="font-size: 0.75rem;" @onclick="ExpandAll"><i class="bi bi-arrows-expand me-1"></i> 전체 나열</button>
                            <button class="settings-secondary-btn py-1 px-3" style="font-size: 0.75rem;" @onclick="CollapseAll"><i class="bi bi-arrows-collapse me-1"></i> 전체 축소</button>
                        </div>
                    </div>

                    <div class="settings-table-container">
                        <table class="settings-table">
                            <thead>
                                <tr>
                                    <th class="text-start ps-4">항목</th>
                                    <th>상세내역</th>
                                    <th>산출근거</th>
                                    <th class="text-end pe-4">금액</th>
                                    <th width="140">관리</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!CurrentYearBudgets.Any())
                                {
                                    <tr><td colspan="5" class="text-center py-5 text-muted">등록된 예산이 없습니다.</td></tr>
                                }
                                else
                                {
                                    @foreach (var group in GroupedBudgets)
                                    {
                                        bool isExpanded = IsExpanded(group.Key);
                                        decimal groupTotal = group.Sum(x => x.Amount);

                                        <tr style="cursor: pointer; background-color: #fcfbf6;" @onclick="() => ToggleCategory(group.Key)">
                                            <td class="fw-bold text-start ps-4" style="color: #5a4000;">
                                                <i class="bi @(isExpanded ? "bi-caret-down-fill" : "bi-caret-right-fill") me-2"></i>@group.Key
                                            </td>
                                            <td></td><td></td>
                                            <td class="text-end fw-bold settings-tabular pe-4" style="color: #1b1c15; font-size: 1rem;">@groupTotal.ToString("N0")</td>
                                            <td class="text-center"><span class="badge bg-white text-secondary border px-2 py-1">@(group.Count())건</span></td>
                                        </tr>

                                        @if (isExpanded)
                                        {
                                            @foreach (var item in group)
                                            {
                                                <tr>
                                                    <td class="text-start ps-5 text-muted small"><i class="bi bi-arrow-return-right me-2"></i></td>
                                                    <td>@item.SubCategory</td>
                                                    <td class="text-muted" style="font-size: 0.85rem;">@item.CalcDetail</td>
                                                    <td class="text-end settings-tabular pe-4 fw-bold" style="color: #785600;">@item.Amount.ToString("N0")</td>
                                                    <td class="text-center">
                                                        <button class="settings-secondary-btn py-1 px-2 me-1" style="font-size: 0.75rem;" @onclick:stopPropagation="true" @onclick="() => EditPlan(item)">수정</button>
                                                        <button class="settings-danger-btn py-1 px-2" style="font-size: 0.75rem;" @onclick:stopPropagation="true" @onclick="() => SafeDeletePlan(item.Id)">삭제</button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                }
                            </tbody>
                            @if (CurrentYearBudgets.Any())
                            {
                                <tfoot style="background-color: #eae9dd; border-top: 2px solid #d2c5b2;">
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold" style="color: #4e4637;">총 합계</td>
                                        <td class="text-end fw-bold settings-tabular pe-4" style="color: #5a4000; font-size: 1.1rem;">@CurrentYearBudgets.Sum(b => b.Amount).ToString("N0")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                }
                else
                {
                    @* Admin 전용: 부서별 아코디언 *@
                    <div class="accordion shadow-sm" id="adminBudgetAccordion">
                        @foreach (var dept in _visibleDepartments)
                        {
                            bool isDeptExpanded = _expandedDepts.ContainsKey(dept.Id) && _expandedDepts[dept.Id];
                            var deptBudgets = _budgetList.Where(b => b.DepartmentId == dept.Id && b.Year == _targetYear && b.Type == _budgetSubTab).ToList();
                            decimal deptTotal = deptBudgets.Sum(b => b.Amount);

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-budget-@dept.Id">
                                    <button class="accordion-button @(isDeptExpanded ? "" : "collapsed")" type="button" @onclick="() => ToggleDept(dept.Id)">
                                        @dept.Name
                                        <span class="badge bg-white text-muted border ms-2">@deptBudgets.Count 건</span>
                                        <span class="ms-3 fw-bold settings-tabular" style="color: #5a4000; font-size: 0.9rem;">\ @deptTotal.ToString("N0")</span>
                                    </button>
                                </h2>
                                <div class="accordion-collapse collapse @(isDeptExpanded ? "show" : "")">
                                    <div class="accordion-body bg-white p-0">
                                        @if (!deptBudgets.Any())
                                        {
                                            <div class="text-center py-4 text-muted">등록된 예산이 없습니다.</div>
                                        }
                                        else
                                        {
                                            <div class="settings-table-container" style="border-radius: 0; border: none; border-top: 1px solid #eae9dd;">
                                                <table class="settings-table">
                                                    <thead>
                                                        <tr>
                                                            <th class="text-start ps-4">항목</th>
                                                            <th>상세내역</th>
                                                            <th>산출근거</th>
                                                            <th class="text-end pe-4">금액</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var catGroup in deptBudgets.GroupBy(b => b.Category))
                                                        {
                                                            string catKey = $"{dept.Id}_{catGroup.Key}";
                                                            bool isCatExpanded = IsExpanded(catKey);
                                                            decimal catTotal = catGroup.Sum(x => x.Amount);

                                                            <tr style="cursor: pointer; background-color: #fcfbf6;" @onclick="() => ToggleCategory(catKey)">
                                                                <td class="fw-bold text-start ps-4" style="color: #5a4000;">
                                                                    <i class="bi @(isCatExpanded ? "bi-caret-down-fill" : "bi-caret-right-fill") me-2"></i>@catGroup.Key
                                                                </td>
                                                                <td></td><td></td>
                                                                <td class="text-end fw-bold settings-tabular pe-4" style="color: #1b1c15;">@catTotal.ToString("N0")</td>
                                                            </tr>
                                                            @if (isCatExpanded)
                                                            {
                                                                @foreach (var item in catGroup)
                                                                {
                                                                    <tr>
                                                                        <td class="text-start ps-5 text-muted small"><i class="bi bi-arrow-return-right me-2"></i></td>
                                                                        <td>@item.SubCategory</td>
                                                                        <td class="text-muted" style="font-size: 0.85rem;">@item.CalcDetail</td>
                                                                        <td class="text-end settings-tabular pe-4 fw-bold" style="color: #785600;">@item.Amount.ToString("N0")</td>
                                                                    </tr>
                                                                }
                                                            }
                                                        }
                                                    </tbody>
                                                    <tfoot style="background-color: #eae9dd; border-top: 2px solid #d2c5b2;">
                                                        <tr>
                                                            <td colspan="3" class="text-end fw-bold" style="color: #4e4637;">합계</td>
                                                            <td class="text-end fw-bold settings-tabular pe-4" style="color: #5a4000;">@deptTotal.ToString("N0")</td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                }

                @* ── 분기(회계) 설정 서브 탭 ── *@
                @if (_budgetSubTab == "Quarter")
                {
                <div class="col-12">
                    <h4 class="fw-bold mb-4" style="color: #1b1c15;">@(_targetYear)년도 분기 날짜 설정</h4>

                    <div class="settings-info-box mb-4">
                        <i class="bi bi-calendar-range fs-5 mt-1" style="color: #785600;"></i>
                        <div>
                            <div class="fw-bold mb-1" style="color: #1b1c15;">분기 설정 규칙 안내</div>
                            <p class="mb-0" style="color: #4e4637; font-size: 0.875rem;">
                                <b>기본 규칙:</b> 매 3개월마다 <b>4주차 주일(일요일)</b>이 분기 마감일이며, 다음 날 월요일이 새 분기 시작일입니다. 매분기마다 확인해서 수정하세요<br/>
                                분기 설정에 따라 대시보드의 통계와 월별장부의 분기설정이 달라집니다, <br/>
                                <b>[기본값 자동 적용]</b> 버튼을 누르면 위 규칙으로 자동 계산되고, 필요 시 수동으로 수정할 수 있습니다. 부서별로 필히 확인해서 설정하셔야 합니다.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <button class="settings-gold-btn" @onclick="ApplyDefaultQuarters">
                            <i class="bi bi-magic me-1"></i>기본값 자동 적용
                        </button>
                        <button class="settings-secondary-btn" @onclick="SaveAllQuarters">
                            <i class="bi bi-save me-1"></i>전체 분기 저장
                        </button>
                    </div>

                    @{
                        var defaultRanges = new (DateTime Start, DateTime End)[4];
                        for (int dq = 1; dq <= 4; dq++)
                            defaultRanges[dq - 1] = AccountingService.GetDefaultQuarterRange(_targetYear, dq);
                    }

                    <div class="settings-card-warm border border-light">
                        @for (int q = 1; q <= 4; q++)
                        {
                            int localQ = q;
                            var defRange = defaultRanges[localQ - 1];
                            <div class="mb-3 row align-items-center bg-white p-3 rounded shadow-sm border border-light">
                                <label class="col-sm-2 col-form-label fw-bold text-center" style="color: #5a4000; font-size: 1.1rem;">@q 분기</label>
                                <div class="col d-flex flex-column gap-1">
                                    <div class="d-flex gap-2 align-items-center">
                                        <button class="settings-secondary-btn py-1 px-2 text-nowrap" style="font-size: 0.75rem;" title="이전 분기 종료일 +1일 적용" @onclick="() => SyncWithPreviousQuarter(localQ)"><i class="bi bi-link-45deg me-1"></i>연속성 맞춤</button>
                                        <input type="date" class="settings-input settings-tabular fw-bold" @bind="_quarterStartDates[localQ - 1]" />
                                        <span style="color: #d2c5b2;">~</span>
                                        <input type="date" class="settings-input settings-tabular fw-bold" @bind="_quarterEndDates[localQ - 1]" />
                                    </div>
                                    <div style="font-size: 0.75rem; color: #807666; padding-left: 6rem;">
                                        기본값: @defRange.Start.ToString("yyyy-MM-dd") ~ @defRange.End.ToString("yyyy-MM-dd")
                                        (@defRange.End.ToString("M월 d일") 주일 마감)
                                    </div>
                                </div>
                                <div class="col-sm-2"><button class="settings-gold-btn w-100 py-2" @onclick="() => SaveQuarter(localQ)">저장</button></div>
                            </div>
                        }
                    </div>
                </div>
                }
            }

            @* ──────────────────────────────
               [2] 탭: 자동분류 설정 (수입/지출 분리형)
            ────────────────────────────── *@
            else if (_activeTab == "Mapping" && CurrentUser?.IsManager == true)
            {
                <h4 class="fw-bold mb-4" style="color: #1b1c15;">엑셀 장부 자동분류 설정</h4>

                @* 🚀 최고관리자 전용: 관리 대상 부서 전환 선택기 *@
                @if (CurrentUser?.IsSystemAdmin == true)
                {
                    <div class="settings-card-warm mb-4 border-start border-4" style="border-color: #785600 !important;">
                        <div class="row g-2 align-items-center">
                            <div class="col-12 col-md-4 col-lg-3">
                                <label class="form-label small fw-bold mb-1" style="color: #5a4000;"><i class="bi bi-building me-1"></i>관리 대상 부서 선택</label>
                                <select class="settings-input fw-bold" style="color: #785600;" value="@_mappingTargetDeptId" @onchange="ChangeMappingTargetDept">
                                    @foreach (var d in _adminDeptList.Where(d => d.Name != "관리자"))
                                    {
                                        <option value="@d.Id">@d.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-8 col-lg-9">
                                <p class="mb-0 small text-muted mt-md-4">선택한 부서의 장부·규칙만 분석/등록 대상이 됩니다. 부서를 바꾸면 분석 결과가 초기화됩니다.</p>
                            </div>
                        </div>
                    </div>
                }

                <ul class="nav nav-pills sub-nav mb-4">
                    <li class="nav-item"><button class="nav-link @(_mappingSubTab == "Income" ? "active" : "")" @onclick='() => _mappingSubTab = "Income"'><i class="bi bi-tags-fill me-1"></i>수입 규칙</button></li>
                    <li class="nav-item"><button class="nav-link @(_mappingSubTab == "Expense" ? "active" : "")" @onclick='() => _mappingSubTab = "Expense"'><i class="bi bi-tags-fill me-1"></i>지출 규칙</button></li>
                    <li class="nav-item"><button class="nav-link @(_mappingSubTab == "Analyze" ? "active" : "")" @onclick='() => _mappingSubTab = "Analyze"'><i class="bi bi-graph-up-arrow me-1"></i>규칙 분석·일괄등록</button></li>
                </ul>

                @if (_mappingSubTab != "Analyze")
                {
                <div class="settings-info-box mb-4">
                    <i class="bi bi-magic fs-5 mt-1" style="color: #785600;"></i>
                    <div>
                        <div class="fw-bold mb-1" style="color: #1b1c15;">자동분류란?</div>
                        <p class="mb-0" style="color: #4e4637; font-size: 0.875rem;">은행 엑셀의 '적요' 칸에 포함된 단어를 인식하여 지정된 항목으로 자동 분류합니다.</p>
                    </div>
                </div>

                <div class="settings-card-warm mb-5">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1 text-muted">구분</label>
                            <select class="settings-input fw-bold" @bind="_mappingType" style="color: #785600;">
                                <option value="수입">수입용</option>
                                <option value="지출">지출용</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1 text-muted">키워드</label>
                            <input class="settings-input" @bind="_newMapping.Keyword" placeholder="적요 키워드 (예: 다이소)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1 text-muted">분류될 항목</label>
                            <ComboBox @bind-Value="_newMapping.Category" Options="@(_mappingType == "수입" ? _incomeCats : _expenseCats)" Placeholder="항목 선택" />
                        </div>
                        <div class="col-md-2">
                            <button class="settings-gold-btn w-100 py-2" @onclick="AddMapping">규칙 등록</button>
                        </div>
                    </div>
                </div>
                }

                @if (_mappingSubTab == "Income")
                {
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <h6 class="fw-bold mb-0" style="color: #5a4000;"><i class="bi bi-tags-fill me-1"></i>수입 항목 자동분류 규칙</h6>
                            <select class="settings-input fw-bold" style="width: auto; max-width: 170px; font-size: 0.8rem; padding: 0.25rem 0.5rem; color: #785600;" @bind="_incomeFilterCategory">
                                <option value="">전체보기</option>
                                @foreach (var c in _incomeCats) { <option value="@c">@c</option> }
                            </select>
                        </div>
                        <div class="settings-table-container" style="min-height: 350px;">
                            <table class="settings-table">
                                <thead><tr>
                                    <th width="40%" style="cursor: pointer;" @onclick='() => SortIncomeRules("Keyword")'>키워드(적요) <i class="bi @IncomeKeywordIcon"></i></th>
                                    <th width="40%" style="cursor: pointer;" @onclick='() => SortIncomeRules("Category")'>분류될 항목 <i class="bi @IncomeCategoryIcon"></i></th>
                                    <th width="20%">관리</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var m in IncomeRules)
                                    {
                                        <tr>
                                            @if (_editingMappingId == m.Id)
                                            {
                                                <td><input type="text" class="form-control form-control-sm" @bind="_editMappingTemp.Keyword" /></td>
                                                <td><ComboBox @bind-Value="_editMappingTemp.Category" Options="_incomeCats" InputClass="form-control form-control-sm" /></td>
                                                <td><button class="btn btn-sm btn-success py-0 px-2 me-1" @onclick="SaveEditMappingAsync"><i class="bi bi-check-lg"></i></button><button class="btn btn-sm btn-secondary py-0 px-2" @onclick="CancelEditMapping"><i class="bi bi-x-lg"></i></button></td>
                                            }
                                            else
                                            {
                                                <td class="fw-bold">@m.Keyword</td><td class="fw-bold" style="color: #785600;">@m.Category</td>
                                                <td><button class="settings-secondary-btn py-1 px-2 me-1" style="font-size: 0.75rem;" @onclick="() => StartEditMapping(m)"><i class="bi bi-pencil"></i></button><button class="settings-danger-btn py-1 px-2" style="font-size: 0.75rem;" @onclick="() => DeleteMapping(m.Id)"><i class="bi bi-trash"></i></button></td>
                                            }
                                        </tr>
                                    }
                                    @if (!IncomeRules.Any()) { <tr><td colspan="3" class="text-muted py-4">@(string.IsNullOrEmpty(_incomeFilterCategory) ? "등록된 수입 규칙이 없습니다." : "선택한 분류의 규칙이 없습니다.")</td></tr> }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (_mappingSubTab == "Expense")
                {
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <h6 class="fw-bold mb-0" style="color: #ba1a1a;"><i class="bi bi-tags-fill me-1"></i>지출 항목 자동분류 규칙</h6>
                            <select class="settings-input fw-bold" style="width: auto; max-width: 170px; font-size: 0.8rem; padding: 0.25rem 0.5rem; color: #ba1a1a;" @bind="_expenseFilterCategory">
                                <option value="">전체보기</option>
                                @foreach (var c in _expenseCats) { <option value="@c">@c</option> }
                            </select>
                        </div>
                        <div class="settings-table-container" style="min-height: 350px;">
                            <table class="settings-table">
                                <thead><tr>
                                    <th width="40%" style="cursor: pointer;" @onclick='() => SortExpenseRules("Keyword")'>키워드(적요) <i class="bi @ExpenseKeywordIcon"></i></th>
                                    <th width="40%" style="cursor: pointer;" @onclick='() => SortExpenseRules("Category")'>분류될 항목 <i class="bi @ExpenseCategoryIcon"></i></th>
                                    <th width="20%">관리</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var m in ExpenseRules)
                                    {
                                        <tr>
                                            @if (_editingMappingId == m.Id)
                                            {
                                                <td><input type="text" class="form-control form-control-sm" @bind="_editMappingTemp.Keyword" /></td>
                                                <td><ComboBox @bind-Value="_editMappingTemp.Category" Options="_expenseCats" InputClass="form-control form-control-sm" /></td>
                                                <td><button class="btn btn-sm btn-success py-0 px-2 me-1" @onclick="SaveEditMappingAsync"><i class="bi bi-check-lg"></i></button><button class="btn btn-sm btn-secondary py-0 px-2" @onclick="CancelEditMapping"><i class="bi bi-x-lg"></i></button></td>
                                            }
                                            else
                                            {
                                                <td class="fw-bold">@m.Keyword</td><td class="fw-bold" style="color: #ba1a1a;">@m.Category</td>
                                                <td><button class="settings-secondary-btn py-1 px-2 me-1" style="font-size: 0.75rem;" @onclick="() => StartEditMapping(m)"><i class="bi bi-pencil"></i></button><button class="settings-danger-btn py-1 px-2" style="font-size: 0.75rem;" @onclick="() => DeleteMapping(m.Id)"><i class="bi bi-trash"></i></button></td>
                                            }
                                        </tr>
                                    }
                                    @if (!ExpenseRules.Any()) { <tr><td colspan="3" class="text-muted py-4">@(string.IsNullOrEmpty(_expenseFilterCategory) ? "등록된 지출 규칙이 없습니다." : "선택한 분류의 규칙이 없습니다.")</td></tr> }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @* ── 규칙 분석·일괄등록 서브 탭 ── *@
                @if (_mappingSubTab == "Analyze")
                {
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-graph-up-arrow fs-4 me-2" style="color: #785600;"></i>
                    <h5 class="fw-bold mb-0" style="color: #1b1c15;">규칙 분석 (추천 시스템)</h5>
                </div>

                <div class="settings-info-box mb-4">
                    <i class="bi bi-lightbulb-fill fs-5 mt-1" style="color: #785600;"></i>
                    <div>
                        <div class="fw-bold mb-1" style="color: #1b1c15;">추천 원리</div>
                        <p class="mb-0" style="color: #4e4637; font-size: 0.875rem;">선택한 기간의 <b>@(_analysisType) 장부</b>에서 이미 분류된 내역을 학습하여, 같은 <b>적요(내역)</b>가 어떤 항목으로 가장 자주 분류됐는지 분석합니다. 가장 비율이 높은 항목을 <b>추천 규칙</b>으로 제안합니다.</p>
                    </div>
                </div>

                <div class="settings-card-warm mb-4">
                    <div class="row g-2 align-items-end">
                        <div class="col-6 col-md-2">
                            <label class="form-label small fw-bold mb-1 text-muted">구분</label>
                            <select class="settings-input fw-bold" @bind="_analysisType" style="color: #785600;">
                                <option value="지출">지출</option>
                                <option value="수입">수입</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small fw-bold mb-1 text-muted">연도</label>
                            <select class="settings-input fw-bold" @bind="_analysisYear" style="color: #785600;">
                                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                                {
                                    <option value="@y">@(y)년</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small fw-bold mb-1 text-muted">분기</label>
                            <select class="settings-input" @bind="_analysisQuarter">
                                <option value="0">전체 분기</option>
                                <option value="1">1분기</option>
                                <option value="2">2분기</option>
                                <option value="3">3분기</option>
                                <option value="4">4분기</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small fw-bold mb-1 text-muted">월</label>
                            <select class="settings-input" @bind="_analysisMonth">
                                <option value="0">전체 월</option>
                                @for (int mo = 1; mo <= 12; mo++)
                                {
                                    <option value="@mo">@(mo)월</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <button class="settings-gold-btn w-100 py-2" @onclick="RunMappingAnalysis" disabled="@_isAnalyzing">
                                @if (_isAnalyzing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span><span>분석 중...</span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-clockwise me-1"></i><span>새로고침 (분석 실행)</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

                @if (_isAnalyzing)
                {
                    <div class="text-center py-5 text-muted"><span class="spinner-border me-2" style="color:#785600;"></span>장부를 분석하고 있습니다...</div>
                }
                else if (_analysisRan && !_suggestions.Any())
                {
                    <div class="settings-info-box danger">
                        <i class="bi bi-exclamation-triangle-fill fs-5 mt-1" style="color: #ba1a1a;"></i>
                        <div><p class="mb-0" style="color: #4e4637; font-size: 0.9rem;">선택한 기간에 분석할 수 있는 데이터가 없습니다. (※ 주의: 항목이 '미분류'인 내역은 학습할 수 없습니다. 월별 장부에서 먼저 항목 분류를 진행해 주세요.)</p></div>
                    </div>
                }
                else if (_suggestions.Any())
                {
                    <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                        <span class="fw-bold" style="color: #4e4637;">총 @_suggestions.Count 개의 키워드 분석됨@(string.IsNullOrEmpty(_suggFilterCategory) ? "" : $" (필터: {FilteredSuggestions.Count()}개)")</span>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button class="btn btn-sm btn-primary" @onclick="BulkAddSuggestedRulesAsync" disabled="@(_selectedSuggestions.Count == 0)">
                                <i class="bi bi-plus-square me-1"></i>선택 항목 일괄 등록 (@_selectedSuggestions.Count)
                            </button>
                            <select class="settings-input fw-bold" style="width: auto; max-width: 180px; font-size: 0.8rem; padding: 0.25rem 0.5rem; color: #785600;" @bind="_suggFilterCategory">
                                <option value="">전체보기</option>
                                @foreach (var c in _suggestions.Select(s => s.RecommendedCategory).Distinct().OrderBy(c => c))
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                            <span class="badge bg-white text-muted border">기준: @(_analysisYear)년 @(_analysisQuarter == 0 ? "전체분기" : $"{_analysisQuarter}분기") @(_analysisMonth == 0 ? "" : $"{_analysisMonth}월")</span>
                        </div>
                    </div>

                    <div class="settings-table-container" style="min-height: 350px;">
                        <table class="settings-table" style="min-width: 760px;">
                            <thead>
                                <tr>
                                    <th width="44" class="text-center"><input type="checkbox" class="form-check-input" checked="@IsAllSuggestionsSelected" @onchange="ToggleAllSuggestions" /></th>
                                    <th class="text-start ps-2" style="min-width: 160px; cursor: pointer;" @onclick='() => SortSuggestions("Keyword")'>키워드(적요) <i class="bi @SuggKeywordIcon"></i></th>
                                    <th style="min-width: 280px; cursor: pointer;" @onclick='() => SortSuggestions("Count")'>분류 항목 분포 <i class="bi @SuggCountIcon"></i></th>
                                    <th style="min-width: 130px; cursor: pointer;" @onclick='() => SortSuggestions("Category")'>추천 분류 <i class="bi @SuggCategoryIcon"></i></th>
                                    <th width="120">관리</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in FilteredSuggestions)
                                {
                                    bool alreadyMapped = _mappingList.Any(m => (m.Keyword ?? "").Trim() == s.Keyword);
                                    <tr>
                                        <td class="text-center">
                                            @if (!alreadyMapped)
                                            {
                                                <input type="checkbox" class="form-check-input" checked="@_selectedSuggestions.Contains(s.Keyword)" @onchange="(e) => ToggleSuggestion(s.Keyword, e.Value)" />
                                            }
                                        </td>
                                        <td class="text-start ps-2 fw-bold" style="color: #1b1c15;">
                                            @s.Keyword
                                            <div class="text-muted small fw-normal">총 @s.TotalCount 건</div>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 22px; background-color: #eae9dd;">
                                                @{ int _ci = 0; }
                                                @foreach (var d in s.Distribution)
                                                {
                                                    <div class="progress-bar" role="progressbar"
                                                         style="width:@(d.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%; background-color:@BarColor(_ci); overflow: visible;"
                                                         title="@d.Category : @(d.Count)건 (@d.Percentage%)">
                                                        <span class="small fw-bold text-nowrap px-1">@d.Category @d.Percentage%</span>
                                                    </div>
                                                    _ci++;
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold" style="color: #785600;">@s.RecommendedCategory</span>
                                            <div class="text-muted small">@s.RecommendedPercentage% 일치</div>
                                        </td>
                                        <td>
                                            @if (alreadyMapped)
                                            {
                                                <span class="badge bg-white border" style="color: #198754;"><i class="bi bi-check-circle me-1"></i>등록됨</span>
                                            }
                                            else
                                            {
                                                <button class="settings-gold-btn py-1 px-2" style="font-size: 0.75rem;" @onclick="() => AddSuggestedRule(s)">
                                                    <i class="bi bi-plus-circle me-1"></i>규칙에 추가
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                }
            }

            @* ──────────────────────────────
               [4] 탭: 데이터 및 엑셀 관리 (Backup)
            ────────────────────────────── *@
            else if (_activeTab == "Backup" && CurrentUser?.IsManager == true)
            {
                <ul class="nav nav-pills sub-nav mb-4">
                    <li class="nav-item"><button class="nav-link @(_backupSubTab == "Ledger" ? "active" : "")" @onclick='() => _backupSubTab = "Ledger"'><i class="bi bi-hdd-fill me-1"></i>월별 장부 백업</button></li>
                    <li class="nav-item"><button class="nav-link @(_backupSubTab == "Settings" ? "active" : "")" @onclick='() => _backupSubTab = "Settings"'><i class="bi bi-file-earmark-spreadsheet me-1"></i>환경설정 엑셀 관리</button></li>
                </ul>

                @if (_backupSubTab == "Settings")
                {
                @* ── 환경설정 엑셀 백업 및 복원 ── *@
                <h4 class="fw-bold mb-3" style="color: #1b1c15;">환경설정 엑셀 백업 및 복원</h4>
                <div class="settings-info-box mb-3">
                    <i class="bi bi-file-earmark-spreadsheet fs-5 mt-1" style="color: #785600;"></i>
                    <div>
                        <div class="fw-bold mb-1" style="color: #1b1c15;">예산항목 · 자동분류 한 번에 백업</div>
                        <p class="mb-0" style="color: #4e4637; font-size: 0.875rem;">@(_targetYear)년도 <b>예산항목</b>과 부서 <b>자동분류 규칙</b>을 엑셀 2개 시트로 내려받고, 같은 양식으로 한 번에 복원(일괄입력)합니다.</p>
                    </div>
                </div>
                <div class="settings-card-warm mb-5">
                    <div class="d-flex flex-wrap gap-2">
                        <button class="settings-secondary-btn px-4 py-2" @onclick="DownloadSettingsExcel">
                            <i class="bi bi-file-earmark-excel me-2"></i>@(CurrentUser?.IsSystemAdmin == true ? "전체 부서 환경설정 백업 (다운로드)" : "환경설정 엑셀 다운로드")
                        </button>
                        <button class="settings-gold-btn px-4 py-2" @onclick="TriggerSettingsImport" disabled="@_isSettingsImporting">
                            @if (_isSettingsImporting) { <span class="spinner-border spinner-border-sm me-2"></span><span>업로드 중...</span> }
                            else { <i class="bi bi-upload me-2"></i><span>@(CurrentUser?.IsSystemAdmin == true ? "전체 부서 일괄 복원 (업로드)" : "환경설정 엑셀 일괄 업로드")</span> }
                        </button>
                    </div>
                </div>
                }

                @if (_backupSubTab == "Ledger")
                {
                @if (CurrentUser?.IsSystemAdmin == true)
                {
                    <h4 class="fw-bold mb-4" style="color: #1b1c15;">전체 시스템 데이터 백업 및 복원</h4>
                    <div class="settings-card-warm mb-4 text-center py-5">
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <button class="settings-secondary-btn px-4 py-3 fs-6" @onclick="DownloadAllDataExcel"><i class="bi bi-file-earmark-excel me-2"></i>모든 부서 엑셀 다운로드</button>
                            <button class="settings-gold-btn px-4 py-3 fs-6" @onclick="DownloadAllDataJson"><i class="bi bi-filetype-json me-2"></i>시스템 JSON 백업</button>
                            <button class="settings-danger-btn px-4 py-3 fs-6" style="background-color: #ba1a1a; color: white;" @onclick="TriggerSystemRestore" disabled="@_isRestoring">
                                @if (_isRestoring) { <span class="spinner-border spinner-border-sm me-2"></span><span>복원 중...</span> }
                                else { <i class="bi bi-arrow-counterclockwise me-2"></i><span>시스템 JSON 복원 (위험)</span> }
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <h4 class="fw-bold mb-4" style="color: #1b1c15;">장부 백업 관리</h4>
                    <div class="settings-card-warm d-flex flex-wrap justify-content-between align-items-center mb-5">
                        <div class="flex-grow-1 me-4">
                            <strong style="color: #5a4000; font-size: 1.1rem;">수동 백업 만들기</strong>
                            <p class="mb-2 mt-1 text-muted small">현재 장부 상태를 안전하게 저장해 둡니다.</p>
                            <input type="text" class="settings-input" style="max-width: 400px;" placeholder="백업 메모 (예: 1분기 결산 완료)" @bind="_customBackupMemo" />
                        </div>
                        <div class="mt-3 mt-md-0">
                            <button class="settings-gold-btn py-3 px-4" @onclick='() => SafeBackup("Manual")'><i class="bi bi-download me-2"></i>지금 백업하기</button>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3" style="color: #5a4000;">수동 백업 내역</h5>
                    <div class="settings-table-container mb-5">
                        <table class="settings-table">
                            <thead><tr><th>백업 일시</th><th>구분</th><th class="text-start">메모</th><th width="250">관리</th></tr></thead>
                            <tbody>
                                @foreach (var b in ManualBackups)
                                {
                                    <tr>
                                        <td class="settings-tabular fw-bold text-muted">@b.BackupDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-white text-dark border">수동</span></td>
                                        <td class="text-start fw-bold" style="color: #1b1c15;">@b.Memo</td>
                                        <td>
                                            <button class="settings-secondary-btn py-1 px-2 me-1" style="font-size: 0.75rem;" @onclick="() => RestoreData(b)">복구</button>
                                            <button class="settings-gold-btn py-1 px-2 me-1" style="font-size: 0.75rem;" @onclick="() => DownloadBackupFile(b)">다운로드</button>
                                            <button class="settings-danger-btn py-1 px-2" style="font-size: 0.75rem;" @onclick="() => DeleteBackup(b.Id)">삭제</button>
                                        </td>
                                    </tr>
                                }
                                @if (!ManualBackups.Any()) { <tr><td colspan="4" class="py-4 text-muted">수동 백업 내역이 없습니다.</td></tr> }
                            </tbody>
                        </table>
                    </div>

                    <h5 class="fw-bold mb-3 text-muted">자동 백업 내역</h5>
                    <div class="settings-table-container">
                        <table class="settings-table">
                            <thead><tr><th>백업 일시</th><th>구분</th><th class="text-start">메모</th><th width="250">관리</th></tr></thead>
                            <tbody>
                                @foreach (var b in AutoBackups)
                                {
                                    <tr>
                                        <td class="settings-tabular fw-bold text-muted">@b.BackupDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-light text-muted border">자동</span></td>
                                        <td class="text-start text-muted">@b.Memo</td>
                                        <td>
                                            <button class="settings-secondary-btn py-1 px-2 me-1" style="font-size: 0.75rem;" @onclick="() => RestoreData(b)">복구</button>
                                            <button class="settings-gold-btn py-1 px-2 me-1" style="font-size: 0.75rem; opacity: 0.8;" @onclick="() => DownloadBackupFile(b)">다운로드</button>
                                            <button class="settings-danger-btn py-1 px-2" style="font-size: 0.75rem; opacity: 0.5;" @onclick="() => DeleteBackup(b.Id)">삭제</button>
                                        </td>
                                    </tr>
                                }
                                @if (!AutoBackups.Any()) { <tr><td colspan="4" class="py-4 text-muted">자동 백업 내역이 없습니다.</td></tr> }
                            </tbody>
                        </table>
                    </div>
                }
                }
            }

            @* ──────────────────────────────
               [5] 탭: 사용자 관리 (시스템 관리자용)
            ────────────────────────────── *@
            else if (_activeTab == "Security")
            {
                <ul class="nav nav-pills sub-nav mb-4">
                    <li class="nav-item"><button class="nav-link @(_securitySubTab == "Password" ? "active" : "")" @onclick='() => _securitySubTab = "Password"'><i class="bi bi-key-fill me-1"></i>비밀번호 및 OTP</button></li>
                    @if (CurrentUser?.IsSystemAdmin == true)
                    {
                        <li class="nav-item"><button class="nav-link @(_securitySubTab == "Users" ? "active" : "")" @onclick='() => _securitySubTab = "Users"'><i class="bi bi-people-fill me-1"></i>사용자 계정 관리</button></li>
                    }
                </ul>

                @if (_securitySubTab == "Users" && CurrentUser?.IsSystemAdmin == true)
                {
                <h4 class="fw-bold mb-4" style="color: #1b1c15;">부서 계정 관리</h4>
                <div class="settings-card-warm mb-4">
                    <div class="row g-2">
                        <div class="col-md-2"><input class="settings-input" @bind="_newUser.Username" placeholder="새로운 ID" /></div>
                        <div class="col-md-2"><input class="settings-input" @bind="_newUser.FullName" placeholder="이름(선택)" /></div>
                        <div class="col-md-3">
                            <select class="settings-input fw-bold" @bind="_newUser.DepartmentId" style="color: #785600;">
                                <option value="0">부서 선택</option>
                                @foreach (var d in _adminDeptList.Where(d => d.Name != "관리자")) { <option value="@d.Id">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="settings-input" @bind="_newUser.Role">
                                <option value="Manager">부서운영자 (전도사/부장/회계)</option>
                                <option value="Auditor">감사/국장 (목사/장로/감사)</option>
                                <option value="User">일반조회 (교사)</option>
                                <option value="Admin">최고관리자 (시스템 통제)</option>
                            </select>
                        </div>
                        <div class="col-md-2"><button class="settings-gold-btn w-100 py-2" @onclick="AddUser">계정 등록</button></div>
                    </div>
                </div>

                <div class="settings-table-container">
                    <table class="settings-table">
                        <thead><tr><th>아이디</th><th>이름</th><th>부서</th><th>권한</th><th>상태</th><th width="200">관리</th></tr></thead>
                        <tbody>
                            @foreach (var u in _adminUserList)
                            {
                                <tr>
                                    <td class="fw-bold">@u.Username</td>
                                    <td>@u.FullName</td>
                                    <td class="fw-bold" style="color: #5a4000;">@(_adminDeptList.FirstOrDefault(d => d.Id == u.DepartmentId)?.Name ?? "미정")</td>
                                    <td class="fw-bold text-muted">
                                        @(u.Role == "Admin" ? "최고관리자" : u.Role == "Manager" ? "부서운영자" : u.Role == "Auditor" ? "감사/국장" : "일반조회")
                                    </td>
                                    <td>
                                        @if (u.IsActive) { <span class="badge bg-white border" style="color: #198754;">활성</span> } 
                                        else { <span class="badge bg-light text-muted border">비활성</span> }
                                    </td>
                                    <td>
    <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap">
        <button class="settings-secondary-btn py-1 px-2" style="font-size: 0.75rem;" @onclick="() => ResetPassword(u.Username)">비번초기화</button>
        @if (u.Username != "admin")
        {
            <button class="btn btn-sm py-1 px-2 @(u.IsActive ? "settings-danger-btn" : "btn-success text-white") fw-bold" style="font-size: 0.75rem;" @onclick="() => ToggleUserStatus(u)">@(u.IsActive ? "정지" : "복구")</button>
            <button class="btn btn-sm py-1 px-2 fw-bold" style="font-size: 0.75rem; background-color: #ba1a1a; color: white;" @onclick="() => DeleteUser(u.Username)">삭제</button>
        }
    </div>
</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }

                @* ── 비밀번호 및 OTP 서브 탭 ── *@
                @if (_securitySubTab == "Password")
                {
                <div class="row g-4 justify-content-center">
                    <div class="col-md-5">
                        <div class="settings-card border border-light p-4 h-100">
                            <h5 class="fw-bold mb-4 text-center" style="color: #1b1c15;"><i class="bi bi-key-fill me-1"></i>비밀번호 변경</h5>
                            
                            <div class="p-3 text-center mb-4 rounded" style="background-color: #f5f4e8; color: #4e4637;">
                                현재 비밀번호: <strong class="fs-5 ms-2" style="color: #1b1c15;">[ @_currentVisiblePassword ]</strong>
                            </div>
                            
                            <div class="mb-4">
                                <label class="form-label fw-bold small" style="color: #ba1a1a;">새로운 비밀번호 입력</label>
                                <div class="position-relative mb-2">
                                    <input type="@(_showNewPassword ? "text" : "password")" class="settings-input" style="border-color: rgba(186, 26, 26, 0.3); padding-right: 2.5rem;" @bind="_newSelfPassword" placeholder="변경할 비밀번호 입력" />
                                    <button type="button" class="btn border-0 position-absolute end-0 top-50 translate-middle-y text-muted" style="padding: 0 0.5rem;" @onclick="() => _showNewPassword = !_showNewPassword" tabindex="-1">
                                        <i class="bi @(_showNewPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <div class="position-relative">
                                    <input type="@(_showConfirmPassword ? "text" : "password")" class="settings-input" style="border-color: rgba(186, 26, 26, 0.3); padding-right: 2.5rem;" @bind="_confirmSelfPassword" placeholder="비밀번호 재입력" @onkeyup="HandlePasswordKey" />
                                    <button type="button" class="btn border-0 position-absolute end-0 top-50 translate-middle-y text-muted" style="padding: 0 0.5rem;" @onclick="() => _showConfirmPassword = !_showConfirmPassword" tabindex="-1">
                                        <i class="bi @(_showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                            </div>
                            <button class="settings-gold-btn w-100 py-3 fs-6" @onclick="ChangeMyPassword">비밀번호 변경 저장</button>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="settings-card border border-light p-4 h-100" style="border-top: 4px solid #785600 !important;">
                            <h5 class="fw-bold mb-4" style="color: #1b1c15;"><i class="bi bi-shield-lock me-2" style="color: #785600;"></i>2단계 보안 인증 (구글 OTP)</h5>
                            
                            @if (CurrentUser != null && !CurrentUser.IsTwoFactorEnabled)
                            {
                                <div class="settings-info-box mb-4 py-2 px-3">
                                    <p class="mb-0 small text-muted">아래 버튼을 눌러 QR 코드를 스캔하여 보안을 강화하세요.</p>
                                </div>
                                
                                @if (string.IsNullOrEmpty(_tempSecret))
                                {
                                    <button class="settings-secondary-btn w-100 py-3 fs-6" @onclick="Prepare2FA"><i class="bi bi-shield-check me-2"></i>보안 설정 시작하기</button>
                                }
                                else
                                {
                                    <div class="text-center bg-light p-4 rounded border">
                                        <p class="mb-3 fw-bold text-dark"><span class="badge bg-dark me-2">Step 1</span> QR 코드를 스캔하세요</p>
                                        <img src="@_qrCodeImageUrl" style="width: 180px; height: 180px; border: 1px solid #d2c5b2;" class="p-2 bg-white rounded shadow-sm mb-4" alt="QR Code" />
                                        
                                        <p class="fw-bold" style="color: #ba1a1a;"><span class="badge" style="background-color: #ba1a1a;">Step 2</span> 앱에 표시된 6자리 번호 입력</p>
                                        <div class="input-group mb-3 w-75 mx-auto">
                                            <input type="text" class="form-control text-center fs-4 fw-bold settings-tabular" style="border-color: #785600; color: #5a4000;" maxlength="6" @bind="_setupOtpCode" placeholder="000000" @onkeyup="HandleOtpKey" />
                                            <button class="settings-gold-btn rounded-start-0" @onclick="Enable2FA">활성화</button>
                                        </div>
                                        <button class="btn btn-sm text-muted fw-bold" @onclick="@(() => { _tempSecret = string.Empty; _setupOtpCode = string.Empty; })">다시 시작</button>
                                    </div>
                                }
                            }
                            else if (CurrentUser != null && CurrentUser.IsTwoFactorEnabled)
                            {
                                <div class="p-4 rounded text-center" style="background-color: rgba(25, 135, 84, 0.05); border: 1px solid rgba(25, 135, 84, 0.2);">
                                    <i class="bi bi-shield-check" style="font-size: 3rem; color: #198754;"></i>
                                    <h5 class="fw-bold mt-3 mb-4" style="color: #198754;">OTP 인증이 활성화되어 안전합니다.</h5>
                                    <button class="settings-danger-btn py-2 px-4" @onclick="Disable2FA"><i class="bi bi-shield-x me-2"></i>보안 일시 해제</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                }
            }

            @* ──────────────────────────────
               [7] 탭: 부서 임원 정보
            ────────────────────────────── *@
            else if (_activeTab == "Info" && (CurrentUser?.IsManager == true || CurrentUser?.IsAuditor == true))
            {
                <ul class="nav nav-pills sub-nav mb-4">
                    <li class="nav-item"><button class="nav-link @(_infoSubTab == "Officers" ? "active" : "")" @onclick='() => _infoSubTab = "Officers"'><i class="bi bi-person-badge me-1"></i>임원 정보</button></li>
                    <li class="nav-item"><button class="nav-link @(_infoSubTab == "Account" ? "active" : "")" @onclick='() => _infoSubTab = "Account"'><i class="bi bi-bank me-1"></i>계좌 번호</button></li>
                </ul>

                @if (_infoSubTab == "Officers")
                {
                <div class="col-md-10 mx-auto">
                    <h4 class="fw-bold mb-4" style="color: #1b1c15;">@(_targetYear)년도 부서 임원 관리</h4>
                    
                    @if (_visibleDepartments.Count > 1)
                    {
                        <div class="settings-info-box mb-4">
                            <p class="mb-0 text-muted small fw-bold">부서명을 클릭하여 해당 부서의 임원 정보를 관리합니다.</p>
                        </div>
                    }

                    <div class="@(_visibleDepartments.Count > 1 ? "accordion shadow-sm" : "")" id="officersAccordion">
                        @foreach (var dept in _visibleDepartments)
                        {
                            var oList = _deptOfficers.ContainsKey(dept.Id) ? _deptOfficers[dept.Id] : new List<DepartmentOfficer>();
                            var nOff = _newOfficers.ContainsKey(dept.Id) ? _newOfficers[dept.Id] : new DepartmentOfficer();
                            bool isEditing = _isEditingMap.ContainsKey(dept.Id) && _isEditingMap[dept.Id];
                            bool isExpanded = _expandedDepts.ContainsKey(dept.Id) && _expandedDepts[dept.Id];
                            bool useAccordion = _visibleDepartments.Count > 1;

                            <div class="@(useAccordion ? "accordion-item" : "settings-card border border-light p-4 mb-4")">
                                @if (useAccordion)
                                {
                                    <h2 class="accordion-header" id="heading-off-@dept.Id">
                                        <button class="accordion-button @(isExpanded ? "" : "collapsed")" type="button" @onclick="() => ToggleDept(dept.Id)">
                                            <i class="bi bi-people-fill me-1" style="color: #785600;"></i>@dept.Name <span class="badge bg-white text-muted border ms-2">총 @oList.Count 명</span>
                                        </button>
                                    </h2>
                                }
                                else
                                {
                                    <h5 class="fw-bold text-dark mb-4"><i class="bi bi-people-fill me-1" style="color: #785600;"></i>@dept.Name 임원 관리 <span class="badge bg-light text-muted border ms-2 fs-6">총 @oList.Count 명</span></h5>
                                }

                                <div id="collapse-off-@dept.Id" class="@(useAccordion ? $"accordion-collapse collapse {(isExpanded ? "show" : "")}" : "")">
                                    <div class="@(useAccordion ? "accordion-body bg-white" : "")">
                                        <div class="text-end mb-3">
                                            <button class="settings-secondary-btn py-1 px-3" style="font-size: 0.8rem;" @onclick="() => ImportPreviousYearOfficers(dept.Id)">
                                                <i class="bi bi-arrow-clockwise me-1"></i>직전년도 임원 불러오기
                                            </button>
                                        </div>

                                        @if (_isReplacing && _officerToReplace != null && _replacingDeptId == dept.Id)
                                        {
                                            <div class="settings-card-warm border border-danger mb-4" style="background-color: rgba(186, 26, 26, 0.03);">
                                                <h6 class="fw-bold mb-3" style="color: #ba1a1a;">[@(_officerToReplace?.Role)] 인수인계 교체 작성</h6>
                                                <div class="row g-2 align-items-end">
                                                    <div class="col-md-4">
                                                        <label class="form-label small fw-bold mb-1 text-muted">새 임원 이름</label>
                                                        <input class="settings-input" style="border-color: #ba1a1a;" @bind="_replaceNewName" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small fw-bold mb-1" style="color: #ba1a1a;">새 임원 시작일</label>
                                                        <input type="date" class="settings-input settings-tabular" style="border-color: #ba1a1a;" @bind="_replaceStartDate" />
                                                    </div>
                                                    <div class="col-md-4 d-flex gap-2">
                                                        <button class="btn btn-danger flex-grow-1 fw-bold shadow-sm" @onclick="ConfirmReplaceOfficer">교체 완료</button>
                                                        <button class="btn btn-light fw-bold border text-muted" @onclick="CancelReplace">취소</button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="settings-card-warm mb-4">
                                                <div class="row g-2 align-items-end">
                                                    <div class="col-md-2">
                                                        <label class="form-label small fw-bold mb-1 text-muted">직분</label>
                                                        <select class="settings-input fw-bold" @bind="nOff.Role" style="color: #5a4000;">
