@page "/settings"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using System.Text
@using ClosedXML.Excel
@using ExcelDataReader
@using System.Data
@using System.IO
@inject AccountingService AccService
@inject AppDbContext DbContext
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject TwoFactorAuthService TotpService
@rendermode InteractiveServer

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0">
        @* 상단 헤더 *@
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-gear-fill me-2"></i>환경 설정
                <span class="fs-6 text-muted">(@(CurrentUser?.Department?.Name ?? (IsSystemAdmin ? "시스템 관리자" : "부서미정")))</span>
            </h4>

            @if (IsDeptAdmin)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark border">현재 작업 연도:</span>
                    <div class="d-flex align-items-center gap-1">
                        <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="() => ChangeYear(-1)" disabled="@(TargetYear <= 2024)">◀</button>
                        <span class="fw-bold fs-5 px-2 text-primary" style="min-width: 80px; text-align: center;">@TargetYear 년</span>
                        <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="() => ChangeYear(1)" disabled="@(TargetYear >= DateTime.Now.Year + 1)">▶</button>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary ms-2 fw-bold" @onclick="SafeImportPreviousYearBudget" disabled="@isImporting">
                        @if (isImporting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <span>🔄 직전년도 예산 불러오기</span>
                        }
                    </button>

                    <button class="btn btn-sm btn-outline-success ms-1 fw-bold" @onclick="DownloadBulkTemplate">
                        📄 엑셀양식 다운로드
                    </button>

                    <button class="btn btn-sm btn-outline-primary ms-1 fw-bold" @onclick="TriggerBulkImport" disabled="@isImporting">
                        📥 일괄입력 (엑셀)
                    </button>
                </div>
            }
        </div>

        @* 숨겨진 파일 업로드 Input 요소들 *@
        <InputFile @key="bulkImportKey" id="bulkImportInput" OnChange="HandleBulkImport" style="display:none;" accept=".xlsx,.xls" />
        <InputFile @key="systemRestoreKey" id="systemRestoreInput" OnChange="HandleSystemRestore" style="display:none;" accept=".json" />

        @* 권한별 탭 메뉴 분리 *@
        <div class="card-header bg-light p-0 border-0">
            <ul class="nav nav-tabs border-bottom-0">
                @if (IsSystemAdmin)
                {
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "Users" ? "active fw-bold text-success" : "")" @onclick='() => ChangeTab("Users")'><i class="bi bi-people-fill me-1"></i> 사용자 관리</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "Backup" ? "active fw-bold text-primary" : "")" @onclick='() => ChangeTab("Backup")'><i class="bi bi-folder-fill me-1"></i> 전체 시스템 백업/복원</button>
                    </li>
                }
                @if (IsDeptAdmin)
                {
                    <li class="nav-item"><button class="nav-link @(activeTab == "Income" ? "active fw-bold text-primary" : "")" @onclick='() => ChangeTab("Income")'>📥 수입 예산</button></li>
                    <li class="nav-item"><button class="nav-link @(activeTab == "Expense" ? "active fw-bold text-danger" : "")" @onclick='() => ChangeTab("Expense")'>📤 지출 예산</button></li>
                    <li class="nav-item"><button class="nav-link @(activeTab == "Mapping" ? "active fw-bold text-warning" : "")" @onclick='() => ChangeTab("Mapping")'>🏷️ 자동분류 설정</button></li>
                    <li class="nav-item"><button class="nav-link @(activeTab == "Quarter" ? "active fw-bold text-info" : "")" @onclick='() => ChangeTab("Quarter")'>📅 분기 설정</button></li>
                    <li class="nav-item"><button class="nav-link @(activeTab == "Backup" ? "active fw-bold text-success" : "")" @onclick='() => ChangeTab("Backup")'>📂 데이터 백업</button></li>
                }
                <li class="nav-item"><button class="nav-link @(activeTab == "MyInfo" ? "active fw-bold text-dark" : "")" @onclick='() => ChangeTab("MyInfo")'>🔒 보안 및 암호</button></li>
                <li class="nav-item"><button class="nav-link @(activeTab == "Officers" ? "active fw-bold text-primary" : "")" @onclick='() => ChangeTab("Officers")'><i class="bi bi-person-vcard me-1"></i> 부서 임원 정보</button></li>
                <li class="nav-item"><button class="nav-link @(activeTab == "Account" ? "active fw-bold text-success" : "")" @onclick='() => ChangeTab("Account")'>🏦 부서 계좌번호</button></li>
            </ul>
        </div>

        <div class="card-body bg-white p-4">

            @* ──────────────────────────────
               [1] 탭: 예산 관리 (수입/지출)
            ────────────────────────────── *@
            @if ((activeTab == "Income" || activeTab == "Expense") && IsDeptAdmin)
            {
                var currentCats = activeTab == "Income" ? IncomeCats : ExpenseCats;
                <h5 class="fw-bold text-primary mb-3">✏️ @(TargetYear) 년도 @(activeTab == "Income" ? "수입" : "지출") 예산 편집</h5>

                <div class="alert alert-success border-success bg-success bg-opacity-10 small mb-2">
                    <i class="bi bi-info-circle-fill me-1"></i> <strong>사용법:</strong> 1년 동안 사용할 수입/지출 예산을 항목별로 등록합니다. 상단의 <b>[엑셀양식 다운로드]</b> 후 <b>[일괄입력]</b>을 사용하시면 매우 편리합니다.
                </div>

                <div class="bg-light p-3 rounded mb-4 border shadow-sm">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1">항목 (직접입력/선택)</label>
                            <div class="input-group">
                                <input class="form-control" list="catList" @bind="newPlan.Category" placeholder="예: 행사비, 주일헌금" />
                                <datalist id="catList">
                                    @foreach (var c in currentCats) { <option value="@c"></option> }
                                </datalist>
                                @if (!string.IsNullOrEmpty(newPlan.Category))
                                {
                                    <button class="btn btn-outline-secondary px-2" type="button" style="font-size: 0.75rem;" @onclick="@(() => newPlan.Category = string.Empty)" title="지우기">❌</button>
                                }
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">상세내역</label>
                            <div class="input-group">
                                <input class="form-control" @bind="newPlan.SubCategory" placeholder="상세내역" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1">산출근거</label>
                            <div class="input-group">
                                <input class="form-control" @bind="newPlan.CalcDetail" placeholder="산출근거" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">금액</label>
                            <div class="input-group">
                                <input type="number" class="form-control text-end" @bind="newPlan.Amount" placeholder="금액" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100 fw-bold" @onclick="SavePlan">@((newPlan.Id == 0) ? "➕ 추가" : "💾 수정")</button>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-bold">총 @(budgetList.Count(b => b.Year == TargetYear && b.Type == activeTab))건의 예산 내역</span>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="ExpandAll"><i class="bi bi-arrows-expand"></i> 전체 나열하기</button>
                        <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="CollapseAll"><i class="bi bi-arrows-collapse"></i> 전체 줄이기</button>
                    </div>
                </div>

                <table class="table table-hover align-middle border-top mb-5">
                    <thead class="@(activeTab == "Income" ? "table-primary" : "table-danger") text-center">
                        <tr>
                            <th>항목</th><th>상세내역</th><th>산출근거</th><th class="text-end">금액</th><th width="120">관리</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!CurrentYearBudgets.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">등록된 예산이 없습니다.</td></tr>
                        }
                        else
                        {
                            @foreach (var group in GroupedBudgets)
                            {
                                bool isExpanded = IsExpanded(group.Key);
                                decimal groupTotal = group.Sum(x => x.Amount);

                                <tr style="cursor: pointer; background-color: #f8f9fa;" @onclick="() => ToggleCategory(group.Key)">
                                    <td class="fw-bold text-center text-primary">
                                        <i class="bi @(isExpanded ? "bi-caret-down-fill" : "bi-caret-right-fill") me-1"></i> @group.Key
                                    </td>
                                    <td></td><td></td>
                                    <td class="text-end fw-bold text-dark">@groupTotal.ToString("N0")</td>
                                    <td class="text-center"><span class="badge bg-white text-secondary border">@(group.Count())건</span></td>
                                </tr>

                                @if (isExpanded)
                                {
                                    @foreach (var item in group)
                                    {
                                        <tr>
                                            <td class="text-center text-muted small"><i class="bi bi-arrow-return-right"></i></td>
                                            <td>@item.SubCategory</td>
                                            <td class="small text-muted">@item.CalcDetail</td>
                                            <td class="text-end">@item.Amount.ToString("N0")</td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-secondary me-1 py-0 fw-bold" @onclick:stopPropagation="true" @onclick="() => EditPlan(item)">수정</button>
                                                <button class="btn btn-sm btn-outline-danger py-0 fw-bold" @onclick:stopPropagation="true" @onclick="() => SafeDeletePlan(item.Id)">삭제</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    </tbody>
                    @if (CurrentYearBudgets.Any())
                    {
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="3" class="text-end fs-5">총 합계</td>
                                <td class="text-end text-primary fs-5">@CurrentYearBudgets.Sum(b => b.Amount).ToString("N0")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            }
            @* ──────────────────────────────
               [2] 탭: 자동분류 설정 (수입/지출 분리형)
            ────────────────────────────── *@
            else if (activeTab == "Mapping" && IsDeptAdmin)
            {
                <h5 class="fw-bold text-warning mb-3">🏷️ 엑셀 장부 자동분류 설정</h5>

                <div class="alert alert-success border-success bg-success bg-opacity-10 small mb-2">
                    <i class="bi bi-info-circle-fill me-1"></i> <strong>사용법:</strong> 은행 엑셀의 '적요' 칸에 포함된 단어를 인식하여 지정된 항목으로 자동 분류합니다.
                </div>

                @* 수동 등록 창 *@
                <div class="bg-light p-3 rounded mb-4 border shadow-sm">
                    <div class="row g-2">
                        <div class="col-md-2">
                            <select class="form-select fw-bold border-warning" @bind="mappingType">
                                <option value="수입">💰 수입용</option>
                                <option value="지출">💸 지출용</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" @bind="newMapping.Keyword" placeholder="적요 키워드 (예: 인천중앙교회)" />
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" list="mapCatList" @bind="newMapping.Category" placeholder="분류될 항목 선택" />
                            <datalist id="mapCatList">
                                @if (mappingType == "수입") { @foreach (var c in IncomeCats) { <option value="@c"></option> } }
                                else { @foreach (var c in ExpenseCats) { <option value="@c"></option> } }
                            </datalist>
                        </div>
                        <div class="col-md-2"><button class="btn btn-warning w-100 fw-bold" @onclick="AddMapping">규칙 등록</button></div>
                    </div>
                </div>

                <h6 class="fw-bold text-primary mb-2"><i class="bi bi-plus-circle-fill me-1"></i> 수입 항목 자동분류 규칙</h6>
                <table class="table table-sm table-bordered bg-white text-center shadow-sm mb-5">
                    <thead class="table-primary"><tr><th width="40%">키워드(은행적요)</th><th width="40%">분류될 수입 항목</th><th width="20%">관리</th></tr></thead>
                    <tbody>
                        @foreach (var m in mappingList.Where(x => IncomeCats.Contains(x.Category ?? "")))
                        {
                            <tr><td>@m.Keyword</td><td class="fw-bold text-primary">@m.Category</td><td><button class="btn btn-sm btn-outline-danger py-0" @onclick="() => DeleteMapping(m.Id)">삭제</button></td></tr>
                        }
                        @if (!mappingList.Any(x => IncomeCats.Contains(x.Category ?? "")))
                        {
                            <tr><td colspan="3" class="text-muted py-3">등록된 수입 규칙이 없습니다.</td></tr>
                        }
                    </tbody>
                </table>

                <h6 class="fw-bold text-danger mb-2"><i class="bi bi-dash-circle-fill me-1"></i> 지출 항목 자동분류 규칙</h6>
                <table class="table table-sm table-bordered bg-white text-center shadow-sm">
                    <thead class="table-danger"><tr><th width="40%">키워드(은행적요)</th><th width="40%">분류될 지출 항목</th><th width="20%">관리</th></tr></thead>
                    <tbody>
                        @foreach (var m in mappingList.Where(x => ExpenseCats.Contains(x.Category ?? "")))
                        {
                            <tr><td>@m.Keyword</td><td class="fw-bold text-danger">@m.Category</td><td><button class="btn btn-sm btn-outline-danger py-0" @onclick="() => DeleteMapping(m.Id)">삭제</button></td></tr>
                        }
                        @if (!mappingList.Any(x => ExpenseCats.Contains(x.Category ?? "")))
                        {
                            <tr><td colspan="3" class="text-muted py-3">등록된 지출 규칙이 없습니다.</td></tr>
                        }
                    </tbody>
                </table>
            }
            @* ──────────────────────────────
               [3] 탭: 분기 설정
            ────────────────────────────── *@
            else if (activeTab == "Quarter" && IsDeptAdmin)
            {
                <div class="col-md-10 mx-auto mt-4">
                    <h5 class="fw-bold mb-3 text-info">📌 @TargetYear 년도 분기 날짜 설정</h5>
                    <div class="card p-4 shadow-sm border-info">
                        @for (int q = 1; q <= 4; q++)
                        {
                            int localQ = q;
                            <div class="mb-3 row align-items-center bg-light p-2 rounded">
                                <label class="col-sm-2 col-form-label fw-bold text-center border-end">@q 분기</label>
                                <div class="col d-flex gap-2 align-items-center">
                                    <input type="date" class="form-control" @bind="QuarterStartDates[localQ - 1]" />
                                    <span>~</span>
                                    <input type="date" class="form-control" @bind="QuarterEndDates[localQ - 1]" />
                                </div>
                                <div class="col-sm-2"><button class="btn btn-sm btn-outline-primary w-100 fw-bold" @onclick="() => SaveQuarter(localQ)">저장</button></div>
                            </div>
                        }
                    </div>
                </div>
            }
            @* ──────────────────────────────
               [4] 탭: 데이터 백업/복구
            ────────────────────────────── *@
            else if (activeTab == "Backup" && (IsSystemAdmin || IsDeptAdmin))
            {
                @if (IsSystemAdmin)
                {
                    <h5 class="mb-3 fw-bold text-primary">📂 전체 시스템 데이터 백업 및 복원</h5>
                    <div class="card p-4 shadow-sm border-primary bg-light mb-4">
                        <div class="d-flex gap-3">
                            <button class="btn btn-success fw-bold px-4 py-2" @onclick="DownloadAllDataExcel"><i class="bi bi-file-earmark-excel me-2"></i>모든 부서 엑셀 다운로드</button>
                            <button class="btn btn-dark fw-bold px-4 py-2" @onclick="DownloadAllDataJson"><i class="bi bi-filetype-json me-2"></i>시스템 JSON 백업</button>
                            <button class="btn btn-danger fw-bold px-4 py-2" @onclick="TriggerSystemRestore" disabled="@isRestoring">
                                @if (isRestoring) { <span class="spinner-border spinner-border-sm me-2"></span><span>복원 중...</span> }
                                else { <i class="bi bi-arrow-counterclockwise me-2"></i><span>시스템 JSON 복원</span> }
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <h5 class="mb-3 fw-bold text-success">📂 장부 백업</h5>
                    <div class="alert border border-primary bg-light shadow-sm d-flex justify-content-between align-items-center mb-5">
                        <div>
                            <strong class="text-primary">현재 상태를 수동으로 즉시 백업</strong><br />
                            <div class="input-group input-group-sm mt-2" style="width: 450px;">
                                <input type="text" class="form-control border-primary" placeholder="백업 메모 입력" @bind="customBackupMemo" />
                            </div>
                        </div>
                        <button class="btn btn-primary fw-bold px-4" @onclick='() => SafeBackup("Manual")'><i class="bi bi-download me-1"></i> 지금 백업하기</button>
                    </div>

                    <h6 class="fw-bold mt-4 text-primary"><i class="bi bi-person-check-fill me-2"></i>수동 백업 내역</h6>
                    <table class="table table-sm table-hover border align-middle text-center shadow-sm mb-5">
                        <thead class="table-light"><tr><th>백업 일시</th><th>구분</th><th>메모</th><th width="250">관리</th></tr></thead>
                        <tbody>
                            @foreach (var b in ManualBackups)
                            {
                                <tr>
                                    <td>@b.BackupDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><span class="badge bg-primary">수동</span></td>
                                    <td class="small text-start">@b.Memo</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary fw-bold px-2 py-0 me-1" @onclick="() => RestoreData(b)">🔄 복구</button>
                                        <button class="btn btn-sm btn-outline-dark fw-bold px-2 py-0 me-1" @onclick="() => DownloadBackupFile(b)">💾 다운로드</button>
                                        <button class="btn btn-sm btn-outline-danger fw-bold px-2 py-0" @onclick="() => DeleteBackup(b.Id)">🗑️ 삭제</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <h6 class="fw-bold mt-4 text-secondary"><i class="bi bi-robot me-2"></i>자동 백업 내역</h6>
                    <table class="table table-sm table-hover border align-middle text-center shadow-sm">
                        <thead class="table-light"><tr><th>백업 일시</th><th>구분</th><th>메모</th><th width="250">관리</th></tr></thead>
                        <tbody>
                            @foreach (var b in AutoBackups)
                            {
                                <tr>
                                    <td>@b.BackupDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><span class="badge bg-secondary">자동</span></td>
                                    <td class="small text-start text-muted">@b.Memo</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary fw-bold px-2 py-0 me-1" @onclick="() => RestoreData(b)">🔄 복구</button>
                                        <button class="btn btn-sm btn-outline-dark fw-bold px-2 py-0 me-1" @onclick="() => DownloadBackupFile(b)">💾 다운로드</button>
                                        <button class="btn btn-sm btn-outline-danger fw-bold px-2 py-0" @onclick="() => DeleteBackup(b.Id)">🗑️ 삭제</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            @* ──────────────────────────────
               [5] 탭: 사용자 관리 (시스템 관리자용)
            ────────────────────────────── *@
            else if (activeTab == "Users" && IsSystemAdmin)
            {
                <h5 class="mb-3 fw-bold text-success">👥 부서 계정 관리</h5>
                <div class="row g-2 mb-3 bg-light p-3 border rounded shadow-sm">
                    <div class="col-3"><input class="form-control" @bind="newUser.Username" placeholder="새로운 ID" /></div>
                    <div class="col-3"><input class="form-control" @bind="newUser.FullName" placeholder="이름(선택)" /></div>
                    <div class="col-3">
                        <select class="form-select" @bind="newUser.DepartmentId">
                            <option value="0">부서 선택</option>
                            @foreach (var d in adminDeptList) { <option value="@d.Id">@d.Name</option> }
                        </select>
                    </div>
                    <div class="col-2">
                        <select class="form-select" @bind="newUser.Role">
