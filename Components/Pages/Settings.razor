    private async Task Enable2FA() 
    {
        if (TotpService.VerifyCode(tempSecret, setupOtpCode)) 
        {
            if (CurrentUser != null)
            {
                var user = await DbContext.Users.FirstOrDefaultAsync(u => u.Username == CurrentUser.Username);
                if (user != null)
                {
                    user.TwoFactorSecret = tempSecret; user.IsTwoFactorEnabled = true; await DbContext.SaveChangesAsync();
                    CurrentUser.IsTwoFactorEnabled = true; tempSecret = ""; setupOtpCode = "";
                    await JSRuntime.InvokeVoidAsync("alert", "✅ 성공! 이제 로그인 시 OTP 인증이 필요합니다.");
                }
            }
        } 
        else { await JSRuntime.InvokeVoidAsync("alert", "❌ 번호가 일치하지 않습니다. 다시 확인하세요."); }
    }
    
