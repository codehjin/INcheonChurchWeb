    // 🚀 일괄입력 엑셀 처리
    private async Task HandleBulkImport(InputFileChangeEventArgs e)
    {
        if (CurrentUser == null) return;
        var file = e.File;
        if (file == null) return;

        isImporting = true;
        StateHasChanged();

        try
        {
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var reader = ExcelReaderFactory.CreateReader(memoryStream);
            var result = reader.AsDataSet();

            int budgetCount = 0, mapCount = 0;
            int deptId = CurrentUser.DepartmentId;

            foreach (DataTable table in result.Tables)
            {
                if (table.TableName == "예산일괄입력")
                {
                    for (int i = 1; i < table.Rows.Count; i++)
                    {
                        var row = table.Rows[i];
                        string type = row[0]?.ToString()?.Trim() ?? ""; string cat = row[1]?.ToString()?.Trim() ?? ""; string sub = row[2]?.ToString()?.Trim() ?? ""; string calc = row[3]?.ToString()?.Trim() ?? ""; string amtStr = row[4]?.ToString()?.Trim() ?? "0";
                        if (type.StartsWith("(예시)") || cat.StartsWith("(예시)") || string.IsNullOrEmpty(cat)) continue;
                        if (type == "수입") type = "Income"; if (type == "지출") type = "Expense";
                        if (type != "Income" && type != "Expense") continue;
                        decimal.TryParse(amtStr, out decimal amt);
                        DbContext.BudgetPlans.Add(new BudgetPlan { DepartmentId = deptId, Year = TargetYear, Type = type, Category = cat, SubCategory = sub, CalcDetail = calc, Amount = amt });
                        budgetCount++;
                    }
                }
                else if (table.TableName == "자동분류일괄입력")
                {
                    for (int i = 1; i < table.Rows.Count; i++)
                    {
                        var row = table.Rows[i];
                        string keyword = row[0]?.ToString()?.Trim() ?? ""; string cat = row[1]?.ToString()?.Trim() ?? "";
                        if (keyword.StartsWith("(예시)") || cat.StartsWith("(예시)") || string.IsNullOrEmpty(keyword) || string.IsNullOrEmpty(cat)) continue;
                        bool exists = await DbContext.CategoryMappings.AnyAsync(m => m.DepartmentId == deptId && m.Keyword == keyword);
                        if (!exists) { DbContext.CategoryMappings.Add(new CategoryMapping { DepartmentId = deptId, Keyword = keyword, Category = cat }); mapCount++; }
                    }
                }
            }
            await DbContext.SaveChangesAsync(); await LoadData(); await JSRuntime.InvokeVoidAsync("alert", $"✅ 일괄 입력 완료!\\n- 예산: {budgetCount}건 추가\\n- 자동분류: {mapCount}건 추가");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"❌ 엑셀 처리 중 오류 발생: {ex.Message}"); }
        finally { isImporting = false; StateHasChanged(); }
    }
