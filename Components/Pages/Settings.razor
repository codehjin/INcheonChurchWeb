    private async Task TriggerSystemRestore() { await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('systemRestoreInput').click()"); }
    
    private async Task HandleSystemRestore(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        if (await JSRuntime.InvokeAsync<bool?>("confirm", "현재 시스템의 모든 데이터가 삭제됩니다. 진행하시겠습니까?") != true) return;
        _isRestoring = true; StateHasChanged();
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var backupData = JsonSerializer.Deserialize<SystemBackupDto>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (backupData == null || backupData.Departments == null || backupData.Users == null) { await ShowAlertAsync("유효하지 않은 백업 파일입니다."); return; }

            using var context = DbContextFactory.CreateDbContext();
            context.CategoryMappings.RemoveRange(context.CategoryMappings); context.BudgetPlans.RemoveRange(context.BudgetPlans); context.Transactions.RemoveRange(context.Transactions); context.Users.RemoveRange(context.Users); context.Departments.RemoveRange(context.Departments);
            await context.SaveChangesAsync();
            if (backupData.Departments.Any()) context.Departments.AddRange(backupData.Departments);
            if (backupData.Users.Any()) context.Users.AddRange(backupData.Users);
            if (backupData.Transactions.Any()) context.Transactions.AddRange(backupData.Transactions);
            if (backupData.BudgetPlans.Any()) context.BudgetPlans.AddRange(backupData.BudgetPlans);
            if (backupData.CategoryMappings.Any()) context.CategoryMappings.AddRange(backupData.CategoryMappings);
            await context.SaveChangesAsync(); await LoadData();
            await ShowAlertAsync("시스템 복원이 완료되었습니다."); Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex) { await ShowAlertAsync($"복원 중 오류 발생: {ex.Message}"); }
        finally { _isRestoring = false; _systemRestoreKey = Guid.NewGuid(); StateHasChanged(); }
    }

    private async Task DownloadAllDataExcel()
    {
        try
        {
            using var context = DbContextFactory.CreateDbContext();
            var depts = await context.Departments.AsNoTracking().ToDictionaryAsync(d => d.Id, d => d.Name);
            var allLedgers = await context.Transactions.AsNoTracking().OrderBy(t => t.Date).ToListAsync(); var allBudgets = await context.BudgetPlans.AsNoTracking().OrderBy(b => b.Year).ThenBy(b => b.DepartmentId).ToListAsync();
            using var workbook = new XLWorkbook();
            var wsLedger = workbook.Worksheets.Add("통합장부");
            var headers = new[] { "부서명", "회계연도", "날짜", "구분", "항목", "적요", "비고", "수입", "지출" };
            for (int i = 0; i < headers.Length; i++) { wsLedger.Cell(1, i + 1).Value = headers[i]; wsLedger.Cell(1, i + 1).Style.Font.Bold = true; wsLedger.Cell(1, i + 1).Style.Fill.BackgroundColor = XLColor.LightGray; }
            int row = 2;
            foreach (var item in allLedgers) 
            { 
                string translatedType = item.Type == "Income" ? "수입" : (item.Type == "Expense" ? "지출" : item.Type);
                wsLedger.Cell(row, 1).Value = depts.ContainsKey(item.DepartmentId) ? depts[item.DepartmentId] : "알수없음";
                wsLedger.Cell(row, 2).Value = item.FiscalYear; wsLedger.Cell(row, 3).Value = item.Date.ToString("yyyy-MM-dd"); wsLedger.Cell(row, 4).Value = translatedType; wsLedger.Cell(row, 5).Value = item.Category; wsLedger.Cell(row, 6).Value = item.Description;
                wsLedger.Cell(row, 7).Value = item.Note; wsLedger.Cell(row, 8).Value = item.Income == 0 ? "" : item.Income; wsLedger.Cell(row, 9).Value = item.Expense == 0 ? "" : item.Expense; row++;
            }
            wsLedger.Columns().AdjustToContents();

            var wsBudget = workbook.Worksheets.Add("통합예산");
            var bHeaders = new[] { "부서명", "연도", "구분", "항목", "상세내역", "산출근거", "금액" };
            for (int i = 0; i < bHeaders.Length; i++) { wsBudget.Cell(1, i + 1).Value = bHeaders[i]; wsBudget.Cell(1, i + 1).Style.Font.Bold = true; wsBudget.Cell(1, i + 1).Style.Fill.BackgroundColor = XLColor.LightGray; }
            int bRow = 2;
            foreach (var item in allBudgets) 
            { 
                string translatedType = item.Type == "Income" ? "수입" : (item.Type == "Expense" ? "지출" : item.Type);
                wsBudget.Cell(bRow, 1).Value = depts.ContainsKey(item.DepartmentId) ? depts[item.DepartmentId] : "알수없음";
                wsBudget.Cell(bRow, 2).Value = item.Year; wsBudget.Cell(bRow, 3).Value = translatedType; wsBudget.Cell(bRow, 4).Value = item.Category; wsBudget.Cell(bRow, 5).Value = item.SubCategory; wsBudget.Cell(bRow, 6).Value = item.CalcDetail;
                wsBudget.Cell(bRow, 7).Value = item.Amount; bRow++; 
            }
            wsBudget.Columns().AdjustToContents();
            using var stream = new MemoryStream(); workbook.SaveAs(stream); var base64 = Convert.ToBase64String(stream.ToArray());
            await JSRuntime.InvokeVoidAsync("downloadExcelFile", $"전체부서_통합백업_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", base64);
        }
        catch (Exception ex) { await ShowAlertAsync($"엑셀 백업 중 오류: {ex.Message}"); }
    }

