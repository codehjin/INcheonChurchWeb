                                </div>

                                <div class="col-md-2 d-flex gap-1">
                                    <button class="btn btn-primary flex-grow-1 fw-bold" @onclick="SaveOfficer">
                                        @(isOfficerEditing ? "수정" : "등록")
                                    </button>
                                    @if (isOfficerEditing)
                                    {
                                        <button class="btn btn-danger fw-bold" @onclick="CancelOfficerEdit" title="초기화">
                                            ❌ 취소
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="mt-2 text-end">
                                <small class="text-muted">※ 기본 임기는 현재 연도의 1분기 시작일 ~ 4분기 마감일입니다.</small>
                            </div>
                        </div>
                    }

                    <table class="table table-hover align-middle border text-center">
                        <thead class="table-light">
                            <tr>
                                <th>직분</th>
                                <th>이름</th>
                                <th>임기 시작일</th>
                                <th>임기 종료일</th>
                                <th width="180">관리 (수정/교체)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in officerList.OrderBy(x => x.Role).ThenBy(x => x.StartDate))
                            {
                                <tr class="@(isReplacing && officerToReplace?.Id == o.Id ? "table-danger" : isOfficerEditing && newOfficer.Id == o.Id ? "table-warning" : "")">
                                    <td class="fw-bold text-secondary">@o.Role</td>
                                    <td class="fw-bold">@o.Name</td>
                                    <td>@o.StartDate.ToString("yyyy년 MM월 dd일")</td>
                                    <td>@o.EndDate.ToString("yyyy년 MM월 dd일")</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary px-2 py-0 me-1 fw-bold" @onclick="() => EditOfficer(o)">수정</button>
                                        <button class="btn btn-sm btn-outline-danger px-2 py-0 me-1 fw-bold" @onclick="() => StartReplaceOfficer(o)">교체</button>
                                        <button class="btn btn-sm btn-danger px-2 py-0 fw-bold" @onclick="() => DeleteOfficerData(o.Id)">삭제</button>
                                    </td>
                                </tr>
                            }
                            @if (!officerList.Any())
                            {
                                <tr><td colspan="5" class="py-4 text-muted">등록된 임원 정보가 없습니다.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* ──────────────────────────────
               [8] 탭: 부서 계좌번호 설정
            ────────────────────────────── *@
            else if (activeTab == "Account")
            {
                <div class="col-md-8 mx-auto mt-4">
                    <div class="card p-4 shadow-sm border-success bg-light">
                        <h5 class="fw-bold mb-3 text-success">🏦 지출결의서 연동 계좌 설정</h5>
                        <p class="text-muted small mb-4">이곳에 입력된 계좌 정보가 지출결의서 '계좌이체' 선택 시 자동으로 인쇄됩니다.</p>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">은행명</label>
                            <div class="input-group">
                                <input type="text" class="form-control" @bind="targetDepartment.BankName" placeholder="예: 농협은행, 하나은행" />
                                @if (!string.IsNullOrEmpty(targetDepartment.BankName))
                                {
                                    <button class="btn btn-outline-secondary px-2" type="button" style="font-size: 0.75rem;" @onclick="() => { targetDepartment.BankName = string.Empty; }" title="지우기">❌</button>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">계좌번호</label>
                            <div class="input-group">
                                <input type="text" class="form-control" @bind="targetDepartment.AccountNumber" placeholder="'-' (하이픈) 포함 입력" />
                                @if (!string.IsNullOrEmpty(targetDepartment.AccountNumber))
                                {
                                    <button class="btn btn-outline-secondary px-2" type="button" style="font-size: 0.75rem;" @onclick="() => { targetDepartment.AccountNumber = string.Empty; }" title="지우기">❌</button>
                                }
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-secondary">예금주</label>
                            <div class="input-group">
                                <input type="text" class="form-control" @bind="targetDepartment.AccountHolder" placeholder="예: 인천중앙교회(청년부)" />
                                @if (!string.IsNullOrEmpty(targetDepartment.AccountHolder))
                                {
                                    <button class="btn btn-outline-secondary px-2" type="button" style="font-size: 0.75rem;" @onclick="() => { targetDepartment.AccountHolder = string.Empty; }" title="지우기">❌</button>
                                }
                            </div>
                        </div>

                        <button class="btn btn-success w-100 fw-bold py-2 shadow-sm" @onclick="SaveAccountInfo">
                            <i class="bi bi-save me-2"></i>계좌 정보 저장
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    window.downloadJsonFile = (fileName, jsonContent) => {
        const blob = new Blob([jsonContent], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = fileName;
        link.href = url;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    };
    window.downloadExcelFile = (fileName, base64String) => {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = `data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,${base64String}`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };
</script>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }
    private string activeTab = "Income";
    private int TargetYear = DateTime.Now.Year;
    private bool isImporting = false;
    private bool isRestoring = false;

    private bool IsSystemAdmin = false;
    private bool IsDeptAdmin = false;

    private List<string> IncomeCats = new();
    private List<string> ExpenseCats = new();

    private List<BudgetPlan> budgetList = new();
    private IGrouping<int, BudgetPlan>[] budgetHistory = Array.Empty<IGrouping<int, BudgetPlan>>();

    private BudgetPlan newPlan = new();
    private List<CategoryMapping> mappingList = new();
    private CategoryMapping newMapping = new();
    private List<DataBackup> backupList = new();

    private List<User> adminUserList = new();
    private List<Department> adminDeptList = new();

    private User newUser = new() { Role = "DeptAdmin", IsActive = true };
    private string newSelfPassword = "";
    private string currentVisiblePassword = "";
    private string customBackupMemo = "";

    private Department targetDepartment = new();

    private List<DepartmentOfficer> officerList = new();
    private DepartmentOfficer newOfficer = new();
    private bool isOfficerEditing = false;
    private bool isReplacing = false;
    private DepartmentOfficer? officerToReplace = null;
    private string replaceNewName = "";
    private DateTime replaceStartDate = DateTime.Now;

    private Dictionary<string, bool> expandedCategories = new();

    class DateRange { public DateTime Start { get; set; } public DateTime End { get; set; } }
    private DateRange[] QuarterDates = new DateRange[4] { new(), new(), new(), new() };

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser == null) return;
        IsSystemAdmin = CurrentUser.Role == "Admin";
        IsDeptAdmin = CurrentUser.Role == "DeptAdmin" || CurrentUser.Role == "User";

        if (IsSystemAdmin) activeTab = "Users";
        else if (IsDeptAdmin) activeTab = "Income";
        else activeTab = "MyInfo";

        TargetYear = Math.Max(2024, DateTime.Now.Year);
        var user = await DbContext.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Username == CurrentUser.Username);
        if (user != null) currentVisiblePassword = user.Password;

        await LoadData();
    }

    private async Task ChangeYear(int offset)
    {
        int newYear = TargetYear + offset;
        if (newYear >= 2024 && newYear <= DateTime.Now.Year + 1)
        {
            TargetYear = newYear;
            await LoadData();
        }
    }

    private async Task ChangeTab(string tab)
    {
        activeTab = tab;
        newPlan = new();
        expandedCategories.Clear();
        await LoadData();

        if (tab == "Account" && CurrentUser != null)
        {
            await LoadDepartmentInfo();
        }
    }

    private async Task LoadData()
    {
        if (CurrentUser == null) return;
        int deptId = CurrentUser.DepartmentId;

        for (int i = 1; i <= 4; i++)
        {
            var range = await AccService.GetQuarterDateRangeAsync(deptId, TargetYear, i);
            QuarterDates[i - 1] = new DateRange { Start = range.Start, End = range.End };
        }

        if (IsSystemAdmin && activeTab == "Users")
        {
            adminUserList = await AccService.GetAllUsersAsync();
            adminDeptList = await AccService.GetDepartmentsAsync();
            return;
        }

        if (activeTab == "Income" || activeTab == "Expense")
        {
            var allPlansForTab = await DbContext.BudgetPlans.AsNoTracking().Where(b => b.DepartmentId == deptId && b.Type == activeTab).OrderBy(b => b.Year).ThenBy(b => b.Category).ToListAsync();
            budgetList = allPlansForTab;
            budgetHistory = allPlansForTab.GroupBy(b => b.Year).ToArray();

            var currentYearAllPlans = await DbContext.BudgetPlans.AsNoTracking().Where(b => b.DepartmentId == deptId && b.Year == TargetYear).ToListAsync();
            IncomeCats = currentYearAllPlans.Where(b => b.Type == "Income" || b.Type == "수입").Select(b => b.Category).Distinct().ToList();
            ExpenseCats = currentYearAllPlans.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();
        }
        else if (activeTab == "Mapping")
        {
            mappingList = await AccService.GetMappingsAsync(deptId);
            var currentYearAllPlans = await DbContext.BudgetPlans.AsNoTracking().Where(b => b.DepartmentId == deptId && b.Year == TargetYear).ToListAsync();
            ExpenseCats = currentYearAllPlans.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();
        }
        else if (activeTab == "Backup") { backupList = await AccService.GetBackupsAsync(deptId); }
        else if (activeTab == "Officers")
        {
            officerList = await DbContext.DepartmentOfficers.AsNoTracking()
                .Where(o => o.DepartmentId == deptId && o.Year == TargetYear)
                .ToListAsync();
            if (!isOfficerEditing && newOfficer.Id == 0)
            {
                newOfficer.StartDate = QuarterDates[0].Start;
                newOfficer.EndDate = QuarterDates[3].End;
            }
        }
    }

    private void ToggleCategory(string category)
    {
        if (expandedCategories.ContainsKey(category))
            expandedCategories[category] = !expandedCategories[category];
        else
            expandedCategories[category] = true;
    }

    private void ExpandAll()
    {
        var cats = budgetList.Where(b => b.Year == TargetYear && b.Type == activeTab).Select(b => b.Category).Distinct();
        foreach (var c in cats) expandedCategories[c] = true;
    }

    private void CollapseAll()
    {
        expandedCategories.Clear();
    }

    private bool IsExpanded(string category)
    {
        return expandedCategories.ContainsKey(category) && expandedCategories[category];
    }

    private async Task SaveOfficer()
    {
        if (string.IsNullOrWhiteSpace(newOfficer.Name) || string.IsNullOrWhiteSpace(newOfficer.Role))
        {
            await JSRuntime.InvokeVoidAsync("alert", "직분과 이름을 정확히 입력해주세요.");
            return;
        }

        if (newOfficer.Id == 0)
        {
            newOfficer.DepartmentId = CurrentUser?.DepartmentId ?? 0;
            newOfficer.Year = TargetYear;
            DbContext.DepartmentOfficers.Add(newOfficer);
        }
        else
        {
            var ex = await DbContext.DepartmentOfficers.FindAsync(newOfficer.Id);
            if (ex != null) DbContext.Entry(ex).CurrentValues.SetValues(newOfficer);
        }
        await DbContext.SaveChangesAsync();
        await LoadData();
        CancelOfficerEdit();
    }

    private void EditOfficer(DepartmentOfficer o)
    {
        CancelReplace();
        newOfficer = new DepartmentOfficer { Id = o.Id, DepartmentId = o.DepartmentId, Year = o.Year, Role = o.Role, Name = o.Name, StartDate = o.StartDate, EndDate = o.EndDate };
        isOfficerEditing = true;
    }

    private void CancelOfficerEdit()
    {
        newOfficer = new DepartmentOfficer { StartDate = QuarterDates[0].Start, EndDate = QuarterDates[3].End };
        isOfficerEditing = false;
    }

    private async Task DeleteOfficerData(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "이 임원의 이력을 완전히 삭제하시겠습니까?"))
        {
            var o = await DbContext.DepartmentOfficers.FindAsync(id);
            if (o != null) { DbContext.DepartmentOfficers.Remove(o); await DbContext.SaveChangesAsync(); await LoadData(); }
        }
    }

    private void StartReplaceOfficer(DepartmentOfficer o)
    {
        CancelOfficerEdit();
        officerToReplace = o;
        replaceNewName = "";
        replaceStartDate = DateTime.Now;
        isReplacing = true;
    }

    private void CancelReplace()
    {
        isReplacing = false;
        officerToReplace = null;
    }

    private async Task ConfirmReplaceOfficer()
    {
        if (officerToReplace == null || string.IsNullOrWhiteSpace(replaceNewName))
        {
            await JSRuntime.InvokeVoidAsync("alert", "새로운 임원의 이름을 입력해주세요.");
            return;
        }

        officerToReplace.EndDate = replaceStartDate.AddDays(-1);
        var ex = await DbContext.DepartmentOfficers.FindAsync(officerToReplace.Id);
        if (ex != null) DbContext.Entry(ex).CurrentValues.SetValues(officerToReplace);

