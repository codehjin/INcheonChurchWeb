@page "/login"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject TwoFactorAuthService TotpService
@rendermode InteractiveServer

<div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: var(--surface); display: flex; justify-content: center; align-items: center;">

<div class="ledger-card p-5" style="width: 100%; max-width: 420px; background-color: #ffffff;">
        <div class="text-center mb-5">
            <img src="/images/church-logo.png" alt="로고" class="img-fluid mb-4" style="max-height: 80px;" />
            <h3 class="font-heading" style="color: var(--on-surface);">교육국 재정 관리 시스템</h3>
            <p style="color: var(--on-surface-sub); font-size: 0.9rem;">등록된 계정으로 로그인하십시오</p>
        </div>

        @if (!_isOtpStep)
        {
            <div class="mb-4">
                <label class="form-label fw-bold" style="color: var(--on-surface-sub); font-size: 0.85rem;">사용자 아이디</label>
                <input type="text" class="form-control form-control-lg ledger-input px-3" @bind="_username" placeholder="ID" />
            </div>
            <div class="mb-5">
                <label class="form-label fw-bold" style="color: var(--on-surface-sub); font-size: 0.85rem;">비밀번호</label>
                <div class="position-relative">
                    <input type="@(_showPassword ? "text" : "password")" class="form-control form-control-lg ledger-input px-3" style="padding-right: 2.5rem;" @bind="_password" placeholder="Password" @onkeyup="EnterKey" />
                    <button type="button" class="btn border-0 position-absolute end-0 top-50 translate-middle-y text-muted" @onclick="() => _showPassword = !_showPassword" tabindex="-1">
                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
            </div>

            <button type="button" class="btn btn-ledger-primary w-100 btn-lg" @onclick="TryLogin" disabled="@_isLoading">
                <span>로그인</span>
            </button>
        }
        else
        {
            <div class="mb-4 text-center p-3" style="background-color: var(--surface-low); border-radius: var(--radius-base);">
                <div style="color: var(--on-surface-sub);">
                    <strong>2단계 보안 인증</strong><br />
                    <small>등록된 OTP 코드를 입력하십시오</small>
                </div>
            </div>

            <div class="mb-4 text-center">
                <input type="text" class="form-control form-control-lg text-center fw-bold ledger-input"
                       @bind="_inputOtpCode" maxlength="6" placeholder="000000"
                       style="font-size: 1.8rem; letter-spacing: 10px;" />
            </div>

            <button type="button" class="btn btn-ledger-primary w-100 btn-lg mb-3" @onclick="VerifyOtp" disabled="@_isOtpLoading">인증 확인</button>
            <button type="button" class="btn w-100 fw-bold" style="color: var(--on-surface-sub);" @onclick="CancelOtp">취소</button>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<User> OnLoginSuccess { get; set; }

    // Step 1: 로그인 입력
    private string _username = "";
    private string _password = "";
    private string _errorMessage = "";
    private bool _isLoading = false;
    private bool _showPassword = false;

    // Step 2: OTP 인증
    private bool _isOtpStep = false;
    private string _inputOtpCode = "";
    private string _otpErrorMessage = "";
    private bool _isOtpLoading = false;
    private User? _targetUser = null;

    /// <summary>
    /// 🚀 Step 1: 아이디/비밀번호로 로그인 시도
    /// </summary>
    private async Task TryLogin()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "아이디와 비밀번호를 입력하세요.";
            return;
        }

        _isLoading = true;
        _errorMessage = "";

        try
        {
            // 🚀 핵심: Department 정보를 함께 로드
            using var context = DbContextFactory.CreateDbContext();

            // 🔐 비밀번호는 DB에서 직접 비교하지 않는다(해시라 SQL 비교가 불가).
            //    아이디로 사용자를 먼저 찾고, 애플리케이션에서 검증한다.
            var user = await context.Users
                .Include(u => u.Department)
                .FirstOrDefaultAsync(u => u.Username == _username);

            if (user != null && !PasswordHasher.Verify(_password, user.Password))
                user = null;   // 비밀번호 불일치 → 기존과 동일하게 "없음"으로 처리

            // 🔐 자동 이행: 평문으로 저장돼 있던 계정은 로그인 성공 시 해시로 바꿔 저장한다.
            //    (기존 사용자가 로그인하지 못하는 일 없이 점진적으로 전환된다)
            if (user != null && !PasswordHasher.IsHashed(user.Password))
            {
                user.Password = PasswordHasher.Hash(_password);
                await context.SaveChangesAsync();
            }

            if (user != null)
            {
                if (!user.IsActive)
                {
                    _errorMessage = "비활성화된 계정입니다. 관리자에게 문의하세요.";
                }
                else
                {
                    // 🚀 수정 권한이 있는 사용자인지 확인
                    bool hasEditPermission = user.CanAccessDataCollection;

                    // 🚀 2FA 활성화 여부 확인
                    if (hasEditPermission && user.IsTwoFactorEnabled && !string.IsNullOrEmpty(user.TwoFactorSecret))
                    {
                        // OTP 입력 단계로 전환
                        _targetUser = user;
                        _isOtpStep = true;
                        _inputOtpCode = "";
                        _otpErrorMessage = "";
                    }
                    else
                    {
                        // 바로 로그인 완료
                        await LoginSuccess(user);
                    }
                }
            }
            else
            {
                _errorMessage = "아이디 또는 비밀번호가 틀렸습니다.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "로그인 처리 중 오류 발생: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// 🚀 Step 2: OTP 코드 검증
    /// </summary>
    private async Task VerifyOtp()
    {
        if (string.IsNullOrWhiteSpace(_inputOtpCode) || _inputOtpCode.Length != 6)
        {
            _otpErrorMessage = "6자리 숫자를 입력하세요.";
            return;
        }

        if (_targetUser == null)
        {
            _otpErrorMessage = "사용자 정보를 찾을 수 없습니다.";
            return;
        }

        if (string.IsNullOrEmpty(_targetUser.TwoFactorSecret))
        {
            _otpErrorMessage = "2단계 인증 설정이 없습니다.";
            return;
        }

        _isOtpLoading = true;
        _otpErrorMessage = "";

        try
        {
            // 🚀 OTP 코드 검증
            if (TotpService.VerifyCode(_targetUser.TwoFactorSecret, _inputOtpCode))
            {
                // 성공 - 로그인 완료
                await LoginSuccess(_targetUser);
            }
            else
            {
                _otpErrorMessage = "코드가 일치하지 않습니다. 다시 확인하세요.";
                _inputOtpCode = "";
            }
        }
        catch (Exception ex)
        {
            _otpErrorMessage = "OTP 검증 중 오류: " + ex.Message;
        }
        finally
        {
            _isOtpLoading = false;
        }
    }

    /// <summary>
    /// 🚀 OTP 입력 취소 및 로그인 화면으로 복귀
    /// </summary>
    private void CancelOtp()
    {
        _isOtpStep = false;
        _targetUser = null;
        _inputOtpCode = "";
        _otpErrorMessage = "";
        _password = ""; // 보안상 비밀번호 초기화
    }

    /// <summary>
    /// 🚀 로그인 성공 처리
    /// </summary>
    private async Task LoginSuccess(User user)
    {
        // 부모 컴포넌트(MainLayout 등)에 로그인 성공 알림
        await OnLoginSuccess.InvokeAsync(user);

        // 메인 페이지로 이동
        Nav.NavigateTo("/");
    }

    /// <summary>
    /// 아이디/비밀번호 입력에서 Enter 키 처리
    /// </summary>
    private async Task EnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isOtpStep)
        {
            await TryLogin();
        }
    }

    /// <summary>
    /// OTP 입력에서 Enter 키 처리
    /// </summary>
    private async Task OtpEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _isOtpStep)
        {
            await VerifyOtp();
        }
    }
}
