@page "/login"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject NavigationManager Nav
@rendermode InteractiveServer

<div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: #f0f2f5; display: flex; justify-content: center; align-items: center;">
    <div class="card shadow-lg p-4 border-0" style="width: 100%; max-width: 400px; border-radius: 15px;">

        @* 🚀 로고가 추가된 헤더 부분 *@
        <div class="text-center mb-4">
            <img src="/images/church-logo.png" alt="인천중앙교회 로고" class="img-fluid mb-3" style="max-height: 90px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);" />
            <h4 class="fw-bold text-primary">교회학교 회계 시스템</h4>
            <p class="text-muted small mb-0">서비스 이용을 위해 로그인해주세요</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">아이디</label>
            <input type="text" class="form-control form-control-lg" @bind="Username" @onkeyup="EnterKey" placeholder="ID 입력" />
        </div>
        <div class="mb-4">
            <label class="form-label fw-bold">비밀번호</label>
            <input type="password" class="form-control form-control-lg" @bind="Password" @onkeyup="EnterKey" placeholder="Password 입력" />
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger p-2 text-center small mb-3">@ErrorMessage</div>
        }

        <button type="button" class="btn btn-primary w-100 btn-lg fw-bold" @onclick="TryLogin" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>확인 중...</span>
            }
            else
            {
                <span>로그인</span>
            }
        </button>

        <div class="text-center mt-4">
            <small class="text-muted fw-bold">인천중앙성결교회 교육국</small>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<User> OnLoginSuccess { get; set; }

    private string Username = "";
    private string Password = "";
    private string ErrorMessage = "";
    private bool isLoading = false;

    private async Task TryLogin()
    {
        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage = "아이디와 비밀번호를 입력하세요.";
            return;
        }

        isLoading = true;
        ErrorMessage = "";

        try
        {
            // 🚀 핵심 수정: .Include(u => u.Department)를 사용하여 부서 정보를 함께 로드합니다.
            // 이 처리가 없으면 화면에서 CurrentUser.Department.Name이 모두 null로 나옵니다.
            var user = await DbContext.Users
                .Include(u => u.Department)
                .FirstOrDefaultAsync(u => u.Username == Username && u.Password == Password);

            if (user != null)
            {
                if (!user.IsActive)
                {
                    ErrorMessage = "비활성화된 계정입니다. 관리자에게 문의하세요.";
                }
                else
                {
                    // 부모 컴포넌트(MainLayout 등)에 로그인 성공 알림
                    await OnLoginSuccess.InvokeAsync(user);
                }
            }
            else
            {
                ErrorMessage = "아이디 또는 비밀번호가 틀렸습니다.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "로그인 처리 중 오류 발생: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task EnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await TryLogin();
    }
}