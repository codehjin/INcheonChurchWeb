@page "/login"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject TwoFactorAuthService TotpService
@rendermode InteractiveServer

<div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background-color: #f0f2f5; display: flex; justify-content: center; align-items: center;">
    <div class="card shadow-lg p-4 border-0" style="width: 100%; max-width: 400px; border-radius: 15px;">

        @* 🚀 로고가 추가된 헤더 부분 *@
        <div class="text-center mb-4">
            <img src="/images/church-logo.png" alt="인천중앙교회 로고" class="img-fluid mb-3" style="max-height: 90px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);" />
            <h4 class="fw-bold text-primary">교회학교 회계 시스템</h4>
            <p class="text-muted small mb-0">서비스 이용을 위해 로그인해주세요</p>
        </div>

        @* 🚀 수정됨: 2FA 여부에 따른 화면 분기 *@
        @if (!isOtpStep)
        {
            @* Step 1: 아이디/비밀번호 입력 *@
            <div class="mb-3">
                <label class="form-label fw-bold">아이디</label>
                <input type="text" class="form-control form-control-lg" @bind="Username" @onkeyup="EnterKey" placeholder="ID 입력" />
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">비밀번호</label>
                <input type="password" class="form-control form-control-lg" @bind="Password" @onkeyup="EnterKey" placeholder="Password 입력" />
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger p-2 text-center small mb-3">
                    <i class="bi bi-exclamation-circle me-1"></i>@ErrorMessage
                </div>
            }

            <button type="button" class="btn btn-primary w-100 btn-lg fw-bold" @onclick="TryLogin" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>확인 중...</span>
                }
                else
                {
                    <span>로그인</span>
                }
            </button>
        }
        else
        {
            @* Step 2: OTP 인증 입력 *@
            <div class="alert alert-info border-info d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-shield-lock" style="font-size: 1.5rem;"></i>
                <div>
                    <strong>보안 확인</strong><br />
                    <small>스마트폰 앱의 6자리 번호를 입력하세요</small>
                </div>
            </div>

            <div class="mb-3 text-center">
                <p class="text-muted small mb-2">
                    <strong>@(targetUser?.FullName ?? targetUser?.Username)</strong> 님의 OTP 코드
                </p>
                <div class="input-group">
                    <input 
                        type="text" 
                        class="form-control form-control-lg text-center fw-bold" 
                        @bind="inputOtpCode" 
                        @onkeyup="OtpEnterKey" 
                        maxlength="6" 
                        placeholder="000000"
                        style="font-size: 1.5rem; letter-spacing: 8px;" />
                </div>
                <small class="text-muted mt-2 d-block">시간이 지나면 코드가 변경됩니다</small>
            </div>

            @if (!string.IsNullOrEmpty(OtpErrorMessage))
            {
                <div class="alert alert-danger p-2 text-center small mb-3">
                    <i class="bi bi-exclamation-circle me-1"></i>@OtpErrorMessage
                </div>
            }

            <button type="button" class="btn btn-success w-100 btn-lg fw-bold mb-2" @onclick="VerifyOtp" disabled="@isOtpLoading">
                @if (isOtpLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>검증 중...</span>
                }
                else
                {
                    <span>인증하기</span>
                }
            </button>

            <button type="button" class="btn btn-outline-secondary w-100 fw-bold" @onclick="CancelOtp">
                <i class="bi bi-arrow-left me-1"></i>뒤로 가기
            </button>
        }

        <div class="text-center mt-4">
            <small class="text-muted fw-bold">인천중앙성결교회 교육국</small>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<User> OnLoginSuccess { get; set; }

    // Step 1: 로그인 입력
    private string Username = "";
    private string Password = "";
    private string ErrorMessage = "";
    private bool isLoading = false;

    // Step 2: OTP 인증
    private bool isOtpStep = false;
    private string inputOtpCode = "";
    private string OtpErrorMessage = "";
    private bool isOtpLoading = false;
    private User? targetUser = null;

    /// <summary>
    /// 🚀 Step 1: 아이디/비밀번호로 로그인 시도
    /// </summary>
    private async Task TryLogin()
    {
        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage = "아이디와 비밀번호를 입력하세요.";
            return;
        }

        isLoading = true;
        ErrorMessage = "";

        try
        {
            // 🚀 핵심: Department 정보를 함께 로드
            var user = await DbContext.Users
                .Include(u => u.Department)
                .FirstOrDefaultAsync(u => u.Username == Username && u.Password == Password);

            if (user != null)
            {
                if (!user.IsActive)
                {
                    ErrorMessage = "비활성화된 계정입니다. 관리자에게 문의하세요.";
                }
                else
                {
                    // 🚀 수정 권한이 있는 사용자인지 확인
                    bool hasEditPermission = user.Role == "Admin" || user.Role == "DeptAdmin" || user.Role == "User";

                    // 🚀 2FA 활성화 여부 확인
                    if (hasEditPermission && user.IsTwoFactorEnabled && !string.IsNullOrEmpty(user.TwoFactorSecret))
                    {
                        // OTP 입력 단계로 전환
                        targetUser = user;
                        isOtpStep = true;
                        inputOtpCode = "";
                        OtpErrorMessage = "";
                    }
                    else
                    {
                        // 바로 로그인 완료
                        await LoginSuccess(user);
                    }
                }
            }
            else
            {
                ErrorMessage = "아이디 또는 비밀번호가 틀렸습니다.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "로그인 처리 중 오류 발생: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// 🚀 Step 2: OTP 코드 검증
    /// </summary>
    private async Task VerifyOtp()
    {
        if (string.IsNullOrWhiteSpace(inputOtpCode) || inputOtpCode.Length != 6)
        {
            OtpErrorMessage = "6자리 숫자를 입력하세요.";
            return;
        }

        if (targetUser == null)
        {
            OtpErrorMessage = "사용자 정보를 찾을 수 없습니다.";
            return;
        }

        if (string.IsNullOrEmpty(targetUser.TwoFactorSecret))
        {
            OtpErrorMessage = "2단계 인증 설정이 없습니다.";
            return;
        }

        isOtpLoading = true;
        OtpErrorMessage = "";

        try
        {
            // 🚀 OTP 코드 검증
            if (TotpService.VerifyCode(targetUser.TwoFactorSecret, inputOtpCode))
            {
                // 성공 - 로그인 완료
                await LoginSuccess(targetUser);
            }
            else
            {
                OtpErrorMessage = "코드가 일치하지 않습니다. 다시 확인하세요.";
                inputOtpCode = "";
            }
        }
        catch (Exception ex)
        {
            OtpErrorMessage = "OTP 검증 중 오류: " + ex.Message;
        }
        finally
        {
            isOtpLoading = false;
        }
    }

    /// <summary>
    /// 🚀 OTP 입력 취소 및 로그인 화면으로 복귀
    /// </summary>
    private void CancelOtp()
    {
        isOtpStep = false;
        targetUser = null;
        inputOtpCode = "";
        OtpErrorMessage = "";
        Password = ""; // 보안상 비밀번호 초기화
    }

    /// <summary>
    /// 🚀 로그인 성공 처리
    /// </summary>
    private async Task LoginSuccess(User user)
    {
        // 부모 컴포넌트(MainLayout 등)에 로그인 성공 알림
        await OnLoginSuccess.InvokeAsync(user);
        
        // 메인 페이지로 이동
        Nav.NavigateTo("/");
    }

    /// <summary>
    /// 아이디/비밀번호 입력에서 Enter 키 처리
    /// </summary>
    private async Task EnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isOtpStep)
        {
            await TryLogin();
        }
    }

    /// <summary>
    /// OTP 입력에서 Enter 키 처리
    /// </summary>
    private async Task OtpEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && isOtpStep)
        {
            await VerifyOtp();
        }
    }
}