@page "/admin/users"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@inject AccountingService AccService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="container mt-4">
    <h3 class="fw-bold mb-4">사용자 및 권한 관리</h3>

    <table class="table table-hover text-center align-middle bg-white shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>상태</th>
                <th>아이디</th>
                <th>이름</th>
                <th>소속 부서</th>
                <th>권한</th>
                <th>관리 (초기화/상태변경)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr class="@(!user.IsActive ? "text-muted bg-light" : "")">
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">활성</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary">비활성</span>
                        }
                    </td>
                    <td class="fw-bold">@user.Username</td>
                    <td>@user.FullName</td>
                    <td>@(GetDepartmentName(user.DepartmentId))</td>
                    <td>@user.Role</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditUser(user)">수정</button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="() => ResetPassword(user)">비번초기화</button>

                        @if (user.Username != "admin")
                        {
                            <button class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                    @onclick="() => ToggleUserStatus(user)">
                                @(user.IsActive ? "정지" : "복구")
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-primary mt-2" @onclick="AddNewUser">새 사용자 추가</button>

    @if (isEditing)
    {
        <div class="card mt-4 shadow border-primary">
            <div class="card-header bg-primary text-white fw-bold">
                @(isNewUser ? "새 사용자 추가" : "사용자 정보 수정")
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">아이디 (로그인용)</label>
                        @* 신규일때만 입력 가능, 수정일때는 읽기전용 *@
                        <input class="form-control" @bind="currentUser.Username" disabled="@(!isNewUser)" placeholder="영문/숫자 입력" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">이름 (실명)</label>
                        <input class="form-control" @bind="currentUser.FullName" placeholder="예: 홍길동" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">소속 부서</label>
                        <select class="form-select" @bind="currentUser.DepartmentId" disabled="@(currentUser.Username == "admin")">
                            @foreach (var dept in departments)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">권한</label>
                        <select class="form-select" @bind="currentUser.Role" disabled="@(currentUser.Username == "admin")">
                            <option value="User">일반 사용자</option>
                            <option value="Admin">관리자</option>
                        </select>
                    </div>
                </div>
                <div class="mt-3 text-end">
                    <button class="btn btn-secondary" @onclick="() => isEditing = false">취소</button>
                    <button class="btn btn-success" @onclick="SaveUser">저장</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<User> users = new();
    private List<Department> departments = new();

    private bool isEditing = false;
    private bool isNewUser = false;
    private User currentUser = new();

    protected override async Task OnInitializedAsync()
    {
        users = await AccService.GetAllUsersAsync();
        departments = await AccService.GetDepartmentsAsync();
    }

    private string GetDepartmentName(int deptId)
    {
        return departments.FirstOrDefault(d => d.Id == deptId)?.Name ?? "미지정";
    }

    private void AddNewUser()
    {
        currentUser = new User
        {
            IsActive = true,
            Role = "User",
            DepartmentId = departments.FirstOrDefault()?.Id ?? 0
        };
        isEditing = true;
        isNewUser = true;
    }

    private void EditUser(User user)
    {
        currentUser = new User
        {
            Username = user.Username,
            FullName = user.FullName,
            DepartmentId = user.DepartmentId,
            Role = user.Role,
            IsActive = user.IsActive,
            Password = user.Password
        };
        isEditing = true;
        isNewUser = false;
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(currentUser.Username))
        {
            await JSRuntime.InvokeVoidAsync("alert", "아이디를 입력하세요.");
            return;
        }

        if (isNewUser)
        {
            currentUser.Password = currentUser.Username; // 초기 비밀번호는 아이디와 동일
            await AccService.AddUserAsync(currentUser);
        }
        else
        {
            await AccService.UpdateUserAsync(currentUser);
        }

        users = await AccService.GetAllUsersAsync();
        isEditing = false;
    }

    private async Task ResetPassword(User user)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"[{user.Username}] 계정의 비밀번호를 '1234'로 초기화하시겠습니까?");
        if (confirmed)
        {
            await AccService.ResetPasswordAsync(user.Username);
            await JSRuntime.InvokeVoidAsync("alert", "초기화되었습니다.");
        }
    }

    private async Task ToggleUserStatus(User user)
    {
        if (user.Username == "admin") return;

        string action = user.IsActive ? "정지(비활성화)" : "복구(활성화)";
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"이 계정을 {action} 하시겠습니까?");

        if (confirmed)
        {
            user.IsActive = !user.IsActive;
            await AccService.UpdateUserAsync(user);
            users = await AccService.GetAllUsersAsync(); // 목록 새로고침
        }
    }
}