@page "/receipt-query"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Hosting
@using System.IO
@inject IWebHostEnvironment Env
@inject AppDbContext DbContext
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h4 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-receipt me-2"></i>@(CanViewAll ? "전체 부서 영수증 보기" : "모바일 업로드 영수증 매칭")
            </h4>
        </div>

        <div class="card-body bg-light p-4">
            @* 🚀 회계담당자(DeptAdmin)에게만 보이는 미처리 영수증 매칭 대시보드 *@
            @if (!CanViewAll && pendingReceipts.Any())
            {
                <div class="alert alert-warning shadow-sm border-warning mb-4">
                    <h5 class="fw-bold text-dark mb-3">⚠️ 장부에 매칭되지 않은 모바일 영수증이 @pendingReceipts.Count 건 있습니다.</h5>
                    <p class="small text-muted mb-0">아래 영수증을 기존에 작성해둔 장부 내역과 연결(매칭)해 주세요.</p>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var receipt in pendingReceipts)
                    {
                        <div class="col">
                            <div class="card h-100 border-warning">
                                <img src="@receipt.ImagePath" class="card-img-top" alt="영수증 이미지" style="height: 150px; object-fit: cover; cursor: pointer;" @onclick="() => ShowLargeImage(receipt.ImagePath)" />
                                <div class="card-body p-2">
                                    <div class="small fw-bold text-primary mb-1">업로드: @receipt.ReceiptDate.ToString("yyyy-MM-dd")</div>
                                    <div class="text-truncate fw-bold mb-2" title="@receipt.Description">@receipt.Description</div>

                                    @* 🚀 기존 장부 매칭 폼 *@
                                    <div class="bg-white p-2 border rounded">
                                        <label class="small fw-bold text-secondary mb-1">연결할 장부 내역 선택</label>
                                        <select class="form-select form-select-sm mb-2 border-primary" @bind="selectedMatchDict[receipt.Id]">
                                            <option value="0">-- 증빙 없는 장부 내역 선택 --</option>
                                            @foreach (var entry in unmatchedEntries)
                                            {
                                                <option value="@entry.Id">[@entry.Date.ToString("MM-dd")] @entry.Description (@(entry.Expense > 0 ? entry.Expense.ToString("N0") : entry.Income.ToString("N0"))원)</option>
                                            }
                                        </select>
                                        <button class="btn btn-sm btn-primary w-100 fw-bold" @onclick="() => MatchReceiptToEntry(receipt)">🔗 선택한 내역에 영수증 연결</button>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-0 p-2 text-end">
                                    <button class="btn btn-sm btn-link text-danger text-decoration-none p-0" @onclick="() => DeleteReceipt(receipt.Id)">❌ 삭제(반려)</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <hr class="my-4 border-2" />
            }

            @if (!CanViewAll && !pendingReceipts.Any())
            {
                <div class="alert alert-success text-center mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i>모든 모바일 영수증이 장부에 연결되었습니다!
                </div>
            }

            @* 🚀 (기존 기능) 처리 완료된 영수증 및 기존 장부 내역 검색 *@
            <h5 class="fw-bold mb-3 text-secondary">🔍 기존 영수증 내역 검색</h5>
            <div class="row g-2 mb-4 align-items-end">
                @if (CanViewAll)
                {
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">부서 선택</label>
                        <select class="form-select" @bind="SearchDeptId">
                            <option value="0">== 전체 부서 ==</option>
                            @foreach (var d in allDepts)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md-3">
                    <label class="form-label small fw-bold">검색어 (적요/비고)</label>
                    <input type="text" class="form-control" @bind="SearchKeyword" placeholder="예: 식대, 다이소" @onkeyup="HandleKeyUp" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100 fw-bold" @onclick="SearchData"><i class="bi bi-search me-2"></i>검색</button>
                </div>
            </div>

            <div class="table-responsive bg-white rounded shadow-sm border">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            @if (CanViewAll)
                            {
                                <th>부서</th>
                            }
                            <th>날짜</th>
                            <th>구분</th>
                            <th>항목</th>
                            <th class="text-start">적요 (클릭시 영수증)</th>
                            <th class="text-end">금액</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in searchResults)
                        {
                            <tr>
                                @if (CanViewAll)
                                {
                                    <td>@(allDepts.FirstOrDefault(d => d.Id == item.DepartmentId)?.Name ?? "미정")</td>
                                }
                                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge @(item.Type == "Income" || item.Type == "수입" ? "bg-primary" : "bg-danger")">@(item.Type == "Income" || item.Type == "수입" ? "수입" : "지출")</span></td>
                                <td>@item.Category</td>
                                <td class="text-start">
                                    @* 영수증 이미지가 연동된 항목은 파란색 링크로 표시 *@
                                    @if (!string.IsNullOrEmpty(item.ReceiptUrl))
                                    {
                                        <a href="javascript:void(0)" class="text-decoration-none fw-bold text-primary" @onclick="() => ShowLargeImage(item.ReceiptUrl!)">
                                            <i class="bi bi-image me-1"></i>@item.Description
                                        </a>
                                    }
                                    else
                                    {
                                        @item.Description
                                    }
                                </td>
                                <td class="text-end fw-bold">@(item.Type == "Income" || item.Type == "수입" ? item.Income.ToString("N0") : item.Expense.ToString("N0"))</td>
                            </tr>
                        }
                        @if (!searchResults.Any())
                        {
                            <tr><td colspan="@(CanViewAll ? 6 : 5)" class="text-muted py-5">검색 결과가 없습니다.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* 🚀 이미지 크게 보기 모달 *@
@if (showImageModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.8);" tabindex="-1" @onclick="CloseImageModal">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation>
            <div class="modal-content bg-transparent border-0">
                <div class="modal-header border-0 justify-content-end p-2">
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImageModal"></button>
                </div>
                <div class="modal-body text-center p-0">
                    <img src="@currentLargeImageUrl" class="img-fluid rounded" style="max-height: 80vh;" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }
    private bool CanViewAll => CurrentUser?.Role == "Admin" || CurrentUser?.Role == "Auditor" || CurrentUser?.Department?.Name == "교육국" || CurrentUser?.Department?.Name == "관리자";

    // 모바일에서 올라온 미처리 영수증 목록
    private List<UploadedReceipt> pendingReceipts = new();

    // 🚀 기존 장부 중 영수증이 없는(미증빙) 내역 목록
    private List<LedgerEntry> unmatchedEntries = new();

    // 🚀 모바일 영수증 ID를 Key로, 연결할 장부 내역 ID를 Value로 저장
    private Dictionary<int, int> selectedMatchDict = new();

    // 검색 관련
    private int SearchDeptId = 0;
    private string SearchKeyword = "";
    private List<Department> allDepts = new();
    private List<LedgerEntry> searchResults = new();

    // 모달 관련
    private bool showImageModal = false;
    private string currentLargeImageUrl = "";

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser == null) return;
        allDepts = await DbContext.Departments.AsNoTracking().OrderBy(d => d.Id).ToListAsync();
        await LoadPendingReceipts();
        await SearchData(); // 초기 진입 시 전체 목록 로드
    }

    private async Task LoadPendingReceipts()
    {
        if (CurrentUser == null || CanViewAll) return; // 감사/관리자는 미처리 영수증 처리 권한 없음

        int deptId = CurrentUser.DepartmentId;

        // 1. 모바일 미처리 영수증 불러오기
        pendingReceipts = await DbContext.UploadedReceipts
            .Where(r => r.DepartmentId == deptId && r.IsMatched == false)
            .OrderByDescending(r => r.ReceiptDate)
            .ToListAsync();

        // 2. 🚀 현재 부서의 장부 내역 중 영수증(ReceiptUrl)이 비어있는 항목 불러오기
        unmatchedEntries = await DbContext.Transactions.AsNoTracking()
            .Where(t => t.DepartmentId == deptId && (t.ReceiptUrl == null || t.ReceiptUrl == ""))
            .OrderByDescending(t => t.Date).ToListAsync();

        selectedMatchDict.Clear();
        foreach (var r in pendingReceipts)
        {
            selectedMatchDict[r.Id] = 0; // 0은 선택 안됨 상태
        }
    }

    // 🚀 모바일 영수증을 기존 장부와 매칭하는 핵심 로직
    private async Task MatchReceiptToEntry(UploadedReceipt receipt)
    {
        if (!selectedMatchDict.ContainsKey(receipt.Id) || selectedMatchDict[receipt.Id] == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "연결할 장부 내역을 먼저 선택해주세요.");
            return;
        }

        int entryId = selectedMatchDict[receipt.Id];
        var entry = await DbContext.Transactions.FindAsync(entryId);

        if (entry == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "해당 장부 내역을 찾을 수 없습니다. 삭제되었을 수 있습니다.");
            return;
        }

        // ================================================================
        // 🚀 파일명 스마트 변경 로직 (예: 20240321_교육국_행사비_50000원_다이소_12.jpg)
        // ================================================================
        string oldRelativePath = receipt.ImagePath;
        string oldPhysicalPath = Path.Combine(Env.WebRootPath, oldRelativePath.TrimStart('/'));

        if (File.Exists(oldPhysicalPath))
        {
            string deptName = allDepts.FirstOrDefault(d => d.Id == entry.DepartmentId)?.Name ?? "알수없음";

            // 파일명에 쓸 수 없는 특수문자(\, /, :, *, ?, ", <, >, |)를 적요에서 제거
            string safeDescription = string.Concat((entry.Description ?? "내역없음").Split(Path.GetInvalidFileNameChars()));
            safeDescription = safeDescription.Replace(" ", ""); // 공백도 제거해서 깔끔하게

            // 새 파일명 생성 (혹시 모를 중복 방지를 위해 끝에 receipt.Id 번호 추가)
            decimal targetAmount = entry.Expense > 0 ? entry.Expense : entry.Income;
            string newFileName = $"{entry.Date:yyyyMMdd}_{deptName}_{entry.Category}_{targetAmount}원_{safeDescription}_{receipt.Id}{Path.GetExtension(oldPhysicalPath)}";

            string newRelativePath = $"/uploads/receipts/{newFileName}";
            string newPhysicalPath = Path.Combine(Env.WebRootPath, "uploads", "receipts", newFileName);

            try
            {
                // 실제 서버의 하드디스크에서 파일 이름을 변경(이동)합니다.
                File.Move(oldPhysicalPath, newPhysicalPath);

                // DB에 저장될 경로도 새롭고 예쁜 이름으로 업데이트!
                entry.ReceiptUrl = newRelativePath;
                receipt.ImagePath = newRelativePath;
            }
            catch (Exception ex)
            {
                // 권한 문제 등으로 파일명 변경 실패 시 기존 이름 그대로 사용
                Console.WriteLine($"파일명 변경 실패: {ex.Message}");
                entry.ReceiptUrl = oldRelativePath;
            }
        }
        else
        {
            entry.ReceiptUrl = oldRelativePath; // 원본 파일을 못 찾으면 기존 경로 유지
        }
        // ================================================================

        // 1. 해당 모바일 영수증을 '처리완료(IsMatched)'로 변경
        receipt.IsMatched = true;

        DbContext.Transactions.Update(entry);
        DbContext.UploadedReceipts.Update(receipt);
        await DbContext.SaveChangesAsync();

        await JSRuntime.InvokeVoidAsync("alert", "영수증이 장부 내역과 성공적으로 연결되었습니다!");

        await LoadPendingReceipts(); // 목록 새로고침
        await SearchData(); // 검색 목록도 갱신
    }

    private async Task DeleteReceipt(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "이 영수증을 삭제(반려)하시겠습니까?\n서버에서도 파일이 완전히 삭제됩니다.");
        if (confirmed)
        {
            var target = await DbContext.UploadedReceipts.FindAsync(id);
            if (target != null)
            {
                string filePath = Path.Combine(Env.WebRootPath, target.ImagePath.TrimStart('/'));
                if (File.Exists(filePath)) File.Delete(filePath); // 실제 파일 삭제

                DbContext.UploadedReceipts.Remove(target);
                await DbContext.SaveChangesAsync();
                await LoadPendingReceipts();
            }
        }
    }

    private async Task SearchData()
    {
        var query = DbContext.Transactions.AsNoTracking().AsQueryable();
        if (CanViewAll && SearchDeptId > 0)
        {
            query = query.Where(t => t.DepartmentId == SearchDeptId);
        }
        else if (!CanViewAll && CurrentUser != null)
        {
            query = query.Where(t => t.DepartmentId == CurrentUser.DepartmentId);
        }

        if (!string.IsNullOrWhiteSpace(SearchKeyword))
        {
            query = query.Where(t => (t.Description != null && t.Description.Contains(SearchKeyword)) || (!string.IsNullOrEmpty(t.Note) && t.Note.Contains(SearchKeyword)));
        }

        searchResults = await query.OrderByDescending(t => t.Date).Take(100).ToListAsync();
    }

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if (e.Key == "Enter") await SearchData(); }

    private void ShowLargeImage(string url) { currentLargeImageUrl = url; showImageModal = true; }
    private void CloseImageModal() { showImageModal = false; currentLargeImageUrl = ""; }
}