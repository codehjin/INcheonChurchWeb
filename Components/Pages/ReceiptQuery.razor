@page "/receipt-query"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h4 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-receipt me-2"></i>@(CanViewAll ? "전체 부서 영수증 보기" : "모바일 업로드 영수증 관리")
            </h4>
        </div>

        <div class="card-body bg-light p-4">
            @* 🚀 회계담당자(DeptAdmin)에게만 보이는 미처리 영수증 처리 대시보드 *@
            @if (!CanViewAll && pendingReceipts.Any())
            {
                <div class="alert alert-warning shadow-sm border-warning mb-4">
                    <h5 class="fw-bold text-dark mb-3">⚠️ 장부에 미등록된 모바일 영수증이 @pendingReceipts.Count 건 있습니다.</h5>

                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                        @foreach (var receipt in pendingReceipts)
                        {
                            <div class="col">
                                <div class="card h-100 border-warning">
                                    <img src="@receipt.ImagePath" class="card-img-top" alt="영수증 이미지" style="height: 150px; object-fit: cover; cursor: pointer;" @onclick="() => ShowLargeImage(receipt.ImagePath)" />
                                    <div class="card-body p-2">
                                        <div class="small fw-bold text-primary mb-1">@receipt.ReceiptDate.ToString("yyyy-MM-dd")</div>
                                        <div class="text-truncate fw-bold mb-2" title="@receipt.Description">@receipt.Description</div>

                                        @* 장부 등록 폼 *@
                                        <div class="bg-white p-2 border rounded">
                                            <div class="mb-1">
                                                <select class="form-select form-select-sm" @bind="newEntryDict[receipt.Id].Category">
                                                    <option value="">항목 선택</option>
                                                    @foreach (var c in ExpenseCats)
                                                    {
                                                        <option value="@c">@c</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="mb-2">
                                                <input type="number" class="form-control form-control-sm text-end" @bind="newEntryDict[receipt.Id].Expense" placeholder="금액 (원)" />
                                            </div>
                                            <button class="btn btn-sm btn-success w-100 fw-bold" @onclick="() => ProcessReceipt(receipt)">장부 등록 및 처리완료</button>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 p-2 text-end">
                                        <button class="btn btn-sm btn-link text-danger text-decoration-none p-0" @onclick="() => DeleteReceipt(receipt.Id)">❌ 삭제(반려)</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <hr class="my-4 border-2" />
            }

            @if (!CanViewAll && !pendingReceipts.Any())
            {
                <div class="alert alert-success text-center mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i>모든 모바일 영수증이 장부에 등록(처리)되었습니다!
                </div>
            }

            @* 🚀 (기존 기능) 처리 완료된 영수증 및 기존 장부 내역 검색 *@
            <h5 class="fw-bold mb-3 text-secondary">🔍 기존 영수증 내역 검색</h5>
            <div class="row g-2 mb-4 align-items-end">
                @if (CanViewAll)
                {
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">부서 선택</label>
                        <select class="form-select" @bind="SearchDeptId">
                            <option value="0">== 전체 부서 ==</option>
                            @foreach (var d in allDepts)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md-3">
                    <label class="form-label small fw-bold">검색어 (적요/비고)</label>
                    <input type="text" class="form-control" @bind="SearchKeyword" placeholder="예: 식대, 다이소" @onkeyup="HandleKeyUp" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100 fw-bold" @onclick="SearchData"><i class="bi bi-search me-2"></i>검색</button>
                </div>
            </div>

            <div class="table-responsive bg-white rounded shadow-sm border">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            @if (CanViewAll)
                            {
                                <th>부서</th>
                            }
                            <th>날짜</th>
                            <th>구분</th>
                            <th>항목</th>
                            <th class="text-start">적요 (클릭시 영수증)</th>
                            <th class="text-end">금액</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in searchResults)
                        {
                            <tr>
                                @if (CanViewAll)
                                {
                                    <td>@(allDepts.FirstOrDefault(d => d.Id == item.DepartmentId)?.Name ?? "미정")</td>
                                }
                                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge @(item.Type == "Income" ? "bg-primary" : "bg-danger")">@(item.Type == "Income" ? "수입" : "지출")</span></td>
                                <td>@item.Category</td>
                                <td class="text-start">
                                    @* 영수증 이미지가 연동된 항목은 파란색 링크로 표시 *@
                                    @if (!string.IsNullOrEmpty(item.ReceiptUrl))
                                    {
                                        <a href="javascript:void(0)" class="text-decoration-none fw-bold text-primary" @onclick="() => ShowLargeImage(item.ReceiptUrl)">
                                            <i class="bi bi-image me-1"></i>@item.Description
                                        </a>
                                    }
                                    else
                                    {
                                        @item.Description
                                    }
                                </td>
                                <td class="text-end fw-bold">@(item.Type == "Income" ? item.Income.ToString("N0") : item.Expense.ToString("N0"))</td>
                            </tr>
                        }
                        @if (!searchResults.Any())
                        {
                            <tr><td colspan="@(CanViewAll ? 6 : 5)" class="text-muted py-5">검색 결과가 없습니다.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* 🚀 이미지 크게 보기 모달 *@
@if (showImageModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.8);" tabindex="-1" @onclick="CloseImageModal">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation>
            <div class="modal-content bg-transparent border-0">
                <div class="modal-header border-0 justify-content-end p-2">
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImageModal"></button>
                </div>
                <div class="modal-body text-center p-0">
                    <img src="@currentLargeImageUrl" class="img-fluid rounded" style="max-height: 80vh;" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }
    private bool CanViewAll => CurrentUser?.Role == "Admin" || CurrentUser?.Role == "Auditor" || CurrentUser?.Department?.Name == "교육국" || CurrentUser?.Department?.Name == "관리자";

    // 모바일에서 올라온 미처리 영수증 목록
    private List<UploadedReceipt> pendingReceipts = new();

    // 영수증 처리 시 입력할 새 장부 데이터 (ReceiptId를 키로 사용)
    private Dictionary<int, LedgerEntry> newEntryDict = new();
    private readonly string[] ExpenseCats = new[] { "행사비", "공과비", "교육활동비", "겨울성경학교", "여름성경학교", "운영비", "간식비", "부서관리비", "교사회의비", "훈련비", "기타지출" };

    // 검색 관련
    private int SearchDeptId = 0;
    private string SearchKeyword = "";
    private List<Department> allDepts = new();
    private List<LedgerEntry> searchResults = new();

    // 모달 관련
    private bool showImageModal = false;
    private string currentLargeImageUrl = "";

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser == null) return;

        allDepts = await DbContext.Departments.AsNoTracking().OrderBy(d => d.Id).ToListAsync();
        await LoadPendingReceipts();
        await SearchData(); // 초기 진입 시 전체 목록 로드
    }

    private async Task LoadPendingReceipts()
    {
        if (CurrentUser == null || CanViewAll) return; // 감사/관리자는 미처리 영수증 처리 권한 없음

        pendingReceipts = await DbContext.UploadedReceipts
            .Where(r => r.DepartmentId == CurrentUser.DepartmentId && r.IsMatched == false)
            .OrderByDescending(r => r.ReceiptDate)
            .ToListAsync();

        // 각 영수증마다 입력 폼 객체 생성
        newEntryDict.Clear();
        foreach (var r in pendingReceipts)
        {
            newEntryDict[r.Id] = new LedgerEntry
            {
                DepartmentId = r.DepartmentId,
                Date = r.ReceiptDate,
                Description = r.Description,
                Type = "Expense" // 기본적으로 영수증은 지출로 처리
            };
        }
    }

    // 🚀 회계담당자가 영수증 확인 후 장부에 등록하는 메서드
    private async Task ProcessReceipt(UploadedReceipt receipt)
    {
        var entry = newEntryDict[receipt.Id];

        if (string.IsNullOrEmpty(entry.Category) || entry.Expense <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "항목을 선택하고 정확한 금액을 입력해주세요.");
            return;
        }

        // 1. 장부에 내역 추가 (영수증 사진 경로 연결)
        entry.ReceiptUrl = receipt.ImagePath;
        entry.FiscalYear = entry.Date.Year;
        DbContext.Transactions.Add(entry);

        // 2. 해당 모바일 영수증을 '처리완료(IsMatched)'로 변경
        receipt.IsMatched = true;
        DbContext.UploadedReceipts.Update(receipt);

        await DbContext.SaveChangesAsync();
        await JSRuntime.InvokeVoidAsync("alert", "장부 등록이 완료되었습니다!");

        await LoadPendingReceipts(); // 목록 새로고침
        await SearchData(); // 검색 목록도 갱신
    }

    private async Task DeleteReceipt(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "이 영수증을 삭제(반려)하시겠습니까?");
        if (confirmed)
        {
            var target = await DbContext.UploadedReceipts.FindAsync(id);
            if (target != null)
            {
                DbContext.UploadedReceipts.Remove(target);
                await DbContext.SaveChangesAsync();
                await LoadPendingReceipts();
            }
        }
    }

    private async Task SearchData()
    {
        var query = DbContext.Transactions.AsNoTracking().AsQueryable();

        if (CanViewAll && SearchDeptId > 0)
        {
            query = query.Where(t => t.DepartmentId == SearchDeptId);
        }
        else if (!CanViewAll && CurrentUser != null)
        {
            query = query.Where(t => t.DepartmentId == CurrentUser.DepartmentId);
        }

        if (!string.IsNullOrWhiteSpace(SearchKeyword))
        {
            query = query.Where(t => t.Description.Contains(SearchKeyword) || (!string.IsNullOrEmpty(t.Note) && t.Note.Contains(SearchKeyword)));
        }

        searchResults = await query.OrderByDescending(t => t.Date).Take(100).ToListAsync();
    }

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if (e.Key == "Enter") await SearchData(); }

    private void ShowLargeImage(string url) { currentLargeImageUrl = url; showImageModal = true; }
    private void CloseImageModal() { showImageModal = false; currentLargeImageUrl = ""; }
}