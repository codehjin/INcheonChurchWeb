    private void OpenPrintModal() { _showPrintModal = true; _selectedPrintType = "Ledger"; }
    private void ClosePrintModal() { _showPrintModal = false; }

    private async Task ExecutePrintAction()
    {
        try
        {
            _showPrintModal = false;

            // 🚀 핵심 수정: 사용자가 선택한 타입(_selectedPrintType)을 실제 인쇄 모드(_printMode)에 동기화
            _printMode = _selectedPrintType;

            if (_printMode == "Receipt")
            {
                _printTargets = _filtered_entries.Where(t => t.Type == "지출" || t.Type == "Expense").ToList();
                if (!_printTargets.Any())
                {
                    await JSRuntime.AlertAsync("인쇄할 지출 내역(영수증)이 현재 화면에 없습니다.");
                    return;
                }
            }

            // 상태 변경 반영을 위해 미세한 대기 시간 부여
            StateHasChanged();
            await Task.Delay(100);

            var htmlContent = await GeneratePrintHtmlAsync();

            if (string.IsNullOrWhiteSpace(htmlContent))
            {
                await JSRuntime.AlertAsync("인쇄할 내용을 생성하지 못했습니다.");
                return;
            }

            // app.js의 printPopup 호출
            await JSRuntime.InvokeVoidAsync("printPopup", htmlContent);
        }
        catch (Exception ex)
        {
            await JSRuntime.AlertAsync($"인쇄 실행 중 오류가 발생했습니다.\n{ex.Message}");
        }
    }

    private async Task<string> GeneratePrintHtmlAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine("<!DOCTYPE html><html><head><meta charset=\"utf-8\" />");
        sb.AppendLine("<title>인쇄 미리보기</title>");
        sb.AppendLine("<script>var base = document.createElement('base'); base.href = window.opener ? window.opener.location.origin + '/' : '/'; document.head.appendChild(base);</script>");
        sb.AppendLine("<style>");
        // 인쇄 CSS는 Services/LedgerPrintCss.cs 한 곳에 있다. 모바일 인쇄 화면도 같은 값을 쓴다.
        sb.AppendLine(LedgerPrintCss.All);
        sb.AppendLine("</style></head><body>");

        if (_printMode == "Ledger")
            sb.AppendLine(await ReadPrintAreaAsync("인쇄할 장부"));
        else
            sb.AppendLine(await ReadPrintAreaAsync("인쇄할 영수증"));

        sb.AppendLine("</body></html>");
        return sb.ToString();
    }

    // 화면에 숨겨둔 .print-only 블록의 내용을 읽어온다.
    // 장부·영수증이 같은 코드였는데 오류 문구만 달라 두 벌로 나뉘어 있었다.
    private async Task<string> ReadPrintAreaAsync(string label)
        => await JSRuntime.InvokeAsync<string>("readPrintArea", label);

    private async Task SaveNewEntry()
    {
        using var context = DbContextFactory.CreateDbContext();
        if (string.IsNullOrWhiteSpace(_newItem.Description)) { await JSRuntime.AlertAsync("내역을 입력해주세요."); return; }
        if (CurrentUser?.CanViewAll == true && _newItem.DepartmentId == 0) { await JSRuntime.AlertAsync("부서를 선택해주세요."); return; }
        if (string.IsNullOrWhiteSpace(_newItem.Category)) _newItem.Category = "미분류";
        _newItem.SubCategory = string.IsNullOrWhiteSpace(_newSubCategory) ? null : _newSubCategory.Trim();

        _newItem.DepartmentId = CurrentUser?.CanViewAll == true ? _newItem.DepartmentId : (_selectedDepartmentId == 0 ? (CurrentUser?.DepartmentId ?? 0) : _selectedDepartmentId);

        int calculatedYear = _newItem.Date.Year;
        if (_newItem.Date.Month == 11 || _newItem.Date.Month == 12)
        {
            var q4 = await Accounting.GetQuarterDateRangeAsync(_newItem.DepartmentId, _newItem.Date.Year, 4);
            if (_newItem.Date > q4.End) calculatedYear = _newItem.Date.Year + 1;
        }

        _newItem.FiscalYear = await Accounting.CalculateFiscalYearAsync(_newItem.DepartmentId, _newItem.Date);
        _newItem.Quarter = await Accounting.GetQuarterNumberAsync(_newItem.DepartmentId, _newItem.FiscalYear, _newItem.Date);
        _newItem.Note ??= "";
        if (_newItem.Type == "수입") _newItem.Expense = 0; else _newItem.Income = 0;

        context.Transactions.Add(_newItem);
        await context.SaveChangesAsync();
        _isAddingNew = false;
        _newItem = new LedgerEntry { Date = DateTime.Now, Type = "지출", Income = 0, Expense = 0 };
        _newSubCategory = "";
        await LoadData();
    }

    private void StartEdit(LedgerEntry item)
    {
        _editingItemId = item.Id;
        _editBuffer = new LedgerEntry { Id = item.Id, Date = item.Date, Type = item.Type, Category = item.Category, SubCategory = item.SubCategory, Description = item.Description ?? "", Note = item.Note ?? "", Income = item.Income, Expense = item.Expense, DepartmentId = item.DepartmentId, FiscalYear = item.FiscalYear, Quarter = item.Quarter };
        _editSubCategory = item.SubCategory ?? "";
    }

    private void CancelEdit() { _editingItemId = null; _editBuffer = null; }

    private async Task SaveEdit()
    {
        using var context = DbContextFactory.CreateDbContext();
        if (_editBuffer == null) return;
        if (string.IsNullOrWhiteSpace(_editBuffer.Description)) { await JSRuntime.AlertAsync("내역을 입력해주세요."); return; }

        var ex = await context.Transactions.FindAsync(_editBuffer.Id);
        if (ex != null)
        {
            ex.Date = _editBuffer.Date;
            ex.Type = _editBuffer.Type;
            ex.Category = string.IsNullOrWhiteSpace(_editBuffer.Category) ? "미분류" : _editBuffer.Category;
            ex.SubCategory = string.IsNullOrWhiteSpace(_editSubCategory) ? null : _editSubCategory.Trim();
            ex.Description = _editBuffer.Description ?? "";
            ex.Note = _editBuffer.Note ?? "";
            if (ex.Type == "수입") { ex.Expense = 0; ex.Income = _editBuffer.Income; } else { ex.Income = 0; ex.Expense = _editBuffer.Expense; }

            int editYear = _editBuffer.Date.Year;
            if (_editBuffer.Date.Month == 11 || _editBuffer.Date.Month == 12)
            {
                var q4Edit = await Accounting.GetQuarterDateRangeAsync(ex.DepartmentId, _editBuffer.Date.Year, 4);
                if (_editBuffer.Date > q4Edit.End) editYear = _editBuffer.Date.Year + 1;
            }

            ex.FiscalYear = await Accounting.CalculateFiscalYearAsync(ex.DepartmentId, _editBuffer.Date);
            ex.Quarter = await Accounting.GetQuarterNumberAsync(ex.DepartmentId, ex.FiscalYear, _editBuffer.Date);

            await context.SaveChangesAsync();
        }
        _editingItemId = null;
        await LoadData();
    }

