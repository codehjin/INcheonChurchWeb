    private async Task AutoMatchReceipts() 
    { 
        int matchCount = 0;
        var availableReceipts = GetFilteredUnmatchedReceipts().ToList();
        var availableEntries = unmatchedEntriesList.ToList();

        foreach (var r in availableReceipts) 
        { 
            var exactMatches = availableEntries.Where(e => e.Date.Date == r.ReceiptDate.Date && e.Expense == r.Amount).ToList();
            LedgerEntry? targetEntry = null;

            if (exactMatches.Count == 1) 
            { 
                targetEntry = exactMatches.First();
            } 
            else if (exactMatches.Count > 1 && !string.IsNullOrWhiteSpace(r.Description)) 
            { 
                string rDesc = r.Description.Replace(" ", "");
                targetEntry = exactMatches.FirstOrDefault(e => 
                    e.Description != null && 
                    (e.Description.Replace(" ", "").Contains(rDesc) || rDesc.Contains(e.Description.Replace(" ", ""))));
            } 

            if (targetEntry != null)
            {
                var dbEntry = await DbContext.Transactions.FindAsync(targetEntry.Id);
                if (dbEntry != null) {
                    dbEntry.ReceiptPath = r.ImagePath;
                    await DbContext.SaveChangesAsync();
                    matchCount++;
                    availableEntries.Remove(targetEntry); 
                }
            }
        } 

        await JSRuntime.InvokeVoidAsync("alert", $"자동 매칭 완료: 총 {matchCount}건의 영수증이 장부와 연결되었습니다.");
        DbContext.ChangeTracker.Clear();
        await LoadData(); 
        await LoadUnmatchedData(); 
    } 

