    private async Task RemoveReceiptOnly(int entryId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "해당 영수증을 장부에서 분리하시겠습니까?"))
        {
            await Accounting.RemoveReceiptAsync(entryId);
            var entry = await DbContext.Transactions.FindAsync(entryId);
            if (entry != null) { entry.ReceiptUrl = ""; entry.ReceiptPath = ""; await DbContext.SaveChangesAsync(); }
