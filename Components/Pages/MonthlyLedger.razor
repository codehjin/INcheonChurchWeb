@page "/monthly"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@using ClosedXML.Excel
@using System.IO
@using Microsoft.AspNetCore.Hosting
@inject AccountingService Accounting
@inject AppDbContext DbContext
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env
@rendermode InteractiveServer

<style>
    /* =========================================
       1. 화면 전용 스타일 (웹 뷰)
       ========================================= */
    .table-fixed-layout { table-layout: fixed; word-break: break-all; } 
    .table-fixed-layout th, .table-fixed-layout td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } 
    .screen-only { display: block; } 
    .print-only { display: none; }

    /* 📱 모바일(640px 이하)에서 PC 전용 장부 테이블 숨김 */
    @@media (max-width: 640px) {
        .screen-only { display: none !important; }
    }

    /* =========================================
       2. 인쇄(Print) 전용 최적화 스타일
       ========================================= */
    @@media print {
        .sidebar, .top-row, .btn, .no-print, .btn-group, select, .form-select, input, .form-control { display: none !important; } 
        .screen-only { display: none !important; } 
        .print-only { display: block !important; } 
        body, .page, main, .content, .container, .container-fluid { margin: 0 !important; padding: 0 !important; width: 100% !important; max-width: 100% !important; background-color: white !important; overflow: visible !important; } 
        .page-break-before { page-break-before: always !important; } 
        .page-break { page-break-after: always !important; width: 100%; display: block; } 
        .print-only-title { display: block !important; text-align: center !important; margin-bottom: 15px !important; font-size: 18pt !important; font-weight: bold; width: 100%; } 
        table.table { width: 100% !important; border-collapse: collapse !important; margin-bottom: 0 !important; table-layout: fixed !important; font-size: 11pt !important; } 
        table.table th, table.table td { padding: 3px 4px !important; line-height: 1.1 !important; height: auto !important; color: black !important; border: 1px solid #444 !important; vertical-align: middle !important; white-space: nowrap !important; } 
        table.table thead th { background-color: #d3d3d3 !important; color: #000000 !important; font-weight: 900 !important; text-align: center !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; } 
        table.table tfoot td { background-color: #f8f9fa !important; color: black !important; font-weight: bold !important; text-align: right !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; } 
        .money-cell { text-align: right !important; overflow: visible !important; } 
        .clip-cell { overflow: hidden !important; text-overflow: clip !important; } 
        
        .receipt-box { display: flex; flex-direction: column; } 
        .receipt-img-wrapper { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-top: 5px; } 
        .receipt-img-wrapper img { max-width: 100%; max-height: 100%; object-fit: contain; } 
        .receipt-grid-1 .receipt-box { width: 100%; margin-bottom: 20mm; page-break-inside: avoid; height: 85vh; } 
        .receipt-grid-2 { display: flex; flex-wrap: wrap; justify-content: space-between; } 
        .receipt-grid-2 .receipt-box { width: 48%; margin-bottom: 20mm; page-break-inside: avoid; height: 85vh; } 
        .receipt-grid-4 { display: flex; flex-wrap: wrap; justify-content: space-between; } 
        .receipt-grid-4 .receipt-box { width: 48%; height: 43vh; margin-bottom: 15mm; page-break-inside: avoid; } 
    }

    /* 관리 화면용 썸네일 호버 효과 */
    .receipt-thumbnail:hover { transform: translateY(-5px); transition: all 0.2s ease; box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }

    /* =========================================
       📱 모바일 장부 뷰 전용 스타일
       ========================================= */
    .mobile-ledger-view {
        padding-bottom: 0.5rem;
    }

    /* 요약 카드 행 */
    .mobile-summary-row {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
    }

    .mobile-summary-card {
        flex: 1;
        background: #fff;
        border-radius: 12px;
        padding: 10px 8px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border-top: 3px solid transparent;
    }

    .mobile-summary-card.income  { border-top-color: #1565c0; }
    .mobile-summary-card.expense { border-top-color: #c62828; }
    .mobile-summary-card.balance { border-top-color: #2e7d32; }

    .mobile-summary-card .label {
        font-size: 0.68rem;
        color: #888;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .mobile-summary-card.income  .amount { color: #1565c0; }
    .mobile-summary-card.expense .amount { color: #c62828; }
    .mobile-summary-card.balance .amount { color: #2e7d32; }

    .mobile-summary-card .amount {
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    /* 탭 바 */
    .mobile-tab-bar {
        display: flex;
        border-radius: 10px;
        background: #f1f3f5;
        padding: 4px;
        margin-bottom: 10px;
        gap: 4px;
    }

    .mobile-tab-btn {
        flex: 1;
        border: none;
        background: transparent;
        border-radius: 8px;
        padding: 8px 0;
        font-size: 0.82rem;
        font-weight: 700;
        color: #666;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }

    .mobile-tab-btn.active {
        background: #fff;
        color: #1565c0;
        box-shadow: 0 1px 4px rgba(0,0,0,0.12);
    }

    .mobile-tab-btn.expense-active {
        color: #c62828;
    }

    .mobile-tab-count {
        display: inline-block;
        background: #e9ecef;
        border-radius: 20px;
        padding: 0 6px;
        font-size: 0.7rem;
        margin-left: 3px;
        font-weight: 700;
        color: #555;
    }

    /* 항목 리스트 */
    .mobile-entry-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .mobile-empty-msg {
        text-align: center;
        padding: 40px 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* 개별 카드 */
    .mobile-entry-card {
        display: flex;
        align-items: center;
        background: #fff;
        border-radius: 10px;
        padding: 10px 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
        gap: 10px;
    }

    .mobile-entry-left {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        min-width: 38px;
    }

    .mobile-entry-date {
        font-size: 0.72rem;
        color: #888;
        font-weight: 600;
        text-align: center;
    }

    .mobile-rcpt-btn {
        background: #e8f0fe;
        border: none;
        border-radius: 6px;
        color: #1565c0;
        width: 26px;
        height: 22px;
        font-size: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .mobile-entry-center {
        flex: 1;
        min-width: 0;
    }

    .mobile-entry-category {
        font-size: 0.72rem;
        color: #1565c0;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 1px;
    }

    .mobile-entry-desc {
        font-size: 0.82rem;
        font-weight: 600;
        color: #222;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mobile-entry-note {
        font-size: 0.68rem;
        color: #aaa;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mobile-entry-amount {
        font-size: 0.88rem;
        font-weight: 800;
        white-space: nowrap;
        letter-spacing: -0.5px;
    }

    .mobile-entry-amount.income  { color: #1565c0; }
    .mobile-entry-amount.expense { color: #c62828; }
</style>

<div class="container-fluid mt-3 mt-sm-4 px-3 px-sm-4">

    @* ============================================================
       🖥️ PC 전용: 제목 + 엑셀/관리 버튼
       ============================================================ *@
    <div class="d-none d-sm-flex justify-content-between align-items-center mb-4 no-print flex-wrap gap-2">
        <h3 class="fw-bold text-primary mb-0"><i class="bi bi-calendar-check me-2"></i>월별 재정 장부</h3>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (CanEditLedger)
            {
                <button class="btn btn-primary fw-bold px-4 shadow-sm" @onclick="OpenUnmatchedManager"><i class="bi bi-receipt-cutoff me-2"></i> 매치 안된 영수증 관리</button>
            }
            <button class="btn btn-success fw-bold px-4 shadow-sm" @onclick="DownloadExcel"><i class="bi bi-file-earmark-excel me-2"></i> 엑셀 다운로드</button>
        </div>
    </div>

    @* ============================================================
       📱 모바일 전용: 컴팩트 연도/월 컨트롤
       ============================================================ *@
    <div class="d-flex d-sm-none align-items-center justify-content-between mb-3 no-print gap-2">
        @* 연도 선택 *@
        <div class="d-flex align-items-center gap-1">
            <button class="btn btn-outline-secondary btn-sm px-2 py-1" style="font-size:0.75rem;" @onclick="() => ChangeYear(-1)">◀</button>
            <span class="fw-bold" style="font-size:0.9rem; white-space:nowrap;">@(CurrentYear)년</span>
            <button class="btn btn-outline-secondary btn-sm px-2 py-1" style="font-size:0.75rem;" @onclick="() => ChangeYear(1)">▶</button>
        </div>
        @* 월 선택 *@
        <div class="d-flex align-items-center gap-1">
            <button class="btn btn-outline-secondary btn-sm px-2 py-1" style="font-size:0.75rem;" @onclick="() => ChangeMonth(-1)">◀</button>
            <select class="form-select form-select-sm fw-bold text-center" style="font-size:0.8rem; width:auto; min-width:70px;" @onchange="OnMonthChanged" value="@CurrentMonth">
                <option value="0">전체</option>
                @for (int i = 1; i <= 12; i++) { <option value="@i">@i 월</option> }
            </select>
            <button class="btn btn-outline-secondary btn-sm px-2 py-1" style="font-size:0.75rem;" @onclick="() => ChangeMonth(1)">▶</button>
        </div>
        @* 부서(관리자만) *@
        @if (IsAdmin)
        {
            <select class="form-select form-select-sm fw-bold text-primary" style="font-size:0.75rem; width:auto; max-width:90px;" @onchange="OnDeptChanged" value="@SelectedDepartmentId">
                <option value="0">전체</option>
                @foreach (var dept in Departments)
                {
                    @if (dept.Name != "관리자" && dept.Name != "교회학교 운영팀")
                    { <option value="@dept.Id">@dept.Name</option> }
                }
            </select>
        }
    </div>

    @* ============================================================
       🖥️ PC 전용: 기존 4열 필터 카드 (연도/월/분기/부서)
       ============================================================ *@
    <div class="card p-3 mb-4 bg-light shadow-sm border-0 no-print d-none d-sm-block">
        <div class="row g-3 align-items-center text-center">
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">회계연도</label>
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeYear(-1)">◀</button>
                    <span class="fw-bold fs-5">@CurrentYear 년</span>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeYear(1)">▶</button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">월 선택</label>
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeMonth(-1)">◀</button>
                    <select class="form-select form-select-sm w-auto fw-bold text-center" @onchange="OnMonthChanged" value="@CurrentMonth">
                        <option value="0">전체 보기</option>
                        @for (int i = 1; i <= 12; i++) { <option value="@i">@i 월</option> }
                    </select>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeMonth(1)">▶</button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">분기 선택</label>
                <select class="form-select form-select-sm w-auto fw-bold text-center mx-auto" @onchange="OnQuarterChanged" value="@CurrentQuarter">
                    <option value="0">전체 분기</option>
                    <option value="1">1분기 (11~2월)</option>
                    <option value="2">2분기 (3~5월)</option>
                    <option value="3">3분기 (6~8월)</option>
                    <option value="4">4분기 (9~11월)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">부서</label>
                @if (IsAdmin)
                {
                    <select class="form-select fw-bold text-primary border-primary" @onchange="OnDeptChanged" value="@SelectedDepartmentId">
                        <option value="0">부서 전체보기</option>
                        @foreach (var dept in Departments)
                        {
                            @if (dept.Name != "관리자" && dept.Name != "교회학교 운영팀")
                            { <option value="@dept.Id">@dept.Name</option> }
                        }
                    </select>
                }
                else
                {
                    <div class="fw-bold text-primary fs-5">@(CurrentUser?.Department?.Name ?? "로그인 필요")</div>
                }
            </div>
        </div>
    </div>

    <InputFile id="pcUploadInput" OnChange="HandlePcUpload" style="display:none;" accept="image/*,.pdf" /> 

    @* 🚀 편집 도구 토글 및 일괄 기능 영역 (PC 전용) *@
    @if (CanEditLedger)
    {
        <div class="d-none d-sm-flex gap-2 mb-3 no-print">
            <button class="btn @(isAddingNew ? "btn-secondary" : "btn-outline-primary") fw-bold" @onclick="ToggleAddForm">
                <i class="bi @(isAddingNew ? "bi-dash-lg" : "bi-plus-lg") me-1"></i>수동 건별 입력
            </button>
            <button class="btn @(isBatchEditMode ? "btn-secondary" : "btn-outline-success") fw-bold" @onclick="ToggleBatchEditMode">
                <i class="bi bi-pencil-square me-1"></i>일괄 수정/삭제
            </button>
            <button class="btn @(isBatchPrintMode ? "btn-secondary" : "btn-outline-dark") fw-bold" @onclick="ToggleBatchPrintMode">
                <i class="bi bi-check2-square me-1"></i>인쇄 항목 선택 (이미지 제외 기능)
            </button>
        </div>

        @if (isBatchEditMode)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap bg-success bg-opacity-10 p-2 rounded border border-success mb-4 no-print shadow-sm"> 
                <span class="badge bg-success fs-6"><i class="bi bi-check-all"></i> @editSelectedIds.Count 건 일괄선택됨</span> 
                <select class="form-select form-select-sm w-auto fw-bold" @bind="bulkCategory"> 
                    <option value="">-- 일괄 변경할 카테고리 선택 --</option> 
                    <optgroup label="[수입]">@foreach (var c in IncomeCats) { <option value="@c">@c</option> }</optgroup> 
                    <optgroup label="[지출]">@foreach (var c in ExpenseCats) { <option value="@c">@c</option> }</optgroup> 
                </select> 
                <button class="btn btn-success btn-sm fw-bold text-nowrap" @onclick="ApplyBulkEdit" disabled="@(editSelectedIds.Count == 0 || string.IsNullOrEmpty(bulkCategory))"><i class="bi bi-check-lg"></i> 일괄수정 적용</button> 
                <button class="btn btn-danger btn-sm fw-bold text-nowrap ms-auto" @onclick="DeleteSelected" disabled="@(editSelectedIds.Count == 0)"><i class="bi bi-trash-fill"></i> 선택 일괄삭제</button> 
            </div> 
        }

        @* 🚀 추가된 부분: 인쇄 모드 툴바 (빈 영수증 만들기) *@
        @if (isBatchPrintMode)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap bg-dark bg-opacity-10 p-2 rounded border border-dark mb-4 no-print shadow-sm"> 
                <span class="badge bg-dark fs-6"><i class="bi bi-printer-fill"></i> @printSelectedIds.Count 건 인쇄 선택됨</span> 
                
                <button class="btn btn-outline-dark btn-sm fw-bold ms-auto" @onclick="SetPrintWithoutImageForSelected" disabled="@(printSelectedIds.Count == 0)" title="선택한 내역은 인쇄 시 빈칸으로 나옵니다">
                    <i class="bi bi-image-alt"></i> 선택항목 이미지 제외
                </button>
                <button class="btn btn-dark btn-sm fw-bold" @onclick="SetPrintWithoutImageForAll" title="화면의 모든 지출 내역을 빈칸으로 출력합니다">
                    <i class="bi bi-images"></i> 화면 전체 이미지 제외
                </button>
                <button class="btn btn-outline-primary btn-sm fw-bold" @onclick="ClearPrintWithoutImage" disabled="@(printWithoutImageIds.Count == 0)">
                    <i class="bi bi-arrow-counterclockwise"></i> 제외 취소
                </button>
            </div>
        }
    }

    <datalist id="categoryList">@foreach (var cat in UniqueCategories) { <option value="@cat"></option> }</datalist> 
    <datalist id="descriptionList">@foreach (var desc in UniqueDescriptions) { <option value="@desc"></option> }</datalist> 

    @{
        string periodLabel = CurrentMonth > 0 ? $"{CurrentMonth}월" : (CurrentQuarter > 0 ? $"{CurrentQuarter}분기" : "전체"); 
        decimal webRunningBalance = CarryOverAmount; 
        decimal webTotalIncome = 0; 
        decimal webTotalExpense = 0; 
        string currentMonthYearForSeq = ""; 
        int seq = 1; 

        @* ============================================================
           📱 모바일 전용: 수입/지출 탭 뷰 (640px 이하, 인쇄 제외)
           기존 PC 기능은 아래 screen-only 영역에 그대로 유지됩니다.
           ============================================================ *@
        <div class="d-block d-sm-none no-print mobile-ledger-view">
            @{
                var mobileIncome  = FilteredEntries.Where(e => e.Type == "수입").OrderByDescending(e => e.Date).ToList();
                var mobileExpense = FilteredEntries.Where(e => e.Type == "지출").OrderByDescending(e => e.Date).ToList();
                decimal mobileIncomeTotal  = mobileIncome.Sum(e => e.Income);
                decimal mobileExpenseTotal = mobileExpense.Sum(e => e.Expense);
                decimal mobileBalance      = CarryOverAmount + mobileIncomeTotal - mobileExpenseTotal;
            }

            @* 요약 카드 *@
            <div class="mobile-summary-row">
                <div class="mobile-summary-card income">
                    <div class="label">수입</div>
                    <div class="amount">@mobileIncomeTotal.ToString("N0")</div>
                </div>
                <div class="mobile-summary-card expense">
                    <div class="label">지출</div>
                    <div class="amount">@mobileExpenseTotal.ToString("N0")</div>
                </div>
                <div class="mobile-summary-card balance">
                    <div class="label">잔액</div>
                    <div class="amount">@mobileBalance.ToString("N0")</div>
                </div>
            </div>

            @* 탭 버튼 *@
            <div class="mobile-tab-bar">
                <button class="mobile-tab-btn @(mobileLedgerTab == "income" ? "active" : "")"
                        @onclick='() => mobileLedgerTab = "income"'>
                    <i class="bi bi-arrow-down-circle-fill text-primary me-1"></i>
                    수입 <span class="mobile-tab-count">@mobileIncome.Count</span>
                </button>
                <button class="mobile-tab-btn @(mobileLedgerTab == "expense" ? "active expense-active" : "")"
                        @onclick='() => mobileLedgerTab = "expense"'>
                    <i class="bi bi-arrow-up-circle-fill text-danger me-1"></i>
                    지출 <span class="mobile-tab-count">@mobileExpense.Count</span>
                </button>
            </div>

            @* 탭 콘텐츠 *@
            <div class="mobile-entry-list">
                @{
                    var mobileList = mobileLedgerTab == "income" ? mobileIncome : mobileExpense;
                }
                @if (!mobileList.Any())
                {
                    <div class="mobile-empty-msg">
                        <i class="bi bi-inbox fs-3 text-muted"></i>
                        <div class="text-muted mt-2">내역이 없습니다</div>
                    </div>
                }
                @foreach (var item in mobileList)
                {
                    bool hasRcpt = !string.IsNullOrEmpty(item.ReceiptUrl) || !string.IsNullOrEmpty(item.ReceiptPath);
                    string rcptUrl = hasRcpt ? (!string.IsNullOrEmpty(item.ReceiptUrl) ? item.ReceiptUrl : item.ReceiptPath!) + $"?v={DateTime.Now.Ticks}" : "";
                    decimal amt = item.Type == "수입" ? item.Income : item.Expense;
                    <div class="mobile-entry-card">
                        <div class="mobile-entry-left">
                            <div class="mobile-entry-date">@item.Date.ToString("MM/dd")</div>
                            @if (hasRcpt)
                            {
                                <button class="mobile-rcpt-btn" @onclick="() => ShowReceiptImage(rcptUrl)" title="영수증 보기">
                                    <i class="bi bi-receipt"></i>
                                </button>
                            }
                        </div>
                        <div class="mobile-entry-center">
                            <div class="mobile-entry-category">@item.Category</div>
                            <div class="mobile-entry-desc">@item.Description</div>
                            @if (!string.IsNullOrEmpty(item.Note))
                            {
                                <div class="mobile-entry-note">@item.Note</div>
                            }
                        </div>
                        <div class="mobile-entry-amount @(item.Type == "수입" ? "income" : "expense")">
                            @amt.ToString("N0")
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ============================================================
           🖥️ PC 전용: 기존 기능 전체 유지 (641px 이상 + 인쇄)
           ============================================================ *@
        <div class="screen-only no-print">
            @* 🚀 인쇄 도구 모음 (장부 표 바로 위) *@
            <div class="d-none d-sm-flex justify-content-between align-items-end mb-2">
                <div class="fw-bold text-primary fs-5 pt-2"><i class="bi bi-list-columns me-2"></i> @CurrentYear 년 @periodLabel 통합 장부</div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button class="btn btn-secondary fw-bold btn-sm" @onclick="PrintLedger"><i class="bi bi-printer me-1"></i> 장부 인쇄</button>
                    
                    <div class="input-group input-group-sm bg-white border rounded shadow-sm" style="width: auto;">
                        <span class="input-group-text fw-bold border-0 bg-light text-dark"><i class="bi bi-layout-split me-1"></i> 레이아웃</span>
                        <select class="form-select fw-bold border-0" @bind="receiptsPerSheet" style="background-color: #f8f9fa;"> 
                            <option value="1">영수증 1장씩</option> 
                            <option value="2">영수증 2장 좌우</option> 
                            <option value="4">영수증 4장 분할</option> 
                        </select> 
                        <button class="btn btn-outline-dark fw-bold border-top-0 border-bottom-0" @onclick="PrintAllReceipts"><i class="bi bi-images me-1"></i> 전체 영수증 인쇄</button> 
                        <button class="btn btn-dark fw-bold border-0" @onclick="PrintSelectedReceipts" disabled="@(!isBatchPrintMode || printSelectedIds.Count == 0)"><i class="bi bi-check-square me-1"></i> 선택 영수증 인쇄</button> 
                    </div> 
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4"> 
                <div class="table-responsive" style="overflow-y:visible;"> 
                    <table class="table table-hover align-middle mb-0 table-bordered table-fixed-layout"> 
                        <thead class="table-dark text-white text-center align-middle"> 
                            <tr> 
                                @if (CanEditLedger && isBatchEditMode) { <th style="width:4%" class="text-center" title="일괄 수정/삭제 선택">수정<br><input type="checkbox" class="form-check-input" @onchange="ToggleAllEdit" checked="@IsAllEditSelected" /></th> } 
                                @if (CanEditLedger && isBatchPrintMode) { <th style="width:4%" class="text-center" title="영수증 인쇄 선택">인쇄<br><input type="checkbox" class="form-check-input" @onchange="ToggleAllPrint" checked="@IsAllPrintSelected" /></th> } 
                                <th style="width:4%" class="text-center">순번</th> 
                                <th style="width:6%" class="text-center">날짜</th> 
                                <th style="width:6%" class="text-center">구분</th> 
                                <th style="width:9%" class="text-center">분류항목</th> 
                                <th style="width:20%" class="text-center">적요</th> 
                                <th style="width:9%" class="text-center">비고</th> 
                                <th style="width:8%" class="text-center">수입</th> 
                                <th style="width:8%" class="text-center">지출</th> 
                                <th style="width:9%" class="text-center">잔액</th> 
                                @if (CanEditLedger) { 
                                    <th style="width:7%" class="text-center">관리</th>  
                                    <th style="width:11%" class="text-center">영수증 첨부</th> 
                                } 
                            </tr> 
                            <tr class="table-secondary"> 
                                @if (CanEditLedger && isBatchEditMode) { <th></th> } 
                                @if (CanEditLedger && isBatchPrintMode) { <th></th> } 
                                <th></th> 
                                <th></th> 
                                <th> 
                                    <select class="form-select form-select-sm px-1" @bind="filterType" @bind:after="ApplyFilters"> 
                                        <option value="">전체</option><option value="수입">수입</option><option value="지출">지출</option> 
                                     </select> 
                                </th> 
                                <th><input type="text" class="form-control form-control-sm text-center px-1" list="categoryList" placeholder="검색" @bind="filterCategory" @bind:event="oninput" autocomplete="off" /></th> 
                                <th><input type="text" class="form-control form-control-sm text-center px-1" list="descriptionList" placeholder="검색" @bind="filterDesc" @bind:event="oninput" autocomplete="off" /></th> 
                                <th colspan="@(CanEditLedger ? 6 : 4)"></th> 
                            </tr> 
                        </thead> 
                        <tbody> 
                            @if (!FilteredEntries.Any() && !isAddingNew)
                            {
                                <tr><td colspan="13" class="text-center text-muted py-5 fw-bold">조건에 맞는 내역이 없습니다.</td></tr>
                            }
                            else
                            {
                                <tr class="table-warning fw-bold"> 
                                    @if (CanEditLedger && isBatchEditMode) { <td></td> } 
                                    @if (CanEditLedger && isBatchPrintMode) { <td></td> } 
                                    <td></td> 
                                    <td class="text-center">-</td> 
                                    <td class="text-center"><span class="badge bg-warning text-dark">이월</span></td> 
                                    <td class="text-center">@(periodLabel == "전체" ? "전년이월" : "이월금")</td> 
                                    <td class="text-start">@if (IsAdmin && SelectedDepartmentId == 0) { <span class="badge bg-light text-dark border">통합 이월금</span> }</td> 
                                    <td class="text-start"></td> 
                                    <td class="text-end">@CarryOverAmount.ToString("N0")</td> 
                                    <td class="text-end">-</td> 
                                    <td class="text-end table-active text-primary">@CarryOverAmount.ToString("N0")</td> 
                                    @if (CanEditLedger) { <td></td><td></td> } 
                                </tr> 

                                @if (CanEditLedger && isAddingNew)
                                { 
                                    <tr class="table-info border-primary"> 
                                        @if (isBatchEditMode) { <td></td> } 
                                        @if (isBatchPrintMode) { <td></td> } 
                                        <td class="text-center"><span class="badge bg-primary">NEW</span></td> 
                                        <td class="text-center"><input type="date" class="form-control form-control-sm px-1" @bind="newItem.Date" /></td> 
                                        <td class="text-center"> 
                                            <select class="form-select form-select-sm px-1" value="@newItem.Type" @onchange="@(e => { newItem.Type = e.Value?.ToString() ?? ""; newItem.Category = ""; })"> 
                                                <option value="지출">지출</option><option value="수입">수입</option> 
                                            </select> 
                                        </td> 
                                        <td class="text-center"> 
                                            <select class="form-select form-select-sm px-1" @bind="newItem.Category"> 
                                                <option value="">--선택--</option> 
                                                @if (newItem.Type == "수입") { @foreach (var c in IncomeCats) { <option value="@c">@c</option> } }  
                                                else { @foreach (var c in ExpenseCats) { <option value="@c">@c</option> } } 
                                            </select> 
                                        </td> 
                                        <td class="text-start"> 
                                            <input type="text" class="form-control form-control-sm px-1 border-primary" list="descriptionList" placeholder="적요 (필수)" @bind-value="newItem.Description" @bind-value:event="oninput" autocomplete="off" /> 
                                        </td> 
                                        <td class="text-start"><input type="text" class="form-control form-control-sm px-1" placeholder="비고" @bind-value="newItem.Note" @bind-value:event="oninput" /></td> 
                                        <td class="text-end"><input type="number" class="form-control form-control-sm px-1 text-end" @bind="newItem.Income" placeholder="0" disabled="@(newItem.Type == "지출")" /></td> 
                                        <td class="text-end"><input type="number" class="form-control form-control-sm px-1 text-end" @bind="newItem.Expense" placeholder="0" disabled="@(newItem.Type == "수입")" /></td> 
                                        <td class="text-end table-active"></td> 
                                        <td class="text-center" colspan="2"> 
                                            <div class="d-flex gap-1 justify-content-center"> 
                                                <button class="btn btn-success btn-sm py-0 fw-bold" @onclick="SaveNewEntry">[저장]</button> 
                                                <button class="btn btn-secondary btn-sm py-0 fw-bold" @onclick="ToggleAddForm">[취소]</button> 
                                            </div> 
                                        </td> 
                                    </tr> 
                                } 

                                @foreach (var item in FilteredEntries) 
                                { 
                                    string itemMonthYear = item.Date.ToString("yyyy-MM");
                                    if (currentMonthYearForSeq != itemMonthYear) { currentMonthYearForSeq = itemMonthYear; seq = 1; } 

                                    webRunningBalance += (item.Income - item.Expense);
                                    webTotalIncome += item.Income; 
                                    webTotalExpense += item.Expense; 
                                    bool isEditing = editingItemId == item.Id; 
                                    bool hasReceipt = !string.IsNullOrEmpty(item.ReceiptUrl) || !string.IsNullOrEmpty(item.ReceiptPath);
                                    string activeReceiptUrl = hasReceipt ? (!string.IsNullOrEmpty(item.ReceiptUrl) ? item.ReceiptUrl : item.ReceiptPath!) + $"?v={DateTime.Now.Ticks}" : "";
                                    <tr class="@(editSelectedIds.Contains(item.Id) ? "table-success" : "")"> 
                                        @if (CanEditLedger && isBatchEditMode) 
                                        { 
                                            <td class="text-center"><input type="checkbox" class="form-check-input border-success" checked="@editSelectedIds.Contains(item.Id)" @onchange="@(e => ToggleEditSelection(item.Id, e))" /></td> 
                                        } 
                                        @if (CanEditLedger && isBatchPrintMode) 
                                        { 
                                            <td class="text-center align-middle">
                                                @* 🚀 수정됨: 영수증 유무와 관계없이 지출이면 무조건 인쇄 선택 가능 *@
                                                @if (item.Type == "지출") { 
                                                    <input type="checkbox" class="form-check-input border-dark" checked="@printSelectedIds.Contains(item.Id)" @onchange="@(e => TogglePrintSelection(item.Id, e))" /> 
                                                    @if (printWithoutImageIds.Contains(item.Id))
                                                    {
                                                        <div class="badge bg-secondary mt-1 d-block mx-auto" style="font-size:0.65rem; width: fit-content;">이미지 제외</div>
                                                    }
                                                }
                                            </td> 
                                        }

                                        @if (CanEditLedger && isEditing && editBuffer != null) 
                                        { 
                                            <td class="text-center fw-bold text-muted">@seq</td> 
                                            <td class="text-center"><input type="date" class="form-control form-control-sm px-1" @bind="editBuffer.Date" /></td> 
                                            <td class="text-center"> 
                                                <select class="form-select form-select-sm px-1" value="@editBuffer.Type" @onchange="@(e => { editBuffer.Type = e.Value?.ToString() ?? ""; editBuffer.Category = ""; })"> 
                                                    <option value="지출">지출</option><option value="수입">수입</option> 
                                                </select> 
                                            </td> 
                                            <td class="text-center"> 
                                                <select class="form-select form-select-sm px-1" @bind="editBuffer.Category"> 
                                                    <option value="">--선택--</option> 
                                                    @if (editBuffer.Type == "수입") { @foreach (var c in IncomeCats) { <option value="@c">@c</option> } }  
                                                    else { @foreach (var c in ExpenseCats) { <option value="@c">@c</option> } } 
                                                </select> 
                                            </td> 
                                            <td class="text-start"><input type="text" class="form-control form-control-sm px-1" list="descriptionList" @bind-value="editBuffer.Description" @bind-value:event="oninput" autocomplete="off" /></td> 
                                            <td class="text-start"><input type="text" class="form-control form-control-sm px-1" @bind-value="editBuffer.Note" @bind-value:event="oninput" /></td> 
                                            <td class="text-end"><input type="number" class="form-control form-control-sm px-1 text-end" @bind="editBuffer.Income" disabled="@(editBuffer.Type == "지출")" /></td> 
                                            <td class="text-end"><input type="number" class="form-control form-control-sm px-1 text-end" @bind="editBuffer.Expense" disabled="@(editBuffer.Type == "수입")" /></td> 
                                            <td class="text-end table-active fw-bold">@webRunningBalance.ToString("N0")</td> 
                                            <td class="text-center" colspan="2"> 
                                                <div class="d-flex gap-1 justify-content-center"> 
                                                    <button class="btn btn-success btn-sm py-0 fw-bold" @onclick="SaveEdit">[저장]</button> 
                                                    <button class="btn btn-secondary btn-sm py-0 fw-bold" @onclick="CancelEdit">[취소]</button> 
                                                </div> 
                                            </td> 
                                        } 
                                        else 
                                        { 
                                            <td class="text-center fw-bold text-muted">@seq</td> 
                                            <td class="text-center">@item.Date.ToString("MM-dd")</td> 
                                            <td class="text-center"> 
                                                @if (item.Type == "수입") { <span class="badge bg-primary bg-opacity-10 text-primary">수입</span> } 
                                                else { <span class="badge bg-danger bg-opacity-10 text-danger">지출</span> } 
                                            </td> 
                                            <td class="text-center fw-bold" title="@item.Category">@item.Category</td> 
                                            <td class="text-start" title="@item.Description"> 
                                                @if (hasReceipt) 
                                                { 
                                                    <a href="javascript:void(0)" class="text-decoration-none fw-bold text-primary me-1" @onclick="() => ShowReceiptImage(activeReceiptUrl)" title="영수증 보기"><i class="bi bi-receipt"></i></a> 
                                                } 
                                                @item.Description 
                                                @if (IsAdmin && SelectedDepartmentId == 0) { <span class="badge bg-light text-dark border ms-2">@(item.DepartmentInfo?.Name)</span> } 
                                            </td> 
                                            <td class="text-start small text-muted" title="@item.Note">@item.Note</td> 
                                            <td class="text-end text-primary">@((item.Income > 0) ? item.Income.ToString("N0") : "")</td> 
                                            <td class="text-end text-danger">@((item.Expense > 0) ? item.Expense.ToString("N0") : "")</td> 
                                            <td class="text-end table-active fw-bold">@webRunningBalance.ToString("N0")</td> 
                                            @if (CanEditLedger) 
                                            { 
                                                <td class="text-center"> 
                                                    <div class="d-flex gap-1 justify-content-center"> 
                                                        <button class="btn btn-sm btn-outline-primary py-0 px-1 fw-bold" @onclick="() => StartEdit(item)">[수정]</button> 
                                                        <button class="btn btn-sm btn-outline-danger py-0 px-1 fw-bold" @onclick="() => DeleteSingle(item.Id)">[삭제]</button> 
                                                    </div> 
                                                </td> 
                                                <td class="text-center"> 
                                                    @if (item.Type == "지출")
                                                    {
                                                        @if (hasReceipt) 
                                                        { 
                                                            <div class="d-flex gap-1 justify-content-center"> 
                                                                <button class="btn btn-sm btn-primary py-0 px-2 fw-bold" @onclick="() => ShowReceiptImage(activeReceiptUrl)">보기</button> 
                                                                <button class="btn btn-sm btn-danger py-0 px-2 fw-bold" @onclick="() => RemoveReceiptOnly(item.Id)">분리</button> 
                                                            </div> 
                                                        } 
                                                        else 
                                                        { 
                                                            <div class="d-flex gap-1 justify-content-center"> 
                                                                <button class="btn btn-sm btn-outline-primary py-0 px-1 fw-bold" @onclick="() => AttachSingleFromUnmatched(item.Id)" title="서버 영수증 붙이기">서버영수증</button> 
                                                                <button class="btn btn-sm btn-outline-success py-0 px-1 fw-bold" @onclick="() => TriggerPcUpload(item.Id)" title="내 PC 사진">PC업로드</button> 
                                                            </div>
                                                        }
                                                    }
                                                    else { <span class="text-muted small">-</span> }
                                                </td> 
                                            } 
                                        } 
                                    </tr> 
                                    seq++; 
                                } 
                            }
                        </tbody> 
                        <tfoot class="table-light fw-bold border-top"> 
                            <tr style="font-size: 1.1em;"> 
                                @if (CanEditLedger && isBatchEditMode) { <td></td> } 
                                @if (CanEditLedger && isBatchPrintMode) { <td></td> } 
                                <td></td> 
                                <td colspan="5" class="text-end">@CurrentYear 년 @periodLabel 총계 (누계 잔액)</td> 
                                <td class="text-end text-primary">@webTotalIncome.ToString("N0")</td> 
                                <td class="text-end text-danger">@webTotalExpense.ToString("N0")</td> 
                                <td class="text-end text-primary">@webRunningBalance.ToString("N0")</td> 
                                @if (CanEditLedger) { <td></td><td></td> } 
                            </tr> 
                        </tfoot> 
                    </table> 
                </div> 
            </div> 
        </div> 

        @* =======================================================
           🚀 인쇄 전용 영역
           ======================================================= *@
        <div class="print-only"> 
            @if (printMode == "Ledger") 
            { 
                var groupedByMonthYear = FilteredEntries.GroupBy(e => e.Date.ToString("yyyy-MM")).OrderBy(g => g.Key).ToList();
                bool isFirstGroup = true; 

                foreach (var monthGroup in groupedByMonthYear) 
                { 
                    var parts = monthGroup.Key.Split('-');
                    int groupYear = int.Parse(parts[0]); 
                    int groupMonth = int.Parse(parts[1]); 

                    decimal previousTotalIncome = Entries.Where(x => x.Date < new DateTime(groupYear, groupMonth, 1)).Sum(x => x.Income);
                    decimal previousTotalExpense = Entries.Where(x => x.Date < new DateTime(groupYear, groupMonth, 1)).Sum(x => x.Expense);
                    decimal startingBalanceForMonth = CarryOverAmount + previousTotalIncome - previousTotalExpense; 

                    decimal runningBalance = startingBalanceForMonth; 
                    decimal currentMonthIncome = 0; 
                    decimal currentMonthExpense = 0;
                    string pageBreakClass = isFirstGroup ? "" : "page-break-before mt-5"; 
                    isFirstGroup = false;
                    <div class="@pageBreakClass"> 
                        <div class="print-only-title"> 
                            @{ string printDeptName = SelectedDepartmentId == 0 ? "전체 부서 통합" : Departments.FirstOrDefault(d => d.Id == SelectedDepartmentId)?.Name ?? ""; } 
                            [ @groupYear 년 @(groupMonth)월 @printDeptName 재정 장부 ] 
                        </div> 

                        <table class="table table-bordered table-fixed-layout mb-0"> 
                            <thead> 
                                <tr> 
                                    <th style="width: 6%;" class="text-center">순번</th> 
                                    <th style="width: 7%;" class="text-center">날짜</th> 
                                    <th style="width: 6%;" class="text-center">구분</th> 
                                    <th style="width: 12%;" class="text-center">분류항목</th> 
                                    <th style="width: 24%;" class="text-center">적요</th> 
                                    <th style="width: 9%;" class="text-center">비고</th> 
                                    <th style="width: 12%;" class="text-center">수입</th> 
                                    <th style="width: 12%;" class="text-center">지출</th> 
                                    <th style="width: 12%;" class="text-center">잔액</th> 
                                </tr> 
                            </thead> 
                            <tbody> 
                                <tr> 
                                    <td class="text-center"></td> 
                                    <td class="text-center">-</td> 
                                    <td class="text-center">이월</td> 
                                    <td class="text-center">전월이월</td> 
                                    <td class="text-center">@if (IsAdmin && SelectedDepartmentId == 0) { <span>통합 이월금</span> }</td> 
                                    <td class="text-center"></td> 
                                    <td class="text-end money-cell">@startingBalanceForMonth.ToString("N0")</td> 
                                    <td class="text-end money-cell">-</td> 
                                    <td class="text-end money-cell">@startingBalanceForMonth.ToString("N0")</td> 
                                </tr> 

                                @{ int printSeq = 1; } 
                                @foreach (var item in monthGroup) 
                                { 
                                    runningBalance += (item.Income - item.Expense); 
                                    currentMonthIncome += item.Income; 
                                    currentMonthExpense += item.Expense;
                                    <tr> 
                                        <td class="text-center clip-cell text-muted fw-bold">@printSeq</td> 
                                        <td class="text-center clip-cell">@item.Date.ToString("MM-dd")</td> 
                                        <td class="text-center clip-cell">@item.Type</td> 
                                        <td class="text-center clip-cell" style="@((item.Category ?? "").Length > 5 ? "font-size:9pt !important; letter-spacing:-0.5px !important;" : "")">@item.Category</td> 
                                        <td class="text-center clip-cell"> 
                                            @{ string descText = item.Description ?? ""; if (descText.Length > 10) descText = descText.Substring(0, 10); } 
                                            @descText @if (IsAdmin && SelectedDepartmentId == 0) { <span> [@(item.DepartmentInfo?.Name)]</span> } 
                                        </td> 
                                        <td class="text-center clip-cell" style="@((item.Note ?? "").Length > 5 ? "font-size:8pt !important; letter-spacing:-0.5px !important;" : "")"> 
                                            @{ string noteText = item.Note ?? ""; if (noteText.Length > 6) noteText = noteText.Substring(0, 6); } @noteText 
                                        </td> 
                                        <td class="text-end money-cell">@((item.Income > 0) ? item.Income.ToString("N0") : "")</td> 
                                        <td class="text-end money-cell">@((item.Expense > 0) ? item.Expense.ToString("N0") : "")</td> 
                                        <td class="text-end money-cell">@runningBalance.ToString("N0")</td> 
                                    </tr> 
                                    printSeq++;
                                } 
                            </tbody> 
                            <tfoot> 
                                <tr> 
                                    <td colspan="6" class="text-end">@groupYear 년 @(groupMonth)월 계 (누계 잔액)</td> 
                                    <td class="text-end money-cell">@currentMonthIncome.ToString("N0")</td> 
                                    <td class="text-end money-cell">@currentMonthExpense.ToString("N0")</td> 
                                    <td class="text-end money-cell">@runningBalance.ToString("N0")</td> 
                                </tr> 
                            </tfoot> 
                        </table> 
                    </div> 
                } 
            } 
            else if (printMode == "Receipt") 
            { 
                int count = 0;
                <div class="receipt-grid-@receiptsPerSheet"> 
                    @foreach (var item in printTargets) 
                    { 
                        <div class="receipt-box"> 
                            @{ 
                                string itemMonthYear = item.Date.ToString("yyyy-MM");
                                int seqInMonth = FilteredEntries.Where(x => x.Date.ToString("yyyy-MM") == itemMonthYear).ToList().IndexOf(item) + 1; 
                                string desc = item.Description ?? "";
                                if (desc.Length > 15) desc = desc.Substring(0, 15) + "...";
                            } 
                            <div class="text-start fw-bold" style="font-size: 14pt; line-height: 1.2;">No.@(item.Date.Month)월-@seqInMonth</div> 
                            <div class="d-flex justify-content-between align-items-end fw-bold" style="font-size: 10pt; border-bottom: 2px solid #000; padding-bottom: 4px; margin-bottom: 10px;"> 
                                <span style="white-space: nowrap;">@item.Date.ToString("yyyy-MM-dd")</span> 
                                <span class="text-end" style="width: 65%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@desc</span> 
                            </div> 
                            
                            @* 🚀 수정됨: 사용자가 이미지 제외를 선택하지 않았고, 실제 영수증 사진이 있는 경우에만 이미지를 그립니다. *@
                            <div class="receipt-img-wrapper">
                                @if (!printWithoutImageIds.Contains(item.Id) && (!string.IsNullOrEmpty(item.ReceiptUrl) || !string.IsNullOrEmpty(item.ReceiptPath)))
                                {
                                    <img src="@(!string.IsNullOrEmpty(item.ReceiptUrl) ? item.ReceiptUrl : item.ReceiptPath)" />
                                }
                            </div> 
                        </div> 
                        count++;
                        if (receiptsPerSheet == 1 || (receiptsPerSheet == 2 && count % 2 == 0) || (receiptsPerSheet == 4 && count % 4 == 0)) 
                        { <div class="page-break"></div> } 
                    } 
                </div> 
            } 
        </div> 
    } 
</div> 

@* 🚀 이미지 크게 보기 모달 *@
@if (showImageModal) 
{ 
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.8); z-index: 1050;" tabindex="-1" @onclick="CloseImageModal"> 
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation> 
            <div class="modal-content bg-transparent border-0"> 
                <div class="modal-header border-0 justify-content-end p-2"> 
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImageModal"></button> 
                </div> 
                <div class="modal-body text-center p-0"> 
                    <img src="@currentLargeImageUrl" class="img-fluid rounded" style="max-height: 80vh;" /> 
                </div> 
            </div> 
        </div> 
    </div> 
} 

@* 🚀 [풀스크린] 매치 안된 영수증 관리 (Split View) *@
@if (showUnmatchedManager) 
{ 
    <div class="modal fade show d-block" style="background-color: #f4f6f9; z-index: 1055; overflow-y: auto;" tabindex="-1"> 
        <div class="container-fluid py-4 h-100 d-flex flex-column"> 
            
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3"> 
                <h3 class="fw-bold text-primary mb-0"><i class="bi bi-receipt-cutoff me-2"></i>매치 안된 영수증 관리</h3> 
                <div class="d-flex gap-2"> 
                    <button class="btn btn-primary fw-bold px-4" @onclick="AutoMatchReceipts"><i class="bi bi-magic me-1"></i> 금액/날짜 자동 매치 (추천)</button> 
                    <button class="btn btn-secondary fw-bold px-4" @onclick="CloseUnmatchedManager"><i class="bi bi-arrow-return-left me-1"></i> 장부로 돌아가기</button> 
                </div> 
            </div> 

            <div class="row flex-grow-1"> 
                @* 1. 썸네일 스트립 (상단) *@
                <div class="col-12 mb-4"> 
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-1-circle-fill text-primary me-1"></i> 매치할 영수증 선택 (@(GetFilteredUnmatchedReceipts().Count)건 대기중)</h5> 
                        
                        <div class="d-flex align-items-center gap-3 bg-white p-2 rounded shadow-sm border">
                            <div class="d-flex align-items-center gap-2 border-end pe-3">
                                <span class="small fw-bold text-secondary">월별 보기:</span>
                                <select class="form-select form-select-sm fw-bold border-primary" style="width: 90px;" @bind="unmatchedFilterMonth">
                                    <option value="0">전체</option>
                                    @for (int i = 1; i <= 12; i++) { <option value="@i">@i 월</option> }
                                </select>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <input type="checkbox" class="form-check-input border-secondary" id="chkAll" checked="@IsAllUnmatchedSelected" @onchange="ToggleAllUnmatchedSelection" />
                                <label class="form-check-label small fw-bold text-secondary" for="chkAll">전체선택</label>
                                <button class="btn btn-sm btn-danger fw-bold ms-2" @onclick="DeleteSelectedUnmatchedReceipts" disabled="@(selectedUnmatchedReceiptIds.Count == 0)">
                                    <i class="bi bi-trash-fill"></i> 선택 삭제 (@selectedUnmatchedReceiptIds.Count)
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    @if (unmatchedReceiptsList == null) 
                    { <div class="spinner-border text-primary"></div> } 
                    else if (!GetFilteredUnmatchedReceipts().Any()) 
                    { <div class="p-4 bg-white rounded shadow-sm text-muted text-center fw-bold border">매칭 대기 중인 모바일 영수증이 없습니다.</div> } 
                    else 
                    {
                        <div class="d-flex gap-3 overflow-auto py-2 px-1" style="white-space: nowrap;"> 
                            @foreach (var r in GetFilteredUnmatchedReceipts()) 
                            { 
                                <div class="card shadow-sm receipt-thumbnail @(activeUnmatchedReceipt?.Id == r.Id ? "border-primary border-3" : "border-0")" style="width: 140px; flex: 0 0 auto; cursor:pointer; position:relative;" @onclick="() => SelectUnmatchedReceipt(r)"> 
                                    <input type="checkbox" class="form-check-input position-absolute" style="top: 8px; left: 8px; transform: scale(1.3); z-index: 10;" checked="@selectedUnmatchedReceiptIds.Contains(r.Id)" @onclick:stopPropagation="true" @onchange="@(e => ToggleUnmatchedSelection(r.Id, e))" />
                                    <div style="height: 140px; background-color: #fff;" class="border-bottom p-1 text-center d-flex align-items-center justify-content-center"> 
                                        <img src="@r.ImagePath" style="max-width: 100%; max-height: 100%; object-fit: contain;" /> 
                                    </div> 
                                    <div class="card-body p-2 text-center bg-light"> 
                                        <div class="small fw-bold text-dark">@r.ReceiptDate.ToString("MM-dd")</div> 
                                        <div class="small text-danger fw-bold">@r.Amount.ToString("N0")원</div> 
                                    </div> 
                                </div> 
                            } 
                        </div> 
                    }
                </div> 

                @* 2. Split View (선택된 영수증 vs 장부 내역) *@
                @if (activeUnmatchedReceipt != null) 
                { 
                    <div class="col-lg-5 col-md-6 mb-4"> 
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-2-circle-fill text-primary me-1"></i> 영수증 크게 보기</h5> 
                        <div class="card shadow-sm border-primary"> 
                            <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between fs-5"> 
                                <span><i class="bi bi-calendar-event me-1"></i> @activeUnmatchedReceipt.ReceiptDate.ToString("yyyy-MM-dd")</span> 
                                <span><i class="bi bi-cash-coin me-1"></i> @activeUnmatchedReceipt.Amount.ToString("N0")원</span> 
                            </div> 
                            <div class="card-body text-center bg-white p-2"> 
                                <img src="@activeUnmatchedReceipt.ImagePath" class="img-fluid rounded" style="max-height: 50vh; object-fit: contain;" /> 
                                <div class="mt-3 p-2 bg-light rounded border fw-bold text-dark fs-5">적요: @(activeUnmatchedReceipt.Description ?? "없음")</div> 
                            </div> 
                        </div> 
                    </div> 

                    <div class="col-lg-7 col-md-6"> 
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-3-circle-fill text-primary me-1"></i> 매치할 장부 내역 (영수증 없는 지출)</h5> 
                        <div class="table-responsive bg-white rounded shadow-sm border" style="max-height: 65vh;"> 
                            <table class="table table-hover align-middle mb-0"> 
                                <thead class="table-light sticky-top"> 
                                    <tr> 
                                        <th class="text-center">날짜</th> 
                                        <th class="text-center">분류</th> 
                                        <th>적요</th> 
                                        <th class="text-end">지출 금액</th> 
                                        <th class="text-center">수동 매치</th> 
                                    </tr> 
                                </thead> 
                                <tbody> 
                                    @foreach (var entry in unmatchedEntriesList) 
                                    { 
                                        bool isSuggested = entry.Date.Date == activeUnmatchedReceipt.ReceiptDate.Date || entry.Expense == activeUnmatchedReceipt.Amount; 
                                        <tr class="@(isSuggested ? "table-warning" : "")"> 
                                            <td class="text-center fw-bold">@entry.Date.ToString("MM-dd")</td> 
                                            <td class="text-center">@entry.Category</td> 
                                            <td>@entry.Description</td> 
                                            <td class="text-end text-danger fw-bold fs-6">@entry.Expense.ToString("N0")</td> 
                                            <td class="text-center"> 
                                                <button class="btn btn-sm btn-primary fw-bold" @onclick="() => AttachServerReceiptToEntry(activeUnmatchedReceipt.ImagePath, entry.Id)">이곳에 붙이기</button> 
                                            </td> 
                                        </tr> 
                                    } 
                                    @if (!unmatchedEntriesList.Any()) 
                                    { 
                                        <tr><td colspan="5" class="text-center py-5 text-muted fw-bold">영수증을 첨부할 빈 지출 내역이 없습니다.<br/>먼저 월별장부에서 내역을 작성해주세요.</td></tr> 
                                    } 
                                </tbody> 
                            </table> 
                        </div> 
                    </div> 
                } 
            </div> 
        </div> 
    </div> 
}

<script>
    window.downloadExcelFile = (fileName, base64String) => { 
        const link = document.createElement('a'); link.download = fileName; link.href = `data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,${base64String}`; 
        document.body.appendChild(link); link.click(); document.body.removeChild(link); 
    }; 
    window.triggerFileInput = (id) => document.getElementById(id).click();
</script> 

@code {
    [CascadingParameter] public User? CurrentUser { get; set; } 

    private int CurrentYear = DateTime.Now.Year; 
    private int CurrentMonth = DateTime.Now.Month; 
    private int CurrentQuarter = 0;
    private int SelectedDepartmentId = 0; 
    
   private bool IsAdmin = false;
    private bool IsSubAccount = false;
    private bool IsDirectorOrAuditor = false;
    
    // 🚀 관리자(Admin) 계정도 수정 권한에서 제외 (오직 부서 메인회계 담당자만 수정/삭제 가능)
    private bool CanEditLedger => !IsAdmin && !IsSubAccount && !IsDirectorOrAuditor;

    private List<Department> Departments = new(); 
    private List<LedgerEntry> Entries = new();
    private List<LedgerEntry> FilteredEntries = new(); 
    private decimal CarryOverAmount = 0; 

    private List<string> IncomeCats = new(); 
    private List<string> ExpenseCats = new();
    private List<string> UniqueDescriptions = new(); 
    private List<string> UniqueCategories = new(); 
    
    private string filterType = ""; 
    private string _filterCategory = "";
    private string filterCategory { get => _filterCategory; set { _filterCategory = value; ApplyFilters(); } } 
    private string _filterDesc = ""; 
    private string filterDesc { get => _filterDesc; set { _filterDesc = value; ApplyFilters(); } } 

    // 💡 모드 토글 변수
    private bool isBatchEditMode = false;
    private bool isBatchPrintMode = false;

    private HashSet<int> editSelectedIds = new(); 
    private HashSet<int> printSelectedIds = new();
    
    // 🚀 수정된 부분: 인쇄시 이미지 제외할 항목을 기억하는 변수
    private HashSet<int> printWithoutImageIds = new();

    private bool IsAllEditSelected => FilteredEntries.Any() && editSelectedIds.Count == FilteredEntries.Count; 
    private bool IsAllPrintSelected => FilteredEntries.Any(t => t.Type == "지출") &&  printSelectedIds.Count == FilteredEntries.Count(t => t.Type == "지출");
    private string bulkCategory = ""; 

    private bool isAddingNew = false;
    private LedgerEntry newItem = new LedgerEntry { Date = DateTime.Now, Type = "지출", Income = 0, Expense = 0 };
    private int? editingItemId = null; 
    private LedgerEntry? editBuffer = null;

    // 📱 모바일 전용: 수입/지출 탭 상태
    private string mobileLedgerTab = "expense";
    
    private bool showImageModal = false; 
    private string currentLargeImageUrl = "";
    private string printMode = "Ledger"; 
    private int receiptsPerSheet = 2; 
    private List<LedgerEntry> printTargets = new(); 
    private int targetUploadEntryId = 0;
    
    // 💡 영수증 통합 관리 모달 변수
    private bool showUnmatchedManager = false; 
    private List<UploadedReceipt>? unmatchedReceiptsList = null;
    private List<LedgerEntry> unmatchedEntriesList = new(); 
    private UploadedReceipt? activeUnmatchedReceipt = null;
    
    private HashSet<int> selectedUnmatchedReceiptIds = new();
    private int _unmatchedFilterMonth = 0;
    private int unmatchedFilterMonth 
    { 
        get => _unmatchedFilterMonth;
        set 
        { 
            _unmatchedFilterMonth = value;
            selectedUnmatchedReceiptIds.Clear(); 
            activeUnmatchedReceipt = GetFilteredUnmatchedReceipts().FirstOrDefault(); 
        } 
    }
    private bool IsAllUnmatchedSelected => GetFilteredUnmatchedReceipts().Any() && selectedUnmatchedReceiptIds.Count == GetFilteredUnmatchedReceipts().Count;
    
    protected override async Task OnInitializedAsync() 
    { 
        Departments = await Accounting.GetDepartmentsAsync();
        if (CurrentUser != null && CurrentUser.Department != null) 
        { 
            IsSubAccount = CurrentUser.Role == "SubAccount" || CurrentUser.Role == "보조회계";
            IsDirectorOrAuditor = CurrentUser.Role == "Auditor" || CurrentUser.Role == "Director" || CurrentUser.Department.Name == "교육국";
            if (CurrentUser.Role == "Admin" || CurrentUser.Department.Name == "관리자" || IsDirectorOrAuditor) 
            { IsAdmin = true; SelectedDepartmentId = 0; } 
            else 
            { IsAdmin = false; SelectedDepartmentId = CurrentUser.DepartmentId; } 
            await LoadData();
        } 
    } 

    private async Task OnDeptChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int deptId)) { SelectedDepartmentId = deptId; await LoadData(); } } 
    private async Task ChangeYear(int value) { CurrentYear += value; await LoadData(); } 
    private async Task ChangeMonth(int value) { CurrentMonth += value; if (CurrentMonth > 12) { CurrentMonth = 1; CurrentYear++; } else if (CurrentMonth < 1) { CurrentMonth = 12; CurrentYear--; } CurrentQuarter = 0; await LoadData(); } 
    private async Task OnMonthChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int m)) { CurrentMonth = m; CurrentQuarter = 0; await LoadData(); } } 
    private async Task OnQuarterChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int q)) { CurrentQuarter = q; CurrentMonth = 0; await LoadData(); } } 

    private async Task LoadData() 
    { 
        var query = DbContext.Transactions.Include(t => t.DepartmentInfo).AsNoTracking().Where(t => t.FiscalYear == CurrentYear);
        if (SelectedDepartmentId != 0) query = query.Where(t => t.DepartmentId == SelectedDepartmentId); 

        var allYearData = await query.OrderBy(t => t.Date).ToListAsync();
        var budgetQuery = DbContext.BudgetPlans.AsNoTracking().Where(b => b.Year == CurrentYear); 
        if (SelectedDepartmentId != 0) budgetQuery = budgetQuery.Where(b => b.DepartmentId == SelectedDepartmentId);
        var budgetPlans = await budgetQuery.ToListAsync(); 

        IncomeCats = budgetPlans.Where(b => b.Type == "Income" || b.Type == "수입").Select(b => b.Category).Distinct().ToList();
        ExpenseCats = budgetPlans.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();
        if (!IncomeCats.Any()) IncomeCats = new List<string> { "주일헌금", "찬조금", "이월금", "교회보조금", "기타수입" };
        if (!ExpenseCats.Any()) ExpenseCats = new List<string> { "행사비", "운영비", "부서관리비", "기타지출" }; 

        decimal baseCarryOver = budgetPlans.FirstOrDefault(b => b.Category.Contains("이월"))?.Amount ?? 0;
        
        // =========================================================
        // 🚀 수정됨: 1~4분기 날짜를 불러와 이월금과 필터링을 정확하게 연동
        // =========================================================
        int queryDeptId = SelectedDepartmentId == 0 ? (CurrentUser?.DepartmentId ?? 0) : SelectedDepartmentId;
        var q1 = await Accounting.GetQuarterDateRangeAsync(queryDeptId, CurrentYear, 1);
        var q2 = await Accounting.GetQuarterDateRangeAsync(queryDeptId, CurrentYear, 2);
        var q3 = await Accounting.GetQuarterDateRangeAsync(queryDeptId, CurrentYear, 3);
        var q4 = await Accounting.GetQuarterDateRangeAsync(queryDeptId, CurrentYear, 4);

        var prevData = new List<LedgerEntry>();
        IEnumerable<LedgerEntry> filteredQuery = allYearData;

        if (CurrentMonth > 0) 
        {
            // 💡 11, 12월은 이전 연도에 귀속 (예: 2026 회계연도의 11월 = 2025년 11월)
            int mYear = (CurrentMonth == 11 || CurrentMonth == 12) ? CurrentYear - 1 : CurrentYear;
            DateTime monthStart = new DateTime(mYear, CurrentMonth, 1);
            DateTime monthEnd = new DateTime(mYear, CurrentMonth, DateTime.DaysInMonth(mYear, CurrentMonth));
            
            // 11월의 경우 설정된 시작일(4째주 월)과 종료일(3째주 주일)을 정확히 반영
            if (CurrentMonth == 11 && mYear == CurrentYear - 1) monthStart = q1.Start.Date;
            if (CurrentMonth == 11 && mYear == CurrentYear) monthEnd = q4.End.Date;

            filteredQuery = allYearData.Where(t => t.Date.Date >= monthStart && t.Date.Date <= monthEnd);
            prevData = allYearData.Where(x => x.Date.Date < monthStart).ToList();
        }
        else if (CurrentQuarter > 0) 
        { 
            DateTime qStart = CurrentQuarter switch { 1 => q1.Start, 2 => q2.Start, 3 => q3.Start, 4 => q4.Start, _ => q1.Start };
            DateTime qEnd = CurrentQuarter switch { 1 => q1.End, 2 => q2.End, 3 => q3.End, 4 => q4.End, _ => q4.End };

            filteredQuery = allYearData.Where(t => t.Date.Date >= qStart.Date && t.Date.Date <= qEnd.Date);
            prevData = allYearData.Where(x => x.Date.Date < qStart.Date).ToList();
        } 
        else 
        {
            // 전체 보기인 경우 1분기 시작 ~ 4분기 종료
            filteredQuery = allYearData.Where(t => t.Date.Date >= q1.Start.Date && t.Date.Date <= q4.End.Date);
        }

        CarryOverAmount = baseCarryOver + prevData.Sum(x => x.Income) - prevData.Sum(x => x.Expense); 

        Entries = filteredQuery.ToList(); 
        ApplyFilters();
        editSelectedIds.Clear(); printSelectedIds.Clear(); printWithoutImageIds.Clear();
    } 

    private void ApplyFilters() 
    { 
        var temp = Entries.AsEnumerable();
        if (!string.IsNullOrEmpty(filterType)) temp = temp.Where(x => x.Type == filterType); 
        if (!string.IsNullOrEmpty(filterCategory)) temp = temp.Where(x => x.Category.Contains(filterCategory, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(filterDesc)) temp = temp.Where(x => x.Description.Contains(filterDesc, StringComparison.OrdinalIgnoreCase)); 

        FilteredEntries = temp.ToList(); 
        UniqueCategories = FilteredEntries.Where(t => !string.IsNullOrWhiteSpace(t.Category)).Select(t => t.Category.Trim()).Distinct().OrderBy(c => c).ToList();
        UniqueDescriptions = FilteredEntries.Where(t => !string.IsNullOrWhiteSpace(t.Description)).Select(t => t.Description.Trim()).Distinct().OrderBy(d => d).ToList(); 
    } 

    // 💡 모드 토글 로직
    private void ToggleAddForm() 
    { 
        isAddingNew = !isAddingNew;
        isBatchEditMode = false; 
        isBatchPrintMode = false; 
        
        if (isAddingNew)  
        { 
            int year = CurrentYear > 2000 ? CurrentYear : DateTime.Now.Year; 
            int month = CurrentMonth > 0 ? CurrentMonth : DateTime.Now.Month;
            int day = (year == DateTime.Now.Year && month == DateTime.Now.Month) ? DateTime.Now.Day : 1; 
            
            DateTime defaultDate;
            try { defaultDate = new DateTime(year, month, day); } catch { defaultDate = DateTime.Now; } 

            newItem = new LedgerEntry  
            {  
                Date = defaultDate,  
                Type = "지출",  
                Income = 0,  
                Expense = 0,  
                DepartmentId = SelectedDepartmentId,  
                Category = "", 
                Description = "", 
                Note = "" 
             }; 
        } 
    } 

    private void ToggleBatchEditMode() { isBatchEditMode = !isBatchEditMode; isAddingNew = false; isBatchPrintMode = false; editSelectedIds.Clear(); }
    
    // 🚀 인쇄 선택 모드 토글시 변수 초기화
    private void ToggleBatchPrintMode() { isBatchPrintMode = !isBatchPrintMode; isAddingNew = false; isBatchEditMode = false; printSelectedIds.Clear(); printWithoutImageIds.Clear(); }

    private async Task SaveNewEntry() 
    { 
        if (string.IsNullOrWhiteSpace(newItem.Description)) { await JSRuntime.InvokeVoidAsync("alert", "적요(내용)를 입력해주세요."); return; } 
        if (string.IsNullOrWhiteSpace(newItem.Category)) newItem.Category = "미분류"; 
        
        newItem.DepartmentId = SelectedDepartmentId;
        newItem.FiscalYear = CurrentYear; 
        newItem.Quarter = GetQuarter(newItem.Date); 
        newItem.Note ??= "";  
        
        if (newItem.Type == "지출") { newItem.Income = 0; } 
        else { newItem.Expense = 0; } 
        
        DbContext.Transactions.Add(newItem); 
        await DbContext.SaveChangesAsync();
        isAddingNew = false; 
        if (CurrentMonth > 0 && newItem.Date.Month != CurrentMonth) 
        {
            await JSRuntime.InvokeVoidAsync("alert", $"[{newItem.Date.Month}월] 장부로 저장되었습니다.");
        }
        
        newItem = new LedgerEntry { Date = DateTime.Now, Type = "지출", Income = 0, Expense = 0 };
        await LoadData(); 
    } 

    private void StartEdit(LedgerEntry item) { editingItemId = item.Id; editBuffer = new LedgerEntry { Id = item.Id, Date = item.Date, Type = item.Type, Category = item.Category, Description = item.Description ?? "", Note = item.Note ?? "", Income = item.Income, Expense = item.Expense, DepartmentId = item.DepartmentId, FiscalYear = item.FiscalYear, Quarter = item.Quarter }; } 
    private void CancelEdit() { editingItemId = null; editBuffer = null; } 
    private async Task SaveEdit() { 
        if (editBuffer != null) { 
            if (string.IsNullOrWhiteSpace(editBuffer.Description)) { await JSRuntime.InvokeVoidAsync("alert", "적요(내용)를 입력해주세요."); return; } 
            var existing = await DbContext.Transactions.FindAsync(editBuffer.Id);
            if (existing != null) { 
                existing.Date = editBuffer.Date;
                existing.Type = editBuffer.Type; existing.Category = string.IsNullOrWhiteSpace(editBuffer.Category) ? "미분류" : editBuffer.Category; existing.Description = editBuffer.Description ?? ""; existing.Note = editBuffer.Note ?? "";
                if (existing.Type == "지출") { existing.Income = 0; existing.Expense = editBuffer.Expense; } else { existing.Expense = 0; existing.Income = editBuffer.Income; } 
                existing.Quarter = GetQuarter(editBuffer.Date);
                existing.FiscalYear = editBuffer.Date.Year; 
                await DbContext.SaveChangesAsync(); 
            } 
            editingItemId = null;
            await LoadData(); 
        } 
    } 

    private void ToggleEditSelection(int id, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) editSelectedIds.Add(id); else editSelectedIds.Remove(id); } 
    private void ToggleAllEdit(ChangeEventArgs e) { if ((bool)(e.Value ?? false)) { foreach (var item in FilteredEntries) editSelectedIds.Add(item.Id); } else editSelectedIds.Clear(); } 
    private void TogglePrintSelection(int id, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) printSelectedIds.Add(id); else printSelectedIds.Remove(id); } 
    
    // 🚀 수정됨: 영수증 유무와 관계없이 지출이면 무조건 인쇄 선택/출력 가능
    private void ToggleAllPrint(ChangeEventArgs e) { if ((bool)(e.Value ?? false)) { foreach (var item in FilteredEntries.Where(t => t.Type == "지출")) printSelectedIds.Add(item.Id); } else printSelectedIds.Clear(); } 

    // 🚀 빈 영수증 모드 토글 함수들
    private void SetPrintWithoutImageForSelected() { foreach (var id in printSelectedIds) { printWithoutImageIds.Add(id); } }
    private void SetPrintWithoutImageForAll() { foreach (var item in FilteredEntries.Where(t => t.Type == "지출")) { printWithoutImageIds.Add(item.Id); printSelectedIds.Add(item.Id); } }
    private void ClearPrintWithoutImage() { printWithoutImageIds.Clear(); }

    private async Task DeleteSingle(int id) { if (await JSRuntime.InvokeAsync<bool>("confirm", "⚠️ [경고] 정말 삭제하시겠습니까?")) { var target = await DbContext.Transactions.FindAsync(id); if (target != null) { DbContext.Transactions.Remove(target); await DbContext.SaveChangesAsync(); await LoadData(); } } } 
