    // 🚀 영수증 관리 풀스크린 모달 관련 로직
    private async Task OpenUnmatchedManager() 
    { 
        showUnmatchedManager = true;
        selectedUnmatchedReceiptIds.Clear();
        await LoadUnmatchedData();
    } 

    private async Task LoadUnmatchedData()
    {
        unmatchedReceiptsList = null;
        StateHasChanged();

        var usedPaths = await DbContext.Transactions.Where(t => t.FiscalYear == CurrentYear && t.DepartmentId == SelectedDepartmentId && !string.IsNullOrEmpty(t.ReceiptPath)).Select(t => t.ReceiptPath).ToListAsync();
        var usedUrls = await DbContext.Transactions.Where(t => t.FiscalYear == CurrentYear && t.DepartmentId == SelectedDepartmentId && !string.IsNullOrEmpty(t.ReceiptUrl)).Select(t => t.ReceiptUrl).ToListAsync();
        var allUsed = usedPaths.Concat(usedUrls).ToHashSet();

        var allUploaded = await DbContext.UploadedReceipts
            .Where(r => r.DepartmentId == SelectedDepartmentId && r.ReceiptDate.Year == CurrentYear) 
            .OrderBy(r => r.ReceiptDate)
            .ToListAsync();
        unmatchedReceiptsList = allUploaded.Where(r => !allUsed.Contains(r.ImagePath)).ToList(); 
        
        unmatchedEntriesList = Entries.Where(e => e.Type == "지출" && string.IsNullOrEmpty(e.ReceiptPath) && string.IsNullOrEmpty(e.ReceiptUrl)).OrderBy(e => e.Date).ToList();
        if (GetFilteredUnmatchedReceipts().Any() && activeUnmatchedReceipt == null) 
            activeUnmatchedReceipt = GetFilteredUnmatchedReceipts().First();
        StateHasChanged();
    }

    private List<UploadedReceipt> GetFilteredUnmatchedReceipts()
    {
        if (unmatchedReceiptsList == null) return new List<UploadedReceipt>();
        if (unmatchedFilterMonth == 0) return unmatchedReceiptsList;
        return unmatchedReceiptsList.Where(r => r.ReceiptDate.Month == unmatchedFilterMonth).ToList();
    }

