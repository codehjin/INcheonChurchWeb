@page "/monthly"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using ClosedXML.Excel
@using System.Text
@using System.Net
@inject AccountingService Accounting
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env

<PageTitle>월간 장부 조회</PageTitle>

<style>
    /* =======================================================
           🎨 DESIGN SYSTEM: The Tactile Ledger (화면 디자인)
        ======================================================= */
    .ledger-surface {
        background-color: #fbfaee;
        min-height: 100vh;
        padding-bottom: 5rem;
    }

    .ledger-card {
        background-color: #ffffff;
        border-radius: 0.5rem;
        border: none;
        box-shadow: 0 2px 8px rgba(48, 49, 41, 0.04);
        transition: all 0.2s ease-out;
    }

    .ledger-card-warm {
        background-color: #f5f4e8;
        border-radius: 0.5rem;
        border: none;
    }

    .ledger-gold-btn {
        background: linear-gradient(135deg, #785600 0%, #5a4000 100%);
        color: #ffffff;
        font-weight: 700;
        border: none;
        border-radius: 0.375rem;
        padding: 0.5rem 1.25rem;
        font-size: 0.875rem;
        transition: all 0.15s ease-out;
    }

        .ledger-gold-btn:hover {
            transform: translateY(-1px);
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(120, 86, 0, 0.2);
        }

        .ledger-gold-btn:disabled {
            opacity: 0.6;
            transform: none;
            box-shadow: none;
            cursor: not-allowed;
        }

    .ledger-secondary-btn {
        background-color: #eae9dd;
        color: #5a4000;
        font-weight: 700;
        border: none;
        border-radius: 0.375rem;
        padding: 0.5rem 1.25rem;
        font-size: 0.875rem;
        transition: all 0.2s ease-out;
    }

        .ledger-secondary-btn:hover {
            background-color: #e4e3d7;
            color: #5a4000;
        }

        .ledger-secondary-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .ledger-input {
        background-color: #ffffff;
        border: 1px solid #e4e3d7;
        border-radius: 0.375rem;
        padding: 0.4rem 0.75rem;
        font-size: 0.875rem;
        color: #1b1c15;
    }

    select.ledger-input {
        padding-right: 2.25rem !important;
    }

    .ledger-input:focus {
        outline: none;
        border-color: #785600;
        box-shadow: 0 0 0 2px rgba(120, 86, 0, 0.1);
    }

    /* 연도/분기/월 선택기 디자인 */
    .compact-selector {
        display: inline-flex;
        align-items: center;
        background-color: #ffffff;
        border-radius: 0.5rem;
        padding: 0.25rem 0.5rem;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        border: 1px solid #eae9dd;
        gap: 0.25rem;
    }

    .selector-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 0.25rem;
        color: #785600;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: background 0.2s;
        font-size: 0.85rem;
    }

        .selector-btn:hover {
            background-color: #f5f4e8;
        }

    .selector-value {
        font-size: 0.9rem;
        font-weight: 700;
        color: #1b1c15;
        min-width: 3.5rem;
        text-align: center;
    }

    .selector-divider {
        width: 1px;
        height: 1.2rem;
        background-color: #eae9dd;
        margin: 0 0.25rem;
    }

    .ledger-table-container {
        overflow-x: auto;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px rgba(48, 49, 41, 0.04);
        background-color: #ffffff;
        border: 1px solid #eae9dd;
    }

    .ledger-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
        margin-bottom: 0;
        table-layout: fixed;
    }

        .ledger-table th {
            background-color: rgba(234, 233, 221, 0.6);
            color: #4e4637;
            font-weight: 800;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 0.875rem 0.5rem;
            border-bottom: 2px solid #d2c5b2;
            border-right: 1px solid #eae9dd;
            text-align: center;
            white-space: nowrap;
        }

        .ledger-table td {
            padding: 0.75rem 0.5rem;
            vertical-align: middle;
            font-size: 0.9rem;
            color: #1b1c15;
            border-bottom: 1px solid #eae9dd;
            border-right: 1px solid #eae9dd;
            text-align: center;
        }

            .ledger-table th:last-child, .ledger-table td:last-child {
                border-right: none;
            }

        .ledger-table tbody tr {
            transition: background-color 0.15s;
        }

            .ledger-table tbody tr:hover {
                background-color: #fbfcfa;
            }

    .text-truncate-custom {
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        margin: 0 auto;
        text-align: left;
    }

    .ledger-tabular {
        font-variant-numeric: tabular-nums;
    }

    .badge-income {
        background-color: rgba(90, 64, 0, 0.1);
        color: #5a4000;
        font-weight: 700;
        padding: 0.3rem 0.6rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        display: inline-block;
    }

    .badge-expense {
        background-color: rgba(186, 26, 26, 0.1);
        color: #ba1a1a;
        font-weight: 700;
        padding: 0.3rem 0.6rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        display: inline-block;
    }

    .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 0.25rem;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.9rem;
    }

        .icon-btn:hover {
            background-color: #eae9dd;
        }

        .icon-btn.edit {
            color: #198754;
        }

        .icon-btn.delete {
            color: #dc3545;
        }

        .icon-btn.receipt {
            color: #785600;
        }

        .icon-btn.upload {
            color: #e6a23c;
        }

    /* =======================================================
           🖨️ 인쇄 전용 스타일 (Razor 문법 에러 방지 위해 @@ 사용)
        ======================================================= */
    @@media screen {
        .print-only {
            display: none !important; /* 화면에서는 숨김 처리 */
        }
    }

    @@media print {
        /* 🚀 1. 화면용 UI 완벽 차단 (사이드바, 모달, 상단바 등) */
        .sidebar, .top-row, .pc-top-bar, .mobile-top-header, .mobile-bottom-nav,
        .ledger-surface, .no-print, .modal, .modal-backdrop, footer {
            display: none !important;
        }
        /* 🚀 2. Blazor 레이아웃 뼈대 강제 해체 (백지 현상의 핵심 원인 제거) */
        /* height, overflow, position 등 인쇄 문서 길이를 0으로 만드는 모든 속성 초기화 */
        html, body, #app, .page, main, article, .content, .main-content-area {
            display: block !important;
            position: static !important;
            float: none !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            height: auto !important;
            min-height: 0 !important;
            max-height: none !important;
            overflow: visible !important;
            background-color: white !important;
            box-sizing: border-box !important;
        }
        /* 🚀 3. 인쇄 전용 영역 강제 표시 */
        .print-only {
            display: block !important;
            position: static !important;
            visibility: visible !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            page-break-after: auto !important;
        }
        /* 용지 규격 */
        @@page {
            size: A4 portrait;
            margin: 15mm 10mm !important;
        }

        .page-break-before {
            page-break-before: always !important;
            break-before: page !important;
            margin-top: 0 !important;
        }
        /* 장부 테이블 설정 */
        table.table, .ledger-table-print {
            width: 100% !important;
            table-layout: auto !important;
            font-size: 10pt !important;
            border-collapse: collapse !important;
        }

            .ledger-table-print th, .ledger-table-print td {
                word-break: keep-all !important;
                padding: 4px !important;
                border: 1px solid #444 !important;
                vertical-align: middle !important;
            }
                /* 날짜 열 절대 줄바꿈 금지 */
                .ledger-table-print td:nth-child(2) {
                    white-space: nowrap !important;
                    width: 80px !important;
                    text-align: center !important;
                }

        .money-cell-print {
            text-align: right !important;
            white-space: nowrap !important;
        }
        /* 영수증 그리드 설정 */
        .receipt-grid-1 .receipt-box {
            width: 100%;
            height: 257mm; /* 267mm - 10mm 여유 */
            margin-bottom: 0;
            page-break-inside: avoid;
            display: flex !important;
            flex-direction: column;
        }

        .receipt-grid-2 {
            display: flex !important;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 5mm; /* margin-bottom 대신 gap 사용 */
        }

            .receipt-grid-2 .receipt-box {
                width: 48%;
                height: 131mm; /* (267 - 5) ÷ 2 */
                margin-bottom: 0;
                page-break-inside: avoid;
                display: flex !important;
                flex-direction: column;
            }

        .receipt-grid-4 {
            display: flex !important;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 5mm;
        }

            .receipt-grid-4 .receipt-box {
                width: 48%;
                height: 125mm; /* (267 - 5×3) ÷ 2 */
                margin-bottom: 0;
                page-break-inside: avoid;
                display: flex !important;
                flex-direction: column;
            }

        .receipt-img-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px dashed #ccc;
            padding: 2px;
        }

            .receipt-img-wrapper img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .receipt-empty {
            flex: 1;
            border: 2px dashed #999;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14pt;
            color: #ccc;
        }
    }
</style>

<InputFile id="pcUploadInput" OnChange="HandlePcUpload" style="display:none;" accept="image/*,.pdf" />

<div class="ledger-surface no-print" id="monthly-ledger-content">
    <div class="container-fluid px-3 px-md-4 pt-4">

        @if (CurrentUser == null)
        {
            <div class="text-center py-5">
                <h5 style="color: #785600; font-weight: 700;">로그인이 필요합니다.</h5>
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                <div class="compact-selector">
                    <button class="selector-btn" @onclick="() => ChangeYear(-1)">◀</button>
                    <span class="selector-value">@(_currentYear)년</span>
                    <button class="selector-btn" @onclick="() => ChangeYear(1)">▶</button>

                    <div class="selector-divider"></div>

                    <select class="settings-input fw-bold border-0 py-1" style="background: transparent; width: auto; box-shadow: none;" @onchange="OnQuarterChanged" value="@_currentQuarter">
                        <option value="0">전체 분기</option>
                        <option value="1">1분기</option>
                        <option value="2">2분기</option>
                        <option value="3">3분기</option>
                        <option value="4">4분기</option>
                    </select>

                    <div class="selector-divider"></div>

                    <button class="selector-btn" @onclick="() => ChangeMonth(-1)">◀</button>
                    <select class="settings-input fw-bold border-0 py-1 px-1" style="background: transparent; width: auto; box-shadow: none; text-align: center; -webkit-appearance: none; appearance: none;" @onchange="OnMonthChanged" value="@_currentMonth">
                        <option value="0">전체 월</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@(i)월</option>
                        }
                    </select>
                    <button class="selector-btn" @onclick="() => ChangeMonth(1)">▶</button>
                </div>

                @if (CurrentUser?.CanViewAll == true)
                {
                    <select class="form-select ledger-input w-auto fw-bold" @onchange="OnDeptChanged" value="@_selectedDepartmentId">
                        <option value="0">전체 부서</option>
                        @foreach (var dept in _departments)
                        {
                            @if (dept.Name != "관리자" && dept.Name != "교회학교 운영팀" && dept.Name != "감사위원회")
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        }
                    </select>
                }
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="ledger-card p-4 h-100 d-flex flex-column justify-content-center" style="border-left: 4px solid #d2c5b2;">
                        <span style="font-size: 1rem; font-weight: 700; color: #4e4637; text-transform: uppercase; letter-spacing: 0.05em;">전월 이월금 (회계연도 기준)</span>
                        <div class="mt-2 ledger-tabular" style="font-size: 1.5rem; font-weight: 800; color: #1b1c15;">
                            <span style="font-size: 1rem; font-weight: 500;">₩</span> @_carryOverAmount.ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="ledger-card p-4 h-100 d-flex flex-column justify-content-center" style="border-left: 4px solid #eec067;">
                        <span style="font-size: 1rem; font-weight: 700, color: #4e4637; text-transform: uppercase; letter-spacing: 0.05em;">조회 기간 수입 / 지출</span>
                        <div class="mt-2 d-flex align-items-baseline gap-2 ledger-tabular">
                            <span style="font-size: 1.25rem; font-weight: 800; color: #785600;">+ ₩@_filtered_entries.Sum(t => t.Income).ToString("N0")</span>
                            <span style="font-size: 0.9rem; font-weight: 600, color: #ba1a1a;">- ₩@_filtered_entries.Sum(t => t.Expense).ToString("N0")</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="ledger-card p-4 h-100 d-flex flex-column justify-content-center" style="border-left: 4px solid #785600; background-color: #fcfbf6;">
                        <span style="font-size: 1rem; font-weight: 700; color: #785600; text-transform: uppercase; letter-spacing: 0.05em;">현재 잔액</span>
                        <div class="mt-2 ledger-tabular" style="font-size: 1.75rem; font-weight: 900; color: #5a4000;">
                            <span style="font-size: 1.1rem; font-weight: 500;">₩</span> @CurrentBalance.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                <h4 class="fw-bold mb-0" style="color: #1b1c15;">
                    @(_currentYear) 회계연도 @(_currentMonth > 0 ? $"{_currentMonth}월" : _currentQuarter > 0 ? $"{_currentQuarter}분기" : "전체") 내역
                </h4>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (CurrentUser?.CanEditLedger == true)
                    {
                        <button class="ledger-gold-btn" @onclick="ToggleBatchEditMode">
                            <i class="bi bi-pencil-square me-1"></i> @(_isBatchEditMode ? "수정 취소" : "일괄 수정")
                        </button>
                    }
                    <button class="ledger-secondary-btn" @onclick="OpenPrintModal" disabled="@(!_filtered_entries.Any())">
                        <i class="bi bi-printer me-1"></i> 인쇄
                    </button>
                    <button class="ledger-secondary-btn" @onclick="DownloadExcel" disabled="@(!_filtered_entries.Any())">
                        <i class="bi bi-file-earmark-excel me-1"></i> 엑셀
                    </button>
                    @if (CurrentUser?.CanEditLedger == true)
                    {
                        <button class="ledger-gold-btn" @onclick="ToggleAddForm">
                            <i class="bi @(_isAddingNew ? "bi-dash-lg" : "bi-plus-lg") me-1"></i> @(_isAddingNew ? "입력 취소" : "새 항목 입력")
                        </button>
                    }
                </div>
            </div>

            @if (_isBatchEditMode && CurrentUser?.CanEditLedger == true)
            {
                <div class="ledger-card-warm p-2 mb-3 d-flex flex-wrap align-items-center gap-2" style="background-color:rgba(23, 69, 119, 0.05); border: 1px solid rgba(23, 69, 119, 0.1);">
                    <span class="fw-bold ms-2" style="color: #174577; font-size: 0.9rem;"><i class="bi bi-check-all me-1"></i> @_editSelectedIds.Count 건 선택됨</span>
                    <select class="form-select ledger-input w-auto ms-3" @bind="_bulkCategory" style="padding: 0.2rem 2rem 0.2rem 0.75rem; font-size: 0.875rem;">
                        <option value="">-- 일괄 변경 분류 --</option>
                        <optgroup label="[수입]">
                            @foreach (var c in _incomeCats)
                            {
                                <option value="@c">@c</option>
                            }
                        </optgroup>
                        <optgroup label="[지출]">
                            @foreach (var c in _expenseCats)
                            {
                                <option value="@c">@c</option>
                            }
                        </optgroup>
                    </select>
                    @* ComboBox 루트가 width:100%라 flex 항목으로 두면 한 줄을 통째로 차지한다.
                       폭을 제한한 래퍼로 감싸 분류 셀렉트와 나란히 놓는다. *@
                    <div style="flex: 0 1 12rem; min-width: 9rem;">
                        <ComboBox @bind-Value="_bulkSubCategory" Options="@SubOptions(BulkType, _bulkCategory)" Placeholder="세부(선택)" InputClass="form-control form-control-sm" />
                    </div>
                    <button class="btn btn-sm btn-primary fw-bold px-3" @onclick="ApplyBulkEdit" disabled="@(_editSelectedIds.Count == 0 || string.IsNullOrEmpty(_bulkCategory))">일괄적용</button>
                    <button class="btn btn-sm btn-outline-danger fw-bold ms-auto px-3" @onclick="DeleteSelected" disabled="@(_editSelectedIds.Count == 0)"><i class="bi bi-trash-fill me-1"></i> 선택 삭제</button>
                </div>
            }

            <div class="ledger-table-container">
                @if (_isLoading)
                {
                    <div class="text-center py-5"><div class="spinner-border" style="color: #785600;"></div></div>
                }
                else
                {
                    <table class="ledger-table">
                        <colgroup>
                            @if (_isBatchEditMode)
                            {
                                <col style="width: 3%;" />
                            }
                            <col style="width: 4%;" />
                            <col style="width: 8%;" />
                            <col style="width: 5%;" />
                            <col style="width: 8%;" />
                            <col style="width: 7%;" />
                            <col style="width: 25%;" />
                            <col style="width: 9%;" />
                            <col style="width: 9%;" />
                            <col style="width: 9%;" />
                            <col style="width: 10%;" />
                            @if (CurrentUser?.CanViewAll == true)
                            {
                                <col style="width: 6%;" />
                            }
                            @if (CurrentUser?.CanEditLedger == true)
                            {
                                <col style="width: 6%;" />
                            }
                            <col style="width: 6%;" />
                        </colgroup>
                        <thead>
                            <tr>
                                @if (_isBatchEditMode)
                                {
                                    <th><input type="checkbox" class="form-check-input" @onchange="ToggleAllEdit" checked="@IsAllEditSelected" /></th>
                                }
                                <th>#</th>
                                <th>날짜</th>
                                <th>구분</th>
                                <th>분류항목</th>
                                <th>세부</th>
                                <th>내역</th>
                                <th>비고</th>
                                <th>수입</th>
                                <th>지출</th>
                                <th>잔액</th>
                                @if (CurrentUser?.CanViewAll == true)
                                {
                                    <th>부서</th>
                                }
                                @if (CurrentUser?.CanEditLedger == true)
                                {
                                    <th>관리</th>
                                }
                                <th>증빙</th>
                            </tr>
                            <tr style="background-color: #fbfcfa; border-bottom: 2px solid #d2c5b2;">
                                @if (_isBatchEditMode)
                                {
                                    <th></th>
                                }
                                <th></th>
                                <th><input type="text" class="form-control form-control-sm px-1" placeholder="날짜" @bind="_filterDate" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                <th>
                                    <select class="form-select form-select-sm px-1" @bind="_filterType" @bind:event="onchange" @bind:after="ApplyFilters">
                                        <option value="">전체</option>
                                        <option value="수입">수입</option>
                                        <option value="지출">지출</option>
                                    </select>
                                </th>
                                <th><input type="text" class="form-control form-control-sm px-1" placeholder="검색" @bind="_filterCategory" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                <th><input type="text" class="form-control form-control-sm px-1" placeholder="검색" @bind="_filterSubCategory" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                <th><input type="text" class="form-control form-control-sm px-1" placeholder="검색" @bind="_filterDescription" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                <th><input type="text" class="form-control form-control-sm px-1" placeholder="검색" @bind="_filterNote" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                @if (CurrentUser?.CanViewAll == true)
                                {
                                    <th><input type="text" class="form-control form-control-sm px-1" placeholder="검색" @bind="_filterDepartment" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                }
                                @if (CurrentUser?.CanEditLedger == true)
                                {
                                    <th></th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNum = 0;
                            }
                            @foreach (var t in _filtered_entries)
                            {
                                rowNum++;
                                bool isEditingThis = _editingItemId == t.Id;
                                <tr>
                                    @if (_isBatchEditMode)
                                    {
                                        <td><input type="checkbox" class="form-check-input" checked="@_editSelectedIds.Contains(t.Id)" @onchange="e => ToggleEditSelection(t.Id, e)" /></td>
                                    }
                                    @if (isEditingThis && _editBuffer != null)
                                    {
                                        <td class="fw-bold" style="color: #174577; font-size: 0.75rem;">EDIT</td>
                                        <td><input type="date" class="form-control form-control-sm px-1" @bind="_editBuffer.Date" /></td>
                                        <td><select class="form-select form-select-sm px-1" @bind="_editBuffer.Type"><option value="수입">수입</option><option value="지출">지출</option></select></td>
                                        <td><ComboBox @bind-Value="_editBuffer.Category" Options="@(_editBuffer.Type == "수입" ? _incomeCats : _expenseCats)" InputClass="form-control form-control-sm px-1 fw-bold" /></td>
                                        <td><ComboBox @bind-Value="_editSubCategory" Options="@SubOptions(_editBuffer.Type, _editBuffer.Category)" Placeholder="세부" InputClass="form-control form-control-sm px-1" /></td>
                                        <td><input class="form-control form-control-sm px-1" @bind="_editBuffer.Description" /></td>
                                        <td><input class="form-control form-control-sm px-1" @bind="_editBuffer.Note" /></td>
                                        <td>
                                            @if (_editBuffer.Type == "수입")
                                            {
                                                <input type="number" class="form-control form-control-sm text-end px-1" @bind="_editBuffer.Income" />
                                            }
                                            else
                                            {

                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (_editBuffer.Type == "지출")
                                            {
                                                <input type="number" class="form-control form-control-sm text-end px-1" @bind="_editBuffer.Expense" />
                                            }
                                            else
                                            {

                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td></td>
                                        @if (CurrentUser?.CanViewAll == true)
                                        {
                                            <td></td>
                                        }
                                        @if (CurrentUser?.CanEditLedger == true)
                                        {
                                            <td>
                                                <div class="d-flex gap-1 justify-content-center">
                                                    <button class="icon-btn edit" @onclick="SaveEdit" title="저장"><i class="bi bi-check-lg fs-5"></i></button>
                                                    <button class="icon-btn text-muted" @onclick="CancelEdit" title="취소"><i class="bi bi-x-lg"></i></button>
                                                </div>
                                            </td>
                                        }
                                        <td></td>
                                    }
                                    else
                                    {
                                        <td class="ledger-tabular text-muted" style="font-size: 0.8rem;">@rowNum</td>
                                        <td class="ledger-tabular fw-bold" style="color: #4e4637;">@t.Date.ToString("MM.dd")</td>
                                        <td>
                                            @if (t.Type == "수입" || t.Type == "Income")
                                            {
                                                <span class="badge-income">수입</span>
                                            }
                                            else
                                            {

                                                <span class="badge-expense">지출</span>
                                            }
                                        </td>
                                        <td class="fw-bold" style="color: #4e4637;">
                                            <div class="text-truncate-custom" title="@t.Category">@t.Category</div>
                                        </td>
                                        <td>
                                            <div class="text-truncate-custom" title="@t.SubCategory" style="color: var(--on-surface-muted); font-size: 0.85em;">@t.SubCategory</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-truncate-custom" title="@t.Description" style="color: #1b1c15;">@t.Description</div>
                                        </td>
                                        <td>
                                            <div class="text-truncate-custom text-muted" title="@t.Note" style="font-size: 0.8rem;">@t.Note</div>
                                        </td>
                                        <td class="text-end ledger-tabular fw-bold" style="color: #785600;">@(t.Income > 0 ? t.Income.ToString("N0") : "")</td>
                                        <td class="text-end ledger-tabular fw-bold" style="color: #ba1a1a;">@(t.Expense > 0 ? t.Expense.ToString("N0") : "")</td>
                                        <td class="text-end ledger-tabular fw-bold" style="color: #1b1c15;">@(_entryBalances.TryGetValue(t.Id, out var b) ? b.ToString("N0") : "-")</td>
                                        @if (CurrentUser?.CanViewAll == true)
                                        {
                                            <td style="font-size: 0.8rem; color: #807666;">@_departments.FirstOrDefault(d => d.Id == t.DepartmentId)?.Name</td>
                                        }
                                        @if (CurrentUser?.CanEditLedger == true)
                                        {
                                            <td>
                                                <div class="d-flex justify-content-center gap-1">
                                                    <button class="icon-btn edit" @onclick="() => StartEdit(t)" title="수정"><i class="bi bi-pencil-fill"></i></button>
                                                    <button class="icon-btn delete" @onclick="() => DeleteSingle(t.Id)" title="삭제"><i class="bi bi-trash-fill"></i></button>
                                                </div>
                                            </td>
                                        }
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                @if (!string.IsNullOrEmpty(t.ReceiptUrl) || !string.IsNullOrEmpty(t.ReceiptPath))
                                                {
                                                    <button class="icon-btn receipt" title="영수증 확인" @onclick="() => ShowReceiptModal(!string.IsNullOrEmpty(t.ReceiptPath) ? t.ReceiptPath! : t.ReceiptUrl!)"><i class="bi bi-receipt-cutoff"></i></button>
                                                    @if (CurrentUser?.CanEditLedger == true)
                                                    {
                                                        <button class="icon-btn delete" style="width:24px; height:24px; font-size:0.75rem;" title="영수증 분리" @onclick="() => RemoveReceiptOnly(t.Id)"><i class="bi bi-x-circle-fill"></i></button>
                                                    }
                                                }
                                                else if (CurrentUser?.CanEditLedger == true)
                                                {
                                                    <button class="icon-btn upload" title="업로드" @onclick="() => TriggerPcUpload(t.Id)"><i class="bi bi-folder-plus fs-5"></i></button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" style="font-size: 0.75rem;">-</span>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }

                            @if (CurrentUser?.CanEditLedger == true && _isAddingNew)
                            {
                                <tr style="background-color: #fbfcfa; border-top: 2px solid #785600;">
                                    @if (_isBatchEditMode)
                                    {
                                        <td></td>
                                    }
                                    <td class="ledger-tabular fw-bold" style="color: #785600; font-size: 0.75rem;">NEW</td>
                                    <td><input type="date" class="form-control form-control-sm ledger-tabular px-1" @bind="_newItem.Date" /></td>
                                    <td><select class="form-select form-select-sm fw-bold px-1" @bind="_newItem.Type"><option value="수입">수입</option><option value="지출">지출</option></select></td>
                                    <td><ComboBox @bind-Value="_newItem.Category" Options="@(_newItem.Type == "수입" ? _incomeCats : _expenseCats)" Placeholder="분류입력" InputClass="form-control form-control-sm fw-bold px-1" /></td>
                                    <td><ComboBox @bind-Value="_newSubCategory" Options="@SubOptions(_newItem.Type, _newItem.Category)" Placeholder="세부(선택)" InputClass="form-control form-control-sm px-1" /></td>
                                    <td><input class="form-control form-control-sm fw-bold px-1" @bind="_newItem.Description" placeholder="내역(필수)" /></td>
                                    <td><input class="form-control form-control-sm px-1" @bind="_newItem.Note" placeholder="비고(선택)" /></td>
                                    <td>
                                        @if (_newItem.Type == "수입")
                                        {
                                            <input type="number" class="form-control form-control-sm text-end ledger-tabular fw-bold px-1" style="color: #785600;" @bind="_newItem.Income" placeholder="0" />
                                        }
                                        else
                                        {

                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (_newItem.Type == "지출")
                                        {
                                            <input type="number" class="form-control form-control-sm text-end ledger-tabular fw-bold px-1" style="color: #ba1a1a;" @bind="_newItem.Expense" placeholder="0" />
                                        }
                                        else
                                        {

                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end ledger-tabular fw-bold" style="color: #807666; font-size: 0.75rem;">자동계산</td>
                                    @if (CurrentUser?.CanViewAll == true)
                                    {
                                        <td>
                                            <select class="form-select ledger-input fw-bold" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; color: #785600;" @bind="_newItem.DepartmentId">
                                                <option value="0">부서 선택</option>
                                                @foreach (var dept in _departments.Where(d => d.Name != "관리자" && d.Name != "교회학교 운영팀" && d.Name != "감사위원회"))
                                                {
                                                    <option value="@dept.Id">@dept.Name</option>
                                                }
                                            </select>
                                        </td>
                                    }
                                    @if (CurrentUser?.CanEditLedger == true)
                                    {
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                <button class="icon-btn" style="background: linear-gradient(135deg, #785600 0%, #5a4000 100%); color: white;" @onclick="SaveNewEntry" title="저장"><i class="bi bi-check-lg"></i></button>
                                                <button class="icon-btn text-muted" style="background-color: #eae9dd;" @onclick="ToggleAddForm" title="취소"><i class="bi bi-x-lg"></i></button>
                                            </div>
                                        </td>
                                    }
                                    <td><span class="text-muted" style="font-size: 0.7rem;">저장 후</span></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background-color: #eae9dd; border-top: 2px solid #d2c5b2;">
                                @{
                                    int tfColspan = 7; if (_isBatchEditMode) tfColspan++;
                                }
                                <td colspan="@tfColspan" class="text-end fw-bold" style="color: #4e4637; padding: 1rem 0.75rem;">조회 기간 합계</td>
                                <td class="text-end ledger-tabular fw-bold" style="color: #785600; padding: 1rem 0.5rem;">₩@_filtered_entries.Sum(t => t.Income).ToString("N0")</td>
                                <td class="text-end ledger-tabular fw-bold" style="color: #ba1a1a; padding: 1rem 0.5rem;">₩@_filtered_entries.Sum(t => t.Expense).ToString("N0")</td>
                                <td class="text-end ledger-tabular fw-bold" style="color: #1b1c15; padding: 1rem 0.5rem;">₩@CurrentBalance.ToString("N0")</td>
                                @if (CurrentUser?.CanViewAll == true)
                                {
                                    <td></td>
                                }
                                @if (CurrentUser?.CanEditLedger == true)
                                {
                                    <td></td>
                                }
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
        }
    </div>
</div>
<div class="no-print">
    @if (_showReceiptModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);" @onclick="CloseReceiptModalHandler">
            <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
                <div class="modal-content ledger-card border-0">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold mb-0" style="color: #1b1c15;">증빙 자료</h5>
                        <button type="button" class="btn-close" @onclick="CloseReceiptModalHandler"></button>
                    </div>
                    <div class="modal-body text-center p-3">
                        <img src="@_currentReceiptUrl" class="img-fluid rounded" style="max-height: 75vh; object-fit: contain;" />
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showPrintModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);" @onclick="ClosePrintModal">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content ledger-card border-0">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold mb-0" style="color: #1b1c15;"><i class="bi bi-printer me-2" style="color: #785600;"></i>인쇄 옵션 선택</h5>
                        <button type="button" class="btn-close" @onclick="ClosePrintModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="d-flex gap-3 mb-4">
                            <div class="flex-fill p-3 rounded text-center border"
                                 style="cursor: pointer; transition: all 0.2s; @(_selectedPrintType == "Ledger" ? "border-color: #785600; background-color: rgba(120,86,0,0.05);" : "border-color: #eae9dd;")"
                                 @onclick='() => _selectedPrintType = "Ledger"'>
                                <i class="bi bi-journal-text fs-2 d-block mb-2" style="color: @(_selectedPrintType == "Ledger" ? "#785600" : "#807666");"></i>
                                <strong style="color: @(_selectedPrintType == "Ledger" ? "#5a4000" : "#4e4637");">장부 인쇄</strong>
                            </div>
                            <div class="flex-fill p-3 rounded text-center border"
                                 style="cursor: pointer; transition: all 0.2s; @(_selectedPrintType == "Receipt" ? "border-color: #785600; background-color: rgba(120,86,0,0.05);" : "border-color: #eae9dd;")"
                                 @onclick='() => _selectedPrintType = "Receipt"'>
                                <i class="bi bi-receipt fs-2 d-block mb-2" style="color: @(_selectedPrintType == "Receipt" ? "#785600" : "#807666");"></i>
                                <strong style="color: @(_selectedPrintType == "Receipt" ? "#5a4000" : "#4e4637");">영수증 인쇄</strong>
                            </div>
                        </div>

                        @if (_selectedPrintType == "Receipt")
                        {
                            <div class="p-3 rounded" style="background-color: #f5f4e8;">
                                <label class="fw-bold small d-block text-muted mb-2">A4 1장당 영수증 개수</label>
                                <select class="form-select ledger-input fw-bold mb-4" @bind="_receiptsPerSheet">
                                    <option value="1">1장에 1개 (크게)</option>
                                    <option value="2">1장에 2개 (중간)</option>
                                    <option value="4">1장에 4개 (작게)</option>
                                </select>

                                <label class="fw-bold small d-block text-muted mb-2">이미지 포함 여부</label>
                                <div class="form-check form-switch d-flex align-items-center gap-2">
                                    <input class="form-check-input" type="checkbox" id="includeImageSwitch" style="width: 2.5rem; height: 1.25rem;" @bind="_includeReceiptImage">
                                    <label class="form-check-label fw-bold ms-2" for="includeImageSwitch" style="color: #1b1c15; margin-top: 0.15rem;">증빙 이미지 함께 인쇄</label>
                                </div>
                                <p class="small text-muted mt-2 mb-0 ms-1">※ 끄면 이미지 없이 빈 양식 칸만 인쇄됩니다.</p>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 rounded text-center" style="background-color: #f5f4e8;">
                                <span class="fw-bold" style="color: #4e4637;">현재 화면에 조회된 내역을 인쇄합니다.</span>
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button class="ledger-secondary-btn flex-fill" @onclick="ClosePrintModal">취소</button>
                        <button class="ledger-gold-btn flex-fill" @onclick="ExecutePrintAction"><i class="bi bi-printer me-1"></i> 인쇄 실행</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="print-only">
    @* 인쇄 지면은 Components/Shared/LedgerPrintSheet.razor 한 곳에 있다.
       모바일 인쇄 화면(/ledger/print)도 같은 컴포넌트를 쓴다. *@
    <LedgerPrintSheet Mode="@_printMode"
                      Entries="_filtered_entries"
                      PriorEntries="_entries"
                      CarryOver="_carryOverAmount"
                      DeptName="@PrintDeptName"
                      ReceiptTargets="_printTargets"
                      ReceiptsPerSheet="_receiptsPerSheet"
                      IncludeReceiptImage="_includeReceiptImage" />
</div>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private int _currentYear = DateTime.Now.Year;
    private int _currentMonth = DateTime.Now.Month;
    private int _currentQuarter = 0;
    private int _selectedDepartmentId = 0;
    private List<Department> _departments = new();
    private List<LedgerEntry> _entries = new();
    private List<LedgerEntry> _filtered_entries = new();
    private decimal _carryOverAmount = 0;
    private decimal CurrentBalance => _carryOverAmount + _filtered_entries.Sum(t => t.Income) - _filtered_entries.Sum(t => t.Expense);
    private Dictionary<int, decimal> _entryBalances = new();

    private List<string> _incomeCats = new();
    private List<string> _expenseCats = new();
    // 🚀 세부(SubCategory) 자동완성: 분류(Category) → 세부 목록
    //   지출 → 그 행사에 편성된 비용 종류만, 수입 → 행사명 목록
    private Dictionary<string, List<string>> _incomeSubMap = new();
    private Dictionary<string, List<string>> _expenseSubMap = new();

    // 선택된 구분·분류에 해당하는 세부 후보를 돌려준다.
    private List<string> SubOptions(string type, string? category)
    {
        var map = type == "수입" ? _incomeSubMap : _expenseSubMap;
        if (!string.IsNullOrWhiteSpace(category) && map.TryGetValue(category.Trim(), out var list))
            return list;
        // 분류 미선택/미등록이면 전체 후보를 합쳐 보여준다(입력을 막지 않기 위해)
        return map.Values.SelectMany(v => v).Distinct().OrderBy(s => s).ToList();
    }

    // ComboBox는 non-nullable string을 받으므로 중간 변수를 둔다(SubCategory는 string?).
    private string _editSubCategory = "";
    private string _newSubCategory = "";
    private List<string> _uniqueCategories = new();

    private string _filterType = "";
    private string _filterCategory = "";
    private string _filterSubCategory = "";
    private string _filterDate = "";
    private string _filterDescription = "";
    private string _filterNote = "";
    private string _filterDepartment = "";

    private bool _isBatchEditMode = false;
    private HashSet<int> _editSelectedIds = new();
    private HashSet<int> _printSelectedIds = new();
    private bool IsAllEditSelected => _filtered_entries.Any() && _editSelectedIds.Count == _filtered_entries.Count;
    private string _bulkCategory = "";
    private string _bulkSubCategory = "";
    // 일괄 변경 분류가 수입/지출 어느 쪽인지 역산 — SubOptions에 넘길 구분값
    private string BulkType => _incomeCats.Contains(_bulkCategory) ? "수입" : "지출";
    private bool _isAddingNew = false;
    private LedgerEntry _newItem = new() { Date = DateTime.Now, Type = "지출", Income = 0, Expense = 0 };
    private int? _editingItemId = null;
    private LedgerEntry? _editBuffer = null;

    private bool _showReceiptModal = false;
    private string _currentReceiptUrl = "";
    private bool _isLoading = false;

    private bool _showPrintModal = false;
    private string _selectedPrintType = "Ledger";
    private string _printMode = "Ledger";
    private int _receiptsPerSheet = 2;
    private bool _includeReceiptImage = true;
    private List<LedgerEntry> _printTargets = new();

    private int _targetUploadEntryId = 0;

    protected override async Task OnInitializedAsync()
    {
        _departments = await Accounting.GetDepartmentsAsync();
        if (CurrentUser?.Department != null)
        {
            _selectedDepartmentId = CurrentUser?.CanViewAll == true ? 0 : (CurrentUser?.DepartmentId ?? 0);
            await LoadData();
        }
    }

    private async Task OnDeptChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int d)) { _selectedDepartmentId = d; await LoadData(); } }
    private async Task ChangeYear(int v) { _currentYear += v; await LoadData(); }
    private async Task OnMonthChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int m)) { _currentMonth = m; _currentQuarter = 0; await LoadData(); } }

    private async Task ChangeMonth(int offset)
    {
        if (_currentMonth == 0)
        {
            _currentMonth = offset > 0 ? 1 : 12;
        }
        else
        {
            _currentMonth += offset;
            if (_currentMonth > 12)
            {
                _currentMonth = 1;
                _currentYear++;
            }
            else if (_currentMonth < 1)
            {
                _currentMonth = 12;
                _currentYear--;
            }
        }
        _currentQuarter = 0;
        await LoadData();
    }

    private async Task OnQuarterChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int q)) { _currentQuarter = q; _currentMonth = 0; await LoadData(); } }

    // 인쇄 제목에 넣을 부서명 (전체 조회면 "전체 부서")
    private string PrintDeptName =>
        _selectedDepartmentId == 0
            ? "전체 부서"
            : _departments.FirstOrDefault(d => d.Id == _selectedDepartmentId)?.Name ?? "";

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            // 🚀 회계연도 범위·이월금·기간 스코프는 AccountingService 한 곳에서 계산한다.
            //    (예전에는 같은 알고리즘이 이 파일에도 복제되어 있었다 — 웹_상세_구조문서.md §6.2)
            var view = await Accounting.GetLedgerViewAsync(
                _selectedDepartmentId, CurrentUser?.DepartmentId ?? 0,
                _currentYear, _currentQuarter, _currentMonth, type: null);

            _entries = view.Entries;
            _carryOverAmount = view.CarryOver;

            // 🚀 분류·세부 자동완성 후보도 서비스에서 받는다 (§6.4)
            var maps = await Accounting.GetCategoryMapsAsync(_selectedDepartmentId, _currentYear);
            _incomeCats = maps.IncomeCategories;
            _expenseCats = maps.ExpenseCategories;
            _incomeSubMap = maps.IncomeSubs;
            _expenseSubMap = maps.ExpenseSubs;

            // 예산이 하나도 없는 부서를 위한 기본 후보 (기존 동작 유지)
            if (!_incomeCats.Any()) _incomeCats = new List<string> { "주일헌금", "십일조", "감사헌금", "절기특별헌금", "기타수입" };
            if (!_expenseCats.Any()) _expenseCats = new List<string> { "예배", "교육비", "부서운영비", "기타지출" };

            ApplyFilters();
            _editSelectedIds.Clear(); _printSelectedIds.Clear();
        }
        finally { _isLoading = false; }
    }

    private void ApplyFilters()
    {
        var temp = _entries.AsEnumerable();
        if (!string.IsNullOrEmpty(_filterType)) temp = temp.Where(x => x.Type == _filterType);
        if (!string.IsNullOrEmpty(_filterCategory)) temp = temp.Where(x => x.Category.Contains(_filterCategory, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_filterSubCategory)) temp = temp.Where(x => x.SubCategory != null && x.SubCategory.Contains(_filterSubCategory, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_filterDate)) temp = temp.Where(x => x.Date.ToString("MM.dd").Contains(_filterDate) || x.Date.ToString("yyyy-MM-dd").Contains(_filterDate));
        if (!string.IsNullOrEmpty(_filterDescription)) temp = temp.Where(x => x.Description != null && x.Description.Contains(_filterDescription, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_filterNote)) temp = temp.Where(x => x.Note != null && x.Note.Contains(_filterNote, StringComparison.OrdinalIgnoreCase));
        if (CurrentUser?.CanViewAll == true && !string.IsNullOrEmpty(_filterDepartment)) temp = temp.Where(x => _departments.FirstOrDefault(d => d.Id == x.DepartmentId)?.Name?.Contains(_filterDepartment, StringComparison.OrdinalIgnoreCase) == true);
        _filtered_entries = temp.ToList();

        _entryBalances.Clear();
        decimal bal = _carryOverAmount;
        foreach (var e in _filtered_entries) { bal += e.Income - e.Expense; _entryBalances[e.Id] = bal; }

        _uniqueCategories = _filtered_entries.Where(t => !string.IsNullOrWhiteSpace(t.Category)).Select(t => t.Category.Trim()).Distinct().OrderBy(c => c).ToList();
    }

