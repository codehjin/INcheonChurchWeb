    private void CloseUnmatchedManager() { showUnmatchedManager = false; activeUnmatchedReceipt = null; } 

    private void ToggleUnmatchedSelection(int id, ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false)) selectedUnmatchedReceiptIds.Add(id);
        else selectedUnmatchedReceiptIds.Remove(id);
    }

    private void ToggleAllUnmatchedSelection(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
        {
            foreach (var r in GetFilteredUnmatchedReceipts()) selectedUnmatchedReceiptIds.Add(r.Id);
        }
        else
        {
            selectedUnmatchedReceiptIds.Clear();
        }
    }

    private async Task DeleteSelectedUnmatchedReceipts()
    {
        if (selectedUnmatchedReceiptIds.Count == 0) return;
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"선택한 {selectedUnmatchedReceiptIds.Count}건의 영수증을 완전히 삭제하시겠습니까?\n(서버 드라이브에서도 사진 파일이 영구 삭제되며 복구할 수 없습니다.)");
        if (!confirmed) return;

        try
        {
            var targets = await DbContext.UploadedReceipts.Where(r => selectedUnmatchedReceiptIds.Contains(r.Id)).ToListAsync();
            var webRoot = Env.WebRootPath;
            
            foreach(var target in targets)
            {
                if (!string.IsNullOrEmpty(target.ImagePath))
                {
                    var filePath = Path.Combine(webRoot, target.ImagePath.TrimStart('/'));
                    if (System.IO.File.Exists(filePath)) System.IO.File.Delete(filePath);
                }
            }

            DbContext.UploadedReceipts.RemoveRange(targets);
            await DbContext.SaveChangesAsync();

            selectedUnmatchedReceiptIds.Clear();
            activeUnmatchedReceipt = null;
            await LoadUnmatchedData();
            await JSRuntime.InvokeVoidAsync("alert", "선택한 영수증 파일이 서버에서 완전히 삭제되었습니다.");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"삭제 중 오류가 발생했습니다: {ex.Message}");
        }
    }

