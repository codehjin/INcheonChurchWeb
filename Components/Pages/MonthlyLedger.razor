    private async Task TriggerPcUpload(int entryId) { targetUploadEntryId = entryId; await JSRuntime.InvokeVoidAsync("triggerFileInput", "pcUploadInput"); }

    private async Task HandlePcUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || targetUploadEntryId == 0) return;
        string result = await Accounting.UploadReceiptAsync(file, targetUploadEntryId);
        if (result == "OK") { await JSRuntime.InvokeVoidAsync("alert", "영수증 업로드 완료!"); DbContext.ChangeTracker.Clear(); await LoadData(); }
        else { await JSRuntime.InvokeVoidAsync("alert", result); }
        targetUploadEntryId = 0;
    }

    private async Task DownloadExcel()
    {
        try
        {
            using var workbook = new XLWorkbook();
            int qDeptIdExcel = SelectedDepartmentId == 0 ? (CurrentUser?.DepartmentId ?? 0) : SelectedDepartmentId;
            var q1RangeExcel = await Accounting.GetQuarterDateRangeAsync(qDeptIdExcel, CurrentYear, 1);
            var q4RangeExcel = await Accounting.GetQuarterDateRangeAsync(qDeptIdExcel, CurrentYear, 4);
            DateTime fyStartExcel = q1RangeExcel.Start.Date;
            DateTime fyEndExcel = q4RangeExcel.End.Date;

            var allData = await DbContext.Transactions.Include(t => t.DepartmentInfo).AsNoTracking()
                .Where(t => t.Date >= fyStartExcel && t.Date <= fyEndExcel && (SelectedDepartmentId == 0 || t.DepartmentId == SelectedDepartmentId))
                .OrderBy(t => t.Date).ToListAsync();
            var bq2 = DbContext.BudgetPlans.AsNoTracking().Where(b => b.Year == CurrentYear);
            if (SelectedDepartmentId != 0) bq2 = bq2.Where(b => b.DepartmentId == SelectedDepartmentId);
            var bp2 = await bq2.ToListAsync();

            decimal baseCarryOver = bp2.FirstOrDefault(b => b.Category.Contains("이월"))?.Amount ?? 0;

            var totalPrevDataExcel = await DbContext.Transactions.AsNoTracking()
                .Where(t => t.DepartmentId == qDeptIdExcel && t.Date < fyStartExcel).ToListAsync();
            decimal runBal = baseCarryOver + totalPrevDataExcel.Sum(x => x.Income) - totalPrevDataExcel.Sum(x => x.Expense);

            foreach (var mg in allData.GroupBy(t => t.Date.ToString("yyyy-MM")).OrderBy(g => g.Key))
            {
                var pts = mg.Key.Split('-');
                int gy = int.Parse(pts[0]); int gm = int.Parse(pts[1]);
                if (CurrentMonth > 0 && gm != CurrentMonth) continue;
                var ws = workbook.Worksheets.Add($"{gy}-{gm:D2}");
                var hdrs = new[] { "날짜", "구분", "분류항목", "내역", "비고", "수입", "지출", "잔액" };
                for (int c = 0; c < hdrs.Length; c++)
                {
                    ws.Cell(1, c + 1).Value = hdrs[c];
                    ws.Cell(1, c + 1).Style.Fill.BackgroundColor = XLColor.LightGray; ws.Cell(1, c + 1).Style.Font.Bold = true; ws.Cell(1, c + 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                }
                ws.Cell(2, 1).Value = "-";
                ws.Cell(2, 2).Value = "이월"; ws.Cell(2, 3).Value = "전월이월"; ws.Cell(2, 6).Value = runBal; ws.Cell(2, 8).Value = runBal;
                ws.Column(6).Style.NumberFormat.Format = "#,##0";
                ws.Column(7).Style.NumberFormat.Format = "#,##0"; ws.Column(8).Style.NumberFormat.Format = "#,##0";
                int row = 3; decimal mI = 0; decimal mE = 0;
                decimal sb = runBal;
                foreach (var item in mg)
                {
                    sb += item.Income - item.Expense;
                    mI += item.Income; mE += item.Expense; runBal += item.Income - item.Expense;
                    ws.Cell(row, 1).Value = item.Date.ToString("yyyy-MM-dd"); ws.Cell(row, 2).Value = item.Type;
                    ws.Cell(row, 3).Value = item.Category;
                    string desc = item.Description;
                    ws.Cell(row, 4).Value = desc;
                    ws.Cell(row, 5).Value = item.Note;
                    ws.Cell(row, 6).Value = item.Income == 0 ? (XLCellValue)"" : (XLCellValue)(decimal)item.Income;
                    ws.Cell(row, 7).Value = item.Expense == 0 ? (XLCellValue)"" : (XLCellValue)(decimal)item.Expense;
                    ws.Cell(row, 8).Value = sb; row++;
                }
                ws.Cell(row, 1).Value = $"{gy}년 {gm}월 계";
                ws.Range(row, 1, row, 5).Merge();
                ws.Cell(row, 6).Value = mI; ws.Cell(row, 7).Value = mE; ws.Cell(row, 8).Value = sb;
                ws.Column(1).Width = 12;
                ws.Column(2).Width = 8; ws.Column(3).Width = 15; ws.Column(4).Width = 35; ws.Column(5).Width = 15;
                ws.Column(6).Width = 12; ws.Column(7).Width = 12;
                ws.Column(8).Width = 12;
            }
            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            string deptName = SelectedDepartmentId == 0 ? "전체부서" : Departments.FirstOrDefault(d => d.Id == SelectedDepartmentId)?.Name ?? "장부";
            await JSRuntime.InvokeVoidAsync("downloadExcelFile", $"{deptName}-{CurrentYear}년-회계장부-{DateTime.Now:yyyyMMdd}.xlsx", Convert.ToBase64String(stream.ToArray()));
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"엑셀 다운로드 오류: {ex.Message}"); }
    }
