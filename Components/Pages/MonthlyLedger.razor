    // 🚀 엑셀 다운로드
    private async Task DownloadExcel() { 
        try { 
            using var workbook = new XLWorkbook();
            var allYearData = await DbContext.Transactions.Include(t => t.DepartmentInfo).AsNoTracking().Where(t => t.FiscalYear == CurrentYear && (SelectedDepartmentId == 0 || t.DepartmentId == SelectedDepartmentId)).OrderBy(t => t.Date).ToListAsync();
            var budgetQuery = DbContext.BudgetPlans.AsNoTracking().Where(b => b.Year == CurrentYear); 
            if (SelectedDepartmentId != 0) budgetQuery = budgetQuery.Where(b => b.DepartmentId == SelectedDepartmentId);
            var budgetPlans = await budgetQuery.ToListAsync(); 
            decimal runningBal = budgetPlans.FirstOrDefault(b => b.Category.Contains("이월"))?.Amount ?? 0;
            var groupedForExcel = allYearData.GroupBy(t => t.Date.ToString("yyyy-MM")).OrderBy(g => g.Key).ToList(); 
            foreach (var monthGroup in groupedForExcel) { 
                var parts = monthGroup.Key.Split('-');
                int gYear = int.Parse(parts[0]); int gMonth = int.Parse(parts[1]); 
                if (CurrentMonth > 0 && gMonth != CurrentMonth) continue;
                var ws = workbook.Worksheets.Add($"{gYear}-{gMonth:D2}"); 
                var headers = new[] { "날짜", "구분", "분류항목", "적요", "비고", "수입", "지출", "잔액" };
                for (int c = 0; c < headers.Length; c++) { ws.Cell(1, c + 1).Value = headers[c];
                ws.Cell(1, c + 1).Style.Fill.BackgroundColor = XLColor.LightGray; ws.Cell(1, c + 1).Style.Font.Bold = true; ws.Cell(1, c + 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                } 
                ws.Cell(2, 1).Value = "-";
                ws.Cell(2, 2).Value = "이월"; ws.Cell(2, 3).Value = "전월이월"; ws.Cell(2, 6).Value = runningBal; ws.Cell(2, 8).Value = runningBal; ws.Column(6).Style.NumberFormat.Format = "#,##0";
                ws.Column(7).Style.NumberFormat.Format = "#,##0"; ws.Column(8).Style.NumberFormat.Format = "#,##0"; 
                int row = 3; decimal mIncome = 0; decimal mExpense = 0;
                decimal currentSheetBal = runningBal; 
                foreach (var item in monthGroup) { currentSheetBal += (item.Income - item.Expense); mIncome += item.Income;
                mExpense += item.Expense; runningBal += (item.Income - item.Expense); ws.Cell(row, 1).Value = item.Date.ToString("yyyy-MM-dd"); ws.Cell(row, 2).Value = item.Type; ws.Cell(row, 3).Value = item.Category;
                string excelDesc = item.Description; if (IsAdmin && SelectedDepartmentId == 0) excelDesc += $" [{item.DepartmentInfo?.Name}]"; ws.Cell(row, 4).Value = excelDesc;
                ws.Cell(row, 5).Value = item.Note; ws.Cell(row, 6).Value = item.Income == 0 ? "" : item.Income;
                ws.Cell(row, 7).Value = item.Expense == 0 ? "" : item.Expense; ws.Cell(row, 8).Value = currentSheetBal; row++;
                } 
                ws.Cell(row, 1).Value = $"{gYear}년 {gMonth}월 계";
                ws.Range(row, 1, row, 5).Merge(); ws.Cell(row, 6).Value = mIncome; ws.Cell(row, 7).Value = mExpense; ws.Cell(row, 8).Value = currentSheetBal; ws.Column(1).Width = 12;
                ws.Column(2).Width = 8; ws.Column(3).Width = 15; ws.Column(4).Width = 35; ws.Column(5).Width = 15; ws.Column(6).Width = 12; ws.Column(7).Width = 12;
                ws.Column(8).Width = 12; 
            } 
            using var stream = new MemoryStream();
            workbook.SaveAs(stream); var base64 = Convert.ToBase64String(stream.ToArray()); string today = DateTime.Now.ToString("yyyyMMdd"); string deptName = SelectedDepartmentId == 0 ?
            "전체부서" : Departments.FirstOrDefault(d => d.Id == SelectedDepartmentId)?.Name ?? "장부"; string fileName = $"{deptName}-{CurrentYear}년-장부-{today}.xlsx"; 
            await JSRuntime.InvokeVoidAsync("downloadExcelFile", fileName, base64);
        } catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"엑셀 생성 오류: {ex.Message}"); } 
    } 
