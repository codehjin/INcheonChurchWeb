    private async Task DeleteSingle(int id)
    {
        using var context = DbContextFactory.CreateDbContext();
        if (await JSRuntime.ConfirmAsync("이 항목을 삭제하시겠습니까?"))
        {
            var t = await context.Transactions.FindAsync(id);
            if (t != null) { context.Transactions.Remove(t); await context.SaveChangesAsync(); await LoadData(); }
        }
    }

    private async Task DeleteSelected()
    {
        using var context = DbContextFactory.CreateDbContext();
        if (await JSRuntime.ConfirmAsync($"선택한 {_editSelectedIds.Count}항목을 삭제하시겠습니까?"))
        {
            var ts = await context.Transactions.Where(t => _editSelectedIds.Contains(t.Id)).ToListAsync();
            context.Transactions.RemoveRange(ts); await context.SaveChangesAsync(); await LoadData();
        }
    }

    private async Task ApplyBulkEdit()
    {
        using var context = DbContextFactory.CreateDbContext();
        if (_editSelectedIds.Count > 0 && !string.IsNullOrEmpty(_bulkCategory))
        {
            var ts = await context.Transactions.Where(t => _editSelectedIds.Contains(t.Id)).ToListAsync();
            foreach (var t in ts)
            {
                t.Category = _bulkCategory;
                if (!string.IsNullOrWhiteSpace(_bulkSubCategory)) t.SubCategory = _bulkSubCategory.Trim();
            }
            await context.SaveChangesAsync(); _bulkCategory = ""; _bulkSubCategory = ""; await LoadData();
        }
    }

