@page "/monthly"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@using INcheonChurchWeb.Data
@using Microsoft.EntityFrameworkCore
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using ClosedXML.Excel
@inject AccountingService Accounting
@inject AppDbContext DbContext
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env
@rendermode InteractiveServer

<PageTitle>월간 장부 조회</PageTitle>

<style>
    /* =======================================================
           🎨 DESIGN SYSTEM: The Tactile Ledger (화면 디자인)
        ======================================================= */
    .ledger-surface {
        background-color: #fbfaee;
        min-height: 100vh;
        padding-bottom: 5rem;
    }

    .ledger-card {
        background-color: #ffffff;
        border-radius: 0.5rem;
        border: none;
        box-shadow: 0 2px 8px rgba(48, 49, 41, 0.04);
        transition: all 0.2s ease-out;
    }

    .ledger-card-warm {
        background-color: #f5f4e8;
        border-radius: 0.5rem;
        border: none;
    }

    .ledger-gold-btn {
        background: linear-gradient(135deg, #785600 0%, #5a4000 100%);
        color: #ffffff;
        font-weight: 700;
        border: none;
        border-radius: 0.375rem;
        padding: 0.5rem 1.25rem;
        font-size: 0.875rem;
        transition: all 0.15s ease-out;
    }

        .ledger-gold-btn:hover {
            transform: translateY(-1px);
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(120, 86, 0, 0.2);
        }

        .ledger-gold-btn:disabled {
            opacity: 0.6;
            transform: none;
            box-shadow: none;
            cursor: not-allowed;
        }

    .ledger-secondary-btn {
        background-color: #eae9dd;
        color: #5a4000;
        font-weight: 700;
        border: none;
        border-radius: 0.375rem;
        padding: 0.5rem 1.25rem;
        font-size: 0.875rem;
        transition: all 0.2s ease-out;
    }

        .ledger-secondary-btn:hover {
            background-color: #e4e3d7;
            color: #5a4000;
        }

        .ledger-secondary-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .ledger-input {
        background-color: #ffffff;
        border: 1px solid #e4e3d7;
        border-radius: 0.375rem;
        padding: 0.4rem 0.75rem;
        font-size: 0.875rem;
        color: #1b1c15;
    }

    select.ledger-input {
        padding-right: 2.25rem !important;
    }

    .ledger-input:focus {
        outline: none;
        border-color: #785600;
        box-shadow: 0 0 0 2px rgba(120, 86, 0, 0.1);
    }

    /* 연도/분기/월 선택기 디자인 */
    .compact-selector {
        display: inline-flex;
        align-items: center;
        background-color: #ffffff;
        border-radius: 0.5rem;
        padding: 0.25rem 0.5rem;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        border: 1px solid #eae9dd;
        gap: 0.25rem;
    }

    .selector-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 0.25rem;
        color: #785600;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: background 0.2s;
        font-size: 0.85rem;
    }

        .selector-btn:hover {
            background-color: #f5f4e8;
        }

    .selector-value {
        font-size: 0.9rem;
        font-weight: 700;
        color: #1b1c15;
        min-width: 3.5rem;
        text-align: center;
    }

    .selector-divider {
        width: 1px;
        height: 1.2rem;
        background-color: #eae9dd;
        margin: 0 0.25rem;
    }

    .ledger-table-container {
        overflow-x: auto;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px rgba(48, 49, 41, 0.04);
        background-color: #ffffff;
        border: 1px solid #eae9dd;
    }

    .ledger-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
        margin-bottom: 0;
        table-layout: fixed;
    }

        .ledger-table th {
            background-color: rgba(234, 233, 221, 0.6);
            color: #4e4637;
            font-weight: 800;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 0.875rem 0.5rem;
            border-bottom: 2px solid #d2c5b2;
            border-right: 1px solid #eae9dd;
            text-align: center;
            white-space: nowrap;
        }

        .ledger-table td {
            padding: 0.75rem 0.5rem;
            vertical-align: middle;
            font-size: 0.9rem;
            color: #1b1c15;
            border-bottom: 1px solid #eae9dd;
            border-right: 1px solid #eae9dd;
            text-align: center;
        }

            .ledger-table th:last-child, .ledger-table td:last-child {
                border-right: none;
            }

        .ledger-table tbody tr {
            transition: background-color 0.15s;
        }

            .ledger-table tbody tr:hover {
                background-color: #fbfcfa;
            }

    .text-truncate-custom {
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        margin: 0 auto;
        text-align: left;
    }

    .ledger-tabular {
        font-variant-numeric: tabular-nums;
    }

    .badge-income {
        background-color: rgba(90, 64, 0, 0.1);
        color: #5a4000;
        font-weight: 700;
        padding: 0.3rem 0.6rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        display: inline-block;
    }

    .badge-expense {
        background-color: rgba(186, 26, 26, 0.1);
        color: #ba1a1a;
        font-weight: 700;
        padding: 0.3rem 0.6rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        display: inline-block;
    }

    .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 0.25rem;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.9rem;
    }

        .icon-btn:hover {
            background-color: #eae9dd;
        }

        .icon-btn.edit {
            color: #198754;
        }

        .icon-btn.delete {
            color: #dc3545;
        }

        .icon-btn.receipt {
            color: #785600;
        }

        .icon-btn.upload {
            color: #e6a23c;
        }

    /* =======================================================
           🖨️ 인쇄 전용 스타일 (Razor 문법 에러 방지 위해 @@ 사용)
        ======================================================= */
    @@media screen {
        .print-only {
            display: block !important;
            visibility: visible !important;
            position: relative !important; /* 🟢 문서 흐름 복원 */
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }
    }

    @@media print {
        /* 🚀 1. 화면용 UI 완벽 차단 (사이드바, 모달, 상단바 등) */
        .sidebar, .top-row, .pc-top-bar, .mobile-top-header, .mobile-bottom-nav,
        .ledger-surface, .no-print, .modal, .modal-backdrop, footer {
            display: none !important;
        }
        /* 🚀 2. Blazor 레이아웃 뼈대 강제 해체 (백지 현상의 핵심 원인 제거) */
        /* height, overflow, position 등 인쇄 문서 길이를 0으로 만드는 모든 속성 초기화 */
        html, body, #app, .page, main, article, .content, .main-content-area {
            display: block !important;
            position: static !important;
            float: none !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            height: auto !important;
            min-height: 0 !important;
            max-height: none !important;
            overflow: visible !important;
            background-color: white !important;
            box-sizing: border-box !important;
        }
        /* 🚀 3. 인쇄 전용 영역 강제 표시 */
        .print-only {
            display: block !important;
            position: static !important;
            visibility: visible !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            page-break-after: auto !important;
        }
        /* 용지 규격 */
        @@page {
            size: A4 portrait;
            margin: 15mm 10mm !important;
        }

        .page-break-before {
            page-break-before: always !important;
            break-before: page !important;
            margin-top: 0 !important;
        }
        /* 장부 테이블 설정 */
        table.table, .ledger-table-print {
            width: 100% !important;
            table-layout: auto !important;
            font-size: 10pt !important;
            border-collapse: collapse !important;
        }

            .ledger-table-print th, .ledger-table-print td {
                word-break: keep-all !important;
                padding: 4px !important;
                border: 1px solid #444 !important;
                vertical-align: middle !important;
            }
                /* 날짜 열 절대 줄바꿈 금지 */
                .ledger-table-print td:nth-child(2) {
                    white-space: nowrap !important;
                    width: 80px !important;
                    text-align: center !important;
                }

        .money-cell-print {
            text-align: right !important;
            white-space: nowrap !important;
        }
        /* 영수증 그리드 설정 */
        .receipt-grid-1 .receipt-box {
            width: 100%;
            height: 257mm; /* 267mm - 10mm 여유 */
            margin-bottom: 0;
            page-break-inside: avoid;
            display: flex !important;
            flex-direction: column;
        }

        .receipt-grid-2 {
            display: flex !important;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 5mm; /* margin-bottom 대신 gap 사용 */
        }

            .receipt-grid-2 .receipt-box {
                width: 48%;
                height: 131mm; /* (267 - 5) ÷ 2 */
                margin-bottom: 0;
                page-break-inside: avoid;
                display: flex !important;
                flex-direction: column;
            }

        .receipt-grid-4 {
            display: flex !important;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 5mm;
        }

            .receipt-grid-4 .receipt-box {
                width: 48%;
                height: 125mm; /* (267 - 5×3) ÷ 2 */
                margin-bottom: 0;
                page-break-inside: avoid;
                display: flex !important;
                flex-direction: column;
            }

        .receipt-img-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px dashed #ccc;
            padding: 2px;
        }

            .receipt-img-wrapper img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .receipt-empty {
            flex: 1;
            border: 2px dashed #999;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14pt;
            color: #ccc;
        }
    }
</style>

<datalist id="incomeCatList">
    @foreach (var cat in IncomeCats)
    {
        <option value="@cat"></option>
    }
</datalist>
<datalist id="expenseCatList">
    @foreach (var cat in ExpenseCats)
    {
        <option value="@cat"></option>
    }
</datalist>

<InputFile id="pcUploadInput" OnChange="HandlePcUpload" style="display:none;" accept="image/*,.pdf" />

<div class="ledger-surface no-print" id="monthly-ledger-content">
    <div class="container-fluid px-3 px-md-4 pt-4">

        @if (CurrentUser == null)
        {
            <div class="text-center py-5">
                <h5 style="color: #785600; font-weight: 700;">로그인이 필요합니다.</h5>
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                <div class="compact-selector">
                    <button class="selector-btn" @onclick="() => ChangeYear(-1)">◀</button>
                    <span class="selector-value">@(CurrentYear)년</span>
                    <button class="selector-btn" @onclick="() => ChangeYear(1)">▶</button>

                    <div class="selector-divider"></div>

                    <select class="settings-input fw-bold border-0 py-1" style="background: transparent; width: auto; box-shadow: none;" @onchange="OnQuarterChanged" value="@CurrentQuarter">
                        <option value="0">전체 분기</option>
                        <option value="1">1분기</option>
                        <option value="2">2분기</option>
                        <option value="3">3분기</option>
                        <option value="4">4분기</option>
                    </select>

                    <div class="selector-divider"></div>

                    <button class="selector-btn" @onclick="() => ChangeMonth(-1)">◀</button>
                    <select class="settings-input fw-bold border-0 py-1 px-1" style="background: transparent; width: auto; box-shadow: none; text-align: center; -webkit-appearance: none; appearance: none;" @onchange="OnMonthChanged" value="@CurrentMonth">
                        <option value="0">전체 월</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@(i)월</option>
                        }
                    </select>
                    <button class="selector-btn" @onclick="() => ChangeMonth(1)">▶</button>
                </div>

                @if (IsAdmin)
                {
                    <select class="form-select ledger-input w-auto fw-bold" @onchange="OnDeptChanged" value="@SelectedDepartmentId">
                        <option value="0">전체 부서</option>
                        @foreach (var dept in Departments)
                        {
                            @if (dept.Name != "관리자" && dept.Name != "교회학교 운영팀" && dept.Name != "감사위원회")
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        }
                    </select>
                }
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="ledger-card p-4 h-100 d-flex flex-column justify-content-center" style="border-left: 4px solid #d2c5b2;">
                        <span style="font-size: 1rem; font-weight: 700; color: #4e4637; text-transform: uppercase; letter-spacing: 0.05em;">전월 이월금 (회계연도 기준)</span>
                        <div class="mt-2 ledger-tabular" style="font-size: 1.5rem; font-weight: 800; color: #1b1c15;">
                            <span style="font-size: 1rem; font-weight: 500;">₩</span> @CarryOverAmount.ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="ledger-card p-4 h-100 d-flex flex-column justify-content-center" style="border-left: 4px solid #eec067;">
                        <span style="font-size: 1rem; font-weight: 700; color: #4e4637; text-transform: uppercase; letter-spacing: 0.05em;">조회 기간 수입 / 지출</span>
                        <div class="mt-2 d-flex align-items-baseline gap-2 ledger-tabular">
                            <span style="font-size: 1.25rem; font-weight: 800; color: #785600;">+ ₩@FilteredEntries.Sum(t => t.Income).ToString("N0")</span>
                            <span style="font-size: 0.9rem; font-weight: 600; color: #ba1a1a;">- ₩@FilteredEntries.Sum(t => t.Expense).ToString("N0")</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="ledger-card p-4 h-100 d-flex flex-column justify-content-center" style="border-left: 4px solid #785600; background-color: #fcfbf6;">
                        <span style="font-size: 1rem; font-weight: 700; color: #785600; text-transform: uppercase; letter-spacing: 0.05em;">현재 잔액</span>
                        <div class="mt-2 ledger-tabular" style="font-size: 1.75rem; font-weight: 900; color: #5a4000;">
                            <span style="font-size: 1.1rem; font-weight: 500;">₩</span> @CurrentBalance.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                <h4 class="fw-bold mb-0" style="color: #1b1c15;">
                    @(CurrentYear) 회계연도 @(CurrentMonth > 0 ? $"{CurrentMonth}월" : CurrentQuarter > 0 ? $"{CurrentQuarter}분기" : "전체") 내역
                </h4>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (CanEditLedger)
                    {
                        <button class="ledger-gold-btn" @onclick="ToggleBatchEditMode">
                            <i class="bi bi-pencil-square me-1"></i> @(isBatchEditMode ? "수정 취소" : "일괄 수정")
                        </button>
                    }
                    <button class="ledger-secondary-btn" @onclick="OpenPrintModal" disabled="@(!FilteredEntries.Any())">
                        <i class="bi bi-printer me-1"></i> 인쇄
                    </button>
                    <button class="ledger-secondary-btn" @onclick="DownloadExcel" disabled="@(!FilteredEntries.Any())">
                        <i class="bi bi-file-earmark-excel me-1"></i> 엑셀
                    </button>
                    @if (CanEditLedger)
                    {
                        <button class="ledger-gold-btn" @onclick="ToggleAddForm">
                            <i class="bi @(isAddingNew ? "bi-dash-lg" : "bi-plus-lg") me-1"></i> @(isAddingNew ? "입력 취소" : "새 항목 입력")
                        </button>
                    }
                </div>
            </div>

            @if (isBatchEditMode && CanEditLedger)
            {
                <div class="ledger-card-warm p-2 mb-3 d-flex flex-wrap align-items-center gap-2" style="background-color:rgba(23, 69, 119, 0.05); border: 1px solid rgba(23, 69, 119, 0.1);">
                    <span class="fw-bold ms-2" style="color: #174577; font-size: 0.9rem;"><i class="bi bi-check-all me-1"></i> @editSelectedIds.Count 건 선택됨</span>
                    <select class="form-select ledger-input w-auto ms-3" @bind="bulkCategory" style="padding: 0.2rem 2rem 0.2rem 0.75rem; font-size: 0.875rem;">
                        <option value="">-- 일괄 변경 분류 --</option>
                        <optgroup label="[수입]">
                            @foreach (var c in IncomeCats)
                            {
                                <option value="@c">@c</option>
                            }
                        </optgroup>
                        <optgroup label="[지출]">
                            @foreach (var c in ExpenseCats)
                            {
                                <option value="@c">@c</option>
                            }
                        </optgroup>
                    </select>
                    <button class="btn btn-sm btn-primary fw-bold px-3" @onclick="ApplyBulkEdit" disabled="@(editSelectedIds.Count == 0 || string.IsNullOrEmpty(bulkCategory))">일괄적용</button>
                    <button class="btn btn-sm btn-outline-danger fw-bold ms-auto px-3" @onclick="DeleteSelected" disabled="@(editSelectedIds.Count == 0)"><i class="bi bi-trash-fill me-1"></i> 선택 삭제</button>
                </div>
            }

            <div class="ledger-table-container">
                @if (isLoading)
                {
                    <div class="text-center py-5"><div class="spinner-border" style="color: #785600;"></div></div>
                }
                else
                {
                    <table class="ledger-table">
                        <colgroup>
                            @if (isBatchEditMode)
                            {
                                <col style="width: 3%;" />
                            }
                            <col style="width: 4%;" />
                            <col style="width: 8%;" />
                            <col style="width: 5%;" />
                            <col style="width: 10%;" />
                            <col style="width: 20%;" />
                            <col style="width: 10%;" />
                            <col style="width: 9%;" />
                            <col style="width: 9%;" />
                            <col style="width: 10%;" />
                            @if (IsAdmin)
                            {
                                <col style="width: 6%;" />
                            }
                            @if (CanEditLedger)
                            {
                                <col style="width: 6%;" />
                            }
                            <col style="width: 6%;" />
                        </colgroup>
                        <thead>
                            <tr>
                                @if (isBatchEditMode)
                                {
                                    <th><input type="checkbox" class="form-check-input" @onchange="ToggleAllEdit" checked="@IsAllEditSelected" /></th>
                                }
                                <th>#</th>
                                <th>날짜</th>
                                <th>구분</th>
                                <th>분류항목</th>
                                <th>내역</th>
                                <th>비고</th>
                                <th>수입</th>
                                <th>지출</th>
                                <th>잔액</th>
                                @if (IsAdmin)
                                {
                                    <th>부서</th>
                                }
                                @if (CanEditLedger)
                                {
                                    <th>관리</th>
                                }
                                <th>증빙</th>
                            </tr>
                            <tr style="background-color: #fbfcfa; border-bottom: 2px solid #d2c5b2;">
                                @if (isBatchEditMode)
                                {
                                    <th></th>
                                }
                                <th></th>
                                <th><input type="text" class="form-control form-control-sm px-1" placeholder="날짜" @bind="filterDate" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                <th>
                                    <select class="form-select form-select-sm px-1" @bind="filterType" @bind:event="onchange" @bind:after="ApplyFilters">
                                        <option value="">전체</option>
                                        <option value="수입">수입</option>
                                        <option value="지출">지출</option>
                                    </select>
                                </th>
                                <th><input type="text" class="form-control form-control-sm px-1" placeholder="검색" @bind="filterCategory" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                <th><input type="text" class="form-control form-control-sm px-1" placeholder="검색" @bind="filterDescription" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                <th><input type="text" class="form-control form-control-sm px-1" placeholder="검색" @bind="filterNote" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                @if (IsAdmin)
                                {
                                    <th><input type="text" class="form-control form-control-sm px-1" placeholder="검색" @bind="filterDepartment" @bind:event="oninput" @bind:after="ApplyFilters" /></th>
                                }
                                @if (CanEditLedger)
                                {
                                    <th></th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNum = 0;
                            }
                            @foreach (var t in FilteredEntries)
                            {
                                rowNum++;
                                bool isEditingThis = editingItemId == t.Id;
                                <tr>
                                    @if (isBatchEditMode)
                                    {
                                        <td><input type="checkbox" class="form-check-input" checked="@editSelectedIds.Contains(t.Id)" @onchange="e => ToggleEditSelection(t.Id, e)" /></td>
                                    }
                                    @if (isEditingThis && editBuffer != null)
                                    {
                                        <td class="fw-bold" style="color: #174577; font-size: 0.75rem;">EDIT</td>
                                        <td><input type="date" class="form-control form-control-sm px-1" @bind="editBuffer.Date" /></td>
                                        <td><select class="form-select form-select-sm px-1" @bind="editBuffer.Type"><option value="수입">수입</option><option value="지출">지출</option></select></td>
                                        <td><input class="form-control form-control-sm px-1 fw-bold" list="@(editBuffer.Type == "수입" ? "incomeCatList" : "expenseCatList")" @bind="editBuffer.Category" /></td>
                                        <td><input class="form-control form-control-sm px-1" @bind="editBuffer.Description" /></td>
                                        <td><input class="form-control form-control-sm px-1" @bind="editBuffer.Note" /></td>
                                        <td>
                                            @if (editBuffer.Type == "수입")
                                            {
                                                <input type="number" class="form-control form-control-sm text-end px-1" @bind="editBuffer.Income" />
                                            }
                                            else
                                            {

                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (editBuffer.Type == "지출")
                                            {
                                                <input type="number" class="form-control form-control-sm text-end px-1" @bind="editBuffer.Expense" />
                                            }
                                            else
                                            {

                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td></td>
                                        @if (IsAdmin)
                                        {
                                            <td></td>
                                        }
                                        @if (CanEditLedger)
                                        {
                                            <td>
                                                <div class="d-flex gap-1 justify-content-center">
                                                    <button class="icon-btn edit" @onclick="SaveEdit" title="저장"><i class="bi bi-check-lg fs-5"></i></button>
                                                    <button class="icon-btn text-muted" @onclick="CancelEdit" title="취소"><i class="bi bi-x-lg"></i></button>
                                                </div>
                                            </td>
                                        }
                                        <td></td>
                                    }
                                    else
                                    {
                                        <td class="ledger-tabular text-muted" style="font-size: 0.8rem;">@rowNum</td>
                                        <td class="ledger-tabular fw-bold" style="color: #4e4637;">@t.Date.ToString("MM.dd")</td>
                                        <td>
                                            @if (t.Type == "수입" || t.Type == "Income")
                                            {
                                                <span class="badge-income">수입</span>
                                            }
                                            else
                                            {

                                                <span class="badge-expense">지출</span>
                                            }
                                        </td>
                                        <td class="fw-bold" style="color: #4e4637;">
                                            <div class="text-truncate-custom" title="@t.Category">@t.Category</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-truncate-custom" title="@t.Description" style="color: #1b1c15;">@t.Description</div>
                                        </td>
                                        <td>
                                            <div class="text-truncate-custom text-muted" title="@t.Note" style="font-size: 0.8rem;">@t.Note</div>
                                        </td>
                                        <td class="text-end ledger-tabular fw-bold" style="color: #785600;">@(t.Income > 0 ? t.Income.ToString("N0") : "")</td>
                                        <td class="text-end ledger-tabular fw-bold" style="color: #ba1a1a;">@(t.Expense > 0 ? t.Expense.ToString("N0") : "")</td>
                                        <td class="text-end ledger-tabular fw-bold" style="color: #1b1c15;">@(entryBalances.TryGetValue(t.Id, out var b) ? b.ToString("N0") : "-")</td>
                                        @if (IsAdmin)
                                        {
                                            <td style="font-size: 0.8rem; color: #807666;">@Departments.FirstOrDefault(d => d.Id == t.DepartmentId)?.Name</td>
                                        }
                                        @if (CanEditLedger)
                                        {
                                            <td>
                                                <div class="d-flex justify-content-center gap-1">
                                                    <button class="icon-btn edit" @onclick="() => StartEdit(t)" title="수정"><i class="bi bi-pencil-fill"></i></button>
                                                    <button class="icon-btn delete" @onclick="() => DeleteSingle(t.Id)" title="삭제"><i class="bi bi-trash-fill"></i></button>
                                                </div>
                                            </td>
                                        }
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                @if (!string.IsNullOrEmpty(t.ReceiptUrl) || !string.IsNullOrEmpty(t.ReceiptPath))
                                                {
                                                    <button class="icon-btn receipt" title="영수증 확인" @onclick="() => ShowReceiptModal(!string.IsNullOrEmpty(t.ReceiptPath) ? t.ReceiptPath! : t.ReceiptUrl!)"><i class="bi bi-receipt-cutoff"></i></button>
                                                    @if (CanEditLedger)
                                                    {
                                                        <button class="icon-btn delete" style="width:24px; height:24px; font-size:0.75rem;" title="영수증 분리" @onclick="() => RemoveReceiptOnly(t.Id)"><i class="bi bi-x-circle-fill"></i></button>
                                                    }
                                                }
                                                else if (CanEditLedger)
                                                {
                                                    <button class="icon-btn upload" title="업로드" @onclick="() => TriggerPcUpload(t.Id)"><i class="bi bi-folder-plus fs-5"></i></button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" style="font-size: 0.75rem;">-</span>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }

                            @if (CanEditLedger && isAddingNew)
                            {
                                <tr style="background-color: #fbfcfa; border-top: 2px solid #785600;">
                                    @if (isBatchEditMode)
                                    {
                                        <td></td>
                                    }
                                    <td class="ledger-tabular fw-bold" style="color: #785600; font-size: 0.75rem;">NEW</td>
                                    <td><input type="date" class="form-control form-control-sm ledger-tabular px-1" @bind="newItem.Date" /></td>
                                    <td><select class="form-select form-select-sm fw-bold px-1" @bind="newItem.Type"><option value="수입">수입</option><option value="지출">지출</option></select></td>
                                    <td><input class="form-control form-control-sm fw-bold px-1" list="@(newItem.Type == "수입" ? "incomeCatList" : "expenseCatList")" @bind="newItem.Category" placeholder="분류입력" /></td>
                                    <td><input class="form-control form-control-sm fw-bold px-1" @bind="newItem.Description" placeholder="내역(필수)" /></td>
                                    <td><input class="form-control form-control-sm px-1" @bind="newItem.Note" placeholder="비고(선택)" /></td>
                                    <td>
                                        @if (newItem.Type == "수입")
                                        {
                                            <input type="number" class="form-control form-control-sm text-end ledger-tabular fw-bold px-1" style="color: #785600;" @bind="newItem.Income" placeholder="0" />
                                        }
                                        else
                                        {

                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (newItem.Type == "지출")
                                        {
                                            <input type="number" class="form-control form-control-sm text-end ledger-tabular fw-bold px-1" style="color: #ba1a1a;" @bind="newItem.Expense" placeholder="0" />
                                        }
                                        else
                                        {

                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end ledger-tabular fw-bold" style="color: #807666; font-size: 0.75rem;">자동계산</td>
                                    @if (IsAdmin)
                                    {
                                        <td>
                                            <select class="form-select ledger-input fw-bold" style="font-size: 0.75rem; padding: 0.2rem 0.5rem; color: #785600;" @bind="newItem.DepartmentId">
                                                <option value="0">부서 선택</option>
                                                @foreach (var dept in Departments.Where(d => d.Name != "관리자" && d.Name != "교회학교 운영팀" && d.Name != "감사위원회"))
                                                {
                                                    <option value="@dept.Id">@dept.Name</option>
                                                }
                                            </select>
                                        </td>
                                    }
                                    @if (CanEditLedger)
                                    {
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                <button class="icon-btn" style="background: linear-gradient(135deg, #785600 0%, #5a4000 100%); color: white;" @onclick="SaveNewEntry" title="저장"><i class="bi bi-check-lg"></i></button>
                                                <button class="icon-btn text-muted" style="background-color: #eae9dd;" @onclick="ToggleAddForm" title="취소"><i class="bi bi-x-lg"></i></button>
                                            </div>
                                        </td>
                                    }
                                    <td><span class="text-muted" style="font-size: 0.7rem;">저장 후</span></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background-color: #eae9dd; border-top: 2px solid #d2c5b2;">
                                @{
                                    int tfColspan = 6; if (isBatchEditMode) tfColspan++;
                                }
                                <td colspan="@tfColspan" class="text-end fw-bold" style="color: #4e4637; padding: 1rem 0.75rem;">조회 기간 합계</td>
                                <td class="text-end ledger-tabular fw-bold" style="color: #785600; padding: 1rem 0.5rem;">₩@FilteredEntries.Sum(t => t.Income).ToString("N0")</td>
                                <td class="text-end ledger-tabular fw-bold" style="color: #ba1a1a; padding: 1rem 0.5rem;">₩@FilteredEntries.Sum(t => t.Expense).ToString("N0")</td>
                                <td class="text-end ledger-tabular fw-bold" style="color: #1b1c15; padding: 1rem 0.5rem;">₩@CurrentBalance.ToString("N0")</td>
                                @if (IsAdmin)
                                {
                                    <td></td>
                                }
                                @if (CanEditLedger)
                                {
                                    <td></td>
                                }
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
        }
    </div>
</div>
<div class="no-print">
    @if (showReceiptModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);" @onclick="CloseReceiptModalHandler">
            <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
                <div class="modal-content ledger-card border-0">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold mb-0" style="color: #1b1c15;">증빙 자료</h5>
                        <button type="button" class="btn-close" @onclick="CloseReceiptModalHandler"></button>
                    </div>
                    <div class="modal-body text-center p-3">
                        <img src="@currentReceiptUrl" class="img-fluid rounded" style="max-height: 75vh; object-fit: contain;" />
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showPrintModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);" @onclick="ClosePrintModal">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content ledger-card border-0">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold mb-0" style="color: #1b1c15;"><i class="bi bi-printer me-2" style="color: #785600;"></i>인쇄 옵션 선택</h5>
                        <button type="button" class="btn-close" @onclick="ClosePrintModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="d-flex gap-3 mb-4">
                            <div class="flex-fill p-3 rounded text-center border"
                                 style="cursor: pointer; transition: all 0.2s; @(selectedPrintType == "Ledger" ? "border-color: #785600; background-color: rgba(120,86,0,0.05);" : "border-color: #eae9dd;")"
                                 @onclick='() => selectedPrintType = "Ledger"'>
                                <i class="bi bi-journal-text fs-2 d-block mb-2" style="color: @(selectedPrintType == "Ledger" ? "#785600" : "#807666");"></i>
                                <strong style="color: @(selectedPrintType == "Ledger" ? "#5a4000" : "#4e4637");">장부 인쇄</strong>
                            </div>
                            <div class="flex-fill p-3 rounded text-center border"
                                 style="cursor: pointer; transition: all 0.2s; @(selectedPrintType == "Receipt" ? "border-color: #785600; background-color: rgba(120,86,0,0.05);" : "border-color: #eae9dd;")"
                                 @onclick='() => selectedPrintType = "Receipt"'>
                                <i class="bi bi-receipt fs-2 d-block mb-2" style="color: @(selectedPrintType == "Receipt" ? "#785600" : "#807666");"></i>
                                <strong style="color: @(selectedPrintType == "Receipt" ? "#5a4000" : "#4e4637");">영수증 인쇄</strong>
                            </div>
                        </div>

                        @if (selectedPrintType == "Receipt")
                        {
                            <div class="p-3 rounded" style="background-color: #f5f4e8;">
                                <label class="fw-bold small d-block text-muted mb-2">A4 1장당 영수증 개수</label>
                                <select class="form-select ledger-input fw-bold mb-4" @bind="receiptsPerSheet">
                                    <option value="1">1장에 1개 (크게)</option>
                                    <option value="2">1장에 2개 (중간)</option>
                                    <option value="4">1장에 4개 (작게)</option>
                                </select>

                                <label class="fw-bold small d-block text-muted mb-2">이미지 포함 여부</label>
                                <div class="form-check form-switch d-flex align-items-center gap-2">
                                    <input class="form-check-input" type="checkbox" id="includeImageSwitch" style="width: 2.5rem; height: 1.25rem;" @bind="includeReceiptImage">
                                    <label class="form-check-label fw-bold ms-2" for="includeImageSwitch" style="color: #1b1c15; margin-top: 0.15rem;">증빙 이미지 함께 인쇄</label>
                                </div>
                                <p class="small text-muted mt-2 mb-0 ms-1">※ 끄면 이미지 없이 빈 양식 칸만 인쇄됩니다.</p>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 rounded text-center" style="background-color: #f5f4e8;">
                                <span class="fw-bold" style="color: #4e4637;">현재 화면에 조회된 내역을 인쇄합니다.</span>
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button class="ledger-secondary-btn flex-fill" @onclick="ClosePrintModal">취소</button>
                        <button class="ledger-gold-btn flex-fill" @onclick="ExecutePrintAction"><i class="bi bi-printer me-1"></i> 인쇄 실행</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="print-only">
    @if (printMode == "Ledger")
    {
        var grouped = FilteredEntries.GroupBy(e => e.Date.ToString("yyyy-MM")).OrderBy(g => g.Key).ToList();
        bool first = true;
        foreach (var mg in grouped)
        {
            var pts = mg.Key.Split('-');
            int gy = int.Parse(pts[0]); int gm = int.Parse(pts[1]);

            decimal pI = Entries.Where(x => x.Date < new DateTime(gy, gm, 1)).Sum(x => x.Income);
            decimal pE = Entries.Where(x => x.Date < new DateTime(gy, gm, 1)).Sum(x => x.Expense);
            decimal sb = CarryOverAmount + pI - pE;
            decimal rb = sb; decimal mI = 0; decimal mEx = 0;
            string pb = first ? "" : "page-break-before"; first = false;

            <div class="@pb">
                <div class="print-only-title" style="text-align:center; font-size:18pt; font-weight:bold; margin-bottom:15px;">
                    @{
                        string pd = SelectedDepartmentId == 0 ? "전체 부서" : Departments.FirstOrDefault(d => d.Id == SelectedDepartmentId)?.Name ?? "";
                    }
                    [ @gy 년 @gm 월 @pd 재정 장부 ]
                </div>

                <table class="ledger-table-print">
                    <thead>
                        <tr>
                            <th style="width:5%">No</th>
                            <th style="width:10%">날짜</th>
                            <th style="width:8%">구분</th>
                            <th style="width:12%">분류항목</th>
                            <th style="width:28%">내역</th>
                            <th style="width:12%">수입</th>
                            <th style="width:12%">지출</th>
                            <th style="width:13%">잔액</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>-</td>
                            <td>-</td>
                            <td>이월</td>
                            <td>전월이월</td>
                            <td style="text-align:left !important;">전월 이월금액</td>
                            <td class="money-cell-print">@sb.ToString("N0")</td>
                            <td class="money-cell-print">-</td>
                            <td class="money-cell-print">@sb.ToString("N0")</td>
                        </tr>

                        @{
                            int seq = 1;
                        }
                        @foreach (var item in mg.OrderBy(x => x.Date))
                        {
                            rb += item.Income - item.Expense;
                            mI += item.Income; mEx += item.Expense;
                            <tr>
                                <td>@seq</td>
                                <td>@item.Date.ToString("MM-dd")</td>
                                <td>@item.Type</td>
                                <td>@item.Category</td>
                                <td style="text-align:left !important;">@item.Description</td>
                                <td class="money-cell-print">@(item.Income > 0 ? item.Income.ToString("N0") : "")</td>
                                <td class="money-cell-print">@(item.Expense > 0 ? item.Expense.ToString("N0") : "")</td>
                                <td class="money-cell-print">@rb.ToString("N0")</td>
                            </tr>
                            seq++;
                        }
                        <tr style="background-color: #f9f9f9 !important; font-weight: bold;">
                            <td colspan="5" style="text-align:right !important; padding-right:10px !important;">@gm 월 합계</td>
                            <td class="money-cell-print">@mI.ToString("N0")</td>
                            <td class="money-cell-print">@mEx.ToString("N0")</td>
                            <td class="money-cell-print">@rb.ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>
                @if (quarterEndMonths.Contains(gm))
                {
                    <div style="margin-top: 40px; page-break-inside: avoid; display: flex; flex-direction: column; align-items: flex-start;">
                        <div style="text-align: left; font-size: 10pt; font-weight: bold; color: #333; margin-bottom: 8px; width: 45%;">
                            [ @gy 년 @gm 월 분기 마감 결재 ]
                        </div>
                        <table style="width: 45%; border-collapse: collapse; font-size: 10pt; text-align: center; border: 1px solid blue;">
                            <tr>
                                <td rowspan="2" style="border: 1px solid blue; width: 10%; font-weight: bold; background-color: #e9ecef !important; -webkit-print-color-adjust: exact; padding: 10px 0;">
                                    결<br /><br />재
                                </td>
                                <td style="border: 1px solid blue; padding: 6px 0; width: 30%; font-weight: bold; background-color: #e9ecef !important; -webkit-print-color-adjust: exact;">회계</td>
                                <td style="border: 1px solid blue; padding: 6px 0; width: 30%; font-weight: bold; background-color: #e9ecef !important; -webkit-print-color-adjust: exact;">팀장</td>
                                <td style="border: 1px solid blue; padding: 6px 0; width: 30%; font-weight: bold; background-color: #e9ecef !important; -webkit-print-color-adjust: exact;">국장</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid blue; height: 70px;"></td>
                                <td style="border: 1px solid blue; height: 70px;"></td>
                                <td style="border: 1px solid blue; height: 70px;"></td>
                            </tr>
                        </table>
                    </div>
                }
                </div>
                }
    }
    else if (printMode == "Receipt")
    {
        <div class="receipt-grid-@receiptsPerSheet">
            @foreach (var t in printTargets)
            {
                int seqNum = FilteredEntries.IndexOf(t) + 1;
                string fontSize = receiptsPerSheet == 1 ? "13pt" : (receiptsPerSheet == 2 ? "11pt" : "9.5pt");

                <div class="receipt-box">
                    <div style="display: flex; flex-wrap: nowrap; align-items: center; border-bottom: 1.5pt solid #444; padding: 4px 2px; margin-bottom: 6px; font-weight: bold; font-size: @fontSize; width: 100%; overflow: hidden;">
                        <div style="flex: 0 0 8%; text-align: left;">@seqNum</div>
                        <div style="flex: 0 0 20%; text-align: left; white-space: nowrap;">@t.Date.ToString("M월 d일")</div>
                        <div style="flex: 1 1 auto; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 5px; margin-right: 5px;">
                            @t.Description
                        </div>
                        <div style="flex: 0 0 24%; text-align: right; color: #ba1a1a; white-space: nowrap;">
                            @t.Expense.ToString("N0")
                        </div>
                    </div>

                    @if (includeReceiptImage && (!string.IsNullOrEmpty(t.ReceiptPath) || !string.IsNullOrEmpty(t.ReceiptUrl)))
                    {
                        <div class="receipt-img-wrapper">
                            <img src="@(!string.IsNullOrEmpty(t.ReceiptPath) ? t.ReceiptPath : t.ReceiptUrl)" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                        </div>
                    }
                    else
                    {
                        <div class="receipt-empty">증빙 이미지 없음</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private int CurrentYear = DateTime.Now.Year;
    private int CurrentMonth = DateTime.Now.Month;
    private int CurrentQuarter = 0;
    private int SelectedDepartmentId = 0;
    private bool IsAdmin => CurrentUser?.Role == "Admin" || CurrentUser?.Role == "Auditor";
    private bool CanEditLedger => CurrentUser?.Role == "Admin" || CurrentUser?.Role == "Manager";
    private List<Department> Departments = new();
    private List<LedgerEntry> Entries = new();
    private List<LedgerEntry> FilteredEntries = new();
    private decimal CarryOverAmount = 0;
    private decimal CurrentBalance => CarryOverAmount + FilteredEntries.Sum(t => t.Income) - FilteredEntries.Sum(t => t.Expense);
    private Dictionary<int, decimal> entryBalances = new();

    private List<string> IncomeCats = new();
    private List<string> ExpenseCats = new();
    private List<string> UniqueCategories = new();

    private string filterType = "";
    private string filterCategory = "";
    private string filterDate = "";
    private string filterDescription = "";
    private string filterNote = "";
    private string filterDepartment = "";

    private bool isBatchEditMode = false;
    private HashSet<int> editSelectedIds = new();
    private HashSet<int> printSelectedIds = new();
    private bool IsAllEditSelected => FilteredEntries.Any() && editSelectedIds.Count == FilteredEntries.Count;
    private string bulkCategory = "";
    private bool isAddingNew = false;
    private LedgerEntry newItem = new() { Date = DateTime.Now, Type = "지출", Income = 0, Expense = 0 };
    private int? editingItemId = null;
    private LedgerEntry? editBuffer = null;

