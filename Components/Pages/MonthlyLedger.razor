@* ==========================================
   인쇄 전용 출력 영역 (Print Only Area)
========================================== *@
<div class="print-only">
    @if (printMode == "Ledger")
    {
        var grouped = FilteredEntries.GroupBy(e => e.Date.ToString("yyyy-MM")).OrderBy(g => g.Key).ToList();
        bool first = true;
        foreach (var mg in grouped)
        {
            var pts = mg.Key.Split('-');
            int gy = int.Parse(pts[0]); int gm = int.Parse(pts[1]);
            decimal pI = Entries.Where(x => x.Date < new DateTime(gy, gm, 1)).Sum(x => x.Income);
            decimal pE = Entries.Where(x => x.Date < new DateTime(gy, gm, 1)).Sum(x => x.Expense);
            decimal sb = CarryOverAmount + pI - pE;
            decimal rb = sb; decimal mI = 0; decimal mEx = 0;
            string pb = first ? "" : "page-break-before mt-5"; first = false;

            <div class="@pb">
                <div class="print-only-title">
                    @{
                        string pd = SelectedDepartmentId == 0 ? "전체 부서" : Departments.FirstOrDefault(d => d.Id == SelectedDepartmentId)?.Name ?? "";
                    }
                    [ @gy 년 @gm 월 @pd 재정 장부 ]
                </div>
                <table class="table table-bordered mb-0">
                    <thead>
                        <tr>
                            <th style="width:7%" class="text-center">No</th>
                            <th style="width:10%" class="text-center">날짜</th>
                            <th style="width:6%" class="text-center">구분</th>
                            <th style="width:10%" class="text-center">분류항목</th>
                            <th style="width:23%" class="text-center">내역</th>
                            <th style="width:13%" class="text-center">비고</th>
                            <th style="width:10%" class="text-center">수입</th>
                            <th style="width:10%" class="text-center">지출</th>
                            <th style="width:11%" class="text-center">잔액</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td></td><td class="text-center">-</td><td class="text-center">이월</td><td class="text-center">전월이월</td><td></td><td></td><td class="text-end money-cell">@sb.ToString("N0")</td><td class="text-end money-cell">-</td><td class="text-end money-cell">@sb.ToString("N0")</td></tr>
                        @{
                            int seq = 1;
                        }
                        @foreach (var item in mg.OrderBy(x => x.Date))
                        {
                            rb += item.Income - item.Expense;
                            mI += item.Income; mEx += item.Expense;
                            <tr>
                                <td class="text-center">@seq</td>
                                <td class="text-center">@item.Date.ToString("MM-dd")</td>
                                <td class="text-center">@item.Type</td>
                                <td class="text-center clip-cell">@item.Category</td>
                                <td class="clip-cell">@item.Description @(IsAdmin && SelectedDepartmentId == 0 ? $"[{Departments.FirstOrDefault(d => d.Id == item.DepartmentId)?.Name}]" : "")</td>
                                <td class="clip-cell">@item.Note</td>
                                <td class="text-end money-cell">@(item.Income > 0 ? item.Income.ToString("N0") : "")</td>
                                <td class="text-end money-cell">@(item.Expense > 0 ? item.Expense.ToString("N0") : "")</td>
                                <td class="text-end money-cell">@rb.ToString("N0")</td>
                            </tr>
                            seq++;
                        }
                    </tbody>
                    <tfoot><tr><td colspan="6" class="text-end fw-bold">@gy 년 @gm 월 계</td><td class="text-end money-cell fw-bold">@mI.ToString("N0")</td><td class="text-end money-cell fw-bold">@mEx.ToString("N0")</td><td class="text-end money-cell fw-bold">@rb.ToString("N0")</td></tr></tfoot>
                </table>
            </div>
        }
    }
    else if (printMode == "Receipt")
    {
        <div class="receipt-grid-@receiptsPerSheet">
            @foreach (var t in printTargets)
            {
                <div class="receipt-box">
                    <div class="text-center" style="border-bottom:1px solid #999; padding:4px 0; margin-bottom:8px; font-size:11pt; font-weight:bold;">
                        @t.Date.ToString("MM-dd") | @(t.Description?.Length > 10 ? t.Description.Substring(0, 10) : t.Description) | @t.Expense.ToString("N0")원
                    </div>
                    @if (includeReceiptImage && (!string.IsNullOrEmpty(t.ReceiptPath) || !string.IsNullOrEmpty(t.ReceiptUrl)))
                    {
                        <div class="receipt-img-wrapper">
                            <img src="@(!string.IsNullOrEmpty(t.ReceiptPath) ? t.ReceiptPath : t.ReceiptUrl)" />
                        </div>
                    }
                    else
                    {
                        <div class="receipt-empty">증빙물 부착란</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    private int CurrentYear = DateTime.Now.Year;
    private int CurrentMonth = DateTime.Now.Month;
    private int CurrentQuarter = 0;
    private int SelectedDepartmentId = 0;
    private bool IsAdmin => CurrentUser?.Role == "Admin" || CurrentUser?.Role == "Auditor";
    private bool CanEditLedger => CurrentUser?.Role == "Admin" || CurrentUser?.Role == "Manager";
    private List<Department> Departments = new();
    private List<LedgerEntry> Entries = new();
    private List<LedgerEntry> FilteredEntries = new();
    private decimal CarryOverAmount = 0;
    private decimal CurrentBalance => CarryOverAmount + FilteredEntries.Sum(t => t.Income) - FilteredEntries.Sum(t => t.Expense);
    private Dictionary<int, decimal> entryBalances = new();

    private List<string> IncomeCats = new();
    private List<string> ExpenseCats = new();
    private List<string> UniqueCategories = new();

    private string filterType = "";
    private string filterCategory = "";

    private bool isBatchEditMode = false;
    private bool isBatchPrintMode = false;
    private HashSet<int> editSelectedIds = new();
    private HashSet<int> printSelectedIds = new();
    private bool IsAllEditSelected => FilteredEntries.Any() && editSelectedIds.Count == FilteredEntries.Count;
    private bool IsAllPrintSelected => FilteredEntries.Any(t => t.Type == "지출") && printSelectedIds.Count == FilteredEntries.Count(t => t.Type == "지출");
    private string bulkCategory = "";

    private bool isAddingNew = false;
    private LedgerEntry newItem = new() { Date = DateTime.Now, Type = "지출", Income = 0, Expense = 0 };
    private int? editingItemId = null;
    private LedgerEntry? editBuffer = null;

    private bool showReceiptModal = false;
    private string currentReceiptUrl = "";
    private bool isLoading = false;

    // 🚀 인쇄 관련 속성
    private bool showPrintModal = false;
    private string selectedPrintType = "Ledger";
    private string printMode = "Ledger";
    private int receiptsPerSheet = 2;
    private bool includeReceiptImage = true;
    private List<LedgerEntry> printTargets = new();

    private int targetUploadEntryId = 0;

    protected override async Task OnInitializedAsync()
    {
        Departments = await Accounting.GetDepartmentsAsync();
        if (CurrentUser?.Department != null)
        {
            SelectedDepartmentId = IsAdmin ? 0 : CurrentUser.DepartmentId;
            await LoadData();
        }
    }

    private async Task OnDeptChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int d)) { SelectedDepartmentId = d; await LoadData(); } }
    private async Task ChangeYear(int v) { CurrentYear += v; await LoadData(); }
    private async Task OnMonthChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int m)) { CurrentMonth = m; CurrentQuarter = 0; await LoadData(); } }
    private async Task OnQuarterChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int q)) { CurrentQuarter = q; CurrentMonth = 0; await LoadData(); } }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var query = DbContext.Transactions.Include(t => t.DepartmentInfo).AsNoTracking().Where(t => t.FiscalYear == CurrentYear);
            if (SelectedDepartmentId != 0) query = query.Where(t => t.DepartmentId == SelectedDepartmentId);
            var allYearData = await query.OrderBy(t => t.Date).ToListAsync();

            var bq = DbContext.BudgetPlans.AsNoTracking().Where(b => b.Year == CurrentYear);
            if (SelectedDepartmentId != 0) bq = bq.Where(b => b.DepartmentId == SelectedDepartmentId);
            var bp = await bq.ToListAsync();

            IncomeCats = bp.Where(b => b.Type == "Income" || b.Type == "수입").Select(b => b.Category).Distinct().ToList();
            ExpenseCats = bp.Where(b => b.Type == "Expense" || b.Type == "지출").Select(b => b.Category).Distinct().ToList();
            if (!IncomeCats.Any()) IncomeCats = new List<string> { "주일헌금", "십일조", "감사헌금", "절기특별헌금", "기타수입" };
            if (!ExpenseCats.Any()) ExpenseCats = new List<string> { "예배", "교육비", "부서운영비", "기타지출" };

            decimal baseCarryOver = bp.FirstOrDefault(b => b.Category.Contains("이월"))?.Amount ?? 0;
            int qDeptId = SelectedDepartmentId == 0 ? (CurrentUser?.DepartmentId ?? 0) : SelectedDepartmentId;
            var q1 = await Accounting.GetQuarterDateRangeAsync(qDeptId, CurrentYear, 1);
            var q2 = await Accounting.GetQuarterDateRangeAsync(qDeptId, CurrentYear, 2);
            var q3 = await Accounting.GetQuarterDateRangeAsync(qDeptId, CurrentYear, 3);
            var q4 = await Accounting.GetQuarterDateRangeAsync(qDeptId, CurrentYear, 4);

            var prevData = new List<LedgerEntry>();
            IEnumerable<LedgerEntry> fq = allYearData;

            if (CurrentMonth > 0)
            {
                int mYear = (CurrentMonth == 11 || CurrentMonth == 12) ? CurrentYear - 1 : CurrentYear;
                DateTime ms = new DateTime(mYear, CurrentMonth, 1);
                DateTime me = new DateTime(mYear, CurrentMonth, DateTime.DaysInMonth(mYear, CurrentMonth));
                if (CurrentMonth == 11 && mYear == CurrentYear - 1) ms = q1.Start.Date;
                if (CurrentMonth == 11 && mYear == CurrentYear) me = q4.End.Date;
                fq = allYearData.Where(t => t.Date.Date >= ms && t.Date.Date <= me);
                prevData = allYearData.Where(x => x.Date.Date < ms).ToList();
            }
            else if (CurrentQuarter > 0)
            {
                DateTime qS = CurrentQuarter switch { 1 => q1.Start, 2 => q2.Start, 3 => q3.Start, 4 => q4.Start, _ => q1.Start };
                DateTime qE = CurrentQuarter switch { 1 => q1.End, 2 => q2.End, 3 => q3.End, 4 => q4.End, _ => q4.End };
                fq = allYearData.Where(t => t.Date.Date >= qS.Date && t.Date.Date <= qE.Date);
                prevData = allYearData.Where(x => x.Date.Date < qS.Date).ToList();
            }
            else
            {
                fq = allYearData.Where(t => t.Date.Date >= q1.Start.Date && t.Date.Date <= q4.End.Date);
            }

            CarryOverAmount = baseCarryOver + prevData.Sum(x => x.Income) - prevData.Sum(x => x.Expense);
            Entries = fq.ToList();
            ApplyFilters();
            editSelectedIds.Clear(); printSelectedIds.Clear();
        }
        finally { isLoading = false; }
    }

    private void ApplyFilters()
    {
        var temp = Entries.AsEnumerable();
        if (!string.IsNullOrEmpty(filterType)) temp = temp.Where(x => x.Type == filterType);
        if (!string.IsNullOrEmpty(filterCategory)) temp = temp.Where(x => x.Category.Contains(filterCategory, StringComparison.OrdinalIgnoreCase));
        FilteredEntries = temp.ToList();

        entryBalances.Clear();
        decimal bal = CarryOverAmount;
        foreach (var e in FilteredEntries) { bal += e.Income - e.Expense; entryBalances[e.Id] = bal; }

        UniqueCategories = FilteredEntries.Where(t => !string.IsNullOrWhiteSpace(t.Category)).Select(t => t.Category.Trim()).Distinct().OrderBy(c => c).ToList();
    }

    private void ToggleAddForm()
    {
        isAddingNew = !isAddingNew;
        isBatchEditMode = false; isBatchPrintMode = false;
        if (isAddingNew)
        {
            int y = CurrentYear > 2000 ? CurrentYear : DateTime.Now.Year;
            int m = CurrentMonth > 0 ? CurrentMonth : DateTime.Now.Month;
            int d = (y == DateTime.Now.Year && m == DateTime.Now.Month) ? DateTime.Now.Day : 1;
            DateTime def;
            try { def = new DateTime(y, m, d); } catch { def = DateTime.Now; }
            newItem = new LedgerEntry { Date = def, Type = "지출", Income = 0, Expense = 0, DepartmentId = SelectedDepartmentId, Category = "", Description = "", Note = "" };
        }
    }

    private void ToggleBatchEditMode() { isBatchEditMode = !isBatchEditMode; isAddingNew = false; isBatchPrintMode = false; editSelectedIds.Clear(); }

    // 🚀 인쇄 팝업 및 실행 로직
    private void OpenPrintModal() { showPrintModal = true; selectedPrintType = "Ledger"; }
    private void ClosePrintModal() { showPrintModal = false; }

    private async Task ExecutePrintAction()
    {
        showPrintModal = false;
        if (selectedPrintType == "Ledger")
        {
            printMode = "Ledger";
            StateHasChanged();
            await Task.Delay(100);
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        else
        {
            printTargets = FilteredEntries.Where(t => t.Type == "지출" || t.Type == "Expense").ToList();
            if (!printTargets.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "인쇄할 지출 내역(영수증)이 현재 화면에 없습니다.");
                return;
            }
            printMode = "Receipt";
            StateHasChanged();
            await Task.Delay(100);
            await JSRuntime.InvokeVoidAsync("window.print");
        }
    }

    private async Task SaveNewEntry()
    {
        if (string.IsNullOrWhiteSpace(newItem.Description)) { await JSRuntime.InvokeVoidAsync("alert", "내역을 입력해주세요."); return; }
        if (string.IsNullOrWhiteSpace(newItem.Category)) newItem.Category = "미분류";
        newItem.DepartmentId = SelectedDepartmentId == 0 ? (CurrentUser?.DepartmentId ?? 0) : SelectedDepartmentId;
        newItem.FiscalYear = CurrentYear;
        newItem.Quarter = GetQuarter(newItem.Date);
        newItem.Note ??= "";
        if (newItem.Type == "수입") newItem.Expense = 0; else newItem.Income = 0;

        DbContext.Transactions.Add(newItem);
        await DbContext.SaveChangesAsync();
        isAddingNew = false;
        newItem = new LedgerEntry { Date = DateTime.Now, Type = "지출", Income = 0, Expense = 0 };
        await LoadData();
    }

    private void StartEdit(LedgerEntry item)
    {
        editingItemId = item.Id;
        editBuffer = new LedgerEntry { Id = item.Id, Date = item.Date, Type = item.Type, Category = item.Category, Description = item.Description ?? "", Note = item.Note ?? "", Income = item.Income, Expense = item.Expense, DepartmentId = item.DepartmentId, FiscalYear = item.FiscalYear, Quarter = item.Quarter };
    }

    private void CancelEdit() { editingItemId = null; editBuffer = null; }

    private async Task SaveEdit()
    {
        if (editBuffer == null) return;
        if (string.IsNullOrWhiteSpace(editBuffer.Description)) { await JSRuntime.InvokeVoidAsync("alert", "내역을 입력해주세요."); return; }
        var ex = await DbContext.Transactions.FindAsync(editBuffer.Id);
        if (ex != null)
        {
            ex.Date = editBuffer.Date;
            ex.Type = editBuffer.Type;
            ex.Category = string.IsNullOrWhiteSpace(editBuffer.Category) ? "미분류" : editBuffer.Category;
            ex.Description = editBuffer.Description ?? "";
            ex.Note = editBuffer.Note ?? "";
            if (ex.Type == "수입") { ex.Expense = 0; ex.Income = editBuffer.Income; } else { ex.Income = 0; ex.Expense = editBuffer.Expense; }
            ex.Quarter = GetQuarter(editBuffer.Date);
            ex.FiscalYear = editBuffer.Date.Year;
            await DbContext.SaveChangesAsync();
        }
        editingItemId = null; await LoadData();
    }

    private void ToggleEditSelection(int id, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) editSelectedIds.Add(id); else editSelectedIds.Remove(id); }
    private void ToggleAllEdit(ChangeEventArgs e) { if ((bool)(e.Value ?? false)) foreach (var i in FilteredEntries) editSelectedIds.Add(i.Id); else editSelectedIds.Clear(); }
    private void TogglePrintSelection(int id, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) printSelectedIds.Add(id); else printSelectedIds.Remove(id); }
    private void ToggleAllPrint(ChangeEventArgs e) { if ((bool)(e.Value ?? false)) foreach (var i in FilteredEntries.Where(t => t.Type == "지출")) printSelectedIds.Add(i.Id); else printSelectedIds.Clear(); }

    private async Task DeleteSingle(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "이 항목을 삭제하시겠습니까?"))
        {
            var t = await DbContext.Transactions.FindAsync(id);
            if (t != null) { DbContext.Transactions.Remove(t); await DbContext.SaveChangesAsync(); await LoadData(); }
        }
    }

    private async Task DeleteSelected()
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"선택한 {editSelectedIds.Count}항목을 삭제하시겠습니까?"))
        {
            var ts = await DbContext.Transactions.Where(t => editSelectedIds.Contains(t.Id)).ToListAsync();
            DbContext.Transactions.RemoveRange(ts); await DbContext.SaveChangesAsync(); await LoadData();
        }
    }

    private async Task ApplyBulkEdit()
    {
        if (editSelectedIds.Count > 0 && !string.IsNullOrEmpty(bulkCategory))
        {
            var ts = await DbContext.Transactions.Where(t => editSelectedIds.Contains(t.Id)).ToListAsync();
            foreach (var t in ts) t.Category = bulkCategory; await DbContext.SaveChangesAsync(); bulkCategory = ""; await LoadData();
        }
    }

