@page "/ledger/print"
@using INcheonChurchWeb.Models
@using INcheonChurchWeb.Services
@inject AccountingService Accounting
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>장부 인쇄</PageTitle>

<style>
    /* 인쇄 화면에서는 앱/웹 레이아웃 껍데기를 모두 감춘다 */
    .sidebar, .pc-top-bar, .mobile-top-header, .ma-tabbar { display: none !important; }
    .main-content-area { margin-left: 0 !important; }
    .content, .content.mobile-content {
        padding: 0 !important; margin: 0 !important;
    }
    body { background: #ffffff !important; }

    /* 화면에서만 보이는 도구 막대 */
    .lp-bar {
        position: sticky; top: 0; z-index: 10;
        display: flex; align-items: center; gap: 8px;
        padding: 10px 16px calc(10px + env(safe-area-inset-top));
        background: #ffffff; border-bottom: 1px solid #E7E5DE;
    }
    .lp-bar .title { font-size: 16px; font-weight: 700; color: #1B1C15; margin-right: auto; }
    .lp-btn {
        min-height: 44px; padding: 0 16px; border: none; border-radius: 12px;
        font-size: 15px; font-weight: 600; cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .lp-btn.primary { background: #785600; color: #fff; }
    .lp-btn.secondary { background: #EFEFEA; color: #1B1C15; }

    .lp-hint {
        padding: 12px 16px; font-size: 13px; color: #8A8577; background: #F6F6F4;
        border-bottom: 1px solid #E7E5DE;
    }

    .lp-sheet { padding: 16px; color: #000; font-family: 'Pretendard', 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif; }

    /* ── 아래부터는 웹 인쇄(GeneratePrintHtmlAsync)와 같은 규칙 ── */
    .print-only-title { text-align: center; font-size: 18pt; font-weight: bold; margin-bottom: 15px; color: black; }
    .ledger-table-print { width: 100%; border-collapse: collapse; font-size: 10pt; color: black; table-layout: auto; }
    .ledger-table-print th, .ledger-table-print td {
        border: 1px solid #444; padding: 4px; text-align: center; word-break: keep-all; vertical-align: middle;
    }
    .ledger-table-print th { background-color: #e9ecef !important; font-weight: bold; }
    .money-cell-print { text-align: right !important; white-space: nowrap !important; }

    .receipt-grid-1, .receipt-grid-2, .receipt-grid-4 {
        display: flex !important; flex-wrap: wrap !important; justify-content: space-between !important;
        align-content: flex-start; gap: 0;
    }
    .receipt-box { page-break-inside: avoid; display: flex; flex-direction: column; color: black; margin: 0; padding: 0; }
    .receipt-grid-1 .receipt-box { height: 266mm; width: 100%; }
    .receipt-grid-2 .receipt-box { height: 266mm; width: 48.5%; }
    .receipt-grid-4 { row-gap: 4mm !important; column-gap: 3% !important; }
    .receipt-grid-4 .receipt-box { height: 131mm; width: 48.5%; }
    .receipt-img-wrapper {
        flex: 1; display: flex; align-items: center; justify-content: center;
        border: 1px dashed #eee; overflow: hidden; background-color: white;
    }
    .receipt-img-wrapper img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .receipt-empty { flex: 1; border: 1px dashed #eee; display: flex; align-items: center; justify-content: center; }

    .page-break-before { page-break-before: always !important; break-before: page !important; }

    @@media print {
        .lp-bar, .lp-hint { display: none !important; }
        .lp-sheet { padding: 0 !important; }
        * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        @@page { size: A4 portrait; margin: 25mm 10mm 5mm 10mm; }
        html, body { margin: 0 !important; padding: 0 !important; background: #fff !important; }
    }
</style>

<div class="lp-bar">
    <span class="title">@(IsReceiptMode ? "영수증 인쇄" : "장부 인쇄")</span>
    <button class="lp-btn secondary" @onclick="GoBack">닫기</button>
    <button class="lp-btn primary" @onclick="DoPrint"><i class="bi bi-printer"></i>인쇄 · PDF 저장</button>
</div>

<div class="lp-hint">
    인쇄 창에서 <b>대상</b>을 <b>PDF로 저장</b>으로 바꾸면 파일로 받을 수 있습니다.
</div>

<div class="lp-sheet">
@if (CurrentUser is null || _isLoading)
{
    <div style="text-align:center; padding:48px 16px; color:#8A8577;">불러오는 중…</div>
}
else if (IsReceiptMode)
{
    @if (!_receiptTargets.Any())
    {
        <div style="text-align:center; padding:48px 16px; color:#8A8577;">인쇄할 지출 내역(영수증)이 현재 화면에 없습니다.</div>
    }
    else
    {
        var groups = _receiptTargets.GroupBy(t => t.Date.ToString("yyyy-MM")).OrderBy(g => g.Key).ToList();
        var firstMonth = true;

        @foreach (var group in groups)
        {
            var pageBreak = firstMonth ? "" : "page-break-before";
            firstMonth = false;
            var monthlySeq = 1;
            var fontSize = Per == 1 ? "13pt" : (Per == 2 ? "11pt" : "9.5pt");

            <div class="@pageBreak">
                <div class="receipt-grid-@Per">
                    @foreach (var t in group.OrderBy(x => x.Date))
                    {
                        <div class="receipt-box">
                            <div style="display:flex; flex-wrap:nowrap; align-items:center; border-bottom:1.5pt solid #444; padding:4px 2px; margin-bottom:6px; font-weight:bold; font-size:@fontSize; width:100%; overflow:hidden;">
                                <div style="flex:0 0 10%; text-align:left;">
                                    <span style="border:1.0pt solid #444; display:inline-block; width:28px; height:28px; line-height:24px; text-align:center; border-radius:2px;">@monthlySeq</span>
                                </div>
                                <div style="flex:0 0 20%; text-align:left; white-space:nowrap;">@t.Date.ToString("M월 d일")</div>
                                <div style="flex:1 1 auto; text-align:left; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; padding:0 5px; margin-right:5px;">@t.Description</div>
                                <div style="flex:0 0 25%; text-align:right; color:#ba1a1a; white-space:nowrap;">@t.Expense.ToString("N0")</div>
                            </div>

                            @if (WithImage && ReceiptOf(t) is string url)
                            {
                                <div class="receipt-img-wrapper">
                                    <img src="@url" style="max-width:100%; max-height:100%; object-fit:contain;" />
                                </div>
                            }
                            else
                            {
                                <div class="receipt-empty"></div>
                            }
                        </div>
                        monthlySeq++;
                    }
                </div>
            </div>
        }
    }
}
else
{
    @if (!_view.Entries.Any())
    {
        <div style="text-align:center; padding:48px 16px; color:#8A8577;">조회된 장부 내역이 없습니다.</div>
    }
    else
    {
        var grouped = _view.Entries.GroupBy(e => e.Date.ToString("yyyy-MM")).OrderBy(g => g.Key).ToList();
        var first = true;

        @foreach (var mg in grouped)
        {
            var parts = mg.Key.Split('-');
            int gy = int.Parse(parts[0]);
            int gm = int.Parse(parts[1]);

            // 그 달 이전까지의 증감을 이월금에 더해 시작 잔액을 만든다 (웹 인쇄와 같은 계산)
            var monthStart = new DateTime(gy, gm, 1);
            decimal prevIn = _view.Entries.Where(x => x.Date < monthStart).Sum(x => x.Income);
            decimal prevEx = _view.Entries.Where(x => x.Date < monthStart).Sum(x => x.Expense);
            decimal startBalance = _view.CarryOver + prevIn - prevEx;

            decimal running = startBalance;
            decimal monthIn = 0, monthEx = 0;
            int seq = 1;
            var pb = first ? "" : "page-break-before";
            first = false;

            <div class="@pb">
                <div class="print-only-title">[ @gy 년 @gm 월 @_deptLabel 재정 장부 ]</div>

                <table class="ledger-table-print">
                    <thead>
                        <tr>
                            <th style="width:4%">No</th>
                            <th style="width:9%">날짜</th>
                            <th style="width:7%">구분</th>
                            <th style="width:12%">분류항목</th>
                            <th style="width:10%">세부</th>
                            <th style="width:22%">내역</th>
                            <th style="width:12%">수입</th>
                            <th style="width:12%">지출</th>
                            <th style="width:12%">잔액</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="background-color:#f9f9f9 !important;">
                            <td>-</td>
                            <td>-</td>
                            <td>이월</td>
                            <td>전월이월</td>
                            <td></td>
                            <td style="text-align:left !important;">전월 이월금액</td>
                            <td class="money-cell-print">@startBalance.ToString("N0")</td>
                            <td class="money-cell-print">-</td>
                            <td class="money-cell-print">@startBalance.ToString("N0")</td>
                        </tr>

                        @foreach (var item in mg.OrderBy(x => x.Date).ThenBy(x => x.Id))
                        {
                            running += item.Income - item.Expense;
                            monthIn += item.Income;
                            monthEx += item.Expense;

                            <tr>
                                <td>@seq</td>
                                <td>@item.Date.ToString("MM-dd")</td>
                                <td>@item.Type</td>
                                <td>@item.Category</td>
                                <td>@item.SubCategory</td>
                                <td style="text-align:left !important;">@item.Description</td>
                                <td class="money-cell-print">@(item.Income > 0 ? item.Income.ToString("N0") : "")</td>
                                <td class="money-cell-print">@(item.Expense > 0 ? item.Expense.ToString("N0") : "")</td>
                                <td class="money-cell-print">@running.ToString("N0")</td>
                            </tr>
                            seq++;
                        }

                        <tr style="background-color:#f9f9f9 !important; font-weight:bold;">
                            <td colspan="6" style="text-align:right !important; padding-right:10px !important;">@gm 월 합계</td>
                            <td class="money-cell-print">@monthIn.ToString("N0")</td>
                            <td class="money-cell-print">@monthEx.ToString("N0")</td>
                            <td class="money-cell-print">@running.ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    }
}
</div>

@code {
    [CascadingParameter] public User? CurrentUser { get; set; }

    // 04 장부 화면의 조회 조건을 그대로 넘겨받는다
    [Parameter, SupplyParameterFromQuery(Name = "year")] public int? Year { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "quarter")] public int? Quarter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "month")] public int? Month { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "dept")] public int? Dept { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "per")] public int? PerSheet { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "img")] public bool? Img { get; set; }

    private AccountingService.LedgerView _view = new();
    private List<LedgerEntry> _receiptTargets = new();
    private string _deptLabel = "";
    private bool _isLoading = true;
    private bool _printed;
    private DotNetObjectReference<MobileLedgerPrint>? _selfRef;

    public void Dispose() => _selfRef?.Dispose();

    private bool IsReceiptMode => string.Equals(Mode, "Receipt", StringComparison.OrdinalIgnoreCase);
    private int Per => PerSheet is 1 or 2 or 4 ? PerSheet.Value : 2;
    private bool WithImage => Img ?? true;

    protected override async Task OnParametersSetAsync()
    {
        if (CurrentUser == null) return;

        _isLoading = true;
        try
        {
            int year = Year ?? DateTime.Now.Year;
            int deptId = Dept ?? 0;

            _view = await Accounting.GetLedgerViewAsync(
                deptId, CurrentUser.DepartmentId, year, Quarter ?? 0, Month ?? 0,
                string.IsNullOrEmpty(Type) ? null : Type);

            var depts = await Accounting.GetDepartmentsAsync();
            _deptLabel = deptId == 0
                ? (CurrentUser.CanViewAll ? "전체 부서" : depts.FirstOrDefault(d => d.Id == CurrentUser.DepartmentId)?.Name ?? "")
                : depts.FirstOrDefault(d => d.Id == deptId)?.Name ?? "";

            _receiptTargets = _view.Entries
                .Where(t => t.Type == GlobalConstants.TransactionTypeExpense || t.Type == "Expense")
                .OrderBy(t => t.Date).ToList();
        }
        finally { _isLoading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 내용이 그려진 뒤 한 번만 인쇄 대화상자를 띄운다
        if (_printed || _isLoading || CurrentUser == null) return;
        _printed = true;
        await Task.Delay(400);          // 영수증 이미지 로드 여유
        await DoPrint();
    }

    private async Task DoPrint()
    {
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("maPrint.run", _selfRef);
        }
        catch
        {
            // maPrint를 못 부르면 최소한 인쇄는 되도록
            try { await JSRuntime.InvokeVoidAsync("print"); } catch { }
        }
    }

    // 인쇄를 마치거나 취소하면 인쇄 지면을 남기지 않고 장부로 돌아간다
    [JSInvokable]
    public Task OnPrintFinished() => InvokeAsync(() => Nav.NavigateTo("/ledger"));

    private void GoBack() => Nav.NavigateTo("/ledger");

    private static string? ReceiptOf(LedgerEntry t)
    {
        if (!string.IsNullOrEmpty(t.ReceiptPath)) return t.ReceiptPath;
        if (!string.IsNullOrEmpty(t.ReceiptUrl)) return t.ReceiptUrl;
        return null;
    }
}
