@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage BrowserStorage
@using INcheonChurchWeb.Models

<div class="page">
    @* 🚀 로딩 중일 때는 로그인 창이 뜨는 것을 막고 스피너를 보여줌 (새 탭 깜빡임 방지) *@
    @if (!isLoaded)
    {
        <div class="d-flex justify-content-center align-items-center vh-100 w-100 bg-light" style="position: fixed; top: 0; left: 0; z-index: 9999;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (CurrentUser == null)
    {
        <INcheonChurchWeb.Components.Pages.Login OnLoginSuccess="HandleLoginSuccess" />
    }
    else
    {
        @* 🖥️ PC용 사이드바 *@
        <div class="sidebar d-none d-sm-block">
            <NavMenu CurrentUser="CurrentUser" />
        </div>

        <main class="d-flex flex-column min-vh-100">

            @* ====================================================
               📱 모바일 상단 헤더 & 넓은 터치 아이콘 메뉴 (Sticky)
               ==================================================== *@
            <div class="d-sm-none sticky-top bg-white" style="box-shadow: 0 4px 10px rgba(0,0,0,0.05);">

                @* 1. 사용자 정보 (부서명 파란색 굵게 ➔ 아이디 순서) *@
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-primary" style="font-size: 1.1rem; letter-spacing: -0.5px;">@(CurrentUser.Department?.Name ?? "소속없음")</span>
                        <span class="fw-bold text-dark" style="font-size: 0.9rem;">👤 @CurrentUser.Username 님</span>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm fw-bold rounded-pill px-3 py-1" @onclick="Logout" style="font-size: 0.75rem;">로그아웃</button>
                </div>

                @* 2. 손가락 터치 면적을 넉넉하게 확보한 아이콘 탭 메뉴 *@
                <nav class="d-flex border-bottom shadow-sm">
                    <NavLink class="flex-fill text-center py-2 mobile-nav-btn text-decoration-none" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-grid-1x2-fill fs-3 d-block text-secondary icon-btn" style="line-height: 1.2;"></i>
                        <span style="font-size: 0.75rem; font-weight: 700;">홈</span>
                    </NavLink>
                    <NavLink class="flex-fill text-center py-2 mobile-nav-btn text-decoration-none" href="receipt-upload">
                        <i class="bi bi-camera-fill fs-3 d-block text-secondary icon-btn" style="line-height: 1.2;"></i>
                        <span style="font-size: 0.75rem; font-weight: 700;">영수증</span>
                    </NavLink>
                    <NavLink class="flex-fill text-center py-2 mobile-nav-btn text-decoration-none" href="monthly">
                        <i class="bi bi-book-half fs-3 d-block text-secondary icon-btn" style="line-height: 1.2;"></i>
                        <span style="font-size: 0.75rem; font-weight: 700;">장부</span>
                    </NavLink>
                </nav>
            </div>

            @* 🖥️ PC용 상단 바 *@
            <div class="top-row px-4 d-none d-sm-flex align-items-center shadow-sm bg-white">
                <span class="me-auto fw-bold text-dark fs-5">
                    @(CurrentUser.Department?.Name ?? "소속없음") 재정관리
                </span>
                <span class="me-3 text-secondary">
                    👤 <b>@CurrentUser.Username</b> 님
                </span>
                <button class="btn btn-sm btn-danger fw-bold rounded-pill px-3" @onclick="Logout">로그아웃</button>
            </div>

            <article class="content px-3 px-sm-4 mobile-content flex-grow-1">
                <CascadingValue Value="CurrentUser">
                    @Body
                </CascadingValue>
            </article>
        </main>
    }
</div>

@* 🚀 모바일 탭 버튼 터치 최적화 스타일 (외부 CSS에 구애받지 않도록 컴포넌트 내부에서 확실하게 강제 적용) *@
<style>
    .mobile-nav-btn {
        color: #8e95a5 !important;
        transition: all 0.2s ease;
        position: relative;
        padding-top: 10px !important;
        padding-bottom: 10px !important;
    }

        .mobile-nav-btn .icon-btn {
            transition: color 0.2s ease, transform 0.2s ease;
        }

        /* 활성화된 탭 디자인 */
        .mobile-nav-btn.active {
            color: #1a56db !important;
            background-color: rgba(26, 86, 219, 0.03);
        }

            .mobile-nav-btn.active .icon-btn {
                color: #1a56db !important; /* 아이콘 색상 파란색으로 변경 */
                transform: translateY(-2px); /* 터치 시 살짝 올라가는 효과 */
            }

            /* 하단 파란색 지시선 */
            .mobile-nav-btn.active::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 20%;
                right: 20%;
                height: 4px;
                background-color: #1a56db;
                border-top-left-radius: 4px;
                border-top-right-radius: 4px;
            }

        .mobile-nav-btn:active {
            background-color: #f0f2f5;
        }

    /* 모바일 콘텐츠 상단 여백 (고정 헤더 가림 방지) */
    @@media (max-width: 640px) {
        .mobile-content {
            padding-top: 15px;
        }
    }
</style>

@* 📱 SweetAlert2 경고창 세팅 *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function formatMessage(msg) {
        if (typeof msg !== 'string') msg = String(msg);
        let safeMsg = msg.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        safeMsg = safeMsg.replace(/\n/g, '<br/>');
        return `<div style="font-size: 16px; font-weight: 500; line-height: 1.5; color: #333; padding: 5px 0;">${safeMsg}</div>`;
    }

    window.alert = function (message) {
        return Swal.fire({
            html: formatMessage(message),
            confirmButtonText: '확인',
            confirmButtonColor: '#1a56db',
            allowOutsideClick: false,
            width: '380px',
            animation: false
        });
    };

    window.confirm = function (message) {
        return Swal.fire({
            html: formatMessage(message),
            showCancelButton: true,
            confirmButtonText: '확인',
            cancelButtonText: '취소',
            confirmButtonColor: '#1a56db',
            cancelButtonColor: '#8e95a5',
            allowOutsideClick: false,
            width: '380px'
        }).then((result) => {
            return result.isConfirmed;
        });
    };
</script>

@code {
    private User? CurrentUser;
    private bool isLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var result = await BrowserStorage.GetAsync<User>("loggedInUser");
                if (result.Success && result.Value != null)
                {
                    CurrentUser = result.Value;
                }
            }
            catch { }

            isLoaded = true;
            StateHasChanged();
        }
    }

    private async Task HandleLoginSuccess(User user)
    {
        CurrentUser = user;
        await BrowserStorage.SetAsync("loggedInUser", user);
        StateHasChanged();
    }

    private async Task Logout()
    {
        CurrentUser = null;
        await BrowserStorage.DeleteAsync("loggedInUser");
        StateHasChanged();
    }
}