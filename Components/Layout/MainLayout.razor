@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage BrowserStorage
@using INcheonChurchWeb.Models
@* 🚀 추가된 두 줄: 유저 복구를 위해 DB 컨텍스트 주입 *@
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<INcheonChurchWeb.Data.AppDbContext> DbContextFactory
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav

@* 🎨 레이아웃 정밀 교정 스타일 (부트스트랩/기존 CSS의 중첩 여백 강제 초기화) *@
<style>
    /* 모바일에서 웹 화면을 볼 때 상단 헤더에 뜨는 복귀 버튼 */
    .ma-back-to-app {
        display: inline-flex; align-items: center; gap: 4px;
        min-height: 44px; padding: 0 10px 0 0; margin-right: 4px;
        border: none; background: none; cursor: pointer;
        color: #785600; font-size: 0.875rem; font-weight: 700; white-space: nowrap;
    }
    .ma-back-to-app i { font-size: 1.05rem; }

    /* 1. 부모 컨테이너: flex-start로 설정하여 사이 간격 벌어짐 방지 */
    .page {
        display: flex !important;
        justify-content: flex-start !important;
        align-items: stretch;
        min-height: 100vh;
        width: 100%;
        overflow-x: hidden;
    }

    /* 2. PC 사이드바: 250px 엄격 고정 */
    .sidebar {
        width: 250px !important;
        flex: 0 0 250px !important;
        height: 100vh;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    /* 3. 메인 본문: 유연한 너비 및 중첩 여백 제거 */
    .main-content-area {
        flex: 1 !important;
        display: flex;
        flex-direction: column;
        min-width: 0;
        margin-left: 0 !important; /* 핵심: 기존에 숨어있던 250px 마진 강제 제거 */
        padding-left: 0 !important;
    }

    /* 모바일 환경 대응 (576px 미만) */
    @@media (max-width: 575.98px) {
        .page {
            flex-direction: column !important;
        }

        .sidebar {
            display: none !important;
        }

        .main-content-area {
            margin-left: 0 !important;
            width: 100%;
        }
    }

</style>

<div class="page">
    @* 🚀 로딩 중일 때는 로그인 창이 뜨는 것을 막고 스피너를 보여줌 (새 탭 깜빡임 방지) *@
    @if (!_isLoaded)
    {
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: var(--surface); display: flex; justify-content: center; align-items: center; z-index: 9999;">
            <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                <div style="width: 2.5rem; height: 2.5rem; border: 3px solid var(--surface-high); border-top-color: var(--primary-gold); border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
                <span style="font-family: 'Manrope', sans-serif; font-size: 0.75rem; font-weight: 700; color: var(--on-surface-muted); text-transform: uppercase; letter-spacing: 0.1em;">Loading</span>
            </div>
        </div>
        <style>
            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }
        </style>
    }
    else if (_currentUser == null)
    {
        <INcheonChurchWeb.Components.Pages.Login OnLoginSuccess="HandleLoginSuccess" />
    }
    else
    {
        @* 🖥️ PC 전용 사이드바 *@
        <div class="sidebar d-none d-sm-flex flex-column">
            <NavMenu CurrentUser="_currentUser" />
        </div>

        <div class="main-content-area">

            @* 🖥️ PC 전용 상단 바 *@
            <div class="pc-top-bar d-none d-sm-flex" style="padding: 0 1.5rem; height: 60px; display: flex; align-items: center; border-bottom: 1px solid var(--surface-high);">
                <span class="me-auto" style="font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 0.9375rem; color: var(--on-surface); letter-spacing: -0.01em;">
                    @(_currentUser.Department?.Name ?? "소속없음") 재정관리
                </span>
                <div class="d-flex align-items-center gap-3">
                    <span style="font-size: 0.8125rem; font-weight: 600; color: var(--on-surface-sub);">
                        @_currentUser.Username 님
                    </span>
                    <button class="btn btn-sm fw-bold" style="background-color: var(--surface-high); color: var(--on-surface-sub); border: none; border-radius: var(--radius-lg); padding: 0.3rem 1rem; font-size: 0.75rem; transition: background-color 0.2s ease-out;" @onclick="Logout">
                        로그아웃
                    </button>
                </div>
            </div>

            @* 📱 모바일 전용 상단 헤더 *@
            <div class="mobile-top-header">
                @if (ShowBackToApp)
                {
                    <button class="ma-back-to-app" title="앱 화면으로 돌아가기" @onclick="BackToApp">
                        <i class="bi bi-arrow-left"></i>
                        <span>앱으로</span>
                    </button>
                }
                <div>
                    <div class="mobile-dept-name">@(_currentUser.Department?.Name ?? "소속없음")</div>
                    <div class="mobile-user-name">@_currentUser.Username 님</div>
                </div>
                <button class="mobile-logout-btn" @onclick="Logout">로그아웃</button>
            </div>

            @* 콘텐츠 영역 *@
            <article class="content px-3 px-sm-4 mobile-content flex-grow-1" style="padding-top: 1.5rem; padding-bottom: 5rem;">
                <CascadingValue Value="_currentUser">
                    @Body
                </CascadingValue>
            </article>

            @* 📱 앱 하단 탭바 — 홈 · 장부 · [촬영] · 계획 · 더보기 (640px 이하에서만 보인다) *@
            <nav class="ma-tabbar">
                <NavLink class="ma-tab" ActiveClass="active" href="dashboard">
                    <i class="bi bi-house-door"></i>
                    <span>홈</span>
                </NavLink>

                <NavLink class="ma-tab" ActiveClass="active" href="ledger">
                    <i class="bi bi-journal-text"></i>
                    <span>장부</span>
                </NavLink>

                <div class="ma-tab-fab-slot">
                    @if (_currentUser.CanAccessDataCollection)
                    {
                        <a class="ma-tab-fab" href="receipt" title="영수증 등록">
                            <i class="bi bi-camera"></i>
                        </a>
                    }
                </div>

                <NavLink class="ma-tab" ActiveClass="active" href="plan">
                    <i class="bi bi-calendar3"></i>
                    <span>계획</span>
                </NavLink>

                <NavLink class="ma-tab" ActiveClass="active" href="more">
                    <i class="bi bi-list"></i>
                    <span>더보기</span>
                </NavLink>
            </nav>

        </div>
    }
</div>

@* 📱 SweetAlert2 경고창 세팅 *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function formatMessage(msg) {
        if (typeof msg !== 'string') msg = String(msg);
        let safeMsg = msg.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        safeMsg = safeMsg.replace(/\n/g, '<br/>');
        return `<div style="font-size: 16px; font-weight: 500; line-height: 1.5; color: #333; padding: 5px 0;">${safeMsg}</div>`;
    }

    window.alert = function (message) {
        return Swal.fire({
            html: formatMessage(message),
            confirmButtonText: '확인',
            confirmButtonColor: '#1a56db',
            allowOutsideClick: false,
            width: '380px',
            animation: false
        });
    };

    window.confirm = function (message) {
        return Swal.fire({
            html: formatMessage(message),
            showCancelButton: true,
            confirmButtonText: '확인',
            cancelButtonText: '취소',
            confirmButtonColor: '#1a56db',
            cancelButtonColor: '#8e95a5',
            allowOutsideClick: false,
            width: '380px'
        }).then((result) => {
            return result.isConfirmed;
        });
    };
</script>

<script>
    // Ensure on PC screens (>=641px) that any element with computed font-size less than 20px
    // is bumped to 20px. This runs once after page load to avoid repaint thrash during navigation.
    (function ensureMinFontSize() {
        try {
            const minPx = 20;
            // 모바일·폴더블에서는 앱 디자인이 깨지므로 적용하지 않는다
            if (!window.maViewport || window.maViewport.isMobile()) return;

            // Run after a short delay to allow Blazor to render dynamic content
            window.addEventListener('load', () => {
                setTimeout(() => {
                    const elems = document.querySelectorAll('body *');
                    for (let i = 0; i < elems.length; i++) {
                        const el = elems[i];
                        // skip script/style/meta elements
                        if (!(el instanceof Element)) continue;
                        // 모바일 앱 디자인을 그대로 재현한 화면은 최소 폰트 강제에서 제외
                        if (el.closest('[data-no-font-bump]')) continue;
                        const cs = window.getComputedStyle(el);
                        if (!cs) continue;
                        const fs = parseFloat(cs.fontSize || '0');
                        if (fs > 0 && fs < minPx) {
                            // apply inline style to enforce minimum font size
                            el.style.fontSize = minPx + 'px';
                        }
                    }
                }, 120);
            });
        }
        catch (e) {
            console && console.warn && console.warn('ensureMinFontSize error', e);
        }
    })();
</script>

@code {
    private User? _currentUser;
    private bool _isLoaded = false;

    // ── 화면 폭에 따른 웹 ↔ 앱 화면 자동 교체 ──
    // 같은 기능의 두 화면을 짝지어 두고, 접속 기기 폭(640px)에 맞는 쪽으로 보낸다.
    private static readonly Dictionary<string, string> WebToApp = new(StringComparer.OrdinalIgnoreCase)
    {
        [""] = "dashboard",
        ["monthly"] = "ledger",
        ["annual-plan"] = "plan",
        ["weekly-meeting"] = "plan",
        ["expense-report-quarterly"] = "resolution",
        ["event-report"] = "event-report-app",
        ["settings"] = "settings-app",
    };

    private static readonly Dictionary<string, string> AppToWeb = new(StringComparer.OrdinalIgnoreCase)
    {
        ["dashboard"] = "",
        ["ledger"] = "monthly",
        ["plan"] = "annual-plan",
        ["resolution"] = "expense-report-quarterly",
        ["event-report-app"] = "event-report",
        ["settings-app"] = "settings",
        ["more"] = "settings",
        ["receipt"] = "data-collection",
        ["matching"] = "data-collection",
    };

    // 앱 화면 경로 (이 목록에 없으면 웹 화면으로 본다)
    private static readonly HashSet<string> AppRoutes = new(StringComparer.OrdinalIgnoreCase)
    {
        "dashboard", "ledger", "ledger/print", "receipt", "matching", "plan",
        "resolution", "event-report-app", "more", "settings-app",
    };

    private bool _isMobile;
    private DotNetObjectReference<MainLayout>? _selfRef;

    // 모바일에서 웹 화면(수집 및 정리, 인쇄용 장부 등)을 보고 있으면 돌아갈 길을 준다
    private bool ShowBackToApp => _isMobile && !AppRoutes.Contains(CurrentPath);

    private void BackToApp()
    {
        // 짝이 되는 앱 화면이 있으면 그쪽으로, 없으면 더보기로 돌아간다
        var target = WebToApp.TryGetValue(CurrentPath, out var app) ? app : "more";
        Nav.NavigateTo(target);
    }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _selfRef?.Dispose();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = SyncRouteAsync();

    [JSInvokable]
    public async Task OnViewportChanged(bool isMobile)
    {
        _isMobile = isMobile;
        await SyncRouteAsync();
        StateHasChanged();
    }

    private string CurrentPath =>
        Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/');

    // ?web=1 이면 모바일에서도 웹 화면을 그대로 본다 (더보기 → "웹 화면으로 열기")
    private bool WantsWebView => Nav.Uri.Contains("web=1", StringComparison.OrdinalIgnoreCase);

    // 현재 경로가 반대쪽 기기 전용이면 짝이 되는 화면으로 옮긴다.
    private async Task SyncRouteAsync()
    {
        if (_currentUser == null) return;

        string path = CurrentPath;
        string? target = null;

        if (_isMobile && !WantsWebView && WebToApp.TryGetValue(path, out var app)) target = app;
        else if (!_isMobile && AppToWeb.TryGetValue(path, out var web)) target = web;

        // 앱 화면에서는 레이아웃의 모바일 상단 헤더를 숨긴다
        bool isAppRoute = AppToWeb.ContainsKey(target ?? path);
        try { await JSRuntime.InvokeVoidAsync("maViewport.setAppRoute", _isMobile && isAppRoute); }
        catch { }

        if (target != null && !string.Equals(target, path, StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo(target, replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // 🚀 1. 유저 객체 전체가 아닌 '아이디(Username) 문자열'만 불러옵니다.
                var result = await BrowserStorage.GetAsync<string>("LoggedInUsername");

                if (result.Success && !string.IsNullOrEmpty(result.Value))
                {
                    // 🚀 2. 아이디를 바탕으로 DB에서 부서 정보(Department)까지 포함하여 온전하게 복구합니다.
                    using var context = DbContextFactory.CreateDbContext();
                    _currentUser = await context.Users
                        .Include(u => u.Department)
                        .AsNoTracking()
                        .FirstOrDefaultAsync(u => u.Username == result.Value);
                }
            }
            catch { }

            try
            {
                _selfRef ??= DotNetObjectReference.Create(this);
                _isMobile = await JSRuntime.InvokeAsync<bool>("maViewport.register", _selfRef);
            }
            catch { }

            _isLoaded = true;
            StateHasChanged();

            await SyncRouteAsync();
        }
    }

    private async Task HandleLoginSuccess(User user)
    {
        _currentUser = user;
        // 🚀 로그인 성공 시 객체가 아닌 '아이디'만 저장합니다.
        await BrowserStorage.SetAsync("LoggedInUsername", user.Username);
        StateHasChanged();
        await SyncRouteAsync();
    }

    private async Task Logout()
    {
        bool confirm = await JSRuntime.ConfirmAsync("로그아웃 하시겠습니까?");
        if (confirm)
        {
            _currentUser = null;
            // 🚀 로그아웃 시 저장된 '아이디'를 삭제합니다.
            await BrowserStorage.DeleteAsync("LoggedInUsername");
            StateHasChanged();
        }
    }
}