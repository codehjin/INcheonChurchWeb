@using INcheonChurchWeb.Models

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">인천중앙교회 교육국</a>
    </div>
</div>

@* 🚀 C#이나 JS 대신 순수 CSS로 동작하는 체크박스 햄버거 버튼 *@
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

@* 🚀 메뉴 항목을 클릭하면 체크박스를 다시 눌러서 창을 닫게 만듦 *@
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill fs-5 me-2"></i> 대시보드
            </NavLink>
        </div>

        @if (!CanViewAll)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="bank-import">
                    <i class="bi bi-bank fs-5 me-2"></i> 은행내역 불러오기
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="expense-report-quarterly">
                    <i class="bi bi-file-earmark-text-fill fs-5 me-2"></i> 지출결의서
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="monthly">
                <i class="bi bi-calendar3 fs-5 me-2"></i> 월별장부
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="receipt-query">
                <i class="bi bi-receipt fs-5 me-2"></i> @(CanViewAll ? "영수증 보기" : "영수증 관리")
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <i class="bi bi-gear-fill fs-5 me-2"></i> 환경설정
            </NavLink>
        </div>
    </nav>
</div>

@code {
    [Parameter] public User? CurrentUser { get; set; }

    private bool CanViewAll => CurrentUser?.Role == "Admin" ||
                               CurrentUser?.Role == "Auditor" ||
                               CurrentUser?.Department?.Name == "교육국" ||
                               CurrentUser?.Department?.Name == "관리자";
}