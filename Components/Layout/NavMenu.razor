@using INcheonChurchWeb.Models

@* ── 브랜드 헤더 ── *@
<div class="stitch-nav-brand">
    <div class="stitch-nav-brand-icon">
        <i class="bi bi-building"></i>
    </div>
    <div>
        <h1>인천중앙교회 교육국</h1>
        <p>회계 관리 시스템</p>
    </div>
</div>

@* ── 네비게이션 메뉴 ── *@
<nav class="stitch-nav">
    <NavLink class="stitch-nav-item" href="" Match="NavLinkMatch.All">
        <span class="nav-icon-wrap"><i class="bi bi-grid-1x2-fill"></i></span>
        <span class="nav-label">대시보드</span>
    </NavLink>

    @if (CurrentUser?.CanEdit == true)
    {
        <NavLink class="stitch-nav-item" href="annual-plan">
            <span class="nav-icon-wrap"><i class="bi bi-calendar-event"></i></span>
            <span class="nav-label">연간 계획</span>
        </NavLink>
        <NavLink class="stitch-nav-item" href="weekly-meeting">
            <span class="nav-icon-wrap"><i class="bi bi-journal-text"></i></span>
            <span class="nav-label">주간 회의록</span>
        </NavLink>
        <NavLink class="stitch-nav-item" href="expense-report-quarterly">
            <span class="nav-icon-wrap"><i class="bi bi-file-earmark-text-fill"></i></span>
            <span class="nav-label">지출결의서</span>
        </NavLink>
    }

    @if (CurrentUser?.CanAccessDataCollection == true)
    {
        <NavLink class="stitch-nav-item" href="data-collection">
            <span class="nav-icon-wrap"><i class="bi bi-receipt-cutoff"></i></span>
            <span class="nav-label">수집 및 정리</span>
        </NavLink>
    }

    <NavLink class="stitch-nav-item" href="monthly">
        <span class="nav-icon-wrap"><i class="bi bi-book-half"></i></span>
        <span class="nav-label">월별 장부</span>
    </NavLink>

    <NavLink class="stitch-nav-item" href="settings">
        <span class="nav-icon-wrap"><i class="bi bi-gear-fill"></i></span>
        <span class="nav-label">환경설정</span>
    </NavLink>

    @if (CurrentUser?.CanEdit == true)
    {
        <NavLink class="stitch-nav-item" href="manual">
            <span class="nav-icon-wrap"><i class="bi bi-info-circle-fill"></i></span>
            <span class="nav-label">도움말</span>
        </NavLink>
    }
</nav>

@code {
    [Parameter] public User? CurrentUser { get; set; }
}
