@using INcheonChurchWeb.Models

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">인천중앙교회 교육국</a>
    </div>
</div>

@* 🚀 C#이나 JS 대신 순수 CSS로 동작하는 체크박스 햄버거 버튼 *@
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

@* 🚀 메뉴 항목을 클릭하면 체크박스를 다시 눌러서 창을 닫게 만듦 *@
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column pb-4">

        @* ==========================================
           📊 [홈] 누구나 접근 가능 (모바일/PC)
           ========================================== *@
        <div class="nav-item px-3 mt-2">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill fs-5 me-2"></i> 대시보드
            </NavLink>
        </div>

        @* ==========================================
           📝 [1단계: 기안] 메인회계 전용 (PC 중심)
           ========================================== *@
        @if (IsMainAccount)
        {
            <div class="d-none d-sm-block mt-3 border-top pt-2">
                <div class="text-white-50 px-3 mb-1" style="font-size: 0.8rem;">사전 준비 및 기안</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="expense-report-quarterly">
                        <i class="bi bi-file-earmark-text-fill fs-5 me-2"></i> 지출결의서
                    </NavLink>
                </div>
            </div>
        }

        @* ==========================================
           💳 [2단계: 증빙] 메인회계 & 보조회계 전용 (모바일/PC)
           ========================================== *@
        @if (IsMainAccount || IsSubAccount)
        {
            <div class="mt-3 border-top pt-2">
                <div class="text-white-50 px-3 mb-1" style="font-size: 0.8rem;">지출 및 증빙</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="receipt-upload">
                        <i class="bi bi-camera-fill fs-5 me-2 text-warning"></i> 영수증 업로드
                    </NavLink>
                </div>
            </div>
        }

        @* ==========================================
           📒 [3단계: 장부 처리] (PC 중심)
           ========================================== *@
        <div class="d-none d-sm-block mt-3 border-top pt-2">
            <div class="text-white-50 px-3 mb-1" style="font-size: 0.8rem;">회계 장부 확인 및 처리</div>

            @* 메인회계만 은행 내역 업로드 가능 *@
            @if (IsMainAccount)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="bank-import">
                        <i class="bi bi-bank fs-5 me-2"></i> 은행내역 불러오기
                    </NavLink>
                </div>
            }

            @* 월별장부는 모두가 열람 가능 (수정/삭제 등은 페이지 내부에서 권한 통제) *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="monthly">
                    <i class="bi bi-calendar3 fs-5 me-2"></i> 월별장부
                </NavLink>
            </div>
        </div>
               
        @* ==========================================
           ⚙️ [기초 설정] 누구나 접근 (세부 권한은 설정 페이지 내부에서 처리)
           ========================================== *@
        <div class="mt-3 border-top pt-2 pb-4">
            <div class="text-white-50 px-3 mb-1" style="font-size: 0.8rem;">환경 설정</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings">
                    <i class="bi bi-gear-fill fs-5 me-2"></i> 환경설정
                </NavLink>
            </div>
        </div>

    </nav>
</div>

@code {
    [Parameter] public User? CurrentUser { get; set; }

    // 💡 1. 관리자 및 감사 그룹 (기존 CanViewAll 논리와 동일)
    private bool IsViewerOrAdmin => CurrentUser?.Role == "Admin" ||
                                    CurrentUser?.Role == "Auditor" ||
                                    CurrentUser?.Department?.Name == "교육국" ||
                                    CurrentUser?.Department?.Name == "관리자";

    // 💡 2. 보조회계 계정 확인
    // 실제 데이터베이스에 저장되는 보조회계의 Role 또는 Department 이름에 맞게 수정하세요.
    private bool IsSubAccount => CurrentUser?.Role == "SubAccount" ||
                                 CurrentUser?.Role == "보조회계";

    // 💡 3. 일반 메인회계 (관리자도 아니고, 보조회계도 아닌 부서 담당자)
    private bool IsMainAccount => !IsViewerOrAdmin && !IsSubAccount;
}