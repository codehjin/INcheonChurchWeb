@* 가정통신문 한 장 — 종이 통신문의 순서 그대로.
   학부모앱의 통신문 화면과 재정앱의 [미리보기]가 이 부품 하나를 함께 쓴다 (어긋날 수 없다).
   HttpContext · 서비스에 기대지 않는다 — 받은 값만으로 그린다. *@

@{
    var n = Notice;
    var profile = Profile;
    var cols = NoticeText.ColumnsOf(n.Weeks);
    int no = 0;
}

<article class="hp-paper">
    <header class="hp-paper-head">
        <p class="hp-hero-dept">@(profile?.DisplayName ?? DeptName)</p>
        <h1 class="hp-paper-title"><span class="hp-paper-month">@(n.Month)월</span> 가정통신문</h1>
        <p class="hp-paper-date">@(n.Year)년 @(n.Month)월</p>
    </header>

    <PortalLinks Profile="profile" />

    @if (!string.IsNullOrWhiteSpace(n.Greeting))
    {
        <section class="hp-card @(RichText.IsHtml(n.Greeting) ? "" : "hp-greeting")">
            <RichContent Content="@n.Greeting" PlainClass="" />
        </section>
    }

    @* ── 일정표 ── *@
    @if (n.Weeks.Count > 0)
    {
        no++;
        <section class="hp-card">
            <h2 class="hp-sec-title"><span class="hp-num">@no</span>일정표</h2>

            @* PC: 종이 통신문과 같은 표 (폰·폴드는 아래 카드) *@
            <div class="hp-table-wrap">
            <table class="hp-table">
                <thead>
                    <tr>
                        <th>주차</th>
                        <th>날짜</th>
                        @if (cols.Scripture) { <th>말씀</th> }
                        @if (cols.SermonTitle) { <th>제목</th> }
                        @if (cols.Activity) { <th>활동</th> }
                        @if (cols.Offering) { <th>봉헌</th> }
                        @if (cols.Prayer) { <th>대표기도</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (w, i) in n.Weeks.Select((w, i) => (w, i)))
                    {
                        <tr>
                            <td class="c">@(i + 1)</td>
                            <td class="c">@NoticeText.Md(w.Date)</td>
                            @if (cols.Scripture) { <td>@w.Scripture</td> }
                            @if (cols.SermonTitle) { <td>@w.SermonTitle</td> }
                            @if (cols.Activity) { <td class="c">@w.Activity</td> }
                            @if (cols.Offering) { <td class="c">@w.Offering</td> }
                            @if (cols.Prayer) { <td class="c">@w.Prayer</td> }
                        </tr>
                    }
                </tbody>
            </table>
            </div>

            @* 폰: 한 주에 카드 하나 · 폴드 메인 화면: 2열 *@
            <ol class="hp-weeks">
                @foreach (var (w, i) in n.Weeks.Select((w, i) => (w, i)))
                {
                    <li class="hp-week">
                        <div class="hp-week-head">
                            <span class="hp-week-no">@(i + 1)주</span>
                            <span class="hp-week-date">@(w.Date.Month)월 @(w.Date.Day)일</span>
                            @if (!string.IsNullOrWhiteSpace(w.Activity))
                            {
                                <span class="hp-chip">@w.Activity</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(w.Scripture))
                        {
                            <div class="hp-week-word"><i class="bi bi-book"></i> @w.Scripture</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(w.SermonTitle))
                        {
                            <div class="hp-week-title">@w.SermonTitle</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(w.Offering) || !string.IsNullOrWhiteSpace(w.Prayer))
                        {
                            <div class="hp-week-people">
                                @if (!string.IsNullOrWhiteSpace(w.Offering)) { <span>봉헌 <b>@w.Offering</b></span> }
                                @if (!string.IsNullOrWhiteSpace(w.Prayer)) { <span>대표기도 <b>@w.Prayer</b></span> }
                            </div>
                        }
                    </li>
                }
            </ol>

            @if (!string.IsNullOrWhiteSpace(n.ScheduleNote))
            {
                <p class="hp-note">@n.ScheduleNote</p>
            }
        </section>
    }

    @* ── 안내 꼭지 ── *@
    @foreach (var s in n.Sections)
    {
        no++;
        <section class="hp-card">
            <h2 class="hp-sec-title"><span class="hp-num">@no</span>@s.Title</h2>
            @if (!string.IsNullOrWhiteSpace(s.Body))
            {
                <RichContent Content="@s.Body" />
            }
        </section>
    }

    @* ── 사진 ── *@
    @if (PhotoLinks.Count > 0 || Album != null)
    {
        no++;
        <section class="hp-card">
            <h2 class="hp-sec-title"><span class="hp-num">@no</span>사진</h2>
            <div class="hp-photos">
                @foreach (var l in PhotoLinks)
                {
                    <a class="hp-photo" href="@l.Url" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-images"></i><span>@l.Title</span><i class="bi bi-box-arrow-up-right"></i>
                    </a>
                }
                @if (Album != null)
                {
                    <a class="hp-photo all" href="@Album" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-collection"></i><span>부서 사진첩 전체 보기</span><i class="bi bi-box-arrow-up-right"></i>
                    </a>
                }
            </div>
        </section>
    }

    @* ── 연락처: 전도사 · 부장 두 분만 ── *@
    @if (HasContact(profile?.MinisterName, profile?.MinisterPhone) || HasContact(profile?.HeadName, profile?.HeadPhone))
    {
        no++;
        <section class="hp-card">
            <h2 class="hp-sec-title"><span class="hp-num">@no</span>선생님 연락처</h2>
            <ul class="hp-contacts">
                @if (HasContact(profile?.MinisterName, profile?.MinisterPhone))
                {
                    <ContactRow Role="@(profile!.MinisterTitle)" Name="@profile.MinisterName" Phone="@profile.MinisterPhone" />
                }
                @if (HasContact(profile?.HeadName, profile?.HeadPhone))
                {
                    <ContactRow Role="부장" Name="@profile!.HeadName" Phone="@profile.HeadPhone" />
                }
            </ul>
        </section>
    }

    <PortalFooter Profile="profile" />
</article>

@code {
    [Parameter, EditorRequired] public Notice Notice { get; set; } = default!;
    [Parameter] public PortalProfile? Profile { get; set; }
    [Parameter] public string DeptName { get; set; } = "";

    /// <summary>그릴 때도 http(s) 주소만 (저장할 때 이미 걸렀지만 한 번 더)</summary>
    private List<NoticeLink> PhotoLinks => Notice.Links.Where(l => SafeUrl.IsHttp(l.Url)).ToList();

    private string? Album => SafeUrl.OrNull(Profile?.PhotoAlbumUrl);

    private static bool HasContact(string? name, string? phone)
        => !string.IsNullOrWhiteSpace(name) || !string.IsNullOrWhiteSpace(phone);
}
